                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,6">
                                        <TextBlock Text="Nội dung"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="8,6">
                                        <Grid>
                                            <TextBox Text="{Binding CommandPanelSmsContent, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="90"
                                                     Padding="0"
                                                     materialDesign:HintAssist.Hint="Nội dung tin nhắn"/>
                                            <TextBlock Text="0/160"
                                                       Foreground="#B8C0D0"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Mã hóa & Chế độ -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Mã hóa" Foreground="White" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding CommandPanelSmsEncoding}"
                                              Height="28">
                                        <ComboBoxItem Content="Tự động"/>
                                        <ComboBoxItem Content="GSM"/>
                                        <ComboBoxItem Content="UCS2"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2" Text="Chế độ" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Column="3"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="4" Text="Thử lại" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Column="5"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>

                            <!-- Proxy -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Proxy">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Hướng dẫn Proxy -->
                                <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Proxy Server Tự Động Đang Chạy Ngầm" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                        <TextBlock Text="Hệ thống đã tự động quét các mạng 3G/4G của SIM và khởi tạo Proxy Server nội bộ thành công." Foreground="#B8C0D0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="Port mặc định: 3001, 3002... tương ứng với từng cổng mạng." Foreground="#B8C0D0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="👉 Cách dùng API tự động:" Foreground="#EC3F9B" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="1. Lấy danh sách IP và Port Proxy: GET http://localhost:8080/api/proxies" Foreground="#FFCCBC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="2. Gửi lệnh Reset IP cho một cổng (ví dụ COM5): GET http://localhost:8080/api/proxy/reset/COM5" Foreground="#FFCCBC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="*Tính năng Hàng đợi lệnh tạm vô hiệu hóa trên tab này do Proxy chạy nền tự động." Foreground="#8892B0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>



                            <!-- Gọi -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Call">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Gọi đến -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="Gọi đến"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelCallNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>

                                <!-- Thời gian cuộc gọi -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="Thời gian cuộc gọi"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelCallDuration, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1,1,0,1"
                                             Padding="8,3"
                                             materialDesign:HintAssist.Hint="Để trống nếu không giới hạn thời gian cuộc gọi"/>

                                    <Border Grid.Column="2"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="0">
                                        <TextBlock Text="s"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- DTMF -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="DTMF"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelCallDtmf, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"
                                             materialDesign:HintAssist.Hint="Không bắt buộc, chỉ cho phép kí tự 0-9, *, #, A-D, -"/>
                                </Grid>

                                <!-- Chế độ / thử lại -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                                
                                
                            </StackPanel>

                            <!-- Data -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Data">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Cảnh báo đã hỗ trợ -->
                                <Border Background="#334CAF50" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <TextBlock Text="✔️ Đã hỗ trợ chạy tải Data ngầm (Tương thích tốt nhất với chip Quectel) để tiêu thụ dung lượng KB." Foreground="#C8E6C9" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Dung lượng data -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="Dung lượng data"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelDataAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1,1,0,1"
                                             Padding="8,3"/>

                                    <Border Grid.Column="2"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="0">
                                        <TextBlock Text="KB"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Chế độ / thử lại -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>

                                <!-- Khoảng trống giống ảnh -->
                                
                            </StackPanel>
                            

                            
                            <!-- Trễ -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Delay">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Thời gian trễ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Thời gian" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                    <TextBlock Grid.Column="2" Text="giây" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Chạy ngay lập tức"
                                    Background="#F59E0B"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="28"
                                    Command="{Binding RunSingleCommandQueueCommand}">
                                <Button.ToolTip>
                                    <ToolTip Content="Thực thi lệnh ngay trên các cổng đã chọn mà không cần thêm vào Kịch bản"/>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Margin space -->
                <Border Grid.Row="2" Background="Transparent" Height="10"/>

                <!-- Kết quả chạy lệnh -->
                <Border Grid.Row="3" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,0,0">
                            <materialDesign:PackIcon Kind="ListStatus" Foreground="#00D1C7" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Kết quả chạy lệnh"
                                       Foreground="#DDE2FF"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Ports}"
                                  Style="{StaticResource ProDataGridStyle}"
                                  Margin="6"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cổng" Binding="{Binding PortName}" Width="65" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="115" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                <DataGridTextColumn Header="Kết quả lệnh" Binding="{Binding LastCommandResult}" Width="*" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>



        <!-- #6: Terminal Log với bộ lọc theo cổng -->
        <Expander Grid.Row="2" Background="#020617" Foreground="#4CAF50" ExpandDirection="Up" Padding="0" Header="Lịch sử AT Commands (Terminal)" FontFamily="Consolas">
            <Border BorderBrush="#333" BorderThickness="0,1,0,0" Height="170">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Filter bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#020617" Margin="10,4">
                        <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0"/>
                        <TextBox Width="120" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Lọc cổng (VD: COM41)"
                                 Style="{StaticResource SearchTextBoxStyle}" FontFamily="Consolas" Foreground="#4CAF50"/>
                        <Button Content="All" Command="{Binding SetLogFilterCommand}" CommandParameter="" Background="#333344" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="8,0,0,0"/>

                        <Button Content="Firebase" Command="{Binding SetLogFilterCommand}" CommandParameter="[FIREBASE]" Background="#5C6BC0" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="SMS" Command="{Binding SetLogFilterCommand}" CommandParameter="[SMS]" Background="#00897B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="USSD" Command="{Binding SetLogFilterCommand}" CommandParameter="[USSD]" Background="#7E57C2" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <TextBlock Text="|" Foreground="#444" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilteredLogCount, StringFormat='Hiển thị: {0} dòng'}" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>

                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}" Background="Transparent" BorderThickness="0" Margin="10,0,10,6">
                        <ListBox.ContextMenu>
                            <ContextMenu >
                                <MenuItem Header="Sao chép" Command="{Binding Path=DataContext.CopySelectedLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sao chép tất cả" Command="{Binding Path=DataContext.CopyAllLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="Gray" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Level}" Foreground="Cyan" Margin="0,0,10,0" Width="50"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Expander>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#020617" Foreground="#94a3b8" Padding="10,5" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Ports.Count, StringFormat='Số lượng cổng: \{0\}'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SmsMessages.Count, StringFormat='Mẹo: Giữ Ctrl và lăn chuột để phóng to/thu nhỏ bảng | Tổng SMS: \{0\}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Global Snackbar Notifications -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}" Grid.RowSpan="4"/>
        </Grid> <!-- Close Main Workspace Grid -->
    </Grid> <!-- Close Outer Grid -->
                        <!-- DialogHost closing tag removed -->
                    <!-- DialogHost closing tag removed -->
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>
    </materialDesign:DialogHost>
    </materialDesign:DialogHost>
</materialDesign:DialogHost>
</Window>

