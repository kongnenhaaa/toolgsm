                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ServerNetwork" Width="32" Height="32" Foreground="#38bdf8" VerticalAlignment="Center"/>
                    <TextBlock Text="GSM" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                </StackPanel>

                <!-- Navigation Menu & Tools -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,20">
                        <RadioButton GroupName="SidebarMenu" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}" 
                                     Style="{StaticResource SidebarTabRadioButtonStyle}" Margin="0,5" Height="45" HorizontalContentAlignment="Left" Padding="15,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="UsbPort" Width="20" Height="20" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý GSM" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <RadioButton GroupName="SidebarMenu" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}" 
                                     Style="{StaticResource SidebarTabRadioButtonStyle}" Margin="0,5" Height="45" HorizontalContentAlignment="Left" Padding="15,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="MessageText" Width="20" Height="20" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tin Nhắn SMS" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <RadioButton GroupName="SidebarMenu" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}" 
                                     Style="{StaticResource SidebarTabRadioButtonStyle}" Margin="0,5" Height="45" HorizontalContentAlignment="Left" Padding="15,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="20" Height="20" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hướng Dẫn" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <Separator Background="#334155" Margin="10,15" />
                        <TextBlock Text="CÔNG CỤ" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold" Margin="15,0,0,10" Style="{StaticResource SidebarTextStyle}"/>
                        
                        <Button Command="{Binding ToggleCommandPanelCommand}" Style="{StaticResource SidebarToolButtonStyle}" ToolTip="Mở/đóng bảng lệnh">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Asterisk" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Bảng lệnh" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Sắp xếp cổng">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SortAscending" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Sắp xếp cổng" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Sắp xếp theo thứ tự COM" Command="{Binding SortPortsCommand}" CommandParameter="COM">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="SortNumericAscending"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sắp xếp theo Nhà mạng" Command="{Binding SortPortsCommand}" CommandParameter="Network">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="Sim"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sắp xếp theo Trạng thái (Online)" Command="{Binding SortPortsCommand}" CommandParameter="Status">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CheckCircle"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sắp xếp theo Cường độ sóng" Command="{Binding SortPortsCommand}" CommandParameter="Signal">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="Signal"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sắp xếp theo Số dư (Cao - Thấp)" Command="{Binding SortPortsCommand}" CommandParameter="Balance">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="Wallet"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Kiểm tra số dư">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wallet" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Kiểm tra số dư" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kiểm tra số dư TẤT CẢ các cổng" Command="{Binding CheckBalanceCommand}" CommandParameter="All">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="WalletPlus"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Kiểm tra số dư CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding CheckBalanceCommand}" CommandParameter="Selected">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="WalletOutline"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Đặt pass MyVNPT">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Đặt pass MyVNPT" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Chạy TẤT CẢ các cổng" Command="{Binding SetMyVnptPasswordCommand}" CommandParameter="All">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CheckAll"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Chạy CÁC CỔNG ĐÃ TÍCH (☑)" Command="{Binding SetMyVnptPasswordCommand}" CommandParameter="Selected">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CheckboxMarkedOutline"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Chạy CÁC CỔNG CÓ LỖI (OTP không trả về, đặt không thành công...)" Command="{Binding SetMyVnptPasswordCommand}" CommandParameter="Error">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="AlertCircleOutline"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Sidebar USSD Button removed -->
                        <Button Command="{Binding OpenExportExcelDialogCommand}" Style="{StaticResource SidebarToolButtonStyle}" ToolTip="Xuất danh sách cổng ra file Excel">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Xuất Excel" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Quét tin nhắn kẹt">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Foreground="#22D3EE" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quét tin kẹt" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Quét TẤT CẢ các cổng" Command="{Binding SweepSmsCommand}" CommandParameter="All">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="Broom"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Quét CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding SweepSmsCommand}" CommandParameter="Selected">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CursorDefaultClick"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Làm mới hoặc Khởi động lại cổng">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Làm mới / Reset" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🔄 Làm mới danh sách cổng (Refresh)" Command="{Binding RefreshPortsCommand}">
                                    </MenuItem>
                                    <Separator Background="#444"/>
                                    <MenuItem Header="⚡ Khởi động lại Modem CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding RebootModemCommand}" CommandParameter="Selected">
                                    </MenuItem>
                                    <MenuItem Header="⚡ Khởi động lại TẤT CẢ Modem" Command="{Binding RebootModemCommand}" CommandParameter="All">
                                    </MenuItem>
                                    <Separator Background="#444"/>
                                    <MenuItem Header="🛠️ Fix Modem EC20 CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding FixEc20Command}" CommandParameter="Selected">
                                    </MenuItem>
                                    <MenuItem Header="🛠️ Fix Modem EC20 TẤT CẢ CỔNG" Command="{Binding FixEc20Command}" CommandParameter="All">
                                    </MenuItem>
                                    <Separator Background="#444"/>
                                    <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding ClearSmsCommand}" CommandParameter="Selected">
                                    </MenuItem>
                                    <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên TẤT CẢ CỔNG" Command="{Binding ClearSmsCommand}" CommandParameter="All">
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Ngắt sóng an toàn để đổi SIM">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SimOutline" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Đổi SIM mới" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🛡️ CHUẨN BỊ ĐỔI SIM CÁC CỔNG ĐÃ CHỌN (An Toàn)" Command="{Binding PrepareSwapSimCommand}" Foreground="#81C784">
                                        <MenuItem.ToolTip>
                                            <ToolTip Content="Ngắt sóng các cổng đã chọn để bạn có thể rút khay SIM ra thay SIM mới mà không bị lộ IMEI phần cứng." />
                                        </MenuItem.ToolTip>
                                    </MenuItem>
                                    <MenuItem Header="🛡️ CHUẨN BỊ ĐỔI SIM TẤT CẢ (An Toàn)" Command="{Binding PrepareSwapSimCommand}" CommandParameter="All" Foreground="#81C784">
                                        <MenuItem.ToolTip>
                                            <ToolTip Content="Ngắt sóng tất cả các cổng để bạn có thể rút khay SIM ra thay SIM mới mà không bị lộ IMEI phần cứng." />
                                        </MenuItem.ToolTip>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Command="{Binding ApproveUnknownSimCommand}" CommandParameter="AllBlocked" Style="{StaticResource SidebarToolButtonStyle}" ToolTip="Duyệt tất cả SIM lạ đang bị chặn">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckDecagram" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Duyệt tất cả SIM lạ" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenTopUpDialogCommand}" CommandParameter="All" Style="{StaticResource PrimarySidebarToolButtonStyle}" ToolTip="Nạp thẻ cào điện thoại">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardPlus" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Nạp thẻ" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarToolButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Đăng ký dịch vụ EZ COM (Vinaphone)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SimAlert" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Đăng ký EZ COM" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Đăng ký EZ COM cho TẤT CẢ các cổng" Command="{Binding RegisterEzComCommand}" CommandParameter="All">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CheckAll"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Đăng ký EZ COM CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding RegisterEzComCommand}" CommandParameter="Selected">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CursorDefaultClick"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Sidebar ComposeSms Button removed -->
                        <Button Command="{Binding OpenCallManagerDialogCommand}" Style="{StaticResource SidebarToolButtonStyle}" ToolTip="Quản lý lịch sử và thực hiện cuộc gọi">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Phone" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý cuộc gọi" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Background="#0f172a">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Tab Content -->
                <RowDefinition Height="Auto"/> <!-- Terminal -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#111B2E" BorderBrush="#2A3952" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToggleSidebarButton" Style="{StaticResource MaterialDesignHamburgerToggleButton}" Foreground="#CBD5E1" Margin="0,0,15,0"/>
                        <TextBlock Text="Trang chủ" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Terminal (Lệnh AT)" Height="40" Width="40" Command="{Binding OpenAtCommandDialogCommand}" Background="Transparent" BorderThickness="0">
                            <materialDesign:PackIcon Kind="Terminal" Foreground="#60A5FA" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Quản lý IMEI" Height="40" Width="40" Margin="10,0" Command="{Binding OpenImeiManagerCommand}" Background="Transparent" BorderThickness="0">
                            <materialDesign:PackIcon Kind="CellphoneSettings" Foreground="#CBD5E1" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Quản lý hiển thị (Ẩn/Hiện cột)" Height="40" Width="40" Margin="0,0,10,0" Command="{Binding OpenDisplayColumnsDialogCommand}" Background="Transparent" BorderThickness="0">
                            <materialDesign:PackIcon Kind="ViewColumn" Foreground="#F59E0B" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cài đặt hệ thống" Height="40" Width="40" Command="{Binding OpenSettingsDialogCommand}" Background="Transparent" BorderThickness="0">
                            <materialDesign:PackIcon Kind="Cog" Foreground="#CBD5E1" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tab Content -->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCommandPanelOpen}" Value="True">
                                    <Setter Property="Width" Value="575"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: GSM -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <UniformGrid Grid.Row="0" Columns="4" Margin="10,10,10,5">
                        <!-- Tổng COM -->
                        <Border Background="#182338" BorderBrush="#2A3952" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0">
                            <Grid>
                                <Border Background="#3B82F6" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="3,0,0,3"/>
                                <Grid Margin="15,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Tổng COM" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding TotalPortCount}" Foreground="#3B82F6" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="UsbPort" Width="28" Height="28" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- Online -->
                        <Border Background="#182338" BorderBrush="#2A3952" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0">
                            <Grid>
                                <Border Background="#22C55E" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="3,0,0,3"/>
                                <Grid Margin="15,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Online" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding OnlinePortCount}" Foreground="#22C55E" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircleOutline" Width="28" Height="28" Foreground="#22C55E" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- Offline -->
                        <Border Background="#182338" BorderBrush="#2A3952" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0">
                            <Grid>
                                <Border Background="#EF4444" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="3,0,0,3"/>
                                <Grid Margin="15,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Offline" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding OfflinePortCount}" Foreground="#EF4444" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="CloseCircleOutline" Width="28" Height="28" Foreground="#EF4444" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- SMS Nhận -->
                        <Border Background="#182338" BorderBrush="#2A3952" BorderThickness="1" CornerRadius="10" Margin="0,0,0,0">
                            <Grid>
                                <Border Background="#F59E0B" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="3,0,0,3"/>
                                <Grid Margin="15,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="SMS Nhận" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SmsReceivedCount}" Foreground="#F59E0B" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="MessageTextOutline" Width="28" Height="28" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    
                    <!-- GSM DataGrid Wrapper -->
                    <Border Grid.Row="1" Background="#182338" BorderBrush="#2A3952" BorderThickness="1" CornerRadius="10" Margin="10" Padding="5">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <DataGrid x:Name="MainDataGrid" ItemsSource="{Binding FilteredPortsView}" SelectedItem="{Binding SelectedPort}" 
                                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                                      Style="{StaticResource ProDataGridStyle}"
                                      Margin="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu >
                                <MenuItem Command="Copy" Header="Sao chép (Ctrl+C)" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="#444"/>
                                <MenuItem Header="Chấp thuận SIM lạ (Lưu vào kho)" Command="{Binding Path=DataContext.ApproveUnknownSimCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#90CAF9">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CheckDecagram"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="#444"/>
                                <MenuItem Header="Sao chép SĐT" Command="{Binding Path=DataContext.CopyPhoneFromPortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Phone"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Nạp thẻ nhanh" Command="{Binding Path=DataContext.OpenTopUpDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Selected"  Foreground="#4CAF50">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CashPlus"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Kiểm tra số dư (Các cổng đã chọn)" Command="{Binding Path=DataContext.CheckBalanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Selected" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Magnify"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- ContextMenu USSD removed -->
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" ClipboardContentBinding="{Binding IsSelected}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.IsAllPortsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" ToolTip="Chọn / Bỏ chọn tất cả" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="STT" Binding="{Binding Stt}" Width="80" IsReadOnly="True"  Visibility="{Binding Data.AppSettings.ShowColStt, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" SortMemberPath="PortNumber" Width="160" HeaderTemplate="{StaticResource PortNameHeaderTemplate}" Visibility="{Binding Data.AppSettings.ShowColPort, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Thiết bị (Fake)" Binding="{Binding DeviceName}" Width="160" Foreground="#29B6F6" Visibility="{Binding Data.AppSettings.ShowColDevice, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="IMEI" Binding="{Binding Imei}" Width="160" HeaderTemplate="{StaticResource ImeiHeaderTemplate}" Visibility="{Binding Data.AppSettings.ShowColImei, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Serial" Binding="{Binding Serial}" Width="180" HeaderTemplate="{StaticResource SerialHeaderTemplate}" Visibility="{Binding Data.AppSettings.ShowColSerial, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SĐT" Binding="{Binding PhoneNumber}" Width="150" HeaderTemplate="{StaticResource PhoneHeaderTemplate}" Visibility="{Binding Data.AppSettings.ShowColPhone, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTemplateColumn Header="TKC" Width="110" ClipboardContentBinding="{Binding Balance}" Visibility="{Binding Data.AppSettings.ShowColBalance, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Balance}" TextWrapping="Wrap" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="OTP" Width="110" ClipboardContentBinding="{Binding Otp}" Visibility="{Binding Data.AppSettings.ShowColOtp, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Otp}" Value="{x:Null}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Otp}" Value="">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Otp}" TextWrapping="Wrap" Foreground="#FF9800" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Trạng thái" Binding="{Binding VnptStatus}" Width="120" Visibility="{Binding Data.AppSettings.ShowColStatus, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding LastMessageContent}" Width="800" Visibility="{Binding Data.AppSettings.ShowColContent, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Ngày tạo" Binding="{Binding CreatedAt}" Width="150" Visibility="{Binding Data.AppSettings.ShowColCreatedAt, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTemplateColumn Header="Kết nối" Width="110" ClipboardContentBinding="{Binding Status}" Visibility="{Binding Data.AppSettings.ShowColConnect, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1EEF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#1E22C55E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Background" Value="#1EEF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                                            <Setter Property="Background" Value="#1EF59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unknown">
                                                            <Setter Property="Background" Value="#1E64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unknown">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Health" Width="150" ClipboardContentBinding="{Binding HealthSummary}" Visibility="{Binding Data.AppSettings.ShowColHealth, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#263238" CornerRadius="10" Padding="8,3" ToolTip="{Binding LastError}">
                                            <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" Foreground="#B2EBF2" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Timeout" Binding="{Binding TimeoutCount}" Width="75" Visibility="{Binding Data.AppSettings.ShowColTimeout, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi SMS" Binding="{Binding SmsErrorCount}" Width="75" Visibility="{Binding Data.AppSettings.ShowColSmsError, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Reconnect" Binding="{Binding ReconnectCount}" Width="85" Visibility="{Binding Data.AppSettings.ShowColReconnect, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SMS cuối" Binding="{Binding LastSmsSentAt}" Width="90" Visibility="{Binding Data.AppSettings.ShowColLastSms, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi cuối" Binding="{Binding LastError}" Width="180" Visibility="{Binding Data.AppSettings.ShowColLastError, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            
                            <!-- Tín hiệu Signal Bars -->
                            <DataGridTemplateColumn Header="Tín hiệu" Width="150" ClipboardContentBinding="{Binding SignalStrength}" Visibility="{Binding Data.AppSettings.ShowColSignal, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                            <ProgressBar Value="{Binding SignalStrength}" Maximum="100" Height="10" Width="60" Background="#444" Foreground="#4CAF50" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            <TextBlock Text="{Binding SignalStrength, StringFormat={}{0}%}" Margin="5,0,0,0" FontSize="11" Foreground="LightGray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120" Visibility="{Binding Data.AppSettings.ShowColProvider, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            
                            <!-- #8: Tô đỏ HSD nếu sắp hết hạn (dưới 7 ngày) -->
                            <DataGridTemplateColumn Header="HSD" Width="120" ClipboardContentBinding="{Binding ExpiryDate}" Visibility="{Binding Data.AppSettings.ShowColExpiry, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpiryDate}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- #4: Cột số điện thoại nhận chuyển hướng -->
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Fwd→" Binding="{Binding ForwardedTo}" Width="130" Foreground="#03A9F4" Visibility="{Binding Data.AppSettings.ShowColForward, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cập nhật lúc" Binding="{Binding UpdatedAt}" Width="160" Visibility="{Binding Data.AppSettings.ShowColUpdatedAt, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120" Visibility="{Binding Data.AppSettings.ShowColSender, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lúc" Binding="{Binding LastReceivedTime}" Width="150" Visibility="{Binding Data.AppSettings.ShowColLastReceived, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                            </ScrollViewer>
                            
                            <!-- Empty State Panel -->
                            <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=MainDataGrid, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="UsbPort" Width="48" Height="48" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Chưa phát hiện thiết bị" Foreground="#CBD5E1" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="Kết nối thiết bị hoặc nhấn Làm mới để bắt đầu" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SMS -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top filter bar for SMS -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="#F06292" Width="20" Height="20" Margin="0,0,15,0"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsPhoneFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nhập SĐT..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="CỔNG" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="100" Text="{Binding SmsPortFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm cổng..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="NGƯỜI GỬI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsSenderFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm người gửi..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="Lọc Dữ Liệu" Command="{Binding ApplySmsFilterCommand}" Style="{StaticResource ModernButtonStyle}" Width="110" Height="34" VerticalAlignment="Bottom" Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Command="{Binding MarkAllSmsReadCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="Đánh dấu đã đọc" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="CheckAll" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding DeleteFilteredSmsCommand}" Background="#E53935" Style="{StaticResource ModernButtonStyle}" ToolTip="Xóa tin nhắn" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="White"/>
                                </Button>
                                <Button Content="Xuất Excel" Background="#4CAF50" Command="{Binding ExportSmsToExcelCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DataGrid Margin="10" ItemsSource="{Binding FilteredSmsMessages}"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  Style="{StaticResource ProDataGridStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu >
                                <MenuItem Header="Sao chép OTP" Command="{Binding Path=DataContext.CopyOtpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Xóa tin nhắn này" Command="{Binding Path=DataContext.DeleteSmsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"  Foreground="#E53935">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Delete"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" ClipboardContentBinding="{Binding Status}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Số điện thoại" Binding="{Binding ReceiverPhone}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhận lúc" Binding="{Binding ReceivedTime}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="OTP" Binding="{Binding Otp}" Width="100" Foreground="#FF9800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cuộc gọi" Binding="{Binding CallCount}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Chuyển lời" Binding="{Binding ForwardContent}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding Content}" Width="800"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <!-- TAB 5: HƯỚNG DẪN SỬ DỤNG -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Hướng Dẫn" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="20" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="📖 HƯỚNG DẪN QUẢN LÝ IMEI &amp; ĐỔI SIM" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,20"/>

                        <Border Background="#1e293b" CornerRadius="10" Padding="20" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="LUỒNG THIẾT LẬP SIẾT CHẶT NHẤT (CHỐNG LỘ IMEI GỐC 100%)" FontSize="18" FontWeight="Bold" Foreground="#E91E63" Margin="0,0,0,15"/>
                                <TextBlock Text="Để đảm bảo an toàn tuyệt đối, KHÔNG BAO GIỜ bị lộ IMEI phần cứng thật lên nhà mạng (chống khóa SIM 100%), tính năng Chặn SIM lạ luôn được BẬT mặc định:"
                                           FontSize="15" Foreground="White" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,10"/>
                                <TextBlock Text="[1] Bật Phục hồi IMEI: Đảm bảo SIM cũ cắm vào bất kỳ cổng nào cũng được ghi lại IMEI đã giả lập trước đó, rồi mới mở sóng."
                                           FontSize="14" Foreground="#4DD0E1" TextWrapping="Wrap" LineHeight="24" Margin="10,0,0,5"/>
                                <TextBlock Text="[2] Chặn SIM lạ (Luôn Bật): Khi bạn cắm 1 SIM hoàn toàn mới vào, mạch sẽ CÚP SÓNG NGAY LẬP TỨC (đèn đỏ) để ngăn SIM tự động lên mạng bằng IMEI gốc."
                                           FontSize="14" Foreground="#4DD0E1" TextWrapping="Wrap" LineHeight="24" Margin="10,0,0,5"/>
                                <TextBlock Text="[3] Nạp SIM Mới: Sau khi SIM lạ bị chặn, bạn click chuột phải chọn 'Chấp Thuận SIM Lạ', Tool sẽ lập tức bơm 1 IMEI giả mạo hoàn toàn mới vào mạch rồi mới MỞ SÓNG trở lại."
                                           FontSize="14" Foreground="#4DD0E1" TextWrapping="Wrap" LineHeight="24" Margin="10,0,0,15"/>
                                <TextBlock Text="📌 Quy tắc cắm rút: Rút thẻ SIM cũ ra -> Đợi 3 giây (để Tool tự động tắt sóng cổng đó) -> Cắm thẻ SIM mới vào -> Bấm Làm mới. Tool sẽ tự lo phần còn lại!"
                                           FontSize="14" Foreground="#FFD54F" FontWeight="Bold" TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="✅ GIẢI THÍCH CHI TIẾT QUY TRÌNH XỬ LÝ SIM MỚI" FontSize="18" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                        <TextBlock Text="Khi một SIM mới (chưa từng được lưu) được cắm vào mạch:" FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,10"/>
                        
                        <Grid Margin="10,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#FF5252" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG BẬT [Chặn SIM lạ]:" FontSize="15" FontWeight="Bold" Foreground="#FF5252"/>
                                <TextBlock Text="Tool sẽ ngay lập tức vô hiệu hóa cổng COM (CFUN=0), đổi trạng thái sang Đỏ (Security Blocked) để bảo vệ IMEI gốc. Để dùng SIM, click Chuột phải -&gt; 'Chấp Thuận SIM Lạ'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="10,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#FF5252" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu BẬT [Nạp SIM Mới]:" FontSize="15" FontWeight="Bold" Foreground="#FF5252"/>
                                <TextBlock Text="Khi SIM được chấp thuận, Tool tạo ngẫu nhiên một IMEI Fake tráng vào mạch, rồi lưu cặp [CCID của SIM] + [Fake IMEI mới] vào Kho Backup. Lần sau cắm lại SIM này, nó sẽ là SIM Cũ." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="10,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#4CAF50" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu TẮT cả 2 tính năng trên:" FontSize="15" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="Tool sẽ tự động nhận SIM, lấy nguyên bản IMEI cứng của thiết bị (rủi ro lộ IMEI gốc) và gán vĩnh viễn vào Kho Backup." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>


                        <TextBlock Text="✅ GIẢI THÍCH CHI TIẾT QUY TRÌNH XỬ LÝ SIM CŨ (ĐÃ CÓ BACKUP)" FontSize="18" FontWeight="Bold" Foreground="#FFB300" Margin="0,0,0,15"/>
                        <TextBlock Text="Khi một SIM cũ (đã lưu trong Backup) được cắm vào bất kỳ mạch nào:" FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,10"/>
                        
                        <Grid Margin="10,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#FFB300" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG BẬT [Phục hồi IMEI]:" FontSize="15" FontWeight="Bold" Foreground="#FFB300"/>
                                <TextBlock Text="Tool sẽ so sánh IMEI hiện tại của mạch với IMEI trong Backup. Nếu khác nhau, Tool tự động gửi lệnh ép ghi lại IMEI cũ vào mạch (Restore). Điều này giúp nhà mạng luôn thấy đúng 1 danh tính thiết bị." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="10,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#9E9E9E" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG TẮT [Phục hồi IMEI]:" FontSize="15" FontWeight="Bold" Foreground="#9E9E9E"/>
                                <TextBlock Text="Tool bỏ qua khâu kiểm tra. SIM sẽ lên mạng bằng đúng IMEI gốc của khe cắm hiện tại (có thể bị nhà mạng phát hiện đổi thiết bị)." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Background="#3D3D5C" Margin="0,20"/>
                        
                        <TextBlock Text="📱 HƯỚNG DẪN CÁC TÍNH NĂNG KHÁC" FontSize="20" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,20"/>
                        
                        <!-- Hướng dẫn Bảng Hàng Đợi Lệnh -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="RocketLaunch" Width="40" Height="40" Foreground="#E91E63" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="1. Bảng Hàng Đợi Lệnh (Góc trên bên phải)" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="Bảng Hàng đợi lệnh là nơi bạn xếp chồng và chạy liên hoàn các thao tác. Hỗ trợ các tính năng:" FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="• USSD: Chọn mã lệnh (VD: *101#) hoặc tự nhập, sau đó ấn '[+] Thêm vào kịch bản'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• SMS: Gửi tin nhắn đồng loạt. Nhập SĐT và Nội dung -> '[+] Thêm vào kịch bản'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Proxy: Xem trạng thái và quản lý thiết lập Proxy cho SIM." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Gọi: Nhập SĐT và thời gian (giây). Tool sẽ tự động ngắt cuộc gọi khi hết thời gian." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• IMEI: Sinh mã IMEI ngẫu nhiên hoặc tự cấu hình để ghi đè xuống thiết bị." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Data: Cấu hình bật hoặc tắt kết nối dữ liệu mạng 3G/4G." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Trễ: Thêm khoảng thời gian chờ (giây) giữa các lệnh. Rất hữu ích để tạo kịch bản tự động hóa (VD: Gọi -> Trễ 10s -> Gửi SMS)." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                
                                <TextBlock Text="💡 Mẹo: Bạn có thể chọn nhiều cổng cùng lúc (tick ô vuông đầu dòng), sau đó bấm 'Chạy ngay lập tức' để thực thi lệnh đồng loạt trên tất cả các cổng đó!" FontSize="14" Foreground="#A5D6A7" FontStyle="Italic" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tính năng Webhook -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Web" Width="40" Height="40" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="2. Webhook Tự Động (Forward OTP/SMS lên Server)" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="Vào Cài Đặt (Bánh răng) -> Thêm Rule Webhook để tự động đẩy tin nhắn OTP về Telegram, Zalo hoặc API riêng." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tính năng Khác -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Menu" Width="40" Height="40" Foreground="#FF9800" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="3. Các phím tắt &amp; thao tác nhanh" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="• Kiểm tra số dư: Chuột phải vào cổng -> 'Kiểm tra tài khoản' (Ctrl+B).&#x0a;• Lọc tin nhắn rác: Vào Cài đặt -> Cấu hình Blacklist / Whitelist.&#x0a;• Nạp thẻ: Chuột phải vào cổng -> 'Nạp thẻ / Top-up'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Command panel bên phải giống ảnh 3 -->
        <Border Grid.Column="1"
                Background="#0f172a"
                BorderBrush="#334155"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsCommandPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1*" MinHeight="150"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1e293b" Padding="8,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Asterisk" Foreground="#B8C0FF" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Hàng đợi lệnh" Foreground="#DDE2FF" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCommandPanelCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="30"
                                Height="30"
                                ToolTip="Đóng">
                            <materialDesign:PackIcon Kind="Close" Foreground="White" Width="18" Height="18"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Vùng tạo lệnh giống ảnh 3 -->
                <Border Grid.Row="1" Margin="8,6,8,4" Padding="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,10">
                            <Button Content="USSD" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="USSD" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="USSD">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="SMS" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="SMS" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="SMS">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Gọi" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="Call" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Call">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Data" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="Data" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Data">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="IMEI" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="IMEI" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="IMEI">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Trễ" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="Delay" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Delay">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Proxy" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="Proxy" Margin="0,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Proxy">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,4,0">
                            <Grid>
                            <!-- USSD -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="USSD">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="USSD"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <ComboBox Grid.Column="1"
                                              IsEditable="True"
                                              ItemsSource="{Binding PredefinedUssdCommands}"
                                              SelectedValuePath="Key"
                                              TextSearch.TextPath="Key"
                                              Text="{Binding CommandPanelUssdText, UpdateSourceTrigger=PropertyChanged}"
                                              Height="28"
                                              Background="#1e293b"
                                              Foreground="White"
                                              BorderBrush="#334155"
                                              BorderThickness="1"
                                              Padding="8,3"
                                              materialDesign:HintAssist.Hint="Nhập lệnh USSD">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="70"/>
                                                    <TextBlock Text=" - " Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="#B2EBF2" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                                
                                
                            </StackPanel>

                            <!-- SMS -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="SMS">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Người nhận -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,6">
                                        <TextBlock Text="Người nhận"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="8,6">
                                        <Grid>
                                            <TextBox Text="{Binding CommandPanelSmsRecipient, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="54"
                                                     Padding="0"
                                                     materialDesign:HintAssist.Hint="Nhập số điện thoại, rồi nhấn Enter, dấu cách, dấu phẩy hoặc dán danh sách"/>
                                            <TextBlock Text="0/6"
                                                       Foreground="#B8C0D0"
                                                       FontSize="11"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Nội dung -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,6">
                                        <TextBlock Text="Nội dung"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="8,6">
                                        <Grid>
                                            <TextBox Text="{Binding CommandPanelSmsContent, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="90"
                                                     Padding="0"
                                                     materialDesign:HintAssist.Hint="Nội dung tin nhắn"/>
                                            <TextBlock Text="0/160"
                                                       Foreground="#B8C0D0"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Mã hóa & Chế độ -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Mã hóa" Foreground="White" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding CommandPanelSmsEncoding}"
                                              Height="28">
                                        <ComboBoxItem Content="Tự động"/>
                                        <ComboBoxItem Content="GSM"/>
                                        <ComboBoxItem Content="UCS2"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2" Text="Chế độ" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Column="3"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="4" Text="Thử lại" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Grid.Column="5"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>

                            <!-- Proxy -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Proxy">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Hướng dẫn Proxy -->
                                <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Proxy Server Tự Động Đang Chạy Ngầm" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                        <TextBlock Text="Hệ thống đã tự động quét các mạng 3G/4G của SIM và khởi tạo Proxy Server nội bộ thành công." Foreground="#B8C0D0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="Port mặc định: 3001, 3002... tương ứng với từng cổng mạng." Foreground="#B8C0D0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="👉 Cách dùng API tự động:" Foreground="#EC3F9B" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="1. Lấy danh sách IP và Port Proxy: GET http://localhost:8080/api/proxies" Foreground="#FFCCBC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="2. Gửi lệnh Reset IP cho một cổng (ví dụ COM5): GET http://localhost:8080/api/proxy/reset/COM5" Foreground="#FFCCBC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="*Tính năng Hàng đợi lệnh tạm vô hiệu hóa trên tab này do Proxy chạy nền tự động." Foreground="#8892B0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>



                            <!-- Gọi -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Call">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Gọi đến -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="Gọi đến"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelCallNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>

                                <!-- Thời gian cuộc gọi -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
