<div class="info-row">
    <MudText Typo="Typo.caption" Class="info-row-label">@Label</MudText>
    <MudText Typo="@(Small ? Typo.caption : Typo.body2)"
             Class="@GetValueClass()"
             Style="@(string.IsNullOrEmpty(Color) ? null : $"color:{Color}")">
        @Value
    </MudText>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Bold { get; set; }
    [Parameter] public bool Mono { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public string Color { get; set; } = "";

    private string GetValueClass()
    {
        var classes = new List<string> { "info-row-value" };
        if (Bold) classes.Add("is-bold");
        if (Mono) classes.Add("is-mono");
        if (Small) classes.Add("is-small");
        return string.Join(" ", classes);
    }
}
