                                <TextBlock Text="SMS nhận" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding SmsReceivedCount}" Foreground="#FF9800" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2A1820" CornerRadius="8"  Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Lỗi SMS" Foreground="#FF9AA8" FontSize="11"/>
                                <TextBlock Text="{Binding SmsFailedCount}" Foreground="#FF5252" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2B2414" CornerRadius="8"  Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Timeout" Foreground="#FFD27A" FontSize="11"/>
                                <TextBlock Text="{Binding TimeoutTotalCount}" Foreground="#FFC107" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2B2414" CornerRadius="8"  Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Cooldown" Foreground="#FFD27A" FontSize="11"/>
                                <TextBlock Text="{Binding CooldownPortCount}" Foreground="#FFC107" FontSize="22" FontWeight="Bold"/>
