@page "/imei"
@inject MainViewModel Vm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject gsm.Services.IFileDialogService FileDialog
@using gsm.ViewModels
@using gsm.Models
@using gsm.Services
@implements IDisposable

<!-- ========== ACTION FORM / TOOLBAR ========== -->
<MudPaper Class="pa-3 mx-3 mb-4 feature-toolbar" Elevation="0">
<MudStack Row="true" Class="mb-4" Spacing="2" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="ExportBackup" Size="Size.Small">
        Export Backup
    </MudButton>

    <MudButton Variant="Variant.Outlined" Color="Color.Success" 
               StartIcon="@Icons.Material.Filled.Upload"
               OnClick="ImportBackup" Size="Size.Small">
        Import Backup
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Error" 
               StartIcon="@Icons.Material.Filled.DeleteSweep"
               OnClick="ClearAllBackup" Size="Size.Small">
        Xóa tất cả
    </MudButton>

    <MudSpacer />

        <MudTextField @bind-Value="_search" Placeholder="Tìm COM / IMEI / CCID / SĐT..." 
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Style="max-width:280px; background:#F8FAFC;" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudStack>
</MudPaper>

<!-- ========== STATS ========== -->
<MudGrid Class="mb-4 px-3">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Tổng mapping</MudText>
            <MudText Typo="Typo.h5" Style="font-weight:700;">@BackupCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Đang Active</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                @Ports.Count(p => p.Status == SimStatus.Active)
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Có backup</MudText>
            <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">@_withBackupCount</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<div class="mx-3 mt-1">
    <!-- ========== TABS ========== -->
    <MudTabs Class="feature-tabs" Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pa-0" Style="background:transparent;">

        <!-- TAB 1: MAPPING HIỆN TẠI -->
        <MudTabPanel Text="Mapping hiện tại">
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; overflow-x:auto; overflow-y:hidden; margin-top:12px;">
            <MudTable Items="@FilteredPorts" Hover="true" Dense="true" Elevation="0"
                      Style="background:white; min-width:1450px;" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh Style="white-space: nowrap;">COM</MudTh>
                    <MudTh Style="min-width:230px; white-space: nowrap;">CCID / Serial</MudTh>
                    <MudTh Style="white-space: nowrap;">IMEI hiện tại</MudTh>
                    <MudTh Style="white-space: nowrap;">IMEI gốc (backup)</MudTh>
                    <MudTh Style="white-space: nowrap;">SĐT</MudTh>
                    <MudTh Style="white-space: nowrap;">Nhà mạng</MudTh>
                    <MudTh Style="white-space: nowrap;">Trạng thái</MudTh>
                    <MudTh Style="min-width:160px; white-space: nowrap;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:16px; font-weight:600; white-space: nowrap;">@context.PortName</MudTd>
                    <MudTd Style="@("font-family:monospace; font-size:16px; min-width:230px; white-space:nowrap; mso-number-format: '\\@';")">@(string.IsNullOrEmpty(context.Serial) ? "—" : context.Serial)</MudTd>
                    <MudTd Style="@("font-family:monospace; font-size:16px; white-space: nowrap; mso-number-format: '\\@';")">@(string.IsNullOrEmpty(context.Imei) ? "—" : context.Imei)</MudTd>
                    <MudTd Style="@("font-family:monospace; font-size:16px; color:#64748B; white-space: nowrap; mso-number-format: '\\@';")">@(GetOriginalImei(context.Serial) ?? "—")</MudTd>
                    <MudTd Style="@("font-size:16px; white-space: nowrap; mso-number-format: '\\@';")">@(string.IsNullOrEmpty(context.PhoneNumber) || context.PhoneNumber.Contains("Chưa") ? "—" : context.PhoneNumber)</MudTd>
                    <MudTd Style="font-size:16px; white-space: nowrap;">@(context.NetworkProvider ?? "—")</MudTd>
                    <MudTd Style="white-space: nowrap;">
                        <gsm.Components.Shared.StatusBadge Status="@context.Status" />
                    </MudTd>
                    <MudTd Style="white-space: nowrap;">
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="Copy IMEI">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                               OnClick="@(() => CopyText(context.Imei))" />
                            </MudTooltip>
                            <MudTooltip Text="Xóa mapping">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => DeleteMapping(context))" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-10 text-center">
                        <MudIcon Icon="@Icons.Material.Outlined.PhonelinkSetup" Size="Size.Large" Class="mb-3" Style="opacity:0.35;" />
                        <MudText Typo="Typo.body1" Style="color:#94A3B8;">Chưa có dữ liệu IMEI</MudText>
                        <MudText Typo="Typo.caption" Style="color:#94A3B8;">Cắm thiết bị và Connect All để bắt đầu</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

        <!-- TAB 2: BACKUP DATABASE -->
        <MudTabPanel Text="Backup Database">
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; overflow-x:auto; overflow-y:hidden; margin-top:12px;">
            <MudTable Items="@_backupList" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" Style="background:white; min-width:520px;">
                <HeaderContent>
                    <MudTh Style="min-width:230px; white-space: nowrap;">CCID</MudTh>
                    <MudTh Style="white-space: nowrap;">IMEI đã gán</MudTh>
                    <MudTh Style="width:100px; white-space: nowrap;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="@("font-family:monospace; font-size:16px; min-width:230px; white-space:nowrap; mso-number-format: '\\@';")">@context.Ccid</MudTd>
                    <MudTd Style="@("font-family:monospace; font-size:16px; font-weight:600; white-space: nowrap; mso-number-format: '\\@';")">@context.Imei</MudTd>
                    <MudTd Style="white-space: nowrap;">
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="Copy IMEI">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                               OnClick="@(() => CopyText(context.Imei))" />
                            </MudTooltip>
                            <MudTooltip Text="Xóa mapping này">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => DeleteBackupItem(context))" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-10 text-center" Style="color:#94A3B8;">Backup database trống</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

        <!-- TAB 3: CÔNG CỤ -->
        <MudTabPanel Text="Công cụ">
        <MudGrid Class="mt-3">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">Kiểm tra IMEI</MudText>
                    
                    <MudTextField @bind-Value="_checkImei" Label="Nhập IMEI cần check" 
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                  Immediate="true" />
                    
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               OnClick="ValidateImei" Disabled="@(string.IsNullOrEmpty(_checkImei))">
                        Kiểm tra Luhn + định dạng
                    </MudButton>

                    @if (!string.IsNullOrEmpty(_imeiCheckResult))
                    {
                        <MudAlert Severity="@(_imeiValid ? Severity.Success : Severity.Error)" Class="mt-3" Dense="true">
                            @_imeiCheckResult
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
    </MudTabs>
</div>

@code {
    private string _search = "";
    private List<ImeiBackupItem> _backupList = new();
    private int BackupCount => _backupList.Count;
    private int _withBackupCount = 0;

    private string _checkImei = "";
    private string _imeiCheckResult = "";
    private bool _imeiValid = false;

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();

    private List<SimPort> FilteredPorts => string.IsNullOrWhiteSpace(_search)
        ? Ports
        : Ports.Where(p =>
            (p.PortName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Imei?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Serial?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.PhoneNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
          ).ToList();

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        LoadBackup();
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 2000, 2000);
    }

    void LoadBackup()
    {
        _backupList.Clear();
        foreach (var kvp in Vm.ImeiCache)
        {
            var entry = kvp.Value;
            _backupList.Add(new ImeiBackupItem
            {
                Ccid = entry.Ccid,
                Imei = entry.Imei
            });
        }
        _withBackupCount = Ports.Count(p => !string.IsNullOrEmpty(GetOriginalImei(p.Serial)));
    }

    string? GetOriginalImei(string? ccid)
    {
        if (string.IsNullOrEmpty(ccid)) return null;
        return _backupList.FirstOrDefault(x => x.Ccid == ccid)?.Imei;
    }

    // ========== ACTIONS ==========

    async Task ExportBackup()
    {
        try
        {
            var path = FileDialog.SaveFile($"imei_backup_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", "Excel Workbook (*.xlsx)|*.xlsx");
            if (string.IsNullOrEmpty(path)) return;

            await Task.Run(() => Vm.ExportImeiBackupWorkbook(path));
            Snackbar.Add($"Đã export backup XLSX thành công ra {path}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi export XLSX: " + ex.Message, Severity.Error);
        }
    }

    async Task ImportBackup()
    {
        try
        {
            var path = FileDialog.OpenFile("Excel Workbook (*.xlsx)|*.xlsx");
            if (string.IsNullOrEmpty(path)) return;

            int imported = await Task.Run(() => Vm.ImportImeiBackupWorkbook(path));
            if (imported == 0)
            {
                Snackbar.Add("File rỗng hoặc không có dòng CCID/IMEI hợp lệ", Severity.Warning);
                return;
            }

            LoadBackup();
            Snackbar.Add($"Đã import {imported} bản ghi từ XLSX", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi import XLSX: " + ex.Message, Severity.Error);
        }
    }

    async Task DeleteMapping(SimPort port)
    {
        if (string.IsNullOrEmpty(port.Serial)) return;
        var confirm = await DialogService.ShowMessageBox(
            "Xóa mapping",
            $"Xóa mapping của cổng {port.PortName} (CCID: {port.Serial})?",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm == true)
        {
            Vm.RemoveImeiCacheEntry(port.Serial);
            LoadBackup();
            Snackbar.Add("Đã xóa mapping khỏi cache", Severity.Success);
        }
    }

    async Task DeleteBackupItem(ImeiBackupItem item)
    {
        _backupList.Remove(item);
        Vm.RemoveImeiCacheEntry(item.Ccid);
        _withBackupCount = Ports.Count(p => !string.IsNullOrEmpty(GetOriginalImei(p.Serial)));
        Snackbar.Add("Đã xóa", Severity.Normal);
    }

    async Task ClearAllBackup()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Xóa toàn bộ backup",
            "Bạn có chắc muốn xóa hết database mapping IMEI? Hành động này không thể hoàn tác.",
            yesText: "Xóa tất cả", cancelText: "Hủy");

        if (confirm == true)
        {
            foreach (var item in _backupList)
            {
                Vm.RemoveImeiCacheEntry(item.Ccid);
            }
            _backupList.Clear();
            _withBackupCount = Ports.Count(p => !string.IsNullOrEmpty(GetOriginalImei(p.Serial)));
            Snackbar.Add("Đã xóa toàn bộ backup", Severity.Success);
        }
    }

    void ValidateImei()
    {
        var imei = _checkImei.Trim();
        if (imei.Length != 15 || !imei.All(char.IsDigit))
        {
            _imeiValid = false;
            _imeiCheckResult = "IMEI phải đúng 15 chữ số";
            return;
        }

        // Luhn
        int sum = 0;
        for (int i = 0; i < 14; i++)
        {
            int d = imei[i] - '0';
            if (i % 2 == 1) { d *= 2; if (d > 9) d -= 9; }
            sum += d;
        }
        int check = (10 - (sum % 10)) % 10;
        _imeiValid = check == (imei[14] - '0');
        _imeiCheckResult = _imeiValid ? "IMEI hợp lệ (Luhn OK)" : "IMEI không hợp lệ (sai check digit)";
    }

    async Task CopyText(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("clipboardCopy.copyText", text);
            Snackbar.Add("Đã copy vào Clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Copy thất bại", Severity.Warning);
        }
    }

    public void Dispose() => _timer?.Dispose();

    // Model
    public class ImeiBackupItem
    {
        public string Ccid { get; set; } = "";
        public string Imei { get; set; } = "";
    }
}
