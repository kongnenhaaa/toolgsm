@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject gsm.ViewModels.MainViewModel Vm

<MudThemeProvider Theme="_theme" IsDarkMode="true" />

<MudLayout>
    <!-- TOP APP BAR -->
    <MudAppBar Elevation="0" Dense="true" Style="background:#0F172A; border-bottom:1px solid #1E293B; height:52px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-2">
            <MudButton Variant="@GetTabVariant("ussd")" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Navigate("ussd"))" Style="@GetTabStyle("ussd")">
                USSD
            </MudButton>
            <MudButton Variant="@GetTabVariant("sms")" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Navigate("sms"))" Style="@GetTabStyle("sms")">
                SMS
            </MudButton>
            <MudButton Variant="@GetTabVariant("call")" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Navigate("call"))" Style="@GetTabStyle("call")">
                Gọi
            </MudButton>
            <MudButton Variant="@GetTabVariant("imei")" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Navigate("imei"))" Style="@GetTabStyle("imei")">
                IMEI
            </MudButton>
            <MudButton Variant="@GetTabVariant("logs")" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Navigate("logs"))" Style="@GetTabStyle("logs")">
                Log & Vận hành
            </MudButton>
            <MudButton Variant="@GetTabVariant("settings")" Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => Navigate("settings"))" Style="@GetTabStyle("settings")">
                Cài đặt
            </MudButton>
        </MudStack>

        <MudSpacer />

        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mr-3">
            @ActiveComCount COM Active
        </MudChip>
        <MudText Typo="Typo.subtitle2" Style="color:#94A3B8; margin-right:16px;">
            ♥ Tool GSM Professional
        </MudText>
    </MudAppBar>

    <MudMainContent Style="background:#0B1220; min-height:100vh; padding-top:8px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private string _current = "ussd";
    private int ActiveComCount => Vm.Ports?.Count(p => p.Status == gsm.Models.SimStatus.Active) ?? 0;

    private MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#22C55E",
            Secondary = "#3B82F6",
            Background = "#0B1220",
            Surface = "#0F172A",
            AppbarBackground = "#0F172A",
            DrawerBackground = "#0F172A",
            TextPrimary = "#E2E8F0",
            TextSecondary = "#94A3B8",
            ActionDefault = "#94A3B8",
            Divider = "#1E293B",
            TableLines = "#1E293B"
        }
    };

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        if (path.Contains("sms")) _current = "sms";
        else if (path.Contains("call")) _current = "call";
        else if (path.Contains("imei")) _current = "imei";
        else if (path.Contains("logs")) _current = "logs";
        else if (path.Contains("settings")) _current = "settings";
        else _current = "ussd";

        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 2000, 2000);
    }

    void Navigate(string tab)
    {
        _current = tab;
        if (tab == "ussd") Nav.NavigateTo($"/");
        else Nav.NavigateTo($"/{tab}");
    }

    Variant GetTabVariant(string tab) => _current == tab ? Variant.Filled : Variant.Text;
    string GetTabStyle(string tab) => _current == tab 
        ? "background:#166534; color:white; font-weight:600;" 
        : "color:#94A3B8;";

    public void Dispose() => _timer?.Dispose();
}
