                                    <Border Grid.Column="2"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="0">
                                        <TextBlock Text="s"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- DTMF -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="DTMF"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelCallDtmf, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"
                                             materialDesign:HintAssist.Hint="Không bắt buộc, chỉ cho phép kí tự 0-9, *, #, A-D, -"/>
                                </Grid>

                                <!-- Chế độ / thử lại -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                                
                                
                            </StackPanel>

                            <!-- Data -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Data">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Cảnh báo đã hỗ trợ -->
                                <Border Background="#334CAF50" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <TextBlock Text="✔️ Đã hỗ trợ chạy tải Data ngầm (Tương thích tốt nhất với chip Quectel) để tiêu thụ dung lượng KB." Foreground="#C8E6C9" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Dung lượng data -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1,1,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="Dung lượng data"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelDataAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1,1,0,1"
                                             Padding="8,3"/>

                                    <Border Grid.Column="2"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="0">
                                        <TextBlock Text="KB"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Chế độ / thử lại -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>

                                <!-- Khoảng trống giống ảnh -->
                                
                            </StackPanel>
                            
                            <!-- IMEI -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="IMEI">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <!-- Cảnh báo chưa hỗ trợ -->
                                <Border Background="#33FF5722" BorderBrush="#FF5722" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <TextBlock Text="⚠️ Tính năng Đổi IMEI qua Hàng đợi lệnh bị khóa để đảm bảo an toàn. Việc đổi IMEI sẽ khởi động lại sóng, làm đứt kết nối cổng COM và gãy toàn bộ hàng đợi phía sau. Vui lòng bật Fake IMEI tự động ở phần Cài Đặt." Foreground="#FFCCBC" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- IMEI -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Mã IMEI" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelImeiValue, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Trễ -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Delay">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Thời gian trễ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Thời gian" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                    <TextBlock Grid.Column="2" Text="giây" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Chạy ngay lập tức"
                                    Background="#F59E0B"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="28"
                                    Command="{Binding RunSingleCommandQueueCommand}">
                                <Button.ToolTip>
                                    <ToolTip Content="Thực thi lệnh ngay trên các cổng đã chọn mà không cần thêm vào Kịch bản"/>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Margin space -->
                <Border Grid.Row="2" Background="Transparent" Height="10"/>

                <!-- Kết quả chạy lệnh -->
                <Border Grid.Row="3" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,0,0">
                            <materialDesign:PackIcon Kind="ListStatus" Foreground="#00D1C7" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Kết quả chạy lệnh"
                                       Foreground="#DDE2FF"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Ports}"
                                  Style="{StaticResource ProDataGridStyle}"
                                  Margin="6"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cổng" Binding="{Binding PortName}" Width="65" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="115" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                <DataGridTextColumn Header="Kết quả lệnh" Binding="{Binding LastCommandResult}" Width="*" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>



        <!-- #6: Terminal Log với bộ lọc theo cổng -->
        <Expander Grid.Row="2" Background="#080E1A" Foreground="#CBD5E1" ExpandDirection="Up" Padding="0" Header="Lịch sử AT Commands (Terminal)" FontFamily="Consolas">
            <Border BorderBrush="#2A3952" BorderThickness="0,1,0,0" Background="#080E1A" Height="170">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Filter bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#080E1A" Margin="10,4">
                        <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0"/>
                        <TextBox Width="120" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Lọc cổng (VD: COM41)"
                                 Style="{StaticResource SearchTextBoxStyle}" FontFamily="Consolas" Foreground="#4CAF50"/>
                        <Button Content="All" Command="{Binding SetLogFilterCommand}" CommandParameter="" Background="#333344" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="8,0,0,0"/>
                        <Button Content="IMEI" Command="{Binding SetLogFilterCommand}" CommandParameter="[IMEI]" Background="#455A64" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="Firebase" Command="{Binding SetLogFilterCommand}" CommandParameter="[FIREBASE]" Background="#5C6BC0" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="SMS" Command="{Binding SetLogFilterCommand}" CommandParameter="[SMS]" Background="#00897B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="USSD" Command="{Binding SetLogFilterCommand}" CommandParameter="[USSD]" Background="#7E57C2" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <TextBlock Text="|" Foreground="#444" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilteredLogCount, StringFormat='Hiển thị: {0} dòng'}" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>
                        <Button Content="Reload IMEI CSV" Command="{Binding ReloadImeiBackupCommand}" Background="#607D8B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="10,0" Margin="12,0,0,0" ToolTip="Nạp lại imei_backup.csv và imei-lookup-*.csv trong thư mục chạy"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}" Background="Transparent" BorderThickness="0" Margin="10,0,10,6">
                        <ListBox.ContextMenu>
                            <ContextMenu >
                                <MenuItem Header="Sao chép" Command="{Binding Path=DataContext.CopySelectedLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sao chép tất cả" Command="{Binding Path=DataContext.CopyAllLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Time}" Foreground="#64748B" Margin="0,0,10,0" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Level}" Margin="0,0,10,0" Width="65" FontWeight="Bold" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FIREBASE">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" Foreground="#CBD5E1" TextWrapping="Wrap" FontFamily="Consolas"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Expander>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#080E1A" Foreground="#CBD5E1" Padding="10,5" BorderBrush="#2A3952" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Ports.Count, StringFormat='Số lượng cổng: \{0\}'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Center">
                <TextBlock Text="{Binding VnptSummaryText}" Foreground="#F59E0B" FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SmsMessages.Count, StringFormat='Mẹo: Giữ Ctrl và lăn chuột để phóng to/thu nhỏ bảng | Tổng SMS: \{0\}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Global Snackbar Notifications -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}" Grid.RowSpan="4"/>
        </Grid> <!-- Close Main Workspace Grid -->
    </Grid> <!-- Close Outer Grid -->
                        <!-- DialogHost closing tag removed -->
                    <!-- DialogHost closing tag removed -->
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>
    </materialDesign:DialogHost>
    </materialDesign:DialogHost>
</materialDesign:DialogHost>
    </materialDesign:DialogHost>
</Window>

