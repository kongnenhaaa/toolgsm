@page "/viettel-tammi"
@inject gsm.ViewModels.MainViewModel Vm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@using gsm.Services
@implements IDisposable

<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:10px;">
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_password"
                          Label="Mật khẩu Tammi"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Text"
                          HelperText="Tự đăng ký nếu chưa có tài khoản; quên pass nếu đã có"
                          FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string" @bind-Value="_sendMode" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Label="Gửi tới" FullWidth="true">
                <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
                <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                Device ID random riêng mỗi SĐT/lượt chạy
            </MudAlert>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        @if (!_isRunning)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="StartAccounts">
                Đăng ký / Đặt lại pass
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Replay"
                       OnClick="RetryFailedPorts"
                       Disabled="@(Vm.LastTammiFailedPortCount == 0)">
                Chạy lại COM lỗi (@Vm.LastTammiFailedPortCount)
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Stop"
                       OnClick="StopAccounts">
                Dừng
            </MudButton>
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
        }

        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                   OnClick="ClearResults"
                   Disabled="@(!Vm.TammiResults.Any())">
            Xóa kết quả
        </MudButton>

        <MudCheckBox T="bool" Value="@SettingsService.Current.UseProxyForTammi"
                     ValueChanged="SetUseProxy"
                     Label="Sử dụng proxy"
                     Color="Color.Primary"
                     Disabled="@_isRunning" />

        <MudSpacer />
        <MudChip T="string" Color="Color.Success" Size="Size.Small"
                 Variant="Variant.Text" Style="font-weight:600;">
            Thành công: <b>@Vm.TammiSuccessCount</b>
        </MudChip>
        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                 Variant="Variant.Text" Style="font-weight:600;">
            Thất bại: <b>@Vm.TammiFailCount</b>
        </MudChip>
    </MudStack>

    @if (_isRunning)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            Tool kiểm tra trạng thái tài khoản từng SĐT. Số mới dùng OTP REGISTER;
            số đã có tài khoản dùng OTP PASSWORD_RESET. OTP được tự bắt theo đúng COM và phiên SIM.
            @if (!string.IsNullOrWhiteSpace(Vm.TammiSummaryText))
            {
                <br /><b>@Vm.TammiSummaryText</b>
            }
        </MudAlert>
    }
</MudPaper>

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         PanelClass="pa-0" Class="mx-3 mt-1 feature-tabs"
         Style="background:transparent;" @bind-ActivePanelIndex="_subTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="Ports" Operation="TAMMI" @bind-SelectedItems="Vm.SelectedComPorts" />
    </MudTabPanel>

    <MudTabPanel Text="@($"Kết quả ({Vm.TammiResults.Count})")">
        @{ var orderedResults = PortDisplayOrder.Sort(Vm.TammiResults, Ports, item => item.Port); }
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">
                Kết quả tài khoản Viettel Tammi
            </MudText>
            <MudTable Items="@orderedResults" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 300px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Chức năng</MudTh>
                    <MudTh>Mật khẩu</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Phản hồi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:11px; color:#94A3B8;">@(orderedResults.IndexOf(context) + 1)</MudTd>
                    <MudTd Style="font-size:12px; white-space:nowrap;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>@(context.IsPasswordRecovery ? "Quên mật khẩu" : "Đăng ký")</MudTd>
                    <MudTd Style="font-family:monospace; font-size:12px;">@context.Password</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "Thành công" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="max-width:340px; overflow:hidden; text-overflow:ellipsis; font-size:12px; white-space:nowrap;"
                           title="@context.Response">
                        @context.Response
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Security" Size="Size.Large"
                                 Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có kết quả Tammi</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hướng dẫn">
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Luồng Tammi tự nhận biết tài khoản mới hoặc đã tồn tại trước khi gửi OTP.
                </MudAlert>
                <MudText Typo="Typo.body2">
                    <b>1.</b> Nhập mật khẩu muốn đặt; tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.<br />
                    <b>2.</b> Chọn COM hoặc Tất cả Active rồi bấm <b>Đăng ký / Đặt lại pass</b>.<br />
                    <b>3.</b> Tài khoản chưa tồn tại: gửi OTP <code>REGISTER</code>, xác thực và gọi <code>register-user</code>.<br />
                    <b>4.</b> Tài khoản đã tồn tại: gửi OTP <code>PASSWORD_RESET</code>, xác thực và gọi <code>reset-password</code>.<br />
                    <b>5.</b> Tool giữ Device ID cố định trong một workflow, nhưng random mới cho mỗi SĐT/lượt chạy.
                </MudText>
                <MudAlert Severity="Severity.Warning" Dense="true">
                    OTP, tempToken, access token và refresh token chỉ dùng trong RAM; không ghi vào log hoặc file.
                </MudAlert>
            </MudStack>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public bool IsPageActive { get; set; }

    private string _password = "123456a@A";
    private string _sendMode = "all";
    private int _subTab;
    private bool _isRunning;
    private int _startGuard;
    private CancellationTokenSource? _cancellationTokenSource;
    private System.Threading.Timer? _timer;
    private List<SimPort>? _retryTargets;

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts =>
        Ports.Where(port => port.Status == SimStatus.Active);

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (IsPageActive)
                _ = InvokeAsync(StateHasChanged);
        }, null, 1500, 1500);
    }

    private void SetUseProxy(bool enabled)
    {
        if (enabled && !WorkflowProxyService.IsConfigured)
        {
            Snackbar.Add("Chưa thêm proxy trong tab Proxy.", Severity.Warning);
            return;
        }
        bool previous = SettingsService.Current.UseProxyForTammi;
        SettingsService.Current.UseProxyForTammi = enabled;
        if (!SettingsService.SaveSettings(SettingsService.Current))
        {
            SettingsService.Current.UseProxyForTammi = previous;
            Snackbar.Add("Không lưu được lựa chọn proxy Tammi.", Severity.Error);
        }
    }

    private List<SimPort> GetTargets()
    {
        if (_retryTargets is not null)
            return _retryTargets.Where(port => port.Status == SimStatus.Active).ToList();
        return _sendMode == "all"
            ? ActivePorts.ToList()
            : Vm.SelectedComPorts.Where(port => port.Status == SimStatus.Active).ToList();
    }

    private async Task RetryFailedPorts()
    {
        List<SimPort> failedPorts = Vm.GetLastTammiFailedPorts();
        if (failedPorts.Count == 0)
        {
            Snackbar.Add("Không còn COM Tammi lỗi trong lần chạy gần nhất.", Severity.Normal);
            return;
        }
        _retryTargets = failedPorts;
        try { await StartAccounts(); }
        finally { _retryTargets = null; }
    }

    private async Task StartAccounts()
    {
        if (Interlocked.CompareExchange(ref _startGuard, 1, 0) != 0)
        {
            Snackbar.Add("Tiến trình Tammi đang được khởi chạy.", Severity.Warning);
            return;
        }
        try
        {
            if (!TammiService.IsValidPassword(_password, out string passwordError))
            {
                Snackbar.Add(passwordError, Severity.Warning);
                return;
            }

            List<SimPort> targets = GetTargets();
            var validTargets = targets
                .Where(port => !string.IsNullOrWhiteSpace(
                    TammiService.NormalizePhone(port.PhoneNumber)))
                .GroupBy(
                    port => TammiService.NormalizePhone(port.PhoneNumber),
                    StringComparer.Ordinal)
                .Select(group => group.First())
                .ToList();
            if (validTargets.Count == 0)
            {
                Snackbar.Add("Không có cổng Active nào có SĐT hợp lệ.", Severity.Warning);
                return;
            }
            int skipped = targets.Count - validTargets.Count;
            if (skipped > 0)
                Snackbar.Add($"Bỏ qua {skipped} cổng chưa có hoặc bị trùng SĐT.", Severity.Warning);

            if (validTargets.Count > 5)
            {
                bool? confirmed = await DialogService.ShowMessageBox(
                    "Xác nhận",
                    $"Đăng ký/đặt lại mật khẩu Tammi cho {validTargets.Count} cổng?",
                    yesText: "Tiếp tục",
                    cancelText: "Hủy");
                if (confirmed != true) return;
            }

            _isRunning = true;
            _cancellationTokenSource?.Cancel();
            _cancellationTokenSource?.Dispose();
            _cancellationTokenSource = new CancellationTokenSource();
            _subTab = 1;
            Snackbar.Add(
                $"Đang chạy Tammi cho {validTargets.Count} COM; OTP được bắt tự động.",
                Severity.Info);
            try
            {
                await Vm.CreateTammiAccounts(
                    validTargets,
                    _password.Trim(),
                    _cancellationTokenSource.Token);
            }
            catch (OperationCanceledException)
            {
                Snackbar.Add("Đã dừng tiến trình Tammi.", Severity.Normal);
            }
            catch (Exception ex)
            {
                Snackbar.Add(TammiService.GetFriendlyExceptionMessage(ex), Severity.Error);
            }
            finally
            {
                _isRunning = false;
            }
        }
        finally
        {
            Interlocked.Exchange(ref _startGuard, 0);
        }
    }

    private void StopAccounts()
    {
        _cancellationTokenSource?.Cancel();
        Snackbar.Add("Đang hủy request và tiến trình chờ OTP Tammi...", Severity.Normal);
    }

    private void ClearResults()
    {
        Vm.ClearTammiResults();
        Snackbar.Add("Đã xóa kết quả Tammi.", Severity.Normal);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}
