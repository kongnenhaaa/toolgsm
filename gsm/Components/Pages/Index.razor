@page "/"
@inject IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:600;">Danh sách cổng COM</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="color:#64748B;">
    Quản lý multi-port EC20 • New SIM Intake • IMEI Protection
</MudText>

<!-- Stats Cards -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Tổng cổng</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:700;">@_ports.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Đang Active</MudText>
            <MudText Typo="Typo.h4" Color="Color.Success" Style="font-weight:700;">
                @_ports.Count(p => p.Status == SimStatus.Active)
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Chờ Accept</MudText>
            <MudText Typo="Typo.h4" Color="Color.Warning" Style="font-weight:700;">
                @_ports.Count(p => p.Status == SimStatus.SecurityBlocked)
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Lỗi / No Response</MudText>
            <MudText Typo="Typo.h4" Color="Color.Error" Style="font-weight:700;">
                @_ports.Count(p => p.Status == SimStatus.NoResponse)
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Port Cards -->
<MudGrid>
    @foreach (var port in _ports)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <PortCard Port="port" OnAccept="AcceptNewSim" OnRefresh="RefreshPort" />
        </MudItem>
    }
</MudGrid>

@if (_ports.Count == 0)
{
    <MudPaper Class="pa-12 text-center" Elevation="0" Style="border:1px dashed #CBD5E1; border-radius:16px;">
        <MudIcon Icon="@Icons.Material.Outlined.Usb" Size="Size.Large" Color="Color.Default" Class="mb-3" />
        <MudText Typo="Typo.h6" Style="color:#64748B;">Chưa có cổng COM nào</MudText>
        <MudText Typo="Typo.body2" Style="color:#94A3B8;">Cắm thiết bị EC20 để bắt đầu</MudText>
    </MudPaper>
}

@code {
    private List<SimPort> _ports = new();
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // Giả lập hoặc lấy từ service thật
        LoadPorts();
        
        // Real-time update mỗi 2 giây
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                LoadPorts();
                StateHasChanged();
            });
        }, null, 2000, 2000);
    }

    void LoadPorts()
    {
        // TODO: Thay bằng logic thật của bạn
        // _ports = ModemService.GetPorts() hoặc từ MainViewModel cũ
        // Tạm thời demo
        if (_ports.Count == 0)
        {
            _ports = new List<SimPort>
            {
                new SimPort { PortName = "COM3", Imei = "860123456789012", Status = SimStatus.Active, PhoneNumber = "0912345678", Balance = "125.000đ", NetworkProvider = "Viettel" },
                new SimPort { PortName = "COM5", Imei = "860987654321098", Status = SimStatus.SecurityBlocked, PhoneNumber = "", Balance = "", NetworkProvider = "" },
                new SimPort { PortName = "COM7", Imei = "860555666777888", Status = SimStatus.Connecting, PhoneNumber = "Chưa lấy được số", Balance = "", NetworkProvider = "Vinaphone" },
            };
        }
    }

    async Task AcceptNewSim(SimPort port)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Xác nhận chấp nhận SIM mới",
            $"Bạn có chắc muốn tráng IMEI mới cho {port.PortName}?",
            yesText: "Chấp nhận", cancelText: "Hủy");

        if (confirm == true)
        {
            Snackbar.Add($"[{port.PortName}] Đang tráng IMEI...", Severity.Info);
            // Gọi backend: await ModemService.AcceptNewSimAndPaintImeiAsync(...)
            port.Status = SimStatus.Connecting;
            StateHasChanged();
        }
    }

    async Task RefreshPort(SimPort port)
    {
        Snackbar.Add($"[{port.PortName}] Đang làm mới...", Severity.Normal);
        // Gọi logic refresh
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
