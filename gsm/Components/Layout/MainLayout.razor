@inherits LayoutComponentBase
@inject IGsmModemService ModemService
@inject ISnackbar Snackbar

<MudLayout>
    <!-- AppBar -->
    <MudAppBar Elevation="0" Dense="true" Class="border-b" Style="border-color:#E2E8F0; background:white;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-weight:600; color:#0F172A;">
            Tool GSM <span style="color:#2563EB;">EC20</span>
        </MudText>

        <MudSpacer />

        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mr-3">
            @ActivePortsCount COM Active
        </MudChip>

        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Default" OnClick="RefreshAll" Title="Làm mới tất cả" />
        <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Default" OnClick="OpenSettings" />
    </MudAppBar>

    <!-- Drawer Sidebar -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Mini" 
               OpenMiniOnHover="true" ClipMode="DrawerClipMode.Always"
               Style="border-right:1px solid #E2E8F0;">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/sms" Icon="@Icons.Material.Filled.Sms">SMS</MudNavLink>
            <MudNavLink Href="/ussd" Icon="@Icons.Material.Filled.Dialpad">USSD</MudNavLink>
            <MudNavLink Href="/call" Icon="@Icons.Material.Filled.Phone">Cuộc gọi</MudNavLink>
            <MudNavLink Href="/imei" Icon="@Icons.Material.Filled.PhonelinkSetup">IMEI Manager</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Cài đặt</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Class="pt-4 px-4 pb-6" Style="background:#F8FAFC; min-height:100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private int ActivePortsCount => 0; // sẽ bind từ service sau

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    async Task RefreshAll()
    {
        Snackbar.Add("Đang làm mới tất cả cổng...", Severity.Info);
        // Gọi logic refresh của bạn
    }

    void OpenSettings()
    {
        // Mở dialog settings
    }
}
