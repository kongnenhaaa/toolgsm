<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>gsm</RootNamespace>
    <AssemblyName>ToolGSM</AssemblyName>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);RegexTest\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="MudBlazor" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="EPPlus" Version="7.7.3" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Mỗi lần tạo EXE là một bộ cài mới: luôn ghi đè kho runtime bằng workbook
       trắng chỉ có tiêu đề, tuyệt đối không đóng gói dữ liệu SIM/IMEI cũ. -->
  <Target Name="ResetImeiBackupAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\imei_backup.blank.xlsx"
          DestinationFiles="$(TargetDir)imei_backup.xlsx"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="ResetImeiBackupAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\imei_backup.blank.xlsx"
          DestinationFiles="$(PublishDir)imei_backup.xlsx"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
