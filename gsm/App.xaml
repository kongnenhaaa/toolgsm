<Application x:Class="gsm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gsm"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <SolidColorBrush x:Key="AppBackground" Color="#12121E"/>
            <SolidColorBrush x:Key="PanelBackground" Color="#1E1E2F"/>
            <SolidColorBrush x:Key="AccentColor" Color="#E91E63"/>
            
            <!-- Professional Button Style -->
            <Style TargetType="Button" x:Key="ModernButtonStyle" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!-- Remove border by default -->
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- Modern DataGrid Row Style -->
            <Style TargetType="DataGridRow" x:Key="ProDataGridRowStyle">
                <Setter Property="Background" Value="#1E1E2F"/>
                <Setter Property="BorderBrush" Value="#2A2A40"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MinHeight" Value="45"/>
                <Setter Property="Foreground" Value="White"/>
                <Style.Triggers>
                    <!-- Alternating Row Color -->
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#181825"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2D2D44"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#3F51B5"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Professional DataGrid Column Header Style -->
            <Style TargetType="DataGridColumnHeader" x:Key="ProDataGridColumnHeaderStyle">
                <Setter Property="Background" Value="#232338"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="Padding" Value="14,14,14,14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush" Value="#3F51B5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Professional DataGrid Cell Style -->
            <Style TargetType="DataGridCell" x:Key="ProDataGridCellStyle">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Text Element Style to disable Fade-out (OpacityMask) and enable Wrap -->
            <Style TargetType="TextBlock" x:Key="ProDataGridTextElementStyle">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="OpacityMask" Value="{x:Null}"/>
            </Style>

            <!-- Professional DataGrid Style -->
            <Style TargetType="DataGrid" x:Key="ProDataGridStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ProDataGridColumnHeaderStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource ProDataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource ProDataGridCellStyle}"/>
                <Setter Property="AlternationCount" Value="2"/>
            </Style>

            <!-- Search TextBox Style -->
            <Style TargetType="TextBox" x:Key="SearchTextBoxStyle" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Background" Value="#1A1A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="Background" Value="#222235"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
