<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>gsm</RootNamespace>
    <AssemblyName>ToolGSM</AssemblyName>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);RegexTest\**;artifacts\**;gsm\**;logs\**;scratch\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="MudBlazor" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="EPPlus" Version="7.7.3" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="voice_otp\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Publish vào một thư mục cũ không tự xóa dependency đã bỏ khỏi project. -->
  <Target Name="RemoveRetiredSpeechRecognitionArtifactsAfterPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libvosk.dll;$(PublishDir)Vosk.dll;$(PublishDir)NAudio.dll;$(PublishDir)System.Speech.dll" />
    <RemoveDir Directories="$(PublishDir)vosk-model-vn-0.4"
               Condition="Exists('$(PublishDir)vosk-model-vn-0.4')" />
  </Target>

</Project>
