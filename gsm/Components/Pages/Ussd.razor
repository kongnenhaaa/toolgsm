    void DeleteSms(IncomingSmsItem item)
    {
        if (item.OriginalMessage != null)
        {
            Vm.SmsMessages.Remove(item.OriginalMessage);
            Snackbar.Add("Đã xóa", Severity.Normal);
        }
    }

    void ClearAllSms()
    {
        Vm.SmsMessages.Clear();
        Snackbar.Add("Đã xóa tất cả tin nhắn", Severity.Normal);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _spamCts?.Cancel();
        _spamCts?.Dispose();
    }

