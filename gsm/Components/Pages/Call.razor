@page "/call"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2" Elevation="0" 
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.caption" Style="color:#64748B; min-width:80px;">Người nhận</MudText>
        <MudTextField @bind-Value="_phone" Placeholder="09xxxxxxxx" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:140px; background:#F8FAFC;" Immediate="true" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Nhấn phím (DTMF)</MudText>
        <MudTextField @bind-Value="_dtmf" Placeholder="1,2,3" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:100px; background:#F8FAFC;" Immediate="true" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Thời gian (s)</MudText>
        <MudNumericField @bind-Value="_duration" Min="1" Max="300"
                         Variant="Variant.Outlined" Margin="Margin.Dense" 
                         Style="max-width:80px; background:#F8FAFC;" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Chế độ</MudText>
        <MudSelect T="string" @bind-Value="_sendMode" Dense="true" Variant="Variant.Outlined" 
                   Margin="Margin.Dense" Style="width:130px; background:#F8FAFC;">
            <MudSelectItem Value="@("Selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("All")">Tất cả Active</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Phone"
                   OnClick="MakeCall" Disabled="@(string.IsNullOrEmpty(_phone))">
            Gọi
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.PhoneDisabled"
                   OnClick="HangupAll">
            Cúp máy
        </MudButton>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3 mt-2"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_callSubTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="Lịch sử Cuộc gọi">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudTable Items="@_callHistory" Dense="true" Hover="true" Elevation="0" Height="420px">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Số gọi</MudTh>
                    <MudTh>Thời lượng</MudTh>
                    <MudTh>WAV</MudTh>
                    <MudTh>Ghi âm</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh Style="width:80px;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>@context.Duration s</MudTd>
                    <MudTd Style="font-size:12px;">@(System.IO.Path.GetFileName(context.WavFile) ?? "—")</MudTd>
                    <MudTd>
                        @if (context.HasRecording)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Có</MudChip>
                        }
                        else { <span style="color:#94A3B8;">—</span> }
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "OK" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" 
                                       OnClick="@(() => Redial(context))" Title="Gọi lại" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có lịch sử cuộc gọi</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private string _phone = "";
    private string _dtmf = "";
    private int _duration = 15;
    private string _sendMode = "Selected";
    private HashSet<SimPort> _selectedPorts = new();
    private int _callSubTab = 0;

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private List<SimPort> FilteredPorts => Ports;

    private System.Threading.Timer? _timer;

    // --- Lịch sử gọi Models ---
    public class CallHistoryItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Phone { get; set; } = "";
        public int Duration { get; set; }
        public string WavFile { get; set; } = "";
        public bool HasRecording { get; set; }
        public bool Success { get; set; }
    }
    private List<CallHistoryItem> _callHistory = new();

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    async Task MakeCall()
    {
        var targets = _sendMode == "Selected" 
            ? _selectedPorts.Select(p => p.PortName).ToList() 
            : Ports.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng nào để gọi", Severity.Warning);
            return;
        }

        foreach (var port in targets)
        {
            _ = Vm.ExecuteCallFromUiAsync(port, _phone, "", _duration);
            
            _callHistory.Insert(0, new CallHistoryItem
            {
                Time = DateTime.Now,
                Port = port,
                Phone = _phone,
                Duration = _duration,
                Success = true
            });
            await Task.Delay(500);
        }
        Snackbar.Add($"Đã gửi lệnh gọi tới {targets.Count} cổng", Severity.Success);
    }

    async Task HangupAll()
    {
        var targets = _sendMode == "Selected" 
            ? _selectedPorts.Select(p => p.PortName).ToList() 
            : Ports.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();

        foreach (var port in targets)
        {
            await ModemService.SendCommandAsync(port, "ATH");
        }
        Snackbar.Add("Đã gửi lệnh cúp máy (ATH)", Severity.Info);
    }

    void Redial(CallHistoryItem item)
    {
        _phone = item.Phone;
        Snackbar.Add($"Chuẩn bị gọi lại {item.Phone}", Severity.Info);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
