@page "/logs"
@inject MainViewModel Vm
@inject IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.ViewModels
@using gsm.Models
@using System.IO
@implements IDisposable

<!-- ========== STATS ========== -->
<MudGrid Class="mb-4 px-3">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Tổng log</MudText>
            <MudText Typo="Typo.h5" Style="font-weight:700;">@_totalLogs</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Thành công</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">@_successCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Lỗi</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight:700;">@_errorCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Tỷ lệ thành công</MudText>
            <MudText Typo="Typo.h5" Style="font-weight:700;">@_successRate%</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- ========== ACTION FORM / TOOLBAR ========== -->
<MudPaper Class="pa-3 mx-3 mb-4 feature-toolbar" Elevation="0">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearLogs">
        Xóa log
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Download" OnClick="ExportLogs">
        Export log
    </MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Pause" OnClick="ToggleAutoScroll"
               Color="@(_autoScroll ? Color.Warning : Color.Default)">
        @(_autoScroll ? "Tắt auto-scroll" : "Bật auto-scroll")
    </MudButton>

    <MudSpacer />

    <MudSelect T="string" @bind-Value="_filterLevel" Dense="true" Variant="Variant.Outlined" 
               Margin="Margin.Dense" Style="width:130px;" Placeholder="Mức độ">
        <MudSelectItem Value="@("all")">Tất cả</MudSelectItem>
        <MudSelectItem Value="@("info")">Info</MudSelectItem>
        <MudSelectItem Value="@("success")">Success</MudSelectItem>
        <MudSelectItem Value="@("warning")">Warning</MudSelectItem>
        <MudSelectItem Value="@("error")">Error</MudSelectItem>
    </MudSelect>

        <MudTextField @bind-Value="_search" Placeholder="Tìm trong log..." 
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Style="max-width:240px; background:#F8FAFC;" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudStack>
</MudPaper>

<div class="mx-3 mt-1">
    <!-- ========== TABS ========== -->
    <MudTabs Class="feature-tabs" Elevation="0" Rounded="false" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_activeTab" PanelClass="pa-0" Style="background:transparent;">

        <!-- TAB 1: LOG REALTIME -->
        <MudTabPanel Text="Log realtime">
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; overflow:hidden; margin-top:12px;">
            <div style="height:480px; overflow-y:auto; background:#0F172A; color:#E2E8F0; font-family:Consolas,monospace; font-size:12.5px; padding:12px;" 
                 id="log-container" @ref="_logContainer">
                @foreach (var log in FilteredLogs)
                {
                    <div style="margin-bottom:3px; display:flex; gap:8px;">
                        <span style="color:#64748B; min-width:70px;">@log.Time.ToString("HH:mm:ss")</span>
                        <span style="min-width:70px; color:@(GetLevelColor(log.Level))">[@log.Level.ToUpper()]</span>
                        <span style="color:#94A3B8; min-width:60px;">@log.Port</span>
                        <span style="flex:1; word-break:break-all;">@log.Message</span>
                    </div>
                }
                @if (!FilteredLogs.Any())
                {
                    <div style="color:#64748B; text-align:center; margin-top:80px;">Chưa có log nào</div>
                }
            </div>
        </MudPaper>
    </MudTabPanel>

        <!-- TAB 2: THỐNG KÊ CHI TIẾT -->
        <MudTabPanel Text="Thống kê chi tiết">
        <MudGrid Class="mt-3">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">Theo loại thao tác</MudText>
                    <MudSimpleTable Dense="true" Style="background:transparent;">
                        <tbody>
                            <tr>
                                <td>Gửi SMS</td>
                                <td style="text-align:right; color:#16A34A; font-weight:600;">@_smsSuccess</td>
                                <td style="text-align:right; color:#DC2626;">@_smsError</td>
                            </tr>
                            <tr>
                                <td>USSD / Check TKC</td>
                                <td style="text-align:right; color:#16A34A; font-weight:600;">@_ussdSuccess</td>
                                <td style="text-align:right; color:#DC2626;">@_ussdError</td>
                            </tr>
                            <tr>
                                <td>Cuộc gọi</td>
                                <td style="text-align:right; color:#16A34A; font-weight:600;">@_callSuccess</td>
                                <td style="text-align:right; color:#DC2626;">@_callError</td>
                            </tr>
                            <tr>
                                <td>Accept SIM / Tráng IMEI</td>
                                <td style="text-align:right; color:#16A34A; font-weight:600;">@_acceptSuccess</td>
                                <td style="text-align:right; color:#DC2626;">@_acceptError</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; height:100%;">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">Tổng quan hôm nay</MudText>
                    <MudStack Spacing="2">
                        <MudText>Tổng thao tác: <b>@_totalOps</b></MudText>
                        <MudText>Thành công: <b style="color:#16A34A">@_successCount</b></MudText>
                        <MudText>Lỗi: <b style="color:#DC2626">@_errorCount</b></MudText>
                        <MudText>Tỷ lệ thành công: <b>@_successRate%</b></MudText>
                        <MudProgressLinear Color="Color.Success" Value="@_successRate" Class="mt-2" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
    </MudTabs>
</div>

@code {
    // ========== BINDINGS ==========
    [Parameter] public bool IsPageActive { get; set; }

    private string _search = "";
    private string _filterLevel = "all";
    private bool _autoScroll = true;
    private int _activeTab = 0;

    private List<LogItem> _logs = new();
    private ElementReference _logContainer;
    private int _renderScheduled;
    private bool _disposed;
    private bool _wasPageActive;

    // Stats counters (cập nhật realtime)
    private int _smsSuccess, _smsError, _ussdSuccess, _ussdError;
    private int _callSuccess, _callError, _acceptSuccess, _acceptError;

    private int _totalLogs => _logs.Count;
    private int _successCount => _logs.Count(x => x.Level == "success");
    private int _errorCount => _logs.Count(x => x.Level == "error");
    private int _successRate => _totalLogs == 0 ? 0 : (int)(_successCount * 100.0 / _totalLogs);
    private int _totalOps => _smsSuccess + _smsError + _ussdSuccess + _ussdError + _callSuccess + _callError + _acceptSuccess + _acceptError;

    private IEnumerable<LogItem> FilteredLogs
    {
        get
        {
            var list = _logs.AsEnumerable();
            if (_filterLevel != "all")
                list = list.Where(x => x.Level == _filterLevel);
            if (!string.IsNullOrWhiteSpace(_search))
                list = list.Where(x =>
                    x.Message.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    x.Port.Contains(_search, StringComparison.OrdinalIgnoreCase));
            return list.OrderByDescending(x => x.Time).Take(800);
        }
    }

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // ========== SUBSCRIBE LOG TỪ BACKEND (QUAN TRỌNG) ==========
        try
        {
            Vm.LogAdded += OnVmLogAdded;
        }
        catch { }

        _timer = new System.Threading.Timer(_ => RequestRender(), null, 1000, 1000);
    }

    protected override void OnParametersSet()
    {
        if (IsPageActive && !_wasPageActive)
            ReloadFromViewModel();
        _wasPageActive = IsPageActive;
    }

    private void ReloadFromViewModel()
    {
        _logs.Clear();
        _smsSuccess = _smsError = 0;
        _ussdSuccess = _ussdError = 0;
        _callSuccess = _callError = 0;
        _acceptSuccess = _acceptError = 0;

        foreach (LogMessage log in Vm.SystemLogs.Reverse())
            AddViewModelLog(log);

        if (_logs.Count == 0)
        {
            AddLog("system", "info", "Tool GSM đã khởi động");
            AddLog("system", "info", "Sẵn sàng kết nối thiết bị");
        }
    }

    private void RequestRender()
    {
        if (_disposed
            || !IsPageActive
            || Interlocked.Exchange(ref _renderScheduled, 1) != 0)
            return;

        try
        {
            _ = InvokeAsync(() =>
            {
                try
                {
                    if (!_disposed && IsPageActive)
                        StateHasChanged();
                }
                finally
                {
                    Interlocked.Exchange(ref _renderScheduled, 0);
                }
            });
        }
        catch
        {
            Interlocked.Exchange(ref _renderScheduled, 0);
        }
    }

    // =====================================================
    // NHẬN LOG TỪ BACKEND
    // =====================================================
    private void OnVmLogAdded(LogMessage logMsg)
    {
        // PersistentPageHost keeps this component alive while hidden. Avoid one
        // renderer callback per modem line for an invisible page; reload the
        // bounded ViewModel snapshot when the user opens the page again.
        if (_disposed || !IsPageActive)
            return;

        _ = InvokeAsync(() =>
        {
            if (!_disposed && IsPageActive)
                AddViewModelLog(logMsg);
        });
    }

    private void AddViewModelLog(LogMessage logMsg)
    {
        var level = logMsg.Level?.ToLowerInvariant() ?? "info";
        var msg = logMsg.Message ?? "";
        string port = "system";

        // Thử tách [COMX] từ Message nếu có
        var match = System.Text.RegularExpressions.Regex.Match(msg, @"^\[(.*?)\]\s*(.*)");
        if (match.Success)
        {
            port = match.Groups[1].Value;
            msg = match.Groups[2].Value;
        }

        if (msg.Contains("ERROR", StringComparison.OrdinalIgnoreCase) ||
            msg.Contains("Lỗi", StringComparison.OrdinalIgnoreCase) ||
            msg.Contains("FAIL", StringComparison.OrdinalIgnoreCase))
            level = "error";
        else if (msg.Contains("OK", StringComparison.OrdinalIgnoreCase) ||
                 msg.Contains("thành công", StringComparison.OrdinalIgnoreCase) ||
                 msg.Contains("SUCCESS", StringComparison.OrdinalIgnoreCase))
            level = "success";
        else if (msg.Contains("WARN", StringComparison.OrdinalIgnoreCase))
            level = "warning";

        AddLog(port, level, msg);
    }

    void AddLog(string port, string level, string message)
    {
        _logs.Insert(0, new LogItem
        {
            Time = DateTime.Now,
            Port = port,
            Level = level,
            Message = message
        });

        // Giữ tối đa 3000 dòng trong memory
        if (_logs.Count > 3000)
            _logs.RemoveRange(3000, _logs.Count - 3000);

        // Cập nhật counter theo loại
        if (message.Contains("SMS", StringComparison.OrdinalIgnoreCase))
        {
            if (level == "success") _smsSuccess++; else if (level == "error") _smsError++;
        }
        else if (message.Contains("USSD", StringComparison.OrdinalIgnoreCase) || message.Contains("*101#"))
        {
            if (level == "success") _ussdSuccess++; else if (level == "error") _ussdError++;
        }
        else if (message.Contains("Call", StringComparison.OrdinalIgnoreCase) || message.Contains("ATD"))
        {
            if (level == "success") _callSuccess++; else if (level == "error") _callError++;
        }
        else if (message.Contains("Accept", StringComparison.OrdinalIgnoreCase) || message.Contains("IMEI"))
        {
            if (level == "success") _acceptSuccess++; else if (level == "error") _acceptError++;
        }
    }

    string GetLevelColor(string level) => level switch
    {
        "success" => "#4ADE80",
        "error"   => "#F87171",
        "warning" => "#FBBF24",
        "info"    => "#60A5FA",
        _         => "#94A3B8"
    };

    // =====================================================
    // CLEAR LOG
    // =====================================================
    async Task ClearLogs()
    {
        var ok = await DialogService.ShowMessageBox("Xóa log",
            "Xóa toàn bộ nhật ký trong bộ nhớ?", yesText: "Xóa", cancelText: "Hủy");
        if (ok == true)
        {
            _logs.Clear();
            _smsSuccess = _smsError = _ussdSuccess = _ussdError = 0;
            _callSuccess = _callError = _acceptSuccess = _acceptError = 0;
            Snackbar.Add("Đã xóa log", Severity.Success);
        }
    }

    // =====================================================
    // EXPORT LOG THẬT (ghi file .txt + .csv)
    // =====================================================
    async Task ExportLogs()
    {
        try
        {
            var folder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "ToolGSM_Logs");
            Directory.CreateDirectory(folder);

            var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var txtPath = Path.Combine(folder, $"log_{stamp}.txt");
            var csvPath = Path.Combine(folder, $"log_{stamp}.csv");

            // TXT
            var txtLines = _logs.OrderBy(x => x.Time)
                .Select(x => $"{x.Time:yyyy-MM-dd HH:mm:ss}\t[{x.Level.ToUpper()}]\t{x.Port}\t{x.Message}");
            await File.WriteAllLinesAsync(txtPath, txtLines);

            // CSV
            var csvLines = new List<string> { "Time,Level,Port,Message" };
            csvLines.AddRange(_logs.OrderBy(x => x.Time)
                .Select(x => $"\"{x.Time:yyyy-MM-dd HH:mm:ss}\",\"{x.Level}\",\"{x.Port}\",\"{x.Message.Replace("\"", "\"\"")}\""));
            await File.WriteAllLinesAsync(csvPath, csvLines);

            Snackbar.Add($"Đã export:\n{txtPath}\n{csvPath}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Export lỗi: " + ex.Message, Severity.Error);
        }
    }

    void ToggleAutoScroll() => _autoScroll = !_autoScroll;

    public void Dispose()
    {
        _disposed = true;
        try
        {
            Vm.LogAdded -= OnVmLogAdded;
        }
        catch { }
        _timer?.Dispose();
    }

    public class LogItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Level { get; set; } = "info";
        public string Message { get; set; } = "";
    }
}
