                                        </Grid>
                                        <Button Content="Tự động chọn mạng (Auto)" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetOperatorAuto" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+COPS=0"/>
                                        <Button Content="Chế độ quét Auto" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetScanAuto" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+QCFG=nwscanmode,0"/>
                                        <Button Content="Chỉ quét 4G (LTE Only)" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetScanLte" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+QCFG=nwscanmode,3"/>
                                    </StackPanel>
                                    
                                    <!-- Column 2: Thông tin & Kiểm tra sóng -->
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
