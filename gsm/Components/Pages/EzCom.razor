@page "/ezcom"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<MudPaper Class="pa-3 mb-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_ezCommand" Label="Lệnh" Placeholder="DK EZ"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px;" />
        <MudTextField @bind-Value="_ezNumber" Label="Số nhận" Placeholder="888"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;" />
        <MudSelect T="string" @bind-Value="_sendMode" Dense="true" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Style="width:150px;" Label="Gửi tới">
            <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
        </MudSelect>

        @if (!_isRegistering)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Send" OnClick="RegisterEzCom"
                       Disabled="@(string.IsNullOrWhiteSpace(_ezCommand) || string.IsNullOrWhiteSpace(_ezNumber))">
                Đăng ký
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Stop" OnClick="StopRegister">
                Dừng
            </MudButton>
        }

        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                   OnClick="ClearEzResults">Xóa kết quả</MudButton>

        <MudSpacer />
        <div class="d-flex align-center gap-3">
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text" Style="font-weight:600;">Thành công: <b>@(_ezResults.Count(r => r.Success))</b></MudChip>
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text" Style="font-weight:600;">Thất bại: <b>@(_ezResults.Count(r => !r.Success))</b></MudChip>
        </div>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3 mt-2"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_subTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="Kết quả Đăng ký">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Kết quả đăng ký EZ COM</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="ClearEzResults">
                    Xóa kết quả
                </MudButton>
            </MudStack>

            <MudTable Items="@_ezResults" Dense="true" Hover="true" Elevation="0" Height="380px">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Lệnh</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Phản hồi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px;">@context.Time.ToString("HH:mm:ss")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd Style="font-family:monospace;">@context.Command</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "Thành công" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="max-width:220px; overflow:hidden; text-overflow:ellipsis; font-size:12px;" title="@context.Response">
                        @context.Response
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-10 text-center" Style="color:#94A3B8;">Chưa có kết quả đăng ký</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _ezCommand = "DK EZ";
    private string _ezNumber = "888";
    private string _sendMode = "selected"; // selected | all
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab = 0;
    private bool _isRegistering = false;
    private CancellationTokenSource? _cts;

    private List<EzResultItem> _ezResults = new();

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);
    private List<SimPort> FilteredPorts => Ports;

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    // =====================================================
    // ĐĂNG KÝ EZ COM (1 / Selected / All) – 100%
    // =====================================================
    async Task RegisterEzCom()
    {
        if (string.IsNullOrWhiteSpace(_ezCommand) || string.IsNullOrWhiteSpace(_ezNumber))
        {
            Snackbar.Add("Nhập lệnh và số nhận (888)", Severity.Warning);
            return;
        }

        var targets = GetTargetPorts();
        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        if (targets.Count > 5)
        {
            var ok = await DialogService.ShowMessageBox("Xác nhận",
                $"Đăng ký EZ COM trên {targets.Count} cổng?\nLệnh: {_ezCommand} → {_ezNumber}",
                yesText: "Đăng ký", cancelText: "Hủy");
            if (ok != true) return;
        }

        _isRegistering = true;
        _cts = new CancellationTokenSource();
        int okCount = 0, failCount = 0;

        Snackbar.Add($"Đang đăng ký EZ COM {targets.Count} cổng...", Severity.Info);

        foreach (var port in targets)
        {
            if (_cts.Token.IsCancellationRequested) break;

            string rawResponse = "";
            bool success = false;

            try
            {
                // Gửi SMS thật
                rawResponse = await ModemService.SendSmsAsync(port, _ezNumber.Trim(), _ezCommand.Trim());
                if (rawResponse != null && rawResponse.Contains("ERROR"))
                {
                    failCount++;
                    Snackbar.Add($"[{port}] Lỗi: {rawResponse}", Severity.Error);
                }
                else
                {
                    success = true;
                    okCount++;
                    Snackbar.Add($"[{port}] Đăng ký OK", Severity.Success);
                }
            }
            catch (Exception ex)
            {
                rawResponse = ex.Message;
                failCount++;
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }

            // Lấy SĐT của cổng nếu có
            var phone = Ports.FirstOrDefault(p => p.PortName == port)?.PhoneNumber ?? "—";

            _ezResults.Insert(0, new EzResultItem
            {
                Time = DateTime.Now,
                Port = port,
                Phone = phone,
                Command = _ezCommand,
                Success = success,
                Response = string.IsNullOrEmpty(rawResponse) ? (success ? "Đã gửi SMS thành công" : "Lỗi") : rawResponse
            });

            if (_ezResults.Count > 200) _ezResults.RemoveRange(200, _ezResults.Count - 200);
            StateHasChanged();
            await Task.Delay(800, _cts.Token);
        }

        _isRegistering = false;
        Snackbar.Add($"Hoàn tất: {okCount} thành công, {failCount} lỗi",
            failCount == 0 ? Severity.Success : Severity.Warning);
    }

    void StopRegister()
    {
        _cts?.Cancel();
        _isRegistering = false;
        Snackbar.Add("Đã dừng", Severity.Normal);
    }

    void ClearEzResults()
    {
        _ezResults.Clear();
        Snackbar.Add("Đã xóa kết quả", Severity.Normal);
    }

    List<string> GetTargetPorts()
    {
        if (_sendMode == "all" || !_selectedPorts.Any())
            return ActivePorts.Select(p => p.PortName).ToList();
        return _selectedPorts.Select(p => p.PortName).ToList();
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
    }

    public class EzResultItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Command { get; set; } = "";
        public bool Success { get; set; }
        public string Response { get; set; } = "";
    }
}
