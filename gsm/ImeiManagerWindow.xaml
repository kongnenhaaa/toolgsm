<Window x:Class="gsm.ImeiManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:gsm.ViewModels"
        mc:Ignorable="d"
        Title="Quản lý IMEI" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.DataContext>
        <viewmodels:ImeiManagerViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bảng Dữ Liệu -->
        <DataGrid Grid.Row="0" 
                  ItemsSource="{Binding PagedRecords}" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  RowHeight="30"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#E0E0E0"
                  VerticalGridLinesBrush="#E0E0E0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#00BCD4"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Phonenumber" Binding="{Binding PhoneNumber}" Width="120"/>
                <DataGridTextColumn Header="ICCID" Binding="{Binding Iccid}" Width="180"/>
                <DataGridTextColumn Header="IMEI" Binding="{Binding Imei}" Width="180"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Các chức năng bên dưới -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nhóm 1: Lấy dữ liệu -->
            <GroupBox Grid.Column="0" Header="Lấy dữ liệu" Margin="0,0,10,0">
                <StackPanel>
                    <Button Content="Xuất .txt" 
                            Command="{Binding ExportTxtCommand}"
                            Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                            Margin="0,0,0,5" Width="130" HorizontalAlignment="Left"/>
                    <Button Content="Copy nhanh ICCID|IMEI" 
                            Command="{Binding CopyQuickCommand}"
                            Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                            Width="160" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <!-- Nhóm 2: Kiểm tra dữ liệu -->
            <GroupBox Grid.Column="1" Header="Kiểm tra dữ liệu" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <Button Content="Chọn file .txt" 
                                Command="{Binding CheckImeiCommand}"
                                Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                                Width="120" Margin="0,0,0,5"/>
                        <TextBlock Text="Chọn file .txt chứa ICCID&#x0a;hoặc SĐT cần tra cứu IMEI" 
                                   FontSize="10" Foreground="Gray" Width="140" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="=>" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Button Content="Kiểm tra IMEI" 
                            Command="{Binding CheckImeiCommand}"
                            Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                            Height="30" Width="110"/>
                </StackPanel>
            </GroupBox>

            <!-- Nhóm 3: Nhập dữ liệu -->
            <GroupBox Grid.Column="2" Header="Nhập dữ liệu" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <Button Content="Chọn file .txt" 
                                Command="{Binding ImportDataCommand}"
                                Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                                Width="150" Margin="0,0,0,5"/>
                        <TextBlock Text="Định dạng ICCID|IMEI hoặc ICCID IMEI" 
                                   FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                    <TextBlock Text="=>" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Button Content="Nhập" 
                            Command="{Binding ImportDataCommand}"
                            Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                            Height="30" Width="80"/>
                </StackPanel>
            </GroupBox>
            
            <!-- Điều khiển phân trang & Tìm kiếm -->
            <Grid Grid.Column="0" Grid.ColumnSpan="4" Margin="0,95,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Paging Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Page size:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" 
                              SelectedItem="{Binding PageSize}" 
                              Width="80" Margin="0,0,15,0"
                              Background="White" BorderBrush="#BDBDBD" BorderThickness="1"/>
                    
                    <Button Content="&lt;&lt; Previous" 
                            Command="{Binding PreviousPageCommand}"
                            Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"
                            Margin="0,0,5,0"/>
                    
                    <TextBlock Text="{Binding CurrentPage, StringFormat='Trang {0}'}" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="/" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    
                    <Button Content="Next &gt;&gt;" 
                            Command="{Binding NextPageCommand}"
                            Background="#E0E0E0" Foreground="Black" BorderBrush="#BDBDBD"/>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="150" Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="Tìm kiếm ICCID/IMEI/SĐT"
                             Background="White" BorderBrush="#BDBDBD" BorderThickness="1" Padding="5,2"/>
                    <Button Content="Tìm kiếm" 
                            Background="#00BCD4" Foreground="White" BorderBrush="#00BCD4"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
