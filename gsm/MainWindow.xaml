                        <Button Background="#F06292" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Sắp xếp cổng" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
