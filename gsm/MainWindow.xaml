                        </Border>
                        <Border Background="#1E1E2E" CornerRadius="8" >
                            <StackPanel>
                                <TextBlock Text="Lỗi nhiều nhất" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding TopProblemPort}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <!-- GSM DataGrid Wrapper -->
                    <Border Grid.Row="2" Background="#1E1E2F" CornerRadius="12" Margin="10" BorderThickness="1" BorderBrush="#2A2A40">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding FilteredPortsView}" SelectedItem="{Binding SelectedPort}" 
                                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                                      Style="{StaticResource ProDataGridStyle}"
                                      Margin="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu >
                                <MenuItem Command="Copy" Header="Sao chép (Ctrl+C)" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
