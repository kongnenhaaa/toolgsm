@page "/vnpt-pass"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2" Elevation="0" 
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.caption" Style="color:#64748B; min-width:80px;">Mật khẩu mới</MudText>
        <MudTextField @bind-Value="_vnptPassword" Placeholder="Nhập mật khẩu..." 
                      Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password"
                      Style="max-width:140px; background:#F8FAFC;" Immediate="true" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Nhập lại</MudText>
        <MudTextField @bind-Value="_vnptConfirm" Placeholder="Xác nhận mật khẩu..." 
                      Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password"
                      Style="max-width:140px; background:#F8FAFC;" Immediate="true" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Chế độ</MudText>
        <MudSelect T="string" @bind-Value="_sendMode" Dense="true" Variant="Variant.Outlined" 
                   Margin="Margin.Dense" Style="width:130px; background:#F8FAFC;">
            <MudSelectItem Value="@("Selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("All")">Tất cả Vina</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Lock"
                   OnClick="SetVnptPassword" Disabled="@(string.IsNullOrEmpty(_vnptPassword))">
            Đặt mật khẩu
        </MudButton>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3 mt-2"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_subTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="Kết quả Đổi MK">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Kết quả đổi mật khẩu My VNPT</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="ClearVnptResult">
                    Xóa kết quả
                </MudButton>
            </MudStack>

            <MudTable Items="@_vnptResults" Dense="true" Hover="true" Elevation="0" Height="380px">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Phản hồi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px;">@context.Time.ToString("HH:mm:ss")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "Thành công" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="max-width:260px; overflow:hidden; text-overflow:ellipsis; font-size:12px;" Title="@context.Response">
                        @context.Response
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-10 text-center" Style="color:#94A3B8;">Chưa có kết quả đổi mật khẩu</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private string _vnptPassword = "";
    private string _vnptConfirm = "";
    private string _sendMode = "Selected";
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab = 0;

    public class VnptResultItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Phone { get; set; } = "";
        public bool Success { get; set; }
        public string Response { get; set; } = "";
    }
    private List<VnptResultItem> _vnptResults = new();

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    
    // VnptPass thường chỉ áp dụng cho Vinaphone
    private List<SimPort> FilteredPorts => Ports.Where(x => (x.NetworkProvider ?? "").Contains("Vina", StringComparison.OrdinalIgnoreCase) || true).ToList();

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    async Task SetVnptPassword()
    {
        if (string.IsNullOrEmpty(_vnptPassword)) return;
        if (_vnptPassword != _vnptConfirm)
        {
            Snackbar.Add("Mật khẩu nhập lại không khớp", Severity.Warning);
            return;
        }

        var targets = _sendMode == "Selected" 
            ? _selectedPorts.Select(p => p.PortName).ToList() 
            : FilteredPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng nào được chọn", Severity.Warning);
            return;
        }

        Snackbar.Add($"Đang gửi đăng ký Pass VNPT tới {targets.Count} cổng...", Severity.Info);
        
        foreach (var port in targets)
        {
            try
            {
                await ModemService.SendSmsAsync(port, "333", $"MK {_vnptPassword}");
                _vnptResults.Insert(0, new VnptResultItem
                {
                    Time = DateTime.Now,
                    Port = port,
                    Phone = "", // Need logic to get phone number if available
                    Success = true,
                    Response = "Đã gửi tin nhắn (SMS)..."
                });
            }
            catch (Exception ex)
            {
                _vnptResults.Insert(0, new VnptResultItem
                {
                    Time = DateTime.Now,
                    Port = port,
                    Phone = "",
                    Success = false,
                    Response = $"Lỗi: {ex.Message}"
                });
            }
            await Task.Delay(500);
        }
    }

    void ClearVnptResult()
    {
        _vnptResults.Clear();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
