@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="PhoneNumber" Label="Số điện thoại gọi" Placeholder="Nhập SĐT..." Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="WavPath" Label="File âm thanh (WAV)" Placeholder="Đường dẫn file .wav..." Variant="Variant.Outlined" Class="mb-3" />
        <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-3 d-block">Lưu ý: File WAV phải chuẩn (Mono, 8000Hz, 16-bit PCM).</MudText>
        <MudNumericField @bind-Value="DurationSeconds" Label="Thời lượng gọi tối đa (giây)" Min="10" Max="300" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(PhoneNumber))">Gọi ra</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string PortName { get; set; } = string.Empty;

    public string PhoneNumber { get; set; } = string.Empty;
    public string WavPath { get; set; } = string.Empty;
    public int DurationSeconds { get; set; } = 60;

    void Submit() => MudDialog.Close(DialogResult.Ok((PhoneNumber, WavPath, DurationSeconds)));
    void Cancel() => MudDialog.Cancel();
}
