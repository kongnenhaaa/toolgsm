@page "/"
@inject MainViewModel Vm
@inject IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable
@using gsm.ViewModels
@using gsm.Models

<MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:700;">Danh sách cổng COM</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="color:#64748B;">
    Multi-port • New SIM Intake • IMEI Protection • Real-time
</MudText>

<!-- Stats -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Tổng cổng</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:700;">@Ports.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Đang Active</MudText>
            <MudText Typo="Typo.h4" Color="Color.Success" Style="font-weight:700;">
                @Ports.Count(p => p.Status == SimStatus.Active)
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Chờ Accept</MudText>
            <MudText Typo="Typo.h4" Color="Color.Warning" Style="font-weight:700;">
                @Ports.Count(p => p.Status == SimStatus.SecurityBlocked)
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Lỗi / No Response</MudText>
            <MudText Typo="Typo.h4" Color="Color.Error" Style="font-weight:700;">
                @Ports.Count(p => p.Status == SimStatus.NoResponse)
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Toolbar -->
<MudStack Row="true" Class="mb-3" Spacing="2" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="RefreshAll" Size="Size.Small">
        Làm mới tất cả
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayArrow"
               OnClick="ConnectAll" Size="Size.Small">
        Connect All
    </MudButton>

    <MudSpacer />

    <!-- Toggle Card / Table -->
    <MudButtonGroup OverrideStyles="false" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
        <MudTooltip Text="Xem dạng Card">
            <MudIconButton Icon="@Icons.Material.Filled.GridView" 
                           Color="@(_viewMode == "card" ? Color.Primary : Color.Default)"
                           OnClick="@(() => _viewMode = "card")" />
        </MudTooltip>
        <MudTooltip Text="Xem dạng Bảng">
            <MudIconButton Icon="@Icons.Material.Filled.TableRows" 
                           Color="@(_viewMode == "table" ? Color.Primary : Color.Default)"
                           OnClick="@(() => _viewMode = "table")" />
        </MudTooltip>
    </MudButtonGroup>

    <MudTextField @bind-Value="_search" Placeholder="Tìm COM / IMEI / SĐT..." 
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Style="max-width:260px;" Variant="Variant.Outlined" Margin="Margin.Dense" />
</MudStack>

@if (_viewMode == "card")
{
    @if (FilteredPorts.Count == 0)
    {
        <!-- Empty state nhỏ gọn trong card mode -->
        <MudPaper Class="pa-16" Elevation="0" Style="border:1px dashed #CBD5E1; border-radius:16px;">
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Outlined.CellTower" Style="opacity:0.35; font-size:64px;" />
                <MudText Typo="Typo.h6" Style="color:#64748B;">Chưa có thiết bị nào</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="color:#94A3B8; max-width:360px;">
                    Cắm modem GSM vào máy tính rồi nhấn <b>Connect All</b> để bắt đầu
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="ConnectAll" Size="Size.Medium">
                    Connect All
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <!-- ========== CARD VIEW ========== -->
        <MudGrid>
            @foreach (var port in FilteredPorts)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <PortCard Port="port" 
                              OnAccept="AcceptNewSim" 
                              OnRefresh="RefreshPort"
                              OnCheckBalance="CheckBalance"
                              OnUssd="OpenUssdDialog"
                              OnSms="OpenSmsDialog"
                              OnCall="OpenCallDialog" />
                </MudItem>
            }
        </MudGrid>
    }
}
else
{
    <!-- ========== TABLE VIEW LUÔN HIỆN ========== -->
    <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; overflow:hidden;">
        <MudTable Items="@FilteredPorts" 
                  Hover="true" 
                  Dense="true" 
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedPorts"
                  Style="background:white;"
                  Breakpoint="Breakpoint.None">
            
            <HeaderContent>
                <MudTh Style="width:42px;"></MudTh>
                <MudTh>STT</MudTh>
                <MudTh>Cổng</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Nhà mạng</MudTh>
                <MudTh>Số dư</MudTh>
                <MudTh>Số điện thoại</MudTh>
                <MudTh>IMEI</MudTh>
                <MudTh>CCID</MudTh>
                <MudTh>HSD</MudTh>
                <MudTh>OTP / Nội dung</MudTh>
                <MudTh>Cập nhật</MudTh>
                <MudTh Style="min-width:150px;">Thao tác</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool" Value="@context.IsSelected" 
                                 ValueChanged="@(v => context.IsSelected = v)" 
                                 Color="Color.Primary" Dense="true" />
                </MudTd>
                <MudTd>@context.Stt</MudTd>
                <MudTd Style="font-weight:600;">@context.PortName</MudTd>
                
                <MudTd>
                    <gsm.Components.Shared.StatusBadge Status="@context.Status" />
                </MudTd>
                
                <MudTd>@(string.IsNullOrEmpty(context.NetworkProvider) ? "—" : context.NetworkProvider)</MudTd>
                
                <MudTd>
                    <span style="color:#16A34A; font-weight:600; white-space:nowrap;">
                        @(string.IsNullOrEmpty(context.Balance) ? "—" : context.Balance)
                    </span>
                </MudTd>
                
                <MudTd Style="white-space:nowrap;">
                    @(string.IsNullOrEmpty(context.PhoneNumber) || context.PhoneNumber.Contains("Chưa") ? "—" : context.PhoneNumber)
                </MudTd>
                
                <MudTd Style="font-family:monospace; font-size:12px; white-space:nowrap;">
                    @(string.IsNullOrEmpty(context.Imei) ? "—" : context.Imei)
                </MudTd>
                
                <MudTd Style="font-family:monospace; font-size:11px; max-width:130px; overflow:hidden; text-overflow:ellipsis;">
                    @(string.IsNullOrEmpty(context.Serial) ? "—" : context.Serial)
                </MudTd>
                
                <MudTd Style="white-space:nowrap; font-size:12px;">
                    @(string.IsNullOrEmpty(context.ExpiryDate) ? "—" : context.ExpiryDate)
                </MudTd>
                
                <MudTd Style="max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px;">
                    @(string.IsNullOrEmpty(context.Otp) ? (context.LastMessageContent ?? "—") : context.Otp)
                </MudTd>
                
                <MudTd Style="font-size:12px; color:#64748B; white-space:nowrap;">
                    @context.UpdatedAt
                </MudTd>
                
                <MudTd>
                    <MudStack Row="true" Spacing="0">
                        @if (context.Status == SimStatus.SecurityBlocked)
                        {
                            <MudTooltip Text="Chấp nhận SIM mới">
                                <MudIconButton Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" 
                                               Color="Color.Primary"
                                               OnClick="@(() => AcceptNewSim(context))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Làm mới">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" 
                                           OnClick="@(() => RefreshPort(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Check TKC">
                            <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" 
                                           Color="Color.Success"
                                           OnClick="@(() => CheckBalance(context))" />
                        </MudTooltip>
                        <MudTooltip Text="USSD">
                            <MudIconButton Icon="@Icons.Material.Filled.Dialpad" Size="Size.Small" 
                                           Color="Color.Info"
                                           OnClick="@(() => OpenUssdDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Gọi">
                            <MudIconButton Icon="@Icons.Material.Filled.Phone" Size="Size.Small" 
                                           OnClick="@(() => OpenCallDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Gửi SMS">
                            <MudIconButton Icon="@Icons.Material.Filled.Sms" Size="Size.Small" 
                                           Color="Color.Secondary"
                                           OnClick="@(() => OpenSmsDialog(context))" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="pa-12 text-center">
                    <MudIcon Icon="@Icons.Material.Outlined.CellTower" Size="Size.Large" Class="mb-3" Style="opacity:0.35;" />
                    <MudText Typo="Typo.h6" Style="color:#64748B;">Chưa có thiết bị nào</MudText>
                    <MudText Typo="Typo.body2" Style="color:#94A3B8; margin-bottom:16px;">
                        Cắm modem GSM rồi nhấn <b>Connect All</b>
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ConnectAll">
                        Connect All
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private string _search = "";
    private string _viewMode = "table"; // mặc định là bảng (hoặc "card")
    private HashSet<SimPort> _selectedPorts = new();

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    
    private List<SimPort> FilteredPorts => string.IsNullOrWhiteSpace(_search)
        ? Ports
        : Ports.Where(p => 
            (p.PortName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Imei?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.PhoneNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.NetworkProvider?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Serial?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
          ).ToList();

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 1500, 1500);
    }

    async Task AcceptNewSim(SimPort port)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Xác nhận chấp nhận SIM mới",
            $"Tráng IMEI mới cho {port.PortName}?\n\nIMEI hiện tại: {port.Imei}\nSau khi chấp nhận, SIM sẽ bị gán cố định IMEI mới và reboot.",
            yesText: "Chấp nhận & Tráng IMEI", cancelText: "Hủy");

        if (confirm != true) return;

        try
        {
            Snackbar.Add($"[{port.PortName}] Đang tráng IMEI...", Severity.Info);
            Vm.ApproveUnknownSimCommand?.Execute(port);
            Snackbar.Add($"[{port.PortName}] Đang xử lý Accept SIM...", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }

    async Task RefreshPort(SimPort port)
    {
        Snackbar.Add($"[{port.PortName}] Đang làm mới...", Severity.Normal);
        await Vm.RefreshPortAsync(port.PortName);
    }

    async Task CheckBalance(SimPort port)
    {
        Snackbar.Add($"[{port.PortName}] Đang kiểm tra TKC (*101#)...", Severity.Info);
        await Vm.CheckBalanceForPortAsync(port.PortName);
    }

    async Task OpenUssdDialog(SimPort port)
    {
        var parameters = new DialogParameters { ["PortName"] = port.PortName };
        var dialog = await DialogService.ShowAsync<gsm.Components.Shared.UssdDialog>($"USSD - {port.PortName}", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string code)
        {
            Snackbar.Add($"Đang gửi USSD: {code} trên {port.PortName}", Severity.Info);
            await ModemService.SendCommandAsync(port.PortName, $"AT+CUSD=1,\"{code}\",15", 15000);
        }
    }

    async Task OpenSmsDialog(SimPort port)
    {
        var parameters = new DialogParameters { ["PortName"] = port.PortName };
        var dialog = await DialogService.ShowAsync<gsm.Components.Shared.SmsDialog>($"Gửi SMS - {port.PortName}", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is (string phone, string message))
        {
            Snackbar.Add($"Đã lên lịch gửi SMS trên {port.PortName}", Severity.Info);
            await Vm.QueueSmsAsync(port.PortName, phone, message);
        }
    }

    async Task OpenCallDialog(SimPort port)
    {
        var parameters = new DialogParameters { ["PortName"] = port.PortName };
        var dialog = await DialogService.ShowAsync<gsm.Components.Shared.CallDialog>($"Gọi điện - {port.PortName}", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is (string phone, string wavPath, int duration))
        {
            Snackbar.Add($"Đang gọi {phone} trên {port.PortName}...", Severity.Info);
            string status = await Vm.ExecuteCallFromUiAsync(port.PortName, phone, wavPath, duration);
            Snackbar.Add(status, status.Contains("Lỗi") ? Severity.Error : Severity.Success);
        }
    }

    async Task RefreshAll()
    {
        Snackbar.Add("Đang làm mới tất cả cổng...", Severity.Info);
        Vm.RefreshAllPorts();
    }

    async Task ConnectAll()
    {
        Snackbar.Add("Đang Connect All...", Severity.Info);
        ModemService.ConnectAll(115200);
    }

    public void Dispose() => _timer?.Dispose();
}
