@inherits LayoutComponentBase
@inject MainViewModel Vm
@inject ISnackbar Snackbar
@using gsm.ViewModels
@using gsm.Models

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="@_theme" />

<MudLayout>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Mini" 
               OpenMiniOnHover="true" ClipMode="DrawerClipMode.Always">
        <MudNavMenu Dense="true">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/sms" Icon="@Icons.Material.Filled.Sms">SMS</MudNavLink>
            <MudNavLink Href="/ussd" Icon="@Icons.Material.Filled.Dialpad">USSD</MudNavLink>
            <MudNavLink Href="/call" Icon="@Icons.Material.Filled.Phone">Cuộc gọi</MudNavLink>
            <MudNavLink Href="/imei" Icon="@Icons.Material.Filled.PhonelinkSetup">IMEI Manager</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Cài đặt</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-4 px-4 pb-6 d-flex flex-column" Style="min-height: 100vh;">
        <div class="flex-grow-1">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private int ActiveCount => Vm?.Ports?.Count(p => p.Status == SimStatus.Active) ?? 0;

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    async Task RefreshAll()
    {
        Snackbar.Add("Đang làm mới tất cả...", Severity.Info);
    }

    void OpenSettings()
    {
        // Navigate hoặc mở dialog
    }

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563EB",
            Secondary = "#0D9488",
            AppbarBackground = "#FFFFFF",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#0F172A",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569",
            TextDisabled = "#94A3B8",
            ActionDefault = "#64748B",
            Divider = "#E2E8F0",
            TableLines = "#E2E8F0",
            LinesDefault = "#E2E8F0",
            Success = "#16A34A",
            Warning = "#D97706",
            Error = "#DC2626",
            Info = "#0891B2"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#3B82F6",
            Secondary = "#14B8A6",
            Background = "#0F172A",
            AppbarBackground = "#1E293B",
            Surface = "#1E293B",
            DrawerBackground = "#1E293B",
            DrawerText = "#F8FAFC",
            TextPrimary = "#F8FAFC",
            TextSecondary = "#CBD5E1",
            TextDisabled = "#64748B",
            ActionDefault = "#94A3B8",
            Divider = "#334155",
            TableLines = "#334155",
            LinesDefault = "#334155",
            Success = "#22C55E",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#06B6D4"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Roboto", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "10px"
        }
    };
}
