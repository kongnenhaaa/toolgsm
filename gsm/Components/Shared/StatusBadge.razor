@{
    var (text, cssClass, busy) = Status switch
    {
        gsm.Models.SimStatus.Active          => ("Active", "status-active", false),
        gsm.Models.SimStatus.WaitingAccept   => ("Chờ Accept", "status-waiting", true),
        gsm.Models.SimStatus.SecurityBlocked => ("Cần xử lý", "status-blocked", false),
        gsm.Models.SimStatus.Connecting      => ("Đang xử lý", "status-connecting", true),
        gsm.Models.SimStatus.NoResponse      => ("Mất phản hồi", "status-error", false),
        "Chờ cắm SIM"                        => ("Chờ SIM", "status-idle", false),
        _                                    => (string.IsNullOrWhiteSpace(Status) ? "Chưa xác định" : Status, "status-idle", false)
    };
}

<span class="status-badge @cssClass" role="status" aria-label="Trạng thái: @text">
    <span class="status-indicator @(busy ? "is-busy" : "")"></span>
    <span>@text</span>
</span>

@code {
    [Parameter] public string Status { get; set; } = string.Empty;
}
