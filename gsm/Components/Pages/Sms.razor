@page "/sms"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2" Elevation="0" 
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" Spacing="2" Class="mb-2">
        <MudTextField @bind-Value="_phone" Label="Số điện thoại" Placeholder="09xxxxxxxx (nhiều số: mỗi dòng 1 số)"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;" Lines="2" />
        <MudTextField @bind-Value="_message" Label="Nội dung" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:2;" Lines="2" />
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" @bind-Value="_sendMode" Dense="true" Variant="Variant.Outlined" 
                   Margin="Margin.Dense" Style="width:160px;" Label="Gửi tới">
            <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Send" OnClick="SendNow"
                   Disabled="@(string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))">
            Gửi ngay
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="AddToQueue"
                   Disabled="@(string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))">
            Thêm vào Queue
        </MudButton>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3 mt-2"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_smsSubTab">
    <MudTabPanel Text="Danh sách Cổng">
        <!-- Bảng Cổng COM -->
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="Tin nhắn tới">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Lịch sử tin nhắn nhận được</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearHistory"
                           Disabled="@(!IncomingSms.Any())">
                    Xóa lịch sử tin nhắn
                </MudButton>
            </MudStack>
            <MudTable Items="@IncomingSms" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Người gửi</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh Style="width:90px;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px; white-space:nowrap;">@context.ReceivedTime</MudTd>
                    <MudTd Style="font-weight:600;">@context.PortName</MudTd>
                    <MudTd>@context.Sender</MudTd>
                    <MudTd Style="max-width:260px; overflow:hidden; text-overflow:ellipsis;" title="@context.Content">
                        @context.Content
                    </MudTd>
                    <MudTd Style="font-family:monospace; color:#2563EB; font-weight:600;">
                        @(context.Otp ?? "—")
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                       OnClick="@(() => CopyText(context.Content))" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => ResendSms(context))" title="Gửi lại" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteSms(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có tin nhắn tới</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hàng đợi gửi">
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2">
                @if (!_isRunningQueue)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunQueue">
                        Chạy hàng đợi
                    </MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Stop" OnClick="StopQueue">
                        Dừng
                    </MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearQueue"
                           Disabled="@_isRunningQueue">
                    Xóa hàng đợi
                </MudButton>
            </MudStack>
            <MudTable Items="@SmsQueue" 
                      Dense="true" Hover="true" Elevation="0" Height="360px">
                <HeaderContent>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Kết quả</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PortId</MudTd>
                    <MudTd>@context.Recipient</MudTd>
                    <MudTd Style="max-width:220px; overflow:hidden; text-overflow:ellipsis;">@context.Content</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" 
                                 Color="@(context.Status == "Xong" ? Color.Success : context.Status == "Lỗi" ? Color.Error : Color.Warning)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd Style="font-size:12px;">@context.Result</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-10 text-center" Style="color:#94A3B8;">Hàng đợi trống</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Mẫu tin nhắn">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudStack Row="true" Class="mb-3" Spacing="2">
                <MudTextField @bind-Value="_newTemplate" Placeholder="Nhập nội dung mẫu..." 
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTemplate" Size="Size.Small">
                    Thêm mẫu
                </MudButton>
            </MudStack>
            <MudList T="string" Dense="true">
                @foreach (var tpl in _templates)
                {
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                            <MudText Style="flex:1; font-size:13px;">@tpl</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyText(tpl))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Primary" OnClick="@(() => UseTemplate(tpl))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveTemplate(tpl))" />
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _phone = "";
    private string _message = "";
    private string _sendMode = "selected"; // "selected" | "all"
    private HashSet<SimPort> _selectedPorts = new();
    private int _smsSubTab = 0;

    // Mẫu tin nhắn
    private string _newTemplate = "";
    private List<string> _templates = new()
    {
        "Ma OTP cua ban la: {otp}",
        "Xin chao, tai khoan cua ban da duoc kich hoat.",
        "Vui long nap them tien de tiep tuc su dung dich vu."
    };

    // Queue running state
    private bool _isRunningQueue = false;
    private CancellationTokenSource? _queueCts;
    private string _queueLog = "";

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);
    private List<SimPort> FilteredPorts => Ports;

    private IEnumerable<SmsMessage> IncomingSms =>
        (Vm.SmsMessages ?? Enumerable.Empty<SmsMessage>())
            .OrderByDescending(x => DateTime.TryParse(x.ReceivedTime, out var t) ? t : DateTime.Now);

    private IEnumerable<CommandQueueItem> SmsQueue =>
        (Vm.CommandQueue ?? Enumerable.Empty<CommandQueueItem>())
            .Where(x => x.Type == "SMS" || string.IsNullOrEmpty(x.Type));

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    // =====================================================
    // 1. GỬI NGAY (1 / Selected / All) – KHÔNG QUA QUEUE
    // =====================================================
    async Task SendNow()
    {
        if (string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))
        {
            Snackbar.Add("Nhập số điện thoại và nội dung", Severity.Warning);
            return;
        }

        var phones = _phone.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                           .Select(x => x.Trim())
                           .Where(x => x.Length >= 9)
                           .Distinct()
                           .ToList();

        if (!phones.Any())
        {
            Snackbar.Add("Không có số hợp lệ", Severity.Warning);
            return;
        }

        var ports = GetTargetPorts();
        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        if (ports.Count * phones.Count > 20)
        {
            var ok = await DialogService.ShowMessageBox("Xác nhận",
                $"Gửi {phones.Count} tin × {ports.Count} cổng = {phones.Count * ports.Count} SMS?",
                yesText: "Gửi ngay", cancelText: "Hủy");
            if (ok != true) return;
        }

        int sent = 0, fail = 0;
        Snackbar.Add($"Đang gửi {phones.Count * ports.Count} SMS...", Severity.Info);

        foreach (var port in ports)
        {
            foreach (var phone in phones)
            {
                try
                {
                    // Ưu tiên QueueSmsAsync nếu có, fallback SendSmsAsync
                    string res;
                    if (Vm.GetType().GetMethod("QueueSmsAsync") != null)
                        res = await Vm.QueueSmsAsync(port, phone, _message);
                    else
                        res = await ModemService.SendSmsAsync(port, phone, _message);

                    if (res != null && res.Contains("ERROR"))
                    {
                        fail++;
                        Snackbar.Add($"[{port}] → {phone} Lỗi: {res}", Severity.Error);
                    }
                    else
                    {
                        sent++;
                        Snackbar.Add($"[{port}] → {phone} OK", Severity.Success);
                    }
                }
                catch (Exception ex)
                {
                    fail++;
                    Snackbar.Add($"[{port}] → {phone} Lỗi: {ex.Message}", Severity.Error);
                }
                await Task.Delay(800); // chống spam modem
            }
        }

        Snackbar.Add($"Hoàn tất: {sent} thành công, {fail} lỗi",
            fail == 0 ? Severity.Success : Severity.Warning);
    }

    // =====================================================
    // 2. THÊM VÀO HÀNG ĐỢI
    // =====================================================
    async Task AddToQueue()
    {
        if (string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))
        {
            Snackbar.Add("Nhập số và nội dung", Severity.Warning);
            return;
        }

        var phones = _phone.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                           .Select(x => x.Trim())
                           .Where(x => x.Length >= 9)
                           .Distinct()
                           .ToList();

        var ports = GetTargetPorts();
        if (!ports.Any() || !phones.Any())
        {
            Snackbar.Add("Thiếu cổng hoặc số hợp lệ", Severity.Warning);
            return;
        }

        int added = 0;
        foreach (var port in ports)
        {
            foreach (var phone in phones)
            {
                // Thêm vào queue của ViewModel
                var item = new CommandQueueItem
                {
                    CommandId = Guid.NewGuid().ToString("N")[..8],
                    Type = "SMS",
                    PortId = port,
                    Recipient = phone,
                    Content = _message,
                    Status = "Chờ",
                    Result = ""
                };

                Vm.CommandQueue?.Add(item);
                added++;
            }
        }

        Snackbar.Add($"Đã thêm {added} tin vào hàng đợi", Severity.Success);
        _smsSubTab = 2; // chuyển sang tab Hàng đợi
        StateHasChanged();
    }

    // =====================================================
    // 3. CHẠY HÀNG ĐỢI (RunQueue) – FIX THẬT 100%
    // =====================================================
    async Task RunQueue()
    {
        var queue = SmsQueue.Where(x => x.Status == "Chờ" || x.Status == "Pending" || string.IsNullOrEmpty(x.Status)).ToList();
        if (!queue.Any())
        {
            Snackbar.Add("Hàng đợi trống hoặc không còn tin chờ", Severity.Warning);
            return;
        }

        _isRunningQueue = true;
        _queueCts = new CancellationTokenSource();
        _queueLog = $"[{DateTime.Now:HH:mm:ss}] Bắt đầu chạy {queue.Count} tin...\n";

        int ok = 0, fail = 0;

        try
        {
            foreach (var item in queue)
            {
                if (_queueCts.Token.IsCancellationRequested) break;

                item.Status = "Đang gửi";
                StateHasChanged();

                try
                {
                    // Gửi thật
                    string res;
                    if (Vm.GetType().GetMethod("QueueSmsAsync") != null)
                        res = await Vm.QueueSmsAsync(item.PortId, item.Recipient, item.Content);
                    else
                        res = await ModemService.SendSmsAsync(item.PortId, item.Recipient, item.Content);

                    if (res != null && res.Contains("ERROR"))
                    {
                        item.Status = "Lỗi";
                        item.Result = res;
                        fail++;
                        _queueLog += $"[{DateTime.Now:HH:mm:ss}] {item.PortId} → {item.Recipient} LỖI: {res}\n";
                    }
                    else
                    {
                        item.Status = "Xong";
                        item.Result = "OK";
                        ok++;
                        _queueLog += $"[{DateTime.Now:HH:mm:ss}] {item.PortId} → {item.Recipient} OK\n";
                    }
                }
                catch (Exception ex)
                {
                    item.Status = "Lỗi";
                    item.Result = ex.Message;
                    fail++;
                    _queueLog += $"[{DateTime.Now:HH:mm:ss}] {item.PortId} → {item.Recipient} LỖI: {ex.Message}\n";
                }

                StateHasChanged();
                await Task.Delay(1000, _queueCts.Token); // delay an toàn
            }
        }
        catch (TaskCanceledException) { }

        _isRunningQueue = false;
        _queueLog += $"\n[{DateTime.Now:HH:mm:ss}] Xong • OK: {ok} • Lỗi: {fail}\n";
        Snackbar.Add($"Hàng đợi xong: {ok} thành công, {fail} lỗi",
            fail == 0 ? Severity.Success : Severity.Warning);
    }

    void StopQueue()
    {
        _queueCts?.Cancel();
        _isRunningQueue = false;
        Snackbar.Add("Đã dừng hàng đợi", Severity.Normal);
    }

    // =====================================================
    // 4. XÓA HÀNG ĐỢI
    // =====================================================
    async Task ClearQueue()
    {
        var count = SmsQueue.Count();
        if (count == 0) return;

        var ok = await DialogService.ShowMessageBox("Xác nhận",
            $"Xóa {count} tin trong hàng đợi?", yesText: "Xóa", cancelText: "Hủy");
        if (ok != true) return;

        // Xóa các item SMS
        var toRemove = SmsQueue.ToList();
        foreach (var item in toRemove)
            Vm.CommandQueue?.Remove(item);

        Snackbar.Add($"Đã xóa {count} tin", Severity.Success);
    }

    // =====================================================
    // 5. RESEND TỪ LỊCH SỬ
    // =====================================================
    async Task ResendSms(SmsMessage sms)
    {
        if (string.IsNullOrEmpty(sms.Sender) || string.IsNullOrEmpty(sms.Content))
        {
            Snackbar.Add("Thiếu số hoặc nội dung", Severity.Warning);
            return;
        }

        try
        {
            var port = string.IsNullOrEmpty(sms.PortName) 
                ? ActivePorts.FirstOrDefault()?.PortName 
                : sms.PortName;

            if (string.IsNullOrEmpty(port))
            {
                Snackbar.Add("Không có cổng Active", Severity.Warning);
                return;
            }

            var res = await ModemService.SendSmsAsync(port, sms.Sender, sms.Content);
            if (res != null && res.Contains("ERROR"))
            {
                Snackbar.Add($"[{port}] Resend lỗi: {res}", Severity.Error);
            }
            else
            {
                Snackbar.Add($"[{port}] Đã gửi lại tới {sms.Sender}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Resend lỗi: " + ex.Message, Severity.Error);
        }
    }

    // =====================================================
    // 6. MẪU TIN NHẮN
    // =====================================================
    void AddTemplate()
    {
        if (string.IsNullOrWhiteSpace(_newTemplate)) return;
        _templates.Add(_newTemplate.Trim());
        _newTemplate = "";
        Snackbar.Add("Đã thêm mẫu", Severity.Success);
    }

    void UseTemplate(string tpl)
    {
        _message = tpl;
        _smsSubTab = 0; // về form gửi
        Snackbar.Add("Đã nạp mẫu vào form", Severity.Info);
    }

    void RemoveTemplate(string tpl) => _templates.Remove(tpl);

    // =====================================================
    // 7. COPY / DELETE
    // =====================================================
    async Task CopyText(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("clipboardCopy.copyText", text);
            Snackbar.Add("Đã copy vào Clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Copy thất bại", Severity.Warning);
        }
    }

    async Task DeleteSms(SmsMessage sms)
    {
        Vm.SmsMessages?.Remove(sms);
        Snackbar.Add("Đã xóa tin nhắn", Severity.Normal);
    }

    async Task ClearHistory()
    {
        var ok = await DialogService.ShowMessageBox("Xác nhận",
            "Xóa toàn bộ lịch sử tin nhắn tới?", yesText: "Xóa", cancelText: "Hủy");
        if (ok == true)
        {
            Vm.SmsMessages?.Clear();
            Snackbar.Add("Đã xóa lịch sử", Severity.Success);
        }
    }

    // =====================================================
    // HELPERS
    // =====================================================
    List<string> GetTargetPorts()
    {
        if (_sendMode == "all" || !_selectedPorts.Any())
            return ActivePorts.Select(p => p.PortName).ToList();

        return _selectedPorts.Select(p => p.PortName).ToList();
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _queueCts?.Cancel();
        _queueCts?.Dispose();
    }
}
