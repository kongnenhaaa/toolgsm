                                    <MenuItem Header="Sắp xếp theo Số dư (Cao - Thấp)" Command="{Binding SortPortsCommand}" CommandParameter="Balance">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="Wallet"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Kiểm tra số dư" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wallet" VerticalAlignment="Center" Margin="0,0,10,0"/>
