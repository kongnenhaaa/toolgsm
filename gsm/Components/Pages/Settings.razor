@page "/settings"
@inject MainViewModel Vm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject gsm.Services.IFileDialogService FileDialog
@inject gsm.Services.IAudioService Audio
@using gsm.ViewModels
@using gsm.Models
@using System.IO

<div class="px-3 pt-2">
    <MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:700;">Cài đặt</MudText>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color:#64748B;">
        Cấu hình tool • New SIM Intake • IMEI Restore • Thông báo • Nâng cao
    </MudText>
</div>

<!-- ========== ACTION FORM / TOOLBAR ========== -->
<MudPaper Class="pa-3 mx-3 mb-4" Elevation="0" Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" Spacing="2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="SaveAll" Size="Size.Small">
        Lưu tất cả cài đặt
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" 
               StartIcon="@Icons.Material.Filled.RestartAlt"
               OnClick="ResetDefault" Size="Size.Small">
        Khôi phục mặc định
    </MudButton>
    <MudButton Variant="Variant.Text" Color="Color.Info" 
               StartIcon="@Icons.Material.Filled.Download"
               OnClick="ExportSettings" Size="Size.Small">
        Export cấu hình
    </MudButton>
    <MudButton Variant="Variant.Text" Color="Color.Info" 
               StartIcon="@Icons.Material.Filled.Upload"
               OnClick="ImportSettings" Size="Size.Small">
        Import cấu hình
    </MudButton>
    </MudStack>
</MudPaper>

<div class="mx-3">
    <MudGrid>
    <!-- ========== CỘT TRÁI ========== -->
    <MudItem xs="12" md="6">



        <!-- MẠNG & TÍN HIỆU -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.SignalCellularAlt" Class="mr-1" Size="Size.Small" />
                Mạng & Tín hiệu
            </MudText>

            <MudSwitch T="bool" @bind-Value="_prefer4G" Label="Ưu tiên 4G → 3G → 2G (nwscanseq=030201)" Color="Color.Primary" Class="mb-2" />
            
            <MudSwitch T="bool" @bind-Value="_enableVolte" Label="Bật VoLTE / IMS" Color="Color.Primary" Class="mb-2" />
            
            <MudSwitch T="bool" @bind-Value="_autoRecovery" Label="Tự recovery khi mất sóng" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.caption" Class="mb-3 ml-10" Style="color:#64748B;">
                Tự CFUN=1 + re-apply scan mode + COPS=0 khi mất sóng lâu
            </MudText>

            <MudSwitch T="bool" @bind-Value="_forceCfun1AfterReboot" Label="Ép CFUN=1 sau reboot" Color="Color.Primary" Class="mb-2" />

            <MudNumericField T="int" @bind-Value="_recoveryThreshold" Label="Ngưỡng recovery (lần poll)" Min="5" Max="30" 
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Style="max-width:200px;" />
            
            <MudNumericField T="int" @bind-Value="_watchdogSeconds" Label="Watchdog force CFUN (giây)" Min="20" Max="120" 
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:200px;" />
        </MudPaper>

        <!-- SMS / USSD -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.Sms" Class="mr-1" Size="Size.Small" />
                SMS & USSD
            </MudText>

            <MudSwitch T="bool" @bind-Value="_autoCheckBalanceAfterSms" Label="Tự check TKC sau khi gửi SMS" Color="Color.Primary" Class="mb-2" />
            
            <MudSwitch T="bool" @bind-Value="_autoUssdOnNetwork" Label="Tự USSD *101# khi có nhà mạng" Color="Color.Primary" Class="mb-2" />
            
            <MudNumericField T="int" @bind-Value="_ussdRetrySeconds" Label="Retry USSD sau (giây) nếu trống" Min="15" Max="90" 
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Style="max-width:220px;" />

            <MudNumericField T="int" @bind-Value="_smsTimeout" Label="Timeout gửi SMS (ms)" Min="10000" Max="60000" Step="1000"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" />
        </MudPaper>

        <!-- CHUYỂN TIẾP CUỘC GỌI -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.PhoneForwarded" Class="mr-1" Size="Size.Small" />
                Chuyển tiếp cuộc gọi
            </MudText>

            <MudSwitch T="bool" @bind-Value="_enableAutoCallForwarding" Label="Tự động chuyển tiếp cuộc gọi khi có SIM" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.caption" Class="mb-3 ml-10" Style="color:#64748B; display:block;">
                Tự động gửi lệnh AT+CCFC khi cắm SIM/Nhận diện mạng
            </MudText>

            <MudTextField @bind-Value="_forwardPhoneNumber" Label="Số điện thoại nhận chuyển tiếp" 
                          HelperText="Nhập danh sách số nhận, phân tách bằng dấu phẩy nếu muốn chuyển ngẫu nhiên"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        </MudPaper>
    </MudItem>

    <!-- ========== CỘT PHẢI ========== -->
    <MudItem xs="12" md="6">

        <!-- THÔNG BÁO & ÂM THANH -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mr-1" Size="Size.Small" />
                Thông báo & Âm thanh
            </MudText>

            <MudSwitch T="bool" @bind-Value="_soundOnSms" Label="Phát âm thanh khi có SMS" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_soundOnCall" Label="Phát âm thanh khi có cuộc gọi" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_soundOnOtp" Label="Phát âm thanh khi có OTP" Color="Color.Primary" Class="mb-2" />
            
            <MudDivider Class="my-3" />

            <MudSwitch T="bool" @bind-Value="_telegramOnOtp" Label="Gửi Telegram khi có OTP" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_telegramOnSms" Label="Gửi Telegram khi có SMS" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_telegramOnCall" Label="Gửi Telegram khi có cuộc gọi" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_telegramOnError" Label="Gửi Telegram khi có lỗi" Color="Color.Primary" Class="mb-2" />
        </MudPaper>

        <!-- TELEGRAM -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.Message" Class="mr-1" Size="Size.Small" />
                Telegram
            </MudText>

            <MudTextField @bind-Value="_telegramBotToken" Label="Bot Token" 
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                          InputType="@(_showToken ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End" AdornmentIcon="@(_showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showToken = !_showToken)" />

            <MudTextField @bind-Value="_telegramChatId" Label="Chat ID" 
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="TestTelegram" Disabled="@(string.IsNullOrEmpty(_telegramBotToken) || string.IsNullOrEmpty(_telegramChatId))">
                    Test gửi tin
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                           OnClick="OpenTelegramGuide">
                    Hướng dẫn lấy Token
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- API / WEBHOOK -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.Webhook" Class="mr-1" Size="Size.Small" />
                API / Webhook
            </MudText>

            <MudTextField @bind-Value="_otpWebhookUrl" Label="Link đẩy OTP Web (Webhook URL)" 
                          Placeholder="https://your-server.com/api/otp"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            
            <MudSwitch T="bool" @bind-Value="_pushOtpToWeb" Label="Tự động đẩy OTP lên Web" Color="Color.Primary" Class="mb-3" />

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       OnClick="TestWebhook" Disabled="@(string.IsNullOrEmpty(_otpWebhookUrl))">
                Test gửi Webhook
            </MudButton>
        </MudPaper>

        <!-- FIREBASE (ĐỒNG BỘ TOOLWEB) -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.CloudSync" Class="mr-1" Size="Size.Small" />
                Firebase (Đồng bộ ToolWeb)
            </MudText>

            <MudTextField @bind-Value="_firebaseUrl" Label="Firebase Database URL" 
                          Placeholder="https://your-project-default-rtdb.firebaseio.com/"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudTextField @bind-Value="_machineId" Label="Machine ID (Tên máy)" 
                          Placeholder="machine-1"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudSwitch T="bool" @bind-Value="_writeOtpToFirebase" Label="Tự động đồng bộ OTP/Ports lên Firebase" Color="Color.Primary" Class="mb-2" />
        </MudPaper>

        <!-- ÂM THANH -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Class="mr-1" Size="Size.Small" />
                File âm thanh
            </MudText>

            <MudTextField @bind-Value="_soundSmsPath" Label="Âm thanh SMS" Variant="Variant.Outlined" 
                          Margin="Margin.Dense" Class="mb-2"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                          OnAdornmentClick="@(() => BrowseSound("sms"))" />

            <MudTextField @bind-Value="_soundCallPath" Label="Âm thanh cuộc gọi" Variant="Variant.Outlined" 
                          Margin="Margin.Dense" Class="mb-2"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                          OnAdornmentClick="@(() => BrowseSound("call"))" />

            <MudTextField @bind-Value="_soundOtpPath" Label="Âm thanh OTP" Variant="Variant.Outlined" 
                          Margin="Margin.Dense" Class="mb-3"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                          OnAdornmentClick="@(() => BrowseSound("otp"))" />

            <MudStack Row="true" Spacing="1">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => TestSound("sms"))">Test SMS</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => TestSound("call"))">Test Call</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => TestSound("otp"))">Test OTP</MudButton>
            </MudStack>
        </MudPaper>

        <!-- NÂNG CAO -->
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-1" Size="Size.Small" />
                Nâng cao
            </MudText>

            <MudNumericField T="int" @bind-Value="_baudRate" Label="Baud rate" Variant="Variant.Outlined" 
                             Margin="Margin.Dense" Class="mb-2" Style="max-width:160px;" />

            <MudNumericField T="int" @bind-Value="_commandTimeout" Label="Timeout AT command (ms)" 
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Style="max-width:200px;" />

            <MudSwitch T="bool" @bind-Value="_enableLog" Label="Ghi log chi tiết" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_autoConnectOnStart" Label="Tự Connect All khi khởi động" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_minimizeToTray" Label="Thu nhỏ xuống tray" Color="Color.Primary" Class="mb-2" />

            <MudDivider Class="my-3" />

            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.DeleteForever"
                       OnClick="ClearAllData">
                Xóa toàn bộ dữ liệu tool
            </MudButton>
        </MudPaper>
    </MudItem>
    </MudGrid>
</div>

@code {
    private bool _newSimIntake = true;
    private bool _autoRestoreImei = true;
    private bool _blockUnknown = false;
    private bool _autoAccept = false;
    private bool _prefer4G = true;
    private bool _enableVolte = false;
    private bool _autoRecovery = true;
    private bool _forceCfun1AfterReboot = true;
    private int _recoveryThreshold = 12;
    private int _watchdogSeconds = 50;
    private bool _autoCheckBalanceAfterSms = true;
    private bool _autoUssdOnNetwork = true;
    private int _ussdRetrySeconds = 35;
    private int _smsTimeout = 30000;
    private bool _soundOnSms = true;
    private bool _soundOnCall = true;
    private bool _soundOnOtp = true;
    private bool _telegramOnOtp = true;
    private bool _telegramOnSms = false;
    private bool _telegramOnCall = true;
    private bool _telegramOnError = true;
    private string _telegramBotToken = "";
    private string _telegramChatId = "";
    private bool _showToken = false;
    private string _otpWebhookUrl = "";
    private bool _pushOtpToWeb = false;
    private string _firebaseUrl = "";
    private string _machineId = "machine-1";
    private bool _writeOtpToFirebase = true;
    private string _soundSmsPath = "";
    private string _soundCallPath = "";
    private string _soundOtpPath = "";
    private int _baudRate = 115200;
    private int _commandTimeout = 10000;
    private bool _enableLog = true;
    private bool _autoConnectOnStart = false;
    private bool _minimizeToTray = true;
    private bool _enableAutoCallForwarding = false;
    private string _forwardPhoneNumber = "";

    protected override void OnInitialized()
    {
        LoadSettings();
    }

    async Task SaveAll()
    {
        try
        {
            var cfg = gsm.Services.SettingsService.Current;
            cfg.NewSimIntake = _newSimIntake;
            cfg.AutoRestoreImei = _autoRestoreImei;
            cfg.BlockUnknown = _blockUnknown;
            cfg.AutoAccept = _autoAccept;
            cfg.Prefer4G = _prefer4G;
            cfg.EnableVolte = _enableVolte;
            cfg.AutoRecovery = _autoRecovery;
            cfg.ForceCfun1AfterReboot = _forceCfun1AfterReboot;
            cfg.RecoveryThreshold = _recoveryThreshold;
            cfg.WatchdogSeconds = _watchdogSeconds;
            cfg.AutoCheckBalanceAfterSms = _autoCheckBalanceAfterSms;
            cfg.AutoUssdOnNetwork = _autoUssdOnNetwork;
            cfg.UssdRetrySeconds = _ussdRetrySeconds;
            cfg.SmsTimeout = _smsTimeout;
            cfg.SoundOnSms = _soundOnSms;
            cfg.SoundOnCall = _soundOnCall;
            cfg.SoundOnOtp = _soundOnOtp;
            cfg.TelegramOnOtp = _telegramOnOtp;
            cfg.TelegramOnSms = _telegramOnSms;
            cfg.TelegramOnCall = _telegramOnCall;
            cfg.TelegramOnError = _telegramOnError;
            cfg.TelegramBotToken = _telegramBotToken;
            cfg.TelegramChatId = _telegramChatId;
            cfg.OtpWebhookUrl = _otpWebhookUrl;
            cfg.PushOtpToWeb = _pushOtpToWeb;
            cfg.FirebaseUrl = _firebaseUrl;
            cfg.MachineId = _machineId;
            cfg.WriteOtpToFirebase = _writeOtpToFirebase;
            cfg.SoundSmsPath = _soundSmsPath;
            cfg.SoundCallPath = _soundCallPath;
            cfg.SoundOtpPath = _soundOtpPath;
            cfg.BaudRate = _baudRate;
            cfg.CommandTimeout = _commandTimeout;
            cfg.EnableLog = _enableLog;
            cfg.AutoConnectOnStart = _autoConnectOnStart;
            cfg.MinimizeToTray = _minimizeToTray;
            cfg.EnableAutoCallForwarding = _enableAutoCallForwarding;
            cfg.ForwardPhoneNumber = _forwardPhoneNumber;

            gsm.Services.SettingsService.SaveSettings(cfg);
            Snackbar.Add("Đã lưu cài đặt thành công và áp dụng cho ứng dụng", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi lưu: " + ex.Message, Severity.Error);
        }
    }

    void LoadSettings()
    {
        try
        {
            var cfg = gsm.Services.SettingsService.Current;
            if (cfg == null) return;

            _newSimIntake = cfg.NewSimIntake;
            _autoRestoreImei = cfg.AutoRestoreImei;
            _blockUnknown = cfg.BlockUnknown;
            _autoAccept = cfg.AutoAccept;
            _prefer4G = cfg.Prefer4G;
            _enableVolte = cfg.EnableVolte;
            _autoRecovery = cfg.AutoRecovery;
            _forceCfun1AfterReboot = cfg.ForceCfun1AfterReboot;
            _recoveryThreshold = cfg.RecoveryThreshold;
            _watchdogSeconds = cfg.WatchdogSeconds;
            _autoCheckBalanceAfterSms = cfg.AutoCheckBalanceAfterSms;
            _autoUssdOnNetwork = cfg.AutoUssdOnNetwork;
            _ussdRetrySeconds = cfg.UssdRetrySeconds;
            _smsTimeout = cfg.SmsTimeout;
            _soundOnSms = cfg.SoundOnSms;
            _soundOnCall = cfg.SoundOnCall;
            _soundOnOtp = cfg.SoundOnOtp;
            _telegramOnOtp = cfg.TelegramOnOtp;
            _telegramOnSms = cfg.TelegramOnSms;
            _telegramOnCall = cfg.TelegramOnCall;
            _telegramOnError = cfg.TelegramOnError;
            _telegramBotToken = cfg.TelegramBotToken ?? "";
            _telegramChatId = cfg.TelegramChatId ?? "";
            _otpWebhookUrl = cfg.OtpWebhookUrl ?? "";
            _pushOtpToWeb = cfg.PushOtpToWeb;
            _firebaseUrl = cfg.FirebaseUrl ?? "";
            _machineId = cfg.MachineId ?? "machine-1";
            _writeOtpToFirebase = cfg.WriteOtpToFirebase;
            _soundSmsPath = cfg.SoundSmsPath ?? "";
            _soundCallPath = cfg.SoundCallPath ?? "";
            _soundOtpPath = cfg.SoundOtpPath ?? "";
            _baudRate = cfg.BaudRate;
            _commandTimeout = cfg.CommandTimeout;
            _enableLog = cfg.EnableLog;
            _autoConnectOnStart = cfg.AutoConnectOnStart;
            _minimizeToTray = cfg.MinimizeToTray;
            _enableAutoCallForwarding = cfg.EnableAutoCallForwarding;
            _forwardPhoneNumber = cfg.ForwardPhoneNumber ?? "";
        }
        catch { }
    }

    void ResetDefault()
    {
        _newSimIntake = true;
        _autoRestoreImei = true;
        _blockUnknown = false;
        _autoAccept = false;
        _prefer4G = true;
        _enableVolte = false;
        _autoRecovery = true;
        _forceCfun1AfterReboot = true;
        _recoveryThreshold = 12;
        _watchdogSeconds = 50;
        _autoCheckBalanceAfterSms = true;
        _autoUssdOnNetwork = true;
        _ussdRetrySeconds = 35;
        _smsTimeout = 30000;
        _soundOnSms = true;
        _soundOnCall = true;
        _soundOnOtp = true;
        _telegramOnOtp = true;
        _telegramOnSms = false;
        _telegramOnCall = true;
        _telegramOnError = true;
        _telegramBotToken = "";
        _telegramChatId = "";
        _otpWebhookUrl = "";
        _pushOtpToWeb = false;
        _firebaseUrl = "";
        _machineId = "machine-1";
        _writeOtpToFirebase = true;
        _soundSmsPath = "";
        _soundCallPath = "";
        _soundOtpPath = "";
        _baudRate = 115200;
        _commandTimeout = 10000;
        _enableLog = true;
        _autoConnectOnStart = false;
        _minimizeToTray = true;
        _enableAutoCallForwarding = false;
        _forwardPhoneNumber = "";
        Snackbar.Add("Đã khôi phục mặc định (chưa lưu)", Severity.Info);
    }

    async Task ExportSettings()
    {
        try
        {
            await SaveAll();
            var path = FileDialog.SaveFile($"appsettings_{DateTime.Now:yyyyMMdd_HHmmss}.json", "JSON files (*.json)|*.json");
            if (string.IsNullOrEmpty(path)) return;

            var json = System.Text.Json.JsonSerializer.Serialize(gsm.Services.SettingsService.Current, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await File.WriteAllTextAsync(path, json);
            Snackbar.Add($"Đã export: {path}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Export lỗi: " + ex.Message, Severity.Error);
        }
    }

    async Task ImportSettings()
    {
        try
        {
            var path = FileDialog.OpenFile("JSON files (*.json)|*.json");
            if (string.IsNullOrEmpty(path)) return;

            var json = await File.ReadAllTextAsync(path);
            var cfg = System.Text.Json.JsonSerializer.Deserialize<AppSettings>(json);
            if (cfg == null)
            {
                Snackbar.Add("File cấu hình rỗng hoặc lỗi", Severity.Warning);
                return;
            }

            gsm.Services.SettingsService.SaveSettings(cfg);
            LoadSettings();
            Snackbar.Add("Đã import + load cấu hình thành công", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Import lỗi: " + ex.Message, Severity.Error);
        }
    }

    async Task TestTelegram()
    {
        if (string.IsNullOrWhiteSpace(_telegramBotToken) || string.IsNullOrWhiteSpace(_telegramChatId))
        {
            Snackbar.Add("Nhập Token và Chat ID", Severity.Warning);
            return;
        }
        try
        {
            using var http = new HttpClient();
            var url = $"https://api.telegram.org/bot{_telegramBotToken}/sendMessage";
            var payload = new { chat_id = _telegramChatId, text = $"[Tool GSM] Test thông báo" };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var resp = await http.PostAsync(url, content);
            Snackbar.Add(resp.IsSuccessStatusCode ? "Gửi Telegram thành công!" : "Lỗi Telegram", resp.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("Lỗi: " + ex.Message, Severity.Error); }
    }

    void OpenTelegramGuide() => Snackbar.Add("Mở hướng dẫn lấy Bot Token & Chat ID", Severity.Info);

    async Task TestWebhook()
    {
        if (string.IsNullOrWhiteSpace(_otpWebhookUrl)) { Snackbar.Add("Nhập Webhook URL", Severity.Warning); return; }
        try
        {
            using var http = new HttpClient();
            var payload = new { event_type = "test", time = DateTime.Now };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var resp = await http.PostAsync(_otpWebhookUrl, content);
            Snackbar.Add(resp.IsSuccessStatusCode ? "Webhook OK" : "Webhook lỗi", resp.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("Webhook lỗi: " + ex.Message, Severity.Error); }
    }

    void BrowseSound(string type)
    {
        var path = FileDialog.OpenFile("WAV files (*.wav)|*.wav|All files (*.*)|*.*");
        if (string.IsNullOrEmpty(path)) return;

        if (type == "sms") _soundSmsPath = path;
        else if (type == "call") _soundCallPath = path;
        else if (type == "otp") _soundOtpPath = path;

        Snackbar.Add($"Đã chọn file âm thanh cho {type.ToUpper()}", Severity.Success);
    }

    void TestSound(string type)
    {
        var path = "";
        if (type == "sms") path = _soundSmsPath;
        else if (type == "call") path = _soundCallPath;
        else if (type == "otp") path = _soundOtpPath;

        if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
        {
            Snackbar.Add("File âm thanh không tồn tại", Severity.Warning);
            return;
        }

        Audio.Play(path);
        Snackbar.Add($"Đang phát âm thanh {type.ToUpper()}...", Severity.Normal);
    }

    async Task ClearAllData()
    {
        var ok = await DialogService.ShowMessageBox("CẢNH BÁO", "Xóa TOÀN BỘ dữ liệu?", yesText: "XÓA HẾT", cancelText: "Hủy");
        if (ok != true) return;
        try
        {
            var dataDir = Path.Combine(AppContext.BaseDirectory, "Data");
            if (Directory.Exists(dataDir)) Directory.Delete(dataDir, true);
            Snackbar.Add("Đã xóa toàn bộ dữ liệu", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add("Lỗi xóa: " + ex.Message, Severity.Error); }
    }

}
