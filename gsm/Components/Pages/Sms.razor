@page "/sms"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2" Elevation="0" 
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.caption" Style="color:#64748B; min-width:80px;">Người nhận</MudText>
        <MudTextField @bind-Value="_phone" Placeholder="09xxxxxxxx" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:140px; background:#F8FAFC;" Immediate="true" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Nội dung</MudText>
        <MudTextField @bind-Value="_message" Placeholder="Nhập tin nhắn..." 
                      Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="min-width:250px; flex:1; background:#F8FAFC;" Immediate="true" />

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Chế độ</MudText>
        <MudSelect T="string" @bind-Value="_sendMode" Dense="true" Variant="Variant.Outlined" 
                   Margin="Margin.Dense" Style="width:130px; background:#F8FAFC;">
            <MudSelectItem Value="@("Selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("All")">Tất cả Active</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendSms" Disabled="@(string.IsNullOrEmpty(_phone) || string.IsNullOrEmpty(_message))">
            Thêm vào Queue
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunQueue">
            Chạy Queue
        </MudButton>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3"
         Style="background:transparent;"
         ActivePanelIndexChanged="OnSubTabChanged">
    <MudTabPanel Text="Danh sách Cổng" />
    <MudTabPanel Text="Tin nhắn tới" />
    <MudTabPanel Text="Hàng đợi Gửi" />
    <MudTabPanel Text="Mẫu tin nhắn" />
</MudTabs>

<!-- ========== CONTENT VÙNG DƯỚI TÙY SUB-TAB ========== -->
<div class="mx-3 mt-1">
    @if (_subTab == 0)
    {
        <!-- Bảng Cổng COM -->
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    }
    else if (_subTab == 1)
    {
        <!-- Tin nhắn tới -->
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; background:#FFFFFF; min-height:400px; padding:16px;">
            <MudText Typo="Typo.h6" Style="color:#1E293B;">Danh sách SMS nhận được</MudText>
            <MudText Typo="Typo.body2" Style="color:#64748B;">@Vm.SmsMessages.Count tin nhắn</MudText>
            <MudList T="string" Dense="true">
                @foreach(var sms in Vm.SmsMessages.OrderByDescending(x => x.ReceivedTime).Take(50))
                {
                    <MudListItem>
                        <MudText Style="color:#1E293B; font-size:13px;">
                            <b>[@sms.PortName]</b> <span style="color:#2563EB;">@sms.Sender</span>: @sms.Content <span style="color:#94A3B8; font-size:11px;">(@sms.ReceivedTime)</span>
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
    else if (_subTab == 2)
    {
        <!-- Hàng đợi Gửi -->
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; background:#FFFFFF; min-height:400px; padding:16px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6" Style="color:#1E293B;">Hàng đợi lệnh SMS</MudText>
                <MudSpacer/>
                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" OnClick="() => Vm.CommandQueue.Clear()">Xóa hàng đợi</MudButton>
            </MudStack>
            
            <MudTable Items="@(Vm.CommandQueue.Where(x => x.Type == "SMS"))" Dense="true" Hover="true" Elevation="0" Style="background:#FFFFFF; color:#1E293B;">
                <HeaderContent>
                    <MudTh Style="background:#F8FAFC; color:#64748B;">Cổng</MudTh>
                    <MudTh Style="background:#F8FAFC; color:#64748B;">Người nhận</MudTh>
                    <MudTh Style="background:#F8FAFC; color:#64748B;">Nội dung</MudTh>
                    <MudTh Style="background:#F8FAFC; color:#64748B;">Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="color:#1E293B; border-bottom:1px solid #F1F5F9;">@context.PortId</MudTd>
                    <MudTd Style="color:#1E293B; border-bottom:1px solid #F1F5F9;">@context.Recipient</MudTd>
                    <MudTd Style="color:#1E293B; border-bottom:1px solid #F1F5F9;">@context.Content</MudTd>
                    <MudTd Style="color:#1E293B; border-bottom:1px solid #F1F5F9;">@context.Status</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-4 text-center" style="color:#94A3B8;">Hàng đợi trống</div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
    else if (_subTab == 3)
    {
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; background:#FFFFFF; min-height:400px; padding:16px;">
            <MudText Typo="Typo.h6" Style="color:#1E293B;">Mẫu tin nhắn đang được xây dựng</MudText>
        </MudPaper>
    }
</div>

@code {
    private string _phone = "";
    private string _message = "";
    private string _sendMode = "Selected";
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab = 0;

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private List<SimPort> FilteredPorts => Ports;

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    void OnSubTabChanged(int index) => _subTab = index;

    async Task SendSms()
    {
        var targets = _sendMode == "Selected" 
            ? _selectedPorts.Select(p => p.PortName).ToList() 
            : Ports.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng nào được chọn để gửi", Severity.Warning);
            return;
        }

        int count = 0;
        foreach (var port in targets)
        {
            await Vm.QueueSmsAsync(port, _phone, _message);
            count++;
        }
        
        Snackbar.Add($"Đã thêm {count} lệnh gửi SMS vào hàng đợi", Severity.Success);
    }

    async Task RunQueue()
    {
        Snackbar.Add("Đang chạy hàng đợi SMS...", Severity.Info);
        Vm.RunCommandQueueCommand?.Execute(null);
    }

    public void Dispose() => _timer?.Dispose();
}
