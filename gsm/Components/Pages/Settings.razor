@page "/settings"
@inject MainViewModel Vm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject gsm.Services.IFileDialogService FileDialog
@inject gsm.Services.IAudioService Audio
@using gsm.ViewModels
@using gsm.Models
@using System.IO

<!-- ========== TOOLBAR ========== -->
<MudPaper Class="pa-3 mx-3 mb-4 feature-toolbar settings-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAll" Size="Size.Small">
            Lưu tất cả cài đặt
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   OnClick="ResetDefault" Size="Size.Small">
            Khôi phục mặc định
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="ExportSettings" Size="Size.Small">
            Export cấu hình
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Upload"
                   OnClick="ImportSettings" Size="Size.Small">
            Import cấu hình
        </MudButton>
    </MudStack>
</MudPaper>

<div class="mx-3 settings-grid">
    <MudGrid>

        <!-- ========== CỘT TRÁI ========== -->
        <MudItem xs="12" md="6">

            <!-- MẠNG & TÍN HIỆU -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.SignalCellularAlt" Class="mr-1" Size="Size.Small" />
                    Mạng & Tín hiệu
                </MudText>

                <MudNumericField T="int" @bind-Value="_signalScanIntervalSeconds"
                                 Label="Quét sóng mỗi (giây)"
                                 Min="5" Max="300" Step="5"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Style="max-width:200px;"
                                 HelperText="Áp dụng cho AT+CSQ và kiểm tra rút SIM" />
            </MudPaper>

            <!-- SMS & USSD -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Sms" Class="mr-1" Size="Size.Small" />
                    SMS & USSD
                </MudText>

                <MudSwitch T="bool" @bind-Value="_receiveAllSms"
                           Label="Nhận tất cả SMS (kể cả không OTP)"
                           Color="Color.Primary" Class="mb-2" />
            </MudPaper>

            <!-- WHITELIST / BLACKLIST -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-1" Size="Size.Small" />
                    Lọc người gửi SMS
                </MudText>

                <MudSwitch T="bool" @bind-Value="_enableSenderBlacklist"
                           Label="Bật Blacklist (chặn người gửi)"
                           Color="Color.Error" Class="mb-1" />
                <MudTextField @bind-Value="_senderBlacklist"
                              Label="Danh sách Blacklist (phân cách dấu phẩy)"
                              Placeholder="QCBMB, spam123, 1900xxxx"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@(!_enableSenderBlacklist)"
                              Class="mb-3"
                              HelperText="VD: QCBMB, 1900xxxx — Chặn hoàn toàn tin nhắn từ số này" />

                <MudSwitch T="bool" @bind-Value="_enableSenderWhitelist"
                           Label="Bật Whitelist (chỉ nhận từ danh sách)"
                           Color="Color.Success" Class="mb-1" />
                <MudTextField @bind-Value="_senderWhitelist"
                              Label="Danh sách Whitelist (phân cách dấu phẩy)"
                              Placeholder="Vietcombank, VIB, Momo"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@(!_enableSenderWhitelist)"
                              HelperText="Chỉ nhận tin nhắn từ các số này (bỏ qua tất cả số khác)" />
            </MudPaper>

            <!-- CHUYỂN TIẾP CUỘC GỌI -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.PhoneForwarded" Class="mr-1" Size="Size.Small" />
                    Chuyển tiếp cuộc gọi
                </MudText>

                <MudSwitch T="bool" @bind-Value="_enableAutoCallForwarding"
                           Label="Tự động chuyển tiếp cuộc gọi khi có SIM"
                           Color="Color.Primary" Class="mb-1" />
                <MudText Typo="Typo.caption" Class="mb-3 ml-10" Style="color:#64748B; display:block;">
                    Tự động gửi lệnh AT+CCFC khi cắm SIM / nhận diện mạng
                </MudText>
                <MudTextField @bind-Value="_forwardPhoneNumber"
                              Label="Số điện thoại nhận chuyển tiếp"
                              HelperText="Nhiều số phân cách bằng dấu phẩy → chuyển ngẫu nhiên"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudPaper>

            <!-- API SERVER -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Api" Class="mr-1" Size="Size.Small" />
                    HTTP API Server
                </MudText>

                @* HTTP server removed; ToolWeb communicates only through Firebase.
                <MudSwitch T="bool" @bind-Value="_enableApiServer"
                           Label="Bật API Server (REST HTTP)"
                           Color="Color.Primary" Class="mb-2" />
                <MudNumericField T="int" @bind-Value="_apiServerPort"
                                 Label="Cổng API Server"
                                 Min="1024" Max="65535"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Style="max-width:160px;"
                                 Disabled="@(!_enableApiServer)"
                                 HelperText="Mặc định: 5000 → http://localhost:5000" /> *@
            </MudPaper>

        </MudItem>

        <!-- ========== CỘT PHẢI ========== -->
        <MudItem xs="12" md="6">

            <!-- THÔNG BÁO & ÂM THANH SWITCH -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mr-1" Size="Size.Small" />
                    Thông báo & Âm thanh
                </MudText>

                <MudSwitch T="bool" @bind-Value="_soundOnSms"
                           Label="Phát âm thanh khi có SMS"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_soundOnCall"
                           Label="Phát âm thanh khi có cuộc gọi"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_soundOnOtp"
                           Label="Phát âm thanh khi có OTP"
                           Color="Color.Primary" Class="mb-3" />

                <MudDivider Class="my-2" />

                <MudSwitch T="bool" @bind-Value="_telegramOnOtp"
                           Label="Gửi Telegram khi có OTP"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_telegramOnSms"
                           Label="Gửi Telegram khi có SMS thường (không OTP)"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_telegramOnCall"
                           Label="Gửi Telegram khi có cuộc gọi đến"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_telegramOnError"
                           Label="Gửi Telegram khi có lỗi hệ thống"
                           Color="Color.Primary" />
            </MudPaper>

            <!-- TELEGRAM -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Message" Class="mr-1" Size="Size.Small" />
                    Telegram Bot
                </MudText>

                <MudTextField @bind-Value="_telegramBotToken"
                              Label="Bot Token"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              InputType="@(_showToken ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showToken = !_showToken)"
                              HelperText="Lay tu BotFather tren Telegram" />

                <MudTextField @bind-Value="_telegramChatId"
                              Label="Chat ID (hoặc nhiều ID phân cách dấu phẩy)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                              HelperText="VD: -1001234567890 hoặc 123456789,987654321" />

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="TestTelegram"
                               Disabled="@(string.IsNullOrWhiteSpace(_telegramBotToken) || string.IsNullOrWhiteSpace(_telegramChatId))">
                        ✈ Test gửi tin
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                               OnClick="OpenTelegramGuide">
                        Hướng dẫn lấy Token
                    </MudButton>
                </MudStack>
            </MudPaper>

            @* Webhook removed: ToolWeb communicates only through Firebase.
            <!-- API / WEBHOOK -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Webhook" Class="mr-1" Size="Size.Small" />
                    Webhook OTP / SMS
                </MudText>

                <MudTextField @bind-Value="_otpWebhookUrl"
                              Label="Webhook URL (đẩy OTP/SMS lên Web)"
                              Placeholder="https://your-server.com/api/otp"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              HelperText="POST JSON với: event_type, port, phone, sender, otp, content, time" />

                <MudSwitch T="bool" @bind-Value="_pushOtpToWeb"
                           Label="Chỉ đẩy khi có OTP (tắt = đẩy cả SMS không OTP)"
                           Color="Color.Warning" Class="mb-3" />

                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="TestWebhook"
                           Disabled="@(string.IsNullOrWhiteSpace(_otpWebhookUrl))">
                    Test gửi Webhook
                </MudButton>
            </MudPaper>

            *@
            <!-- FIREBASE -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.CloudSync" Class="mr-1" Size="Size.Small" />
                    Firebase (Đồng bộ ToolWeb)
                </MudText>

                <MudTextField @bind-Value="_firebaseUrl"
                              Label="Firebase Database URL"
                              Placeholder="https://your-project-default-rtdb.firebaseio.com/"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Disabled="true" />
                <MudTextField @bind-Value="_machineId"
                              Label="Machine ID (Tên máy)"
                              Placeholder="machine-1"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudSwitch T="bool" @bind-Value="_writeOtpToFirebase"
                           Label="Tự động đồng bộ OTP/Ports lên Firebase"
                           Color="Color.Primary" />
            </MudPaper>

            <!-- ÂM THANH FILE -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Class="mr-1" Size="Size.Small" />
                    File âm thanh tùy chỉnh
                </MudText>

                <MudTextField @bind-Value="_soundSmsPath"
                              Label="Âm thanh SMS"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                              OnAdornmentClick="@(() => BrowseSound("sms"))"
                              HelperText="Để trống = dùng âm hệ thống" />
                <MudTextField @bind-Value="_soundCallPath"
                              Label="Âm thanh cuộc gọi"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                              OnAdornmentClick="@(() => BrowseSound("call"))"
                              HelperText="Để trống = dùng âm hệ thống" />
                <MudTextField @bind-Value="_soundOtpPath"
                              Label="Âm thanh OTP"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                              OnAdornmentClick="@(() => BrowseSound("otp"))"
                              HelperText="Để trống = dùng âm hệ thống" />

                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@(() => TestSound("sms"))">Test SMS</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@(() => TestSound("call"))">Test Call</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@(() => TestSound("otp"))">Test OTP</MudButton>
                </MudStack>
            </MudPaper>

            <!-- NÂNG CAO -->
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-1" Size="Size.Small" />
                    Nâng cao
                </MudText>

                <MudStack Row="true" Spacing="2" Class="mb-2">
                    <MudNumericField T="int" @bind-Value="_baudRate"
                                     Label="Baud rate"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Style="max-width:150px;" />
                    <MudNumericField T="int" @bind-Value="_commandTimeout"
                                     Label="Timeout AT (ms)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Style="max-width:170px;" />
                </MudStack>

                <MudSwitch T="bool" @bind-Value="_enableLog"
                           Label="Ghi log chi tiết"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_autoConnectOnStart"
                           Label="Tự Connect All khi khởi động"
                           Color="Color.Primary" Class="mb-1" />
                <MudSwitch T="bool" @bind-Value="_minimizeToTray"
                           Label="Thu nhỏ xuống tray khi đóng"
                           Color="Color.Primary" Class="mb-3" />

                <MudDivider Class="my-3" />

                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="ClearAllData">
                    Xóa toàn bộ dữ liệu tool
                </MudButton>
            </MudPaper>

        </MudItem>
    </MudGrid>
</div>

@code {
    // ========== MẠNG & TÍN HIỆU ==========
    private int _signalScanIntervalSeconds = 15;

    // ========== SMS & USSD ==========
    private bool _receiveAllSms = true;

    // ========== WHITELIST / BLACKLIST ==========
    private bool _enableSenderBlacklist = false;
    private string _senderBlacklist = "";
    private bool _enableSenderWhitelist = false;
    private string _senderWhitelist = "";

    // ========== CHUYỂN TIẾP ==========
    private bool _enableAutoCallForwarding = false;
    private string _forwardPhoneNumber = "";

    // ========== API SERVER ==========
    private bool _enableApiServer = true;
    private int _apiServerPort = 5000;

    // ========== THÔNG BÁO ==========
    private bool _soundOnSms = true;
    private bool _soundOnCall = true;
    private bool _soundOnOtp = true;
    private bool _telegramOnOtp = true;
    private bool _telegramOnSms = false;
    private bool _telegramOnCall = true;
    private bool _telegramOnError = true;

    // ========== TELEGRAM ==========
    private string _telegramBotToken = "";
    private string _telegramChatId = "";
    private bool _showToken = false;

    // ========== WEBHOOK ==========
    private string _otpWebhookUrl = "";
    private bool _pushOtpToWeb = false;

    // ========== FIREBASE ==========
    private string _firebaseUrl = "";
    private string _machineId = "machine-1";
    private bool _writeOtpToFirebase = true;

    // ========== ÂM THANH ==========
    private string _soundSmsPath = "";
    private string _soundCallPath = "";
    private string _soundOtpPath = "";

    // ========== NÂNG CAO ==========
    private int _baudRate = 115200;
    private int _commandTimeout = 10000;
    private bool _enableLog = true;
    private bool _autoConnectOnStart = false;
    private bool _minimizeToTray = true;

    // ========== NEW SIM ==========
    private bool _newSimIntake = true;
    private bool _autoAccept = false;

    // ========== LIFECYCLE ==========
    protected override void OnInitialized()
    {
        LoadSettings();
    }

    // ========== LOAD / SAVE ==========
    void LoadSettings()
    {
        try
        {
            var cfg = gsm.Services.SettingsService.Current;
            if (cfg == null) return;

            _signalScanIntervalSeconds = cfg.SignalScanIntervalSeconds;

            _receiveAllSms = cfg.ReceiveAllSms;

            _enableSenderBlacklist = cfg.EnableSenderBlacklist;
            _senderBlacklist = cfg.SenderBlacklist ?? "";
            _enableSenderWhitelist = cfg.EnableSenderWhitelist;
            _senderWhitelist = cfg.SenderWhitelist ?? "";

            _enableAutoCallForwarding = cfg.EnableAutoCallForwarding;
            _forwardPhoneNumber = cfg.ForwardPhoneNumber ?? "";

            _enableApiServer = cfg.EnableApiServer;
            _apiServerPort = cfg.ApiServerPort;

            _soundOnSms = cfg.SoundOnSms;
            _soundOnCall = cfg.SoundOnCall;
            _soundOnOtp = cfg.SoundOnOtp;
            _telegramOnOtp = cfg.TelegramOnOtp;
            _telegramOnSms = cfg.TelegramOnSms;
            _telegramOnCall = cfg.TelegramOnCall;
            _telegramOnError = cfg.TelegramOnError;

            _telegramBotToken = cfg.TelegramBotToken ?? "";
            _telegramChatId = cfg.TelegramChatId ?? "";

            _otpWebhookUrl = cfg.OtpWebhookUrl ?? "";
            _pushOtpToWeb = cfg.PushOtpToWeb;

            _firebaseUrl = gsm.Services.FirebaseService.DatabaseUrl;
            _machineId = cfg.MachineId ?? "machine-1";
            _writeOtpToFirebase = cfg.WriteOtpToFirebase;

            _soundSmsPath = cfg.SoundSmsPath ?? "";
            _soundCallPath = cfg.SoundCallPath ?? "";
            _soundOtpPath = cfg.SoundOtpPath ?? "";

            _baudRate = cfg.BaudRate;
            _commandTimeout = cfg.CommandTimeout;
            _enableLog = cfg.EnableLog;
            _autoConnectOnStart = cfg.AutoConnectOnStart;
            _minimizeToTray = cfg.MinimizeToTray;

            _newSimIntake = cfg.NewSimIntake;
            _autoAccept = cfg.AutoAccept;
        }
        catch { }
    }

    async Task SaveAll()
    {
        try
        {
            if (_signalScanIntervalSeconds is < 5 or > 300)
            {
                Snackbar.Add("Chu kỳ quét sóng phải nằm trong khoảng 5–300 giây.", Severity.Warning);
                return;
            }
            if (_enableAutoCallForwarding && string.IsNullOrWhiteSpace(_forwardPhoneNumber))
            {
                Snackbar.Add("Hãy nhập số chuyển tiếp trước khi bật chuyển tiếp cuộc gọi.", Severity.Warning);
                return;
            }

            var cfg = gsm.Services.SettingsService.Current;

            cfg.SignalScanIntervalSeconds = _signalScanIntervalSeconds;

            cfg.ReceiveAllSms = _receiveAllSms;

            cfg.EnableSenderBlacklist = _enableSenderBlacklist;
            cfg.SenderBlacklist = _senderBlacklist.Trim();
            cfg.EnableSenderWhitelist = _enableSenderWhitelist;
            cfg.SenderWhitelist = _senderWhitelist.Trim();

            cfg.EnableAutoCallForwarding = _enableAutoCallForwarding;
            cfg.ForwardPhoneNumber = _forwardPhoneNumber.Trim();

            cfg.EnableApiServer = false;
            cfg.ApiServerPort = _apiServerPort;

            cfg.SoundOnSms = _soundOnSms;
            cfg.SoundOnCall = _soundOnCall;
            cfg.SoundOnOtp = _soundOnOtp;
            cfg.TelegramOnOtp = _telegramOnOtp;
            cfg.TelegramOnSms = _telegramOnSms;
            cfg.TelegramOnCall = _telegramOnCall;
            cfg.TelegramOnError = _telegramOnError;

            cfg.TelegramBotToken = _telegramBotToken.Trim();
            cfg.TelegramChatId = _telegramChatId.Trim();
            cfg.TelegramChatIds = _telegramChatId.Trim(); // Sync cả TelegramChatIds

            cfg.OtpWebhookUrl = _otpWebhookUrl.Trim();
            cfg.PushOtpToWeb = _pushOtpToWeb;

            cfg.FirebaseUrl = gsm.Services.FirebaseService.DatabaseUrl;
            cfg.FirebaseDbUrl = gsm.Services.FirebaseService.DatabaseUrl;
            cfg.MachineId = _machineId.Trim();
            cfg.WriteOtpToFirebase = _writeOtpToFirebase;

            cfg.SoundSmsPath = _soundSmsPath.Trim();
            cfg.SoundCallPath = _soundCallPath.Trim();
            cfg.SoundOtpPath = _soundOtpPath.Trim();

            cfg.BaudRate = _baudRate;
            cfg.CommandTimeout = _commandTimeout;
            cfg.EnableLog = _enableLog;
            cfg.AutoConnectOnStart = _autoConnectOnStart;
            cfg.MinimizeToTray = _minimizeToTray;

            cfg.NewSimIntake = _newSimIntake;
            cfg.AutoAccept = _autoAccept;

            gsm.Services.SettingsService.SaveSettings(cfg);

            // Chỉ báo thành công sau khi backend đã áp dụng xong lên các cổng Active.
            await Vm.ApplySettingsAsync();

            Snackbar.Add("✓ Đã lưu tất cả cài đặt và áp dụng ngay", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi lưu: " + ex.Message, Severity.Error);
        }
    }

    void ResetDefault()
    {
        _signalScanIntervalSeconds = 15;

        _receiveAllSms = true;

        _enableSenderBlacklist = false;
        _senderBlacklist = "";
        _enableSenderWhitelist = false;
        _senderWhitelist = "";

        _enableAutoCallForwarding = false;
        _forwardPhoneNumber = "";

        _enableApiServer = true;
        _apiServerPort = 5000;

        _soundOnSms = true;
        _soundOnCall = true;
        _soundOnOtp = true;
        _telegramOnOtp = true;
        _telegramOnSms = false;
        _telegramOnCall = true;
        _telegramOnError = true;
        _telegramBotToken = "";
        _telegramChatId = "";

        _otpWebhookUrl = "";
        _pushOtpToWeb = false;

        _firebaseUrl = gsm.Services.FirebaseService.DatabaseUrl;
