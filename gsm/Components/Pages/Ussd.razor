@page "/ussd"
@page "/"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2" Elevation="0" 
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.caption" Style="color:#64748B; min-width:70px;">Mã USSD</MudText>
        <MudTextField @bind-Value="_ussdCode" Placeholder="*101#" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:160px; background:#F8FAFC;" Immediate="true" />

        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="SendSelectedOrAll" Disabled="@(string.IsNullOrEmpty(_ussdCode))">
            Thực hiện
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                   OnClick="CheckBalanceSelectedOrAll">
            Check TKC
        </MudButton>

        @{
            var pendingCount = _selectedPorts.Count(IsPendingAccept);
        }
        @if (pendingCount > 0)
        {
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="AcceptSelectedPending" Disabled="@_bulkAccepting">
                @(_bulkAccepting ? "Đang chấp nhận..." : $"CHẤP NHẬN ({pendingCount})")
            </MudButton>
        }

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Mức sóng</MudText>
        <MudSelect T="string" @bind-Value="_scanMode" Dense="true" Variant="Variant.Outlined" 
                   Margin="Margin.Dense" Style="width:100px; background:#F8FAFC;">
            <MudSelectItem Value="@("Auto")">Auto</MudSelectItem>
            <MudSelectItem Value="@("4G")">4G</MudSelectItem>
            <MudSelectItem Value="@("3G")">3G</MudSelectItem>
            <MudSelectItem Value="@("2G")">2G</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Wifi" OnClick="ApplyScanMode">
            Thay đổi
        </MudButton>

        <MudButton Variant="Variant.Filled" Size="Size.Small"
                   Style="background:#A16207; color:white;"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecoverSignal">
            Khôi phục sóng
        </MudButton>
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Link" OnClick="ConnectAll">
            Connect All
        </MudButton>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_subTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" OnAccept="HandleAcceptOne" />
    </MudTabPanel>

    <MudTabPanel Text="Tin nhắn tới">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudTable Items="@IncomingSms" Dense="true" Hover="true" Elevation="0" Height="420px">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Người gửi</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh Style="width:90px;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px; white-space:nowrap;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Sender</MudTd>
                    <MudTd Style="max-width:260px; overflow:hidden; text-overflow:ellipsis;" title="@context.Content">
                        @context.Content
                    </MudTd>
                    <MudTd Style="font-family:monospace; color:#2563EB; font-weight:600;">
                        @(context.Otp ?? "—")
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                       OnClick="@(() => CopyText(context.Content))" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteSms(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có tin nhắn tới</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Spam SMS">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Spam SMS hàng loạt</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_spamPhone" Label="Số nhận (mỗi dòng 1 số)" Lines="5"
                                  Variant="Variant.Outlined" Placeholder="0912345678&#10;0987654321" Class="mb-3" />
                    <MudTextField @bind-Value="_spamContent" Label="Nội dung" Lines="3"
                                  Variant="Variant.Outlined" Class="mb-3" />
                    <MudNumericField @bind-Value="_spamDelay" Label="Delay giữa các tin (ms)" Min="500" Max="10000"
                                     Variant="Variant.Outlined" Class="mb-3" Style="max-width:200px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Send" OnClick="StartSpamSms"
                               Disabled="@(string.IsNullOrEmpty(_spamPhone) || string.IsNullOrEmpty(_spamContent))">
                        Bắt đầu Spam
                    </MudButton>
                </MudItem>
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-3" Style="background:#F8FAFC; border-radius:8px; min-height:220px;">
                        <MudText Typo="Typo.caption" Class="mb-2">Tiến trình</MudText>
                        <pre style="font-size:12px; white-space:pre-wrap; margin:0;">@_spamLog</pre>
                        @if (_isSpamming)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="StopSpamSms" Size="Size.Small" Class="mt-2">
                                Dừng Spam
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Spam/Check Gọi">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Spam / Check cuộc gọi</MudText>
            
            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudTextField @bind-Value="_checkCallPhone" Label="Số cần check / spam" 
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:200px;" />
                <MudNumericField @bind-Value="_checkCallDuration" Label="Thời lượng (giây)" Min="5" Max="60"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCheckCall">
                    Gọi Check
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="StopAllCalls">
                    Dập tất cả
                </MudButton>
            </MudStack>

            <MudTable Items="@_callCheckHistory" Dense="true" Hover="true" Elevation="0" Height="300px">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Số gọi</MudTh>
                    <MudTh>Kết quả</MudTh>
                    <MudTh>Thời lượng</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Time.ToString("HH:mm:ss")</MudTd>
                    <MudTd>@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Success ? Color.Success : Color.Error)">
                            @context.Result
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.Duration s</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-8 text-center" Style="color:#94A3B8;">Chưa có lịch sử check gọi</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="DTMF (Call)">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">DTMF / Nhấn phím trong cuộc gọi</MudText>
            
            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudSelect T="string" Label="Cổng đang gọi" @bind-Value="_dtmfPort" 
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" Dense="true">
                    @foreach (var p in Ports.Where(x => x.Status == SimStatus.Active))
                    {
                        <MudSelectItem Value="@p.PortName">@p.PortName</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_dtmfCode" Label="Mã DTMF" Placeholder="1# hoặc 1234#"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendDtmf">
                    Gửi DTMF
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.caption" Style="color:#64748B;">
                Lưu ý: Chỉ gửi được khi cổng đang trong cuộc gọi (CLCC active).
            </MudText>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Thông báo">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Cài đặt thông báo</MudText>
            
            <MudSwitch T="bool" @bind-Value="_notifySms" Label="Thông báo khi có SMS mới" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_notifyCall" Label="Thông báo khi có cuộc gọi" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_notifyOtp" Label="Thông báo khi phát hiện OTP" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_notifyTelegram" Label="Gửi Telegram khi có OTP" Color="Color.Primary" Class="mb-3" />
            
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveNotifySettings">
                Lưu cài đặt thông báo
            </MudButton>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _ussdCode = "*101#";
    private string _scanMode = "Auto";
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab = 0;

    // Spam SMS
    private string _spamPhone = "";
    private string _spamContent = "";
    private int _spamDelay = 1500;
    private string _spamLog = "";
    private bool _isSpamming = false;
    private CancellationTokenSource? _spamCts;

    // Check Call
    private string _checkCallPhone = "";
    private int _checkCallDuration = 15;
    private List<CallCheckItem> _callCheckHistory = new();
    private bool _isCheckingCall { get; set; } = false;

    // DTMF
    private string _dtmfPort = "";
    private string _dtmfCode = "";

    async Task HandleAcceptOne(SimPort port)
    {
        try
        {
            await Vm.AcceptNewSimAsync(port.PortName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"[{port.PortName}] Accept lỗi: {ex.Message}", Severity.Error);
        }
    }

    bool _bulkAccepting = false;

    bool IsPendingAccept(SimPort p)
    {
        if (p == null) return false;
        var s = p.Status.ToString();
        var err = p.LastError?.ToLowerInvariant() ?? "";
        return s.Contains("Pending", StringComparison.OrdinalIgnoreCase)
            || s.Contains("WaitAccept", StringComparison.OrdinalIgnoreCase)
            || s.Contains("SecurityBlocked", StringComparison.OrdinalIgnoreCase)
            || err.Contains("sim_mới_chờ_chấp_nhận", StringComparison.OrdinalIgnoreCase);
    }

    async Task AcceptSelectedPending()
    {
        var list = _selectedPorts.Where(IsPendingAccept).ToList();
        if (!list.Any())
        {
            Snackbar.Add("Không có cổng nào đang Chờ Accept trong selection", Severity.Warning);
            return;
        }

        if (list.Count > 5)
        {
            var ok = await DialogService.ShowMessageBox(
                "Xác nhận",
                $"Chấp nhận SIM + tráng IMEI cho {list.Count} cổng?\nChỉ Accept khi đã chắc SIM đúng.",
                yesText: "Chấp nhận", cancelText: "Hủy");
            if (ok != true) return;
        }

        _bulkAccepting = true;
        try
        {
            await Vm.AcceptSelectedAsync(list.Select(p => p.PortName));
            Snackbar.Add($"Đã gửi lệnh chấp nhận hàng loạt cho {list.Count} cổng.", Severity.Success);
        }
        finally
        {
            _bulkAccepting = false;
        }
    }

    // Notify
    private bool _notifySms = true;
    private bool _notifyCall = true;
    private bool _notifyOtp = true;
    private bool _notifyTelegram = false;

    // Incoming SMS (bind từ Vm nếu có)
    private List<IncomingSmsItem> IncomingSms => 
        Vm.SmsMessages?
            .Select(x => new IncomingSmsItem
            {
                Time = DateTime.TryParse(x.ReceivedTime, out var t) ? t : DateTime.Now,
                Port = x.PortName,
                Sender = x.Sender,
                Content = x.Content,
                Otp = x.Otp,
                OriginalMessage = x
            }).OrderByDescending(x => x.Time).Take(200).ToList()
        ?? new();

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private List<SimPort> FilteredPorts => Ports;
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
        var settings = gsm.Services.SettingsService.Current;
        if (settings != null)
        {
            _notifySms = settings.SoundOnSms;
            _notifyCall = settings.SoundOnCall;
            _notifyOtp = settings.SoundOnOtp;
            _notifyTelegram = settings.TelegramOnOtp;
        }
    }

    // =====================================================
    // 1. GỬI USSD (1 / Selected / All) – ĐÃ TỐT
    // =====================================================
    async Task SendSelectedOrAll()
    {
        if (string.IsNullOrWhiteSpace(_ussdCode)) return;

        var targets = _selectedPorts.Any()
            ? _selectedPorts.Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng nào để gửi USSD", Severity.Warning);
            return;
        }

        var confirm = targets.Count > 5
            ? await DialogService.ShowMessageBox("Xác nhận", 
                $"Gửi USSD \"{_ussdCode}\" tới {targets.Count} cổng?", 
                yesText: "Gửi", cancelText: "Hủy")
            : true;

        if (confirm != true) return;

        Snackbar.Add($"Đang gửi USSD tới {targets.Count} cổng...", Severity.Info);

        int ok = 0, fail = 0;
        foreach (var port in targets)
        {
            try
            {
                var resp = await ModemService.SendCommandAsync(port, $"AT+CUSD=1,\"{_ussdCode}\",15", 20000);
                ok++;
                Snackbar.Add($"[{port}] OK", Severity.Success);
            }
            catch (Exception ex)
            {
                fail++;
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }
            await Task.Delay(700);
        }

        Snackbar.Add($"Hoàn tất USSD: {ok} thành công, {fail} lỗi", 
            fail == 0 ? Severity.Success : Severity.Warning);
    }

    // =====================================================
    // 2. THAY ĐỔI MỨC SÓNG (ApplyScanMode) – FIX THẬT
    // =====================================================
    async Task ApplyScanMode()
    {
        var targets = _selectedPorts.Any()
            ? _selectedPorts.Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        // Map mode → AT command Quectel EC20
        // nwscanmode: 0=Auto, 1=GSM, 2=WCDMA, 3=LTE
        // nwscanseq: 00=Auto, 020301=2G→3G→4G, 030201=4G→3G→2G
        string nwscanmode = _scanMode switch
        {
            "2G" => "1",
            "3G" => "2",
            "4G" => "3",
            _    => "0"   // Auto
        };

        string nwscanseq = _scanMode switch
        {
            "2G" => "010203",
            "3G" => "020103",
            "4G" => "030201",
            _    => "030201" // ưu tiên 4G→3G→2G
        };

        Snackbar.Add($"Đang áp dụng mức sóng {_scanMode} cho {targets.Count} cổng...", Severity.Info);

        foreach (var port in targets)
        {
            try
            {
                await ModemService.SendCommandAsync(port, $"AT+QCFG=\"nwscanmode\",{nwscanmode}", 5000);
                await ModemService.SendCommandAsync(port, $"AT+QCFG=\"nwscanseq\",{nwscanseq}", 5000);
                // Ép radio on
                await ModemService.SendCommandAsync(port, "AT+CFUN=1", 8000);
                Snackbar.Add($"[{port}] Đã set {_scanMode}", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"[{port}] Lỗi set sóng: {ex.Message}", Severity.Error);
            }
            await Task.Delay(400);
        }
    }

    // =====================================================
    // 3. KHÔI PHỤC SÓNG (RecoverSignal) – FIX THẬT
    // =====================================================
    async Task RecoverSignal()
    {
        var targets = _selectedPorts.Any()
            ? _selectedPorts.Select(p => p.PortName).ToList()
            : Ports.Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng", Severity.Warning);
            return;
        }

        Snackbar.Add($"Đang khôi phục sóng {targets.Count} cổng...", Severity.Info);

        foreach (var port in targets)
        {
            try
            {
                // 1. Force full functionality
                await ModemService.SendCommandAsync(port, "AT+CFUN=1,1", 12000); // soft reset radio
                await Task.Delay(1500);

                // 2. Re-apply scan (ưu tiên 4G)
                await ModemService.SendCommandAsync(port, "AT+QCFG=\"nwscanmode\",0", 4000);
                await ModemService.SendCommandAsync(port, "AT+QCFG=\"nwscanseq\",030201", 4000);

                // 3. Auto register
                await ModemService.SendCommandAsync(port, "AT+COPS=0", 8000);

                // 4. Check signal
                var csq = await ModemService.SendCommandAsync(port, "AT+CSQ", 3000);
                Snackbar.Add($"[{port}] Recover xong • CSQ: {csq}", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"[{port}] Recover lỗi: {ex.Message}", Severity.Error);
            }
            await Task.Delay(800);
        }
    }

    // =====================================================
    // 4. CONNECT ALL
    // =====================================================
    async Task ConnectAll()
    {
        Snackbar.Add("Đang Connect All...", Severity.Info);
        try
        {
            string result = ModemService.ConnectAll(115200);
            Snackbar.Add(result, result.Contains("Lỗi") ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Connect All lỗi: " + ex.Message, Severity.Error);
        }
    }

    // =====================================================
    // 5. CHECK TKC (thêm nút nếu cần)
    // =====================================================
    async Task CheckBalanceSelectedOrAll()
    {
        var targets = _selectedPorts.Any()
            ? _selectedPorts.Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng", Severity.Warning);
            return;
        }

        Snackbar.Add($"Đang check TKC {targets.Count} cổng...", Severity.Info);

        foreach (var port in targets)
        {
            try
            {
                await Vm.CheckBalanceForPortAsync(port);
                Snackbar.Add($"[{port}] Đã gửi *101#", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }
            await Task.Delay(900);
        }
    }

    // =====================================================
    // 6. SPAM SMS – FIX THẬT
    // =====================================================
    async Task StartSpamSms()
    {
        if (string.IsNullOrWhiteSpace(_spamPhone) || string.IsNullOrWhiteSpace(_spamContent))
        {
            Snackbar.Add("Nhập số và nội dung", Severity.Warning);
            return;
        }

        var phones = _spamPhone.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                               .Select(x => x.Trim()).Where(x => x.Length >= 9).ToList();

        if (!phones.Any())
        {
            Snackbar.Add("Không có số hợp lệ", Severity.Warning);
            return;
        }

        var ports = _selectedPorts.Any()
            ? _selectedPorts.Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        _isSpamming = true;
        _spamCts = new CancellationTokenSource();
        _spamLog = $"[{DateTime.Now:HH:mm:ss}] Bắt đầu spam {phones.Count} số × {ports.Count} cổng\n";

        int sent = 0, fail = 0;
        try
        {
            foreach (var phone in phones)
            {
                if (_spamCts.Token.IsCancellationRequested) break;

                foreach (var port in ports)
                {
                    if (_spamCts.Token.IsCancellationRequested) break;

                    try
                    {
                        var res = await ModemService.SendSmsAsync(port, phone, _spamContent);
                        if (res.Contains("ERROR"))
                        {
                            fail++;
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} LỖI: {res}\n";
                        }
                        else
                        {
                            sent++;
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} OK\n";
                        }
                    }
                    catch (Exception ex)
                    {
                        fail++;
                        _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} LỖI: {ex.Message}\n";
                    }
                    StateHasChanged();
                    await Task.Delay(_spamDelay, _spamCts.Token);
                }
            }
        }
        catch (TaskCanceledException) { }

        _isSpamming = false;
        _spamLog += $"\n[{DateTime.Now:HH:mm:ss}] Xong • Gửi: {sent} • Lỗi: {fail}\n";
        Snackbar.Add($"Spam xong: {sent} OK, {fail} lỗi", fail == 0 ? Severity.Success : Severity.Warning);
    }

    void StopSpamSms()
    {
        _spamCts?.Cancel();
        _isSpamming = false;
        Snackbar.Add("Đã dừng spam", Severity.Normal);
    }

    // =====================================================
    // 7. SPAM / CHECK GỌI – FIX THẬT
    // =====================================================
    async Task StartCheckCall()
    {
        if (string.IsNullOrWhiteSpace(_checkCallPhone))
        {
            Snackbar.Add("Nhập số điện thoại", Severity.Warning);
            return;
        }

        var ports = _selectedPorts.Any()
            ? _selectedPorts.Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng", Severity.Warning);
            return;
        }

        _isCheckingCall = true;
        Snackbar.Add($"Đang check gọi {_checkCallPhone} trên {ports.Count} cổng...", Severity.Info);

        foreach (var port in ports)
        {
            try
            {
                // Gọi
                var resp = await ModemService.SendCommandAsync(port, $"ATD{_checkCallPhone};", 10000);
                if (resp.Contains("ERROR") || resp.Contains("NO CARRIER") || resp.Contains("NO DIALTONE") || resp.Contains("BUSY"))
                {
                    _callCheckHistory.Insert(0, new CallCheckItem
                    {
                        Time = DateTime.Now,
                        Port = port,
                        Phone = _checkCallPhone,
                        Duration = 0,
                        Success = false,
                        Result = resp.Trim()
                    });
                    Snackbar.Add($"[{port}] Lỗi gọi: {resp.Trim()}", Severity.Error);
                }
                else
                {
                    await Task.Delay(_checkCallDuration * 1000);

                    // Dập
                    await ModemService.SendCommandAsync(port, "ATH", 3000);

                    _callCheckHistory.Insert(0, new CallCheckItem
                    {
                        Time = DateTime.Now,
                        Port = port,
                        Phone = _checkCallPhone,
                        Duration = _checkCallDuration,
                        Success = true,
                        Result = "OK"
                    });
                    Snackbar.Add($"[{port}] Check gọi xong", Severity.Success);
                }
            }
            catch (Exception ex)
            {
                _callCheckHistory.Insert(0, new CallCheckItem
                {
                    Time = DateTime.Now,
                    Port = port,
                    Phone = _checkCallPhone,
                    Duration = 0,
                    Success = false,
                    Result = ex.Message
                });
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }
            await Task.Delay(800);
        }

        _isCheckingCall = false;
        if (_callCheckHistory.Count > 100) _callCheckHistory.RemoveRange(100, _callCheckHistory.Count - 100);
    }

    async Task StopAllCalls()
    {
        foreach (var p in Ports)
        {
            try { await ModemService.SendCommandAsync(p.PortName, "ATH", 2000); } catch { }
        }
        _isCheckingCall = false;
        Snackbar.Add("Đã dập tất cả cuộc gọi", Severity.Success);
    }

    // =====================================================
    // 8. DTMF – FIX THẬT
    // =====================================================
    async Task SendDtmf()
    {
        if (string.IsNullOrWhiteSpace(_dtmfPort) || string.IsNullOrWhiteSpace(_dtmfCode))
        {
            Snackbar.Add("Chọn cổng và nhập mã DTMF", Severity.Warning);
            return;
        }

        try
        {
            // Quectel: AT+VTS=<tones>
            // hoặc AT+QVTS=...
            var cmd = $"AT+VTS=\"{_dtmfCode}\"";
            var resp = await ModemService.SendCommandAsync(_dtmfPort, cmd, 8000);
            Snackbar.Add($"[{_dtmfPort}] Đã gửi DTMF {_dtmfCode}", Severity.Success);
        }
        catch (Exception ex)
        {
            // Fallback
            try
            {
                await ModemService.SendCommandAsync(_dtmfPort, $"AT+QVTS=\"{_dtmfCode}\"", 8000);
                Snackbar.Add($"[{_dtmfPort}] DTMF (QVTS) OK", Severity.Success);
            }
            catch
            {
                Snackbar.Add($"DTMF lỗi: {ex.Message}", Severity.Error);
            }
        }
    }

    // =====================================================
    // 9. THÔNG BÁO – FIX LƯU THẬT
    // =====================================================
    async Task SaveNotifySettings()
    {
        try
        {
            var settings = gsm.Services.SettingsService.Current;
            if (settings != null)
            {
                settings.SoundOnSms = _notifySms;
                settings.SoundOnCall = _notifyCall;
                settings.SoundOnOtp = _notifyOtp;
                settings.TelegramOnOtp = _notifyTelegram;
                
                gsm.Services.SettingsService.SaveSettings(settings);
                Snackbar.Add("Đã lưu cài đặt thông báo", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi lưu: " + ex.Message, Severity.Error);
        }
    }

    // =====================================================
    // HELPERS
    // =====================================================
    async Task CopyText(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("clipboardCopy.copyText", text);
            Snackbar.Add("Đã copy vào Clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Copy thất bại", Severity.Warning);
        }
    }

    void DeleteSms(IncomingSmsItem item)
    {
        if (item.OriginalMessage != null)
        {
            Vm.SmsMessages.Remove(item.OriginalMessage);
            Snackbar.Add("Đã xóa", Severity.Normal);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _spamCts?.Cancel();
        _spamCts?.Dispose();
    }

    // ========== MODELS ==========
    public class IncomingSmsItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Sender { get; set; } = "";
        public string Content { get; set; } = "";
        public string? Otp { get; set; }
        public SmsMessage? OriginalMessage { get; set; }
    }

    public class CallCheckItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Phone { get; set; } = "";
        public int Duration { get; set; }
        public bool Success { get; set; }
        public string Result { get; set; } = "";
    }
}
