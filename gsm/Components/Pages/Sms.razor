@page "/sms"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_phone"
                          Label="Số điện thoại nhận"
                          Placeholder="900 / 888 / số điện thoại (mỗi dòng 1 đích)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_message"
                          Label="Nội dung tin nhắn"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudStack Spacing="1">
                <MudSelect T="string" @bind-Value="_sendMode" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Label="Gửi tới" FullWidth="true">
                    <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
                    <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
                </MudSelect>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Send" OnClick="SendNow"
                               Disabled="@(string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message) || _isSending)"
                               FullWidth="true">
                        @(_isSending ? "Đang gửi..." : "Gửi ngay")
                    </MudButton>
                    @if (_isSending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error" Size="Size.Small"
                                       OnClick="StopImmediateSend" title="Dừng lệnh gửi ngay" />
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="AddToQueue"
                               Disabled="@(string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))"
                               FullWidth="true">
                        + Queue
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         PanelClass="pa-0" Class="mx-3 mt-1 feature-tabs"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_smsSubTab">

    <!-- TAB 1: DANH SÁCH CỔNG -->
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <!-- TAB 2: TIN NHẮN TỚI -->
    <MudTabPanel Text="@($"Tin nhắn tới ({IncomingSmsCount})")">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">
                    Lịch sử tin nhắn nhận được
                </MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportSmsHistory"
                               Disabled="@(!IncomingSms.Any())">
                        Xuất CSV
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearHistory"
                               Disabled="@(!IncomingSms.Any())">
                        Xóa tất cả
                    </MudButton>
                </MudStack>
            </MudStack>
            <MudTable Items="@IncomingSms" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 280px)" FixedHeader="true" Filter="FilterSms">
                <ToolBarContent>
                    <MudTextField @bind-Value="_smsFilter" Placeholder="Lọc theo số/nội dung..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Style="max-width:280px;" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SIM nhận</MudTh>
                    <MudTh>Người gửi</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh Style="width:100px;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:16px; white-space:nowrap;">@context.ReceivedTime</MudTd>
                    <MudTd Style="font-weight:600;">@context.PortName</MudTd>
                    <MudTd Style="font-size:16px; white-space:nowrap;">
                        <div style="font-weight:600; color:#0F172A;">@GetReceiverDisplay(context)</div>
                        @if (!string.IsNullOrWhiteSpace(context.NetworkProvider))
                        {
                            <div style="font-size:12px; color:#64748B;">@context.NetworkProvider</div>
                        }
                    </MudTd>
                    <MudTd Style="font-size:16px;">@context.Sender</MudTd>
                    <MudTd Style="font-size:16px; white-space:nowrap;"
                           title="@context.Content">
                        @context.Content
                    </MudTd>
                    <MudTd Style="font-size:16px; font-family:monospace; color:#2563EB; font-weight:600;">
                        @(context.Otp ?? "—")
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                       OnClick="@(() => CopyText(context.Content))" title="Copy nội dung" />
                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => ResendSms(context))" title="Gửi lại" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteSms(context))" title="Xóa" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có tin nhắn tới</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 3: HÀNG ĐỢI GỬI -->
    <MudTabPanel Text="@($"Hàng đợi ({SmsQueueCount} lệnh, {SmsQueuePendingCount} chờ)")">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2" AlignItems="AlignItems.Center">
                @if (!_isRunningQueue)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunQueue"
                               Disabled="@(SmsQueuePendingCount == 0)">
                        ▶ Chạy hàng đợi
                    </MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Stop" OnClick="StopQueue">
                        ⏹ Dừng
                    </MudButton>
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetFailedQueue"
                           Disabled="@_isRunningQueue">
                    Reset lỗi → Chờ
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearQueue"
                           Disabled="@_isRunningQueue">
                    Xóa tất cả
                </MudButton>
                <MudSpacer />
                @if (_isRunningQueue)
                {
                    <MudText Typo="Typo.caption" Style="color:#64748B;">
                        Đang xử lý... còn @SmsQueuePendingCount tin chờ
                    </MudText>
                }
            </MudStack>
            <MudTable Items="@SmsQueue" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 280px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Nguồn</MudTh>
                    <MudTh>Mã yêu cầu</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT SIM</MudTh>
                    <MudTh>Đầu số</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Kết quả</MudTh>
                    <MudTh Style="width:60px;">Thời gian</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Source == "Firebase" ? Color.Secondary : Color.Default)">
                            @(string.IsNullOrWhiteSpace(context.Source) ? "Tool" : context.Source)
                        </MudChip>
                    </MudTd>
                    <MudTd Style="font-family:monospace; font-size:11px; white-space:nowrap;"
                           title="@context.CommandId">@ShortCommandId(context.CommandId)</MudTd>
                    <MudTd Style="font-weight:600;">@context.PortId</MudTd>
                    <MudTd Style="white-space:nowrap; font-weight:600;">@GetQueueSimPhone(context.PortId)</MudTd>
                    <MudTd>@context.Recipient</MudTd>
                    <MudTd Style="font-family:monospace; font-weight:700; color:#D97706; white-space:nowrap;">
                        @GetQueueOtp(context.PortId)
                    </MudTd>
                    <MudTd Style="white-space:nowrap;"
                           title="@context.Content">@context.Content</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetQueueStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd Style="font-size:11px; color:#475569;" title="@GetQueueResult(context)">
                        @GetQueueResult(context)
                    </MudTd>
                    <MudTd Style="font-size:11px; white-space:nowrap;">@context.UpdatedAt</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-10 text-center" Style="color:#94A3B8;">Hàng đợi trống</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 4: MẪU TIN NHẮN -->
    <MudTabPanel Text="Mẫu tin nhắn">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Quản lý mẫu tin nhắn</MudText>
            <MudStack Row="true" Class="mb-3" Spacing="2" AlignItems="AlignItems.End">
                <MudTextField @bind-Value="_newTemplate"
                              Label="Nội dung mẫu mới"
                              Placeholder="Nhập nội dung mẫu..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="flex:1;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTemplate"
                           Size="Size.Small"
                           Disabled="@string.IsNullOrWhiteSpace(_newTemplate)">
                    + Thêm mẫu
                </MudButton>
            </MudStack>

            @if (!_templates.Any())
            {
                <MudText Style="color:#94A3B8; font-size:13px;">Chưa có mẫu nào. Thêm mẫu bên trên.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var tpl in _templates.ToList())
                    {
                        <MudListItem>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                                <MudText Style="flex:1; font-size:13px; word-break:break-word;">@tpl</MudText>
                                <MudTooltip Text="Copy nội dung">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   OnClick="@(() => CopyText(tpl))" />
                                </MudTooltip>
                                <MudTooltip Text="Nạp vào form gửi">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => UseTemplate(tpl))" />
                                </MudTooltip>
                                <MudTooltip Text="Xóa mẫu">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveTemplate(tpl))" />
                                </MudTooltip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Style="color:#64748B;">
                💡 Biến hỗ trợ trong mẫu: <code>{port}</code> · <code>{phone}</code> · <code>{otp}</code> · <code>{time}</code>
            </MudText>
        </MudPaper>
    </MudTabPanel>

</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _phone = "";
    private string _message = "";
    private string _sendMode = "selected";   // "selected" | "all"
    private string _smsFilter = "";
    private HashSet<SimPort> _selectedPorts = new();
    private int _smsSubTab = 0;
    private bool _isSending = false;
    private CancellationTokenSource? _sendCts;

    // Mẫu tin nhắn
    private string _newTemplate = "";
    private List<string> _templates = new()
    {
        "Ma OTP cua ban la: {otp}",
        "Xin chao, tai khoan cua ban da duoc kich hoat.",
        "Vui long nap them tien de tiep tuc su dung dich vu."
    };

    // Queue
    private bool _isRunningQueue = false;
    private CancellationTokenSource? _queueCts;

    // ========== DATA ==========
    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);
    private List<SimPort> FilteredPorts => Ports;

    private IEnumerable<SmsMessage> IncomingSms =>
        (Vm.SmsMessages ?? Enumerable.Empty<SmsMessage>())
            .OrderByDescending(x => DateTime.TryParse(x.ReceivedTime, out var t) ? t : DateTime.MinValue);

    private int IncomingSmsCount => Vm.SmsMessages?.Count ?? 0;

    private IEnumerable<CommandQueueItem> SmsQueue =>
        (Vm.CommandQueue ?? Enumerable.Empty<CommandQueueItem>())
            .Where(x => string.Equals(x.Type, "SMS", StringComparison.OrdinalIgnoreCase)
                     || string.IsNullOrEmpty(x.Type));

    private int SmsQueueCount => SmsQueue.Count();

    private int SmsQueuePendingCount =>
        SmsQueue.Count(x => x.Status == "Chờ" || x.Status == "Pending" || string.IsNullOrEmpty(x.Status));

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    // ========== HELPERS ==========
    /// <summary>Lấy danh sách portName theo chế độ gửi được chọn.</summary>
    List<string> GetTargetPorts()
    {
        if (_sendMode == "all")
            return ActivePorts.Select(p => p.PortName).ToList();

        // "selected" means exactly the checked Active ports.
        if (_selectedPorts.Any())
            return _selectedPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();

        // SMS can incur charges: selected mode must never silently fall back to all ports.
        return new List<string>();
    }

    List<string> ParsePhones() => _phone
        .Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => GsmDestination.TryNormalizeSms(x, out string destination) ? destination : "")
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    static bool IsSmsSuccess(string? result) =>
        !string.IsNullOrWhiteSpace(result)
        && (result.Contains("thành công", StringComparison.OrdinalIgnoreCase)
            || result.Contains("+CMGS:", StringComparison.OrdinalIgnoreCase)
            || result.StartsWith("OK", StringComparison.OrdinalIgnoreCase));

    Color GetQueueStatusColor(string status) => status?.Trim().ToLowerInvariant() switch
    {
        "xong" or "done" or "success" or "otp_received" => Color.Success,
        "lỗi" or "failed" or "timeout" => Color.Error,
        "đang gửi" or "running" or "sent" or "maybe_sent" => Color.Info,
        "chờ" or "pending" or "queued" => Color.Warning,
        _ => Color.Default
    };

    static string ShortCommandId(string commandId) =>
        string.IsNullOrWhiteSpace(commandId) || commandId.Length <= 14
            ? commandId
            : commandId[..14] + "…";

    string GetQueueSimPhone(string portId)
    {
        var phone = Ports.FirstOrDefault(p =>
            string.Equals(p.PortName, portId, StringComparison.OrdinalIgnoreCase))?.PhoneNumber;
        return string.IsNullOrWhiteSpace(phone) ? "Trống" : phone;
    }

    string GetQueueOtp(string portId)
    {
        var otp = Ports.FirstOrDefault(p =>
            string.Equals(p.PortName, portId, StringComparison.OrdinalIgnoreCase))?.Otp;
        return string.IsNullOrWhiteSpace(otp) || otp == "N/A" ? "—" : otp;
    }

    static string GetQueueResult(CommandQueueItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Error)) return item.Result;
        if (string.IsNullOrWhiteSpace(item.Result)) return "Lỗi: " + item.Error;
        return $"{item.Result} | Lỗi: {item.Error}";
    }

    bool FilterSms(SmsMessage sms)
    {
        if (string.IsNullOrWhiteSpace(_smsFilter)) return true;
        string f = _smsFilter.ToLowerInvariant();
        return (sms.Sender?.ToLowerInvariant().Contains(f) == true)
            || (sms.ReceiverPhone?.ToLowerInvariant().Contains(f) == true)
            || (sms.Content?.ToLowerInvariant().Contains(f) == true)
            || (sms.PortName?.ToLowerInvariant().Contains(f) == true)
            || (sms.Otp?.Contains(f) == true);
    }

    static string GetReceiverDisplay(SmsMessage sms) =>
        string.IsNullOrWhiteSpace(sms.ReceiverPhone) ? sms.PortName : sms.ReceiverPhone;

    // ========== 2. GỬI NGAY ==========
    async Task SendNow()
    {
        if (string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))
        {
            Snackbar.Add("Nhập số điện thoại và nội dung", Severity.Warning);
            return;
        }

        var phones = ParsePhones();

        if (!phones.Any())
        {
            Snackbar.Add("Không có địa chỉ nhận hợp lệ", Severity.Warning);
            return;
        }

        var ports = GetTargetPorts();
        if (!ports.Any())
        {
            Snackbar.Add(_sendMode == "selected"
                ? "Hãy chọn ít nhất một cổng Active"
                : "Không có cổng Active", Severity.Warning);
            return;
        }

        int totalSms = ports.Count * phones.Count;
        if (totalSms > 20)
        {
            var ok = await DialogService.ShowMessageBox("Xác nhận",
                $"Gửi {phones.Count} số × {ports.Count} cổng = {totalSms} SMS?",
                yesText: "Gửi ngay", cancelText: "Hủy");
            if (ok != true) return;
        }

        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();
        CancellationToken token = _sendCts.Token;
        _isSending = true;
        int sent = 0, fail = 0;
        Snackbar.Add($"Đang gửi song song {totalSms} SMS trên {ports.Count} cổng...", Severity.Info);

        async Task SendForPortAsync(string port)
        {
            foreach (var phone in phones)
            {
                if (token.IsCancellationRequested) break;

                string commandId = Guid.NewGuid().ToString("N")[..12];
                if (!Vm.IsPortReadyForOperation(port))
                {
                    Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message,
                        "Lỗi", "Cổng không còn Active hoặc SIM đã thay đổi");
                    Interlocked.Increment(ref fail);
                    continue;
                }

                Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message, "Đang gửi", "Đang xử lý...");
                await InvokeAsync(StateHasChanged);
                try
                {
                    string res = await Vm.QueueSmsAsync(port, phone, _message, token);
                    if (token.IsCancellationRequested && res.Contains("cancel", StringComparison.OrdinalIgnoreCase))
                    {
                        Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message, "Chờ", "Đã dừng");
                        break;
                    }
                    if (IsSmsSuccess(res))
                    {
                        Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message, "Xong", res.Trim());
                        Interlocked.Increment(ref sent);
                    }
                    else
                    {
                        Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message, "Lỗi", res?.Trim() ?? "Không có phản hồi");
                        Interlocked.Increment(ref fail);
                    }
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested)
                {
                    Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message, "Chờ", "Đã dừng");
                    break;
                }
                catch (Exception ex)
                {
                    Vm.UpsertCommandQueue(commandId, port, "SMS", phone, _message, "Lỗi", ex.Message);
                    Interlocked.Increment(ref fail);
                }

                await InvokeAsync(StateHasChanged);
                try { await Task.Delay(600, token); }
                catch (OperationCanceledException) { break; }
            }
        }

        try
        {
            await Task.WhenAll(ports.Select(SendForPortAsync));
        }
        finally
        {
            bool cancelled = token.IsCancellationRequested;
            _isSending = false;
            _sendCts?.Dispose();
            _sendCts = null;
            Snackbar.Add(cancelled
                    ? $"Đã dừng gửi: {sent} thành công, {fail} lỗi"
                    : $"Hoàn tất: {sent} thành công, {fail} lỗi",
                fail == 0 ? Severity.Success : Severity.Warning);
            StateHasChanged();
        }
    }

    void StopImmediateSend()
    {
        _sendCts?.Cancel();
        Snackbar.Add("Đang dừng các lệnh gửi SMS...", Severity.Info);
    }

    // ========== 3. THÊM VÀO HÀNG ĐỢI ==========
    void AddToQueue()
    {
        if (string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))
        {
            Snackbar.Add("Nhập số và nội dung", Severity.Warning);
            return;
        }

        var phones = ParsePhones();

        var ports = GetTargetPorts();

        if (!ports.Any() || !phones.Any())
        {
            Snackbar.Add("Thiếu cổng Active hoặc số hợp lệ", Severity.Warning);
            return;
        }

        int added = 0;
        foreach (var port in ports)
        {
            foreach (var phone in phones)
            {
                // Thêm vào CommandQueue qua UpsertCommandQueue để đảm bảo đúng format
                string cmdId = Guid.NewGuid().ToString("N")[..12];
                Vm.UpsertCommandQueue(cmdId, port, "SMS", phone, _message, "Chờ");
                added++;
            }
        }

        Snackbar.Add($"Đã thêm {added} tin vào hàng đợi", Severity.Success);
        _smsSubTab = 2; // chuyển sang tab Hàng đợi
        StateHasChanged();
    }

    // ========== 4. CHẠY HÀNG ĐỢI ==========
    async Task RunQueue()
    {
        if (_isRunningQueue) return;

        var queue = SmsQueue
            .Where(x => x.Status == "Chờ" || x.Status == "Pending" || string.IsNullOrEmpty(x.Status))
            .Reverse()
            .ToList();

        if (!queue.Any())
        {
            Snackbar.Add("Hàng đợi không có tin nào đang chờ", Severity.Warning);
            return;
        }

        _queueCts?.Cancel();
        _queueCts?.Dispose();
        _queueCts = new CancellationTokenSource();
        CancellationToken token = _queueCts.Token;
        _isRunningQueue = true;

        int ok = 0, fail = 0;

        async Task RunPortQueueAsync(IEnumerable<CommandQueueItem> portItems)
        {
            foreach (var item in portItems)
            {
                if (token.IsCancellationRequested) break;

                if (!Vm.IsPortReadyForOperation(item.PortId))
                {
                    Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                        item.Recipient, item.Content, "Lỗi", "Cổng không còn Active hoặc SIM đã thay đổi");
                    Interlocked.Increment(ref fail);
                    continue;
                }

                Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                    item.Recipient, item.Content, "Đang gửi", "Đang xử lý...");
                await InvokeAsync(StateHasChanged);

                try
                {
                    string res = await Vm.QueueSmsAsync(item.PortId, item.Recipient, item.Content, token);

                    if (token.IsCancellationRequested && res.Contains("cancel", StringComparison.OrdinalIgnoreCase))
                    {
                        Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                            item.Recipient, item.Content, "Chờ", "Đã dừng");
                        break;
                    }
                    if (IsSmsSuccess(res))
                    {
                        Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                            item.Recipient, item.Content, "Xong", res.Trim());
                        Interlocked.Increment(ref ok);
                    }
                    else
                    {
                        Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                            item.Recipient, item.Content, "Lỗi", res?.Trim() ?? "Không có phản hồi");
                        Interlocked.Increment(ref fail);
                    }
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested)
                {
                    Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                        item.Recipient, item.Content, "Chờ", "Đã dừng");
                    break;
                }
                catch (Exception ex)
                {
                    Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                        item.Recipient, item.Content, "Lỗi", ex.Message);
                    Interlocked.Increment(ref fail);
                }

                await InvokeAsync(StateHasChanged);
                try { await Task.Delay(800, token); }
                catch (OperationCanceledException) { break; }
            }
        }

        try
        {
            // Different COMs run concurrently; messages on the same COM stay sequential.
            var groups = queue.GroupBy(item => item.PortId, StringComparer.OrdinalIgnoreCase);
            await Task.WhenAll(groups.Select(RunPortQueueAsync));
        }
        finally
        {
            bool cancelled = token.IsCancellationRequested;
            _isRunningQueue = false;
            _queueCts?.Dispose();
            _queueCts = null;
            int waiting = SmsQueuePendingCount;
            Snackbar.Add(cancelled
                    ? $"Đã dừng hàng đợi: {ok} thành công, {fail} lỗi, {waiting} còn chờ"
                    : $"Hàng đợi xong: {ok} thành công, {fail} lỗi",
                fail == 0 ? Severity.Success : Severity.Warning);
            StateHasChanged();
        }
    }

    void StopQueue()
    {
        _queueCts?.Cancel();
        Snackbar.Add("Đang dừng hàng đợi...", Severity.Info);
    }

    // ========== 5. RESET FAILED → CHỜ ==========
    void ResetFailedQueue()
    {
        var failedItems = SmsQueue.Where(x => x.Status == "Lỗi").ToList();
        if (!failedItems.Any())
        {
            Snackbar.Add("Không có tin nào bị lỗi trong hàng đợi", Severity.Info);
            return;
        }
        foreach (var item in failedItems)
        {
            Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                item.Recipient, item.Content, "Chờ", "");
        }
        Snackbar.Add($"Đã reset {failedItems.Count} tin lỗi → Chờ", Severity.Success);
    }

    // ========== 6. XÓA HÀNG ĐỢI ==========
    async Task ClearQueue()
    {
        int count = SmsQueue.Count();
        if (count == 0) return;

        var ok = await DialogService.ShowMessageBox("Xác nhận",
            $"Xóa {count} tin trong hàng đợi?", yesText: "Xóa", cancelText: "Hủy");
        if (ok != true) return;

        var toRemove = SmsQueue.ToList();
        foreach (var item in toRemove)
            Vm.CommandQueue?.Remove(item);

        Snackbar.Add($"Đã xóa {count} tin", Severity.Success);
    }

    // ========== 7. RESEND TỪ LỊCH SỬ ==========
    async Task ResendSms(SmsMessage sms)
    {
        if (string.IsNullOrEmpty(sms.Sender) || string.IsNullOrEmpty(sms.Content))
        {
            Snackbar.Add("Thiếu số hoặc nội dung để gửi lại", Severity.Warning);
            return;
        }

        // Reply from the original SIM only. Falling back to another COM can expose
        // the wrong phone number and charge a different subscriber.
        string? port = !string.IsNullOrEmpty(sms.PortName)
                       && Vm.IsPortReadyForOperation(sms.PortName)
            ? sms.PortName
            : null;

        if (string.IsNullOrEmpty(port))
        {
            Snackbar.Add($"Cổng gốc {sms.PortName} không còn sẵn sàng để gửi lại", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox("Xác nhận gửi lại",
            $"Gửi lại SMS từ {port} tới {sms.Sender}?", yesText: "Gửi", cancelText: "Hủy");
        if (confirmed != true) return;

        string commandId = Guid.NewGuid().ToString("N")[..12];
        Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Đang gửi", "Đang xử lý...");
        try
        {
            string res = await Vm.QueueSmsAsync(port, sms.Sender, sms.Content);
            if (!IsSmsSuccess(res))
            {
                string error = res?.Trim() ?? "Không có phản hồi";
                Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Lỗi", error);
                Snackbar.Add($"[{port}] Gửi lại lỗi: {error}", Severity.Error);
            }
            else
            {
                Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Xong", res.Trim());
                Snackbar.Add($"[{port}] ✓ Đã gửi lại tới {sms.Sender}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Lỗi", ex.Message);
            Snackbar.Add("Gửi lại lỗi: " + ex.Message, Severity.Error);
        }
    }

    // ========== 8. MẪU TIN NHẮN ==========
    void AddTemplate()
    {
        if (string.IsNullOrWhiteSpace(_newTemplate)) return;
        if (_templates.Contains(_newTemplate.Trim()))
        {
            Snackbar.Add("Mẫu đã tồn tại", Severity.Warning);
            return;
        }
        _templates.Add(_newTemplate.Trim());
        _newTemplate = "";
        Snackbar.Add("Đã thêm mẫu", Severity.Success);
    }

    void UseTemplate(string tpl)
    {
        SimPort? selected = _selectedPorts.FirstOrDefault();
        // Thay biến động nếu có
        string expanded = tpl
            .Replace("{time}", DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy"))
            .Replace("{port}", selected?.PortName ?? "")
            .Replace("{phone}", selected?.PhoneNumber ?? "")
            .Replace("{otp}", selected?.Otp ?? "");
        _message = expanded;
        // Không cần switch tab — form gửi luôn nằm ở trên cùng
        Snackbar.Add("Đã nạp mẫu vào form gửi", Severity.Info);
        StateHasChanged();
    }

    void RemoveTemplate(string tpl)
    {
        _templates.Remove(tpl);
        Snackbar.Add("Đã xóa mẫu", Severity.Normal);
    }

    // ========== 9. XUẤT CSV ==========
    async Task ExportSmsHistory()
    {
        try
        {
            static string Csv(string? value) => $"\"{(value ?? string.Empty).Replace("\"", "\"\"")}\"";
            var lines = new System.Text.StringBuilder();
            lines.AppendLine("Thời gian,Cổng,SIM nhận,Người gửi,Nội dung,OTP");
            foreach (var sms in IncomingSms)
            {
                lines.AppendLine(string.Join(",",
                    Csv(sms.ReceivedTime), Csv(sms.PortName), Csv(GetReceiverDisplay(sms)),
                    Csv(sms.Sender), Csv(sms.Content), Csv(sms.Otp)));
            }
            string fileName = $"sms_history_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            string path = System.IO.Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.Desktop), fileName);
            await System.IO.File.WriteAllTextAsync(path, lines.ToString(), new System.Text.UTF8Encoding(true));
            Snackbar.Add($"Đã xuất {IncomingSmsCount} tin → Desktop/{fileName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Xuất CSV lỗi: " + ex.Message, Severity.Error);
        }
    }

    // ========== 10. COPY / DELETE ==========
    async Task CopyText(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("clipboardCopy.copyText", text);
            Snackbar.Add("Đã copy vào Clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Copy thất bại", Severity.Warning);
        }
    }

    void DeleteSms(SmsMessage sms)
    {
        Vm.SmsMessages?.Remove(sms);
        Snackbar.Add("Đã xóa tin nhắn", Severity.Normal);
    }

    async Task ClearHistory()
    {
        var ok = await DialogService.ShowMessageBox("Xác nhận",
            "Xóa toàn bộ lịch sử tin nhắn tới?", yesText: "Xóa", cancelText: "Hủy");
        if (ok == true)
        {
            Vm.SmsMessages?.Clear();
            Snackbar.Add("Đã xóa lịch sử", Severity.Success);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _queueCts?.Cancel();
        _queueCts?.Dispose();
    }
}
