@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject gsm.ViewModels.MainViewModel Vm
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />

<MudLayout Class="app-shell">
    <MudAppBar Elevation="0" Dense="true" Class="app-shell-bar">
        <div class="app-brand" aria-label="Tool GSM Professional">
            <span class="app-brand-mark"><MudIcon Icon="@Icons.Material.Filled.CellTower" /></span>
            <span class="app-brand-copy">
                <strong>Tool GSM</strong>
                <small>EC20 Control Center</small>
            </span>
        </div>

        <nav class="app-nav" aria-label="Điều hướng chính">
            @foreach (var item in _navItems)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@item.Icon"
                           Class="@GetTabClass(item.Key)"
                           OnClick="@(() => Navigate(item.Route))">
                    @item.Label
                </MudButton>
            }
        </nav>

        <MudSpacer />

        <div class="app-theme-toggle" title="@(_isDarkMode ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối")">
            <MudIcon Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                     Size="Size.Small" />
            <MudSwitch T="bool"
                       Value="@_isDarkMode"
                       ValueChanged="@SetDarkModeAsync"
                       Color="Color.Primary"
                       Class="app-theme-switch"
                       aria-label="Bật tắt Dark Mode" />
        </div>

        <div class="app-health" title="Số cổng đã xác minh và đang hoạt động">
            <span class="app-health-dot"></span>
            <span><strong>@ActiveComCount</strong> / @TotalComCount Active</span>
        </div>
    </MudAppBar>

    <MudMainContent Class="app-main-content">
        <div class="page-enter">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private sealed record NavItem(string Key, string Route, string Label, string Icon);

    private readonly NavItem[] _navItems =
    {
        new("ussd", "ussd", "USSD", Icons.Material.Filled.Dialpad),
        new("sms", "sms", "SMS", Icons.Material.Filled.Sms),
        new("call", "call", "Gọi", Icons.Material.Filled.Phone),
        new("imei", "imei", "IMEI", Icons.Material.Filled.Fingerprint),
        new("ezcom", "ezcom", "EZ COM", Icons.Material.Filled.Router),
        new("vnptpass", "vnpt-pass", "Pass VNPT", Icons.Material.Filled.Key),
        new("logs", "logs", "Vận hành", Icons.Material.Filled.Terminal),
        new("settings", "settings", "Cài đặt", Icons.Material.Filled.Settings)
    };

    private string _current = "ussd";
    private bool _isDarkMode;
    private int ActiveComCount => Vm.Ports?.Count(p => p.Status == gsm.Models.SimStatus.Active) ?? 0;
    private int TotalComCount => Vm.Ports?.Count ?? 0;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#0D9488",
            Tertiary = "#7C3AED",
            Background = "#F5F8FC",
            Surface = "#FFFFFF",
            AppbarBackground = "rgba(255,255,255,.94)",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#172033",
            TextSecondary = "#64748B",
            ActionDefault = "#64748B",
            Divider = "#E2E8F0",
            TableLines = "#E8EEF6",
            Success = "#16A34A",
            Warning = "#D97706",
            Error = "#DC2626",
            Info = "#0284C7"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#60A5FA",
            Secondary = "#2DD4BF",
            Tertiary = "#A78BFA",
            Background = "#0B1120",
            Surface = "#111827",
            AppbarBackground = "rgba(15,23,42,.96)",
            DrawerBackground = "#111827",
            TextPrimary = "#E5EDF8",
            TextSecondary = "#94A3B8",
            ActionDefault = "#94A3B8",
            Divider = "#263449",
            TableLines = "#263449",
            Success = "#4ADE80",
            Warning = "#FBBF24",
            Error = "#F87171",
            Info = "#38BDF8"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _isDarkMode = gsm.Services.SettingsService.Current.DarkMode;
        SyncCurrentRoute();
        Nav.LocationChanged += OnLocationChanged;
        _timer = new System.Threading.Timer(_ => _ = InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("appUi.setDarkMode", _isDarkMode);
    }

    private async Task SetDarkModeAsync(bool enabled)
    {
        if (_isDarkMode == enabled) return;

        _isDarkMode = enabled;
        gsm.Services.SettingsService.Current.DarkMode = enabled;
        gsm.Services.SettingsService.SaveSettings(gsm.Services.SettingsService.Current);
        await JS.InvokeVoidAsync("appUi.setDarkMode", enabled);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncCurrentRoute();
        _ = InvokeAsync(async () =>
        {
            await JS.InvokeVoidAsync("appUi.scrollToTop");
            StateHasChanged();
        });
    }

    private void SyncCurrentRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Trim('/').ToLowerInvariant();
        _current = path switch
        {
            "" => "ussd",
            "vnpt-pass" => "vnptpass",
            _ => _navItems.FirstOrDefault(x => path.StartsWith(x.Route, StringComparison.OrdinalIgnoreCase))?.Key ?? "ussd"
        };
    }

    private void Navigate(string route) => Nav.NavigateTo(route == "ussd" ? "/" : $"/{route}");

    private string GetTabClass(string tab) => _current == tab ? "app-nav-item is-active" : "app-nav-item";

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
    }
}
