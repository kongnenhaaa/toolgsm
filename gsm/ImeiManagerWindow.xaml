<Window x:Class="gsm.ImeiManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:gsm.ViewModels"
        mc:Ignorable="d"
        Title="Quản lý IMEI" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#0f172a" Foreground="#e2e8f0">

    <Window.DataContext>
        <viewmodels:ImeiManagerViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bảng Dữ Liệu -->
        <DataGrid Grid.Row="0" 
                  ItemsSource="{Binding PagedRecords}" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Background="#1e293b"
                  BorderBrush="#334155"
                  BorderThickness="1"
                  RowHeight="35"
                  Foreground="White"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#334155"
                  VerticalGridLinesBrush="Transparent"
                  RowBackground="#1e293b"
                  AlternatingRowBackground="#0f172a">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0f172a"/>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Phonenumber" Binding="{Binding PhoneNumber}" Width="120"/>
                <DataGridTextColumn Header="ICCID" Binding="{Binding Iccid}" Width="180"/>
                <DataGridTextColumn Header="IMEI" Binding="{Binding Imei}" Width="180"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Các chức năng bên dưới -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nhóm 1: Lấy dữ liệu -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Lấy dữ liệu" Margin="0,0,10,0" Foreground="White" BorderBrush="#334155" Style="{StaticResource MaterialDesignGroupBox}">
                <StackPanel Margin="5">
                    <Button Content="Xuất .txt" 
                            Command="{Binding ExportTxtCommand}"
                            Background="#334155" Foreground="White" BorderBrush="Transparent"
                            Margin="0,0,0,5" Padding="20,5"/>
                    <Button Content="Copy nhanh ICCID|IMEI" 
                            Command="{Binding CopyQuickCommand}"
                            Background="#334155" Foreground="White" BorderBrush="Transparent"
                            Padding="20,5"/>
                </StackPanel>
            </GroupBox>

            <!-- Nhóm 2: Kiểm tra dữ liệu -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Kiểm tra dữ liệu" Margin="0,0,10,0" Foreground="White" BorderBrush="#334155" Style="{StaticResource MaterialDesignGroupBox}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Content="Chọn file .txt" 
                                Command="{Binding CheckImeiCommand}"
                                Background="#334155" Foreground="White" BorderBrush="Transparent"
                                Margin="0,0,0,5" Padding="20,5"/>
                        <TextBlock Text="Chọn file .txt chứa ICCID&#x0a;hoặc SĐT cần tra cứu IMEI" 
                                   FontSize="10" Foreground="#94a3b8" Width="150" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="=>" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" Foreground="#e2e8f0"/>
                    <Button Content="Kiểm tra IMEI" 
                            Command="{Binding CheckImeiCommand}"
                            Background="#334155" Foreground="White" BorderBrush="Transparent"
                            Height="30" Padding="20,5"/>
                </StackPanel>
            </GroupBox>

            <!-- Nhóm 3: Nhập dữ liệu -->
            <GroupBox Grid.Row="0" Grid.Column="2" Header="Nhập dữ liệu" HorizontalAlignment="Left" Foreground="White" BorderBrush="#334155" Style="{StaticResource MaterialDesignGroupBox}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Content="Chọn file .txt" 
                                Command="{Binding ImportDataCommand}"
                                Background="#334155" Foreground="White" BorderBrush="Transparent"
                                Margin="0,0,0,5" Padding="20,5"/>
                        <TextBlock Text="Định dạng ICCID|IMEI hoặc ICCID IMEI" 
                                   FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" Width="160"/>
                    </StackPanel>
                    <TextBlock Text="=>" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" Foreground="#e2e8f0"/>
                    <Button Content="Nhập" 
                            Command="{Binding ImportDataCommand}"
                            Background="#334155" Foreground="White" BorderBrush="Transparent"
                            Height="30" Padding="30,5"/>
                </StackPanel>
            </GroupBox>
            
            <!-- Điều khiển phân trang & Tìm kiếm -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Paging Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Page size:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#e2e8f0"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}" 
                              SelectedItem="{Binding PageSize}" 
                              Width="80" Margin="0,0,15,0"
                              Background="#1e293b" Foreground="White" BorderBrush="#334155" BorderThickness="1"/>
                    
                    <Button Content="&lt;&lt; Previous" 
                            Command="{Binding PreviousPageCommand}"
                            Background="#334155" Foreground="White" BorderBrush="Transparent"
                            Margin="0,0,5,0"/>
                    
                    <TextBlock Text="{Binding CurrentPage, StringFormat='Trang {0}'}" VerticalAlignment="Center" Margin="5,0" Foreground="#e2e8f0"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Foreground="#e2e8f0"/>
                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="#e2e8f0"/>
                    
                    <Button Content="Next &gt;&gt;" 
                            Command="{Binding NextPageCommand}"
                            Background="#334155" Foreground="White" BorderBrush="Transparent"/>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="250" Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="Tìm kiếm ICCID/IMEI/SĐT"
                             Background="#1e293b" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="10,5"/>
                    <Button Content="Tìm kiếm" 
                            Background="#0ea5e9" Foreground="White" BorderBrush="Transparent"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
