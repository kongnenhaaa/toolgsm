@{
    string normalizedStatus = gsm.Models.SimPort.NormalizeOperationStatus(Status);
    var (text, cssClass, busy) = normalizedStatus switch
    {
        gsm.Models.SimStatus.Active          => ("Active", "status-active", false),
        gsm.Models.SimStatus.WaitingAccept   => ("Chặn SIM", "status-blocked", false),
        gsm.Models.SimStatus.SecurityBlocked => ("Chặn SIM", "status-blocked", false),
        gsm.Models.SimStatus.Connecting      => ("Đang xử lý", "status-connecting", true),
        gsm.Models.SimStatus.ImeiError       => ("Lỗi IMEI", "status-error", false),
        gsm.Models.SimStatus.NoResponse      => ("Mất phản hồi", "status-error", false),
        // Operation results are shown in the same status column as the modem state.
        // Keep the old compact value as an alias so cached/legacy rows are rendered
        // with the new user-facing label as well.
        "USSDOK"                            => ("USSD OK", "status-active", false),
        "USSD OK"                           => ("USSD OK", "status-active", false),
        "SMS OK"                            => ("SMS OK", "status-active", false),
        "Call OK"                           => ("Call OK", "status-active", false),
        "USSD Fail"                         => ("USSD Fail", "status-error", false),
        "SMS Fail"                          => ("SMS Fail", "status-error", false),
        "Call Fail"                         => ("Call Fail", "status-error", false),
        "Chờ cắm SIM"                        => ("Chờ SIM", "status-idle", false),
        _                                    => (string.IsNullOrWhiteSpace(normalizedStatus) ? "Chưa xác định" : normalizedStatus, "status-idle", false)
    };
}

<span class="status-badge @cssClass" role="status" aria-label="Trạng thái: @text">
    <span class="status-indicator @(busy ? "is-busy" : "")"></span>
    <span>@text</span>
</span>

@code {
    [Parameter] public string Status { get; set; } = string.Empty;
}
