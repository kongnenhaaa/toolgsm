<Window x:Class="gsm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gsm"
        xmlns:converters="clr-namespace:gsm.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="API GSM Pro v1.2.38" Height="750" Width="1250"
        Background="{StaticResource AppBackground}" Foreground="White"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.InputBindings>
        <!-- #14: Hotkeys (Phím tắt) -->
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshPortsCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding CheckBalanceCommand}" CommandParameter="All" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusLogFilterCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ProDialogGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#171827"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ProDialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="ProDialogSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#202236"/>
            <Setter Property="BorderBrush" Value="#343A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ProTerminalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#080A12"/>
            <Setter Property="Foreground" Value="#7CFF9E"/>
            <Setter Property="BorderBrush" Value="#2E3350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader" x:Key="CustomHeaderStyle" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="PortNameHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.PortNameFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImeiHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.ImeiFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SerialHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.SerialFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PhoneHeaderTemplate">
            <StackPanel Margin="0,5">
                <Button Content="SĐT" FontWeight="Bold" Cursor="Hand"
                        ToolTip="Nhấn để copy tất cả Số điện thoại"
                        Foreground="#4CAF50" Background="Transparent" BorderThickness="0"
                        Padding="0" HorizontalAlignment="Left" FontSize="13"
                        Command="{Binding Path=DataContext.CopyAllPhonesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.PhoneNumberFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FilterHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Lọc" Background="#F06292" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Filter" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsTopUpDialogOpen}" CloseOnClickAway="True">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                <Grid Width="480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CashPlus" Width="28" Height="28" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Nạp thẻ / Top-up" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBox Grid.Row="1" materialDesign:HintAssist.Hint="Nhập mã thẻ cào (tự động thêm *100*...#) hoặc tự nhập USSD" 
                             Text="{Binding TopUpInput, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,24" FontSize="16"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,32">
                        <TextBlock Text="Đối tượng nạp thẻ:" Margin="0,0,0,12" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                        <RadioButton Content="Chỉ nạp cổng đang chọn" IsChecked="{Binding TopUpMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Selected}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="Nạp các cổng đã được tick chọn (☑)" IsChecked="{Binding TopUpMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Checked}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="Nạp cho TẤT CẢ cổng đang hoạt động" IsChecked="{Binding TopUpMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=All}" Foreground="White" Margin="0,6"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                        <Button Content="Nạp Tiền" Command="{Binding ExecuteTopUpCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" materialDesign:ButtonAssist.CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <materialDesign:DialogHost IsOpen="{Binding IsCustomUssdDialogOpen}" CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                <Grid Width="480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ConsoleLine" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Chạy USSD Tùy Chỉnh" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ComboBox Grid.Row="1" materialDesign:HintAssist.Hint="Nhập lệnh USSD hoặc chọn từ danh sách" 
                              IsEditable="True"
                              ItemsSource="{Binding PredefinedUssdCommands}"
                              SelectedValuePath="Key"
                              Text="{Binding CustomUssdCode, UpdateSourceTrigger=PropertyChanged}" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Foreground="White" Margin="0,0,0,24" FontSize="16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="80"/>
                                    <TextBlock Text=" - " Foreground="Gray"/>
                                    <TextBlock Text="{Binding Value}" Foreground="#B2EBF2" FontStyle="Italic"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Row="2" Margin="0,0,0,24">
                        <TextBlock Text="Chạy USSD cho:" Margin="0,0,0,12" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                        <RadioButton Content="Chỉ cổng đang chọn" IsChecked="{Binding CustomUssdMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Selected}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="Các cổng đã được tick chọn (☑)" IsChecked="{Binding CustomUssdMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Checked}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="TẤT CẢ cổng đang hoạt động" IsChecked="{Binding CustomUssdMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=All}" Foreground="White" Margin="0,6"/>
                    </StackPanel>
                    
                    <TextBox Grid.Row="3" Text="{Binding CustomUssdOutput}" IsReadOnly="True" 
                             Height="180" Style="{StaticResource ProTerminalTextBoxStyle}"
                             Margin="0,0,0,24" />
                    
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đóng" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                        <Button Content="Chạy Hàng Loạt" Command="{Binding ExecuteCustomUssdCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" BorderBrush="#FF9800" materialDesign:ButtonAssist.CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
            </materialDesign:DialogHost.DialogContent>

        <materialDesign:DialogHost IsOpen="{Binding IsSettingsDialogOpen}" CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                <Grid Width="680">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Cog" Width="28" Height="28" Foreground="#29B6F6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Cài đặt hệ thống" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Margin="0,0,0,24">
                        <StackPanel>
                            <Border Style="{StaticResource ProDialogSectionStyle}" Background="#252538" BorderBrush="#3D3D5C" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CẤU HÌNH TELEGRAM BOT" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập Bot Token (từ @BotFather)" 
                                             Text="{Binding AppSettings.TelegramBotToken}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,15"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập Chat ID (Ngăn cách dấu phẩy nếu nhiều ID)" 
                                             Text="{Binding AppSettings.TelegramChatIds}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ProDialogSectionStyle}" Background="#252538" BorderBrush="#3D3D5C" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CẤU HÌNH NHẬN THÔNG BÁO" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật gửi thông báo qua Web (Firebase)" IsChecked="{Binding AppSettings.EnableWebNotification}" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập Link Web Firebase (Database URL)" 
                                             Text="{Binding AppSettings.FirebaseUrl}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <CheckBox Content="Bật gửi thông báo qua Telegram" IsChecked="{Binding AppSettings.EnableTelegramNotification}" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <Separator Background="#3D3D5C" Margin="0,15,0,15"/>
                                    <TextBlock Text="CẤU HÌNH ÂM THANH &amp; TOAST" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật âm thanh cảnh báo (khi có tin nhắn/cuộc gọi)" IsChecked="{Binding IsSoundAlertEnabled}" Foreground="White" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật âm thanh Toast (thông báo góc màn hình Windows)" IsChecked="{Binding IsToastSoundEnabled}" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="LỌC TIN NHẮN (SMS)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Nhận TẤT CẢ tin nhắn thay vì chỉ nhận Zalo (Không lọc OTP)" IsChecked="{Binding IsReceiveAllSmsEnabled}" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="*Lưu ý: Bật tính năng này bạn sẽ nhận cả tin nhắn rác, quảng cáo từ nhà mạng." FontStyle="Italic" Foreground="#9E9E9E" FontSize="11" Margin="25,0,0,0" TextWrapping="Wrap"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="CHUYỂN HƯỚNG CUỘC GỌI (Tự động chuyển cuộc gọi đến máy bạn)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật tự động chuyển hướng cuộc gọi khi nhận diện được SIM" IsChecked="{Binding AppSettings.EnableAutoCallForwarding}" Foreground="#03A9F4" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập các SĐT nhận, ngăn cách bằng dấu phẩy (VD: 098.., 097..)" 
                                             Text="{Binding AppSettings.ForwardPhoneNumber}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="25,0,0,0"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="LỌC TỪ ĐỘNG (SENDER FILTER)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật Blacklist (Chặn người gửi trong danh sách dưới)" IsChecked="{Binding AppSettings.EnableSenderBlacklist}" Foreground="#E53935" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox materialDesign:HintAssist.Hint="Blacklist: VD: QCBMB, 1900xxxx, spamsender" 
                                             Text="{Binding AppSettings.SenderBlacklist}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="25,0,0,10"/>
                                    <CheckBox Content="Bật Whitelist (Chỉ nhận từ số trong danh sách dưới)" IsChecked="{Binding AppSettings.EnableSenderWhitelist}" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox materialDesign:HintAssist.Hint="Whitelist: VD: ZALO, FACEBOOK, 0987654321" 
                                             Text="{Binding AppSettings.SenderWhitelist}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="25,0,0,10"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="HTTP API SERVER (cổng 8080)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật HTTP API Server" IsChecked="{Binding AppSettings.EnableApiServer}" Foreground="#03A9F4" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Danh sách Endpoints (có thể Copy/Paste cho Dev API):" Foreground="#9E9E9E" FontSize="11" Margin="25,0,0,5" TextWrapping="Wrap"/>
                                    <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="#90CAF9" Background="#111" AcceptsReturn="True" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="25,0,0,5" Height="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBox.Text>
GET  /api/ports
GET  /api/otp/latest
GET  /api/otp/{port}
POST /api/send-sms
GET  /api/history
                                        </TextBox.Text>
                                    </TextBox>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="PING SIM (Kiểm tra SIM còn sống)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật tự động Ping SIM định kỳ" IsChecked="{Binding AppSettings.EnableSimPing}" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="*Nếu SIM không phản hồi sẽ báo Telegram + Toast notification" FontStyle="Italic" Foreground="#9E9E9E" FontSize="11" Margin="25,0,0,0" TextWrapping="Wrap"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="🔔 ÂM THANH CẢNH BÁO" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật âm thanh cảnh báo tùy chỉnh (OTP / SMS / Cuộc gọi)" IsChecked="{Binding AppSettings.EnableSoundAlert}" Foreground="#4DD0E1" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <CheckBox Content="Phát âm thanh Toast của Windows (Góc màn hình)" IsChecked="{Binding AppSettings.EnableToastSound}" Foreground="#FFB300" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <!-- Sound OTP -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔑 OTP:" VerticalAlignment="Center" Foreground="#FF9800" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Đường dẫn .wav (rổng = âm hệ thống)" Text="{Binding AppSettings.SoundOtpPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding BrowseSoundFileCommand}" CommandParameter="OTP" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                                        <Button Grid.Column="3" Content="Test" Command="{Binding TestSoundAlertCommand}" CommandParameter="OTP" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#4CAF50" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <!-- Sound SMS -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📩 SMS:" VerticalAlignment="Center" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Đường dẫn .wav (rổng = âm hệ thống)" Text="{Binding AppSettings.SoundSmsPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding BrowseSoundFileCommand}" CommandParameter="SMS" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                                        <Button Grid.Column="3" Content="Test" Command="{Binding TestSoundAlertCommand}" CommandParameter="SMS" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#4CAF50" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <!-- Sound Call -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📞 Gọi:" VerticalAlignment="Center" Foreground="#2196F3" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Đường dẫn .wav (rổng = âm hệ thống)" Text="{Binding AppSettings.SoundCallPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding BrowseSoundFileCommand}" CommandParameter="CALL" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                                        <Button Grid.Column="3" Content="Test" Command="{Binding TestSoundAlertCommand}" CommandParameter="CALL" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#4CAF50" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
