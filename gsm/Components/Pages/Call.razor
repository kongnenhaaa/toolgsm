@page "/call"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2" Elevation="0" Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:10px;">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
        <MudTextField @bind-Value="_phone" Label="Số điện thoại" Placeholder="09xxxxxxxx"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:180px;" Immediate="true" />

        <MudTextField @bind-Value="_wavPath" Label="File WAV (tùy chọn)" Placeholder="C:\audio\otp.wav"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                      OnAdornmentClick="BrowseWav" HelperText="mono 8kHz 16-bit" />

        <MudNumericField @bind-Value="_duration" Label="Thời lượng (s)" Min="5" Max="180"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;" />
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" @bind-Value="_sendMode" Dense="true" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Style="width:150px;" Label="Gửi tới">
            <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
        </MudSelect>

        <MudSwitch T="bool" @bind-Value="_recordCall" Label="Ghi âm" Color="Color.Primary" />

        <MudTextField @bind-Value="_dtmf" Label="DTMF" Placeholder="1#" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Call" OnClick="MakeCall"
                   Disabled="@(string.IsNullOrWhiteSpace(_phone) || _isCalling)">
            @(_isCalling ? "Đang gọi..." : "Gọi")
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.CallEnd" OnClick="HangupAll"
                   Disabled="@(!_isCalling && !_isRunningQueue)">
            Dập máy
        </MudButton>

        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SendDtmfDuringCall"
                   Disabled="@(string.IsNullOrEmpty(_dtmf) || !_isCalling)">
            Gửi DTMF
        </MudButton>
    </MudStack>

    @if (_isCalling)
    {
        <MudStack Class="mt-2" Spacing="1">
            <MudText Typo="Typo.caption">@_callStatus • @_elapsedSeconds s</MudText>
            <MudProgressLinear Color="Color.Primary" Value="@_progressPercent" />
        </MudStack>
    }
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3 mt-2"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_callSubTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="Lịch sử Cuộc gọi">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Lịch sử cuộc gọi thực hiện</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearCallHistory"
                           Disabled="@(!_callHistory.Any())">
                    Xóa lịch sử cuộc gọi
                </MudButton>
            </MudStack>
            <MudTable Items="@_callHistory" Dense="true" Hover="true" Elevation="0" Height="420px">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Số gọi</MudTh>
                    <MudTh>Thời lượng</MudTh>
                    <MudTh>WAV</MudTh>
                    <MudTh>Ghi âm</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh Style="width:80px;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>@context.Duration s</MudTd>
                    <MudTd Style="font-size:12px;">@(System.IO.Path.GetFileName(context.WavFile) ?? "—")</MudTd>
                    <MudTd>
                        @if (context.HasRecording)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Có</MudChip>
                        }
                        else { <span style="color:#94A3B8;">—</span> }
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "OK" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" 
                                       OnClick="@(() => Redial(context))" title="Gọi lại" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có lịch sử cuộc gọi</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hàng đợi gọi">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudTextField @bind-Value="_queuePhones" Label="Danh sách SĐT (mỗi dòng 1 số)" Lines="4"
                          Variant="Variant.Outlined" Class="mb-3"
                          Placeholder="0912345678&#10;0987654321" />

            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudTextField @bind-Value="_queueWav" Label="WAV chung" Variant="Variant.Outlined" 
                              Margin="Margin.Dense" Style="flex:1;" />
                <MudNumericField @bind-Value="_queueDuration" Label="Giây" Min="5" Max="120"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px;" />
                <MudSwitch T="bool" @bind-Value="_queueRecord" Label="Ghi âm" Color="Color.Primary" />
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="AddToCallQueue">Thêm vào hàng đợi</MudButton>

                @if (!_isRunningQueue)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               OnClick="RunCallQueue" Disabled="@(!_callQueue.Any())">
                        Chạy hàng đợi (@_callQueue.Count)
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               OnClick="StopCallQueue">Dừng</MudButton>
                }

                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           OnClick="ClearCallQueue">Xóa hàng đợi</MudButton>
            </MudStack>

            <MudTable Items="@_callQueue" Dense="true" Hover="true" Elevation="0" Height="280px">
                <HeaderContent>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>WAV</MudTh>
                    <MudTh>Giây</MudTh>
                    <MudTh>Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>@context.Port</MudTd>
                    <MudTd Style="font-size:12px;">@(System.IO.Path.GetFileName(context.Wav) ?? "—")</MudTd>
                    <MudTd>@context.Duration</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Status == "Xong" ? Color.Success : context.Status == "Lỗi" ? Color.Error : Color.Default)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-8 text-center" Style="color:#94A3B8;">Hàng đợi trống</MudText>
                </NoRecordsContent>
                        </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Chuyển tiếp Cuộc gọi">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="mb-3">Cấu hình chuyển tiếp cuộc gọi (AT+CCFC)</MudText>
            
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mb-4">
                <MudTextField @bind-Value="_forwardPhone" Label="Số điện thoại nhận chuyển tiếp" Placeholder="09xxxxxxxx"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px;" />
                
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Forward" OnClick="SetForwardingSelected"
                           Disabled="@_isProcessingForward">
                    Thiết lập
                </MudButton>
                
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Block" OnClick="CancelForwardingSelected"
                           Disabled="@_isProcessingForward">
                    Hủy chuyển tiếp
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.YoutubeSearchedFor" OnClick="CheckForwardingStatusSelected"
                           Disabled="@_isProcessingForward">
                    Kiểm tra trạng thái
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                * Lưu ý: Hãy chọn các cổng ở tab <b>Danh sách Cổng</b> trước khi thực hiện. Số cổng đang chọn: <b>@_selectedPorts.Count</b>
            </MudText>

            @if (_isProcessingForward)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.caption">@_forwardStatusText</MudText>
                </MudStack>
            }

            <MudTable Items="@FilteredPorts" Dense="true" Hover="true" Elevation="0" Height="300px">
                <HeaderContent>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT SIM</MudTh>
                    <MudTh>Nhà mạng</MudTh>
                    <MudTh>Chuyển hướng đến</MudTh>
                    <MudTh>Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-weight:600;">@context.PortName</MudTd>
                    <MudTd>@context.PhoneNumber</MudTd>
                    <MudTd>@context.NetworkProvider</MudTd>
                    <MudTd Style="color:#2563EB; font-weight:600;">
                        @(string.IsNullOrEmpty(context.ForwardedTo) ? "Không có" : context.ForwardedTo)
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" 
                                 Color="@(string.IsNullOrEmpty(context.ForwardedTo) ? Color.Default : Color.Success)">
                            @(string.IsNullOrEmpty(context.ForwardedTo) ? "Tắt" : "Đang bật")
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _phone = "";
    private string _wavPath = "";
    private int _duration = 30;
    private bool _recordCall = true;
    private string _dtmf = "";
    private string _sendMode = "selected"; // selected | all
    private HashSet<SimPort> _selectedPorts = new();
    private int _callSubTab = 0;

    // Trạng thái cuộc gọi
    private bool _isCalling = false;
    private string _callStatus = "";
    private int _elapsedSeconds = 0;
    private double _progressPercent = 0;
    private string _currentPort = "";
    private System.Threading.Timer? _callTimer { get; set; }
    private CancellationTokenSource? _callCts;

    // Lịch sử
    private List<CallHistoryItem> _callHistory = new();

    // Hàng đợi
    private string _queuePhones = "";
    private string _queueWav = "";
    private int _queueDuration = 30;
    private bool _queueRecord = true;
        private List<CallQueueItem> _callQueue = new();
    private bool _isRunningQueue = false;
    private CancellationTokenSource? _queueCts;

    private string _forwardPhone = "";
    private bool _isProcessingForward = false;
    private string _forwardStatusText = "";

    private async Task SetForwardingSelected()
    {
        if (string.IsNullOrWhiteSpace(_forwardPhone))
        {
            Snackbar.Add("Vui lòng điền số điện thoại nhận chuyển tiếp", Severity.Warning);
            return;
        }

        var ports = _selectedPorts.ToList();
        if (!ports.Any())
        {
            Snackbar.Add("Vui lòng chọn ít nhất 1 cổng ở tab Danh sách Cổng", Severity.Warning);
            return;
        }

        _isProcessingForward = true;
        _forwardStatusText = $"Đang thiết lập chuyển tiếp cho {ports.Count} cổng...";
        StateHasChanged();

        int okCount = 0;
        int errCount = 0;

        foreach (var p in ports)
        {
            try
            {
                _forwardStatusText = $"[{p.PortName}] Đang gửi lệnh chuyển tiếp đến {_forwardPhone}...";
                StateHasChanged();

                string fwdDialType = _forwardPhone.StartsWith("+") ? "145" : "129";
                string res = await ModemService.SendCommandAsync(p.PortName, $"AT+CCFC=0,1,\"{_forwardPhone}\",{fwdDialType}", timeoutMs: 8000);
                
                if (res.Contains("OK"))
                {
                    p.ForwardedTo = _forwardPhone;
                    okCount++;
                }
                else
                {
                    errCount++;
                }
            }
            catch (Exception ex)
            {
                errCount++;
                Vm.AddLog($"[{p.PortName}] Lỗi thiết lập chuyển tiếp: {ex.Message}", "ERROR");
            }
            await Task.Delay(200);
        }

        _isProcessingForward = false;
        _forwardStatusText = "";
        Snackbar.Add($"Hoàn tất: Thiết lập thành công {okCount} cổng, thất bại {errCount} cổng.", 
                     errCount == 0 ? Severity.Success : Severity.Warning);
        StateHasChanged();
    }

    private async Task CancelForwardingSelected()
    {
        var ports = _selectedPorts.ToList();
        if (!ports.Any())
        {
            Snackbar.Add("Vui lòng chọn ít nhất 1 cổng ở tab Danh sách Cổng", Severity.Warning);
            return;
        }

        _isProcessingForward = true;
        _forwardStatusText = $"Đang hủy chuyển tiếp cho {ports.Count} cổng...";
        StateHasChanged();

        int okCount = 0;
        int errCount = 0;

        foreach (var p in ports)
        {
            try
            {
                _forwardStatusText = $"[{p.PortName}] Đang gửi lệnh hủy chuyển tiếp...";
                StateHasChanged();

                string res = await ModemService.SendCommandAsync(p.PortName, "AT+CCFC=0,4", timeoutMs: 8000);
                
                if (res.Contains("OK"))
                {
                    p.ForwardedTo = string.Empty;
                    okCount++;
                }
                else
                {
                    errCount++;
                }
            }
            catch (Exception ex)
            {
                errCount++;
                Vm.AddLog($"[{p.PortName}] Lỗi hủy chuyển tiếp: {ex.Message}", "ERROR");
            }
            await Task.Delay(200);
        }

        _isProcessingForward = false;
        _forwardStatusText = "";
        Snackbar.Add($"Hoàn tất: Hủy thành công {okCount} cổng, thất bại {errCount} cổng.", 
                     errCount == 0 ? Severity.Success : Severity.Warning);
        StateHasChanged();
    }

    private async Task CheckForwardingStatusSelected()
    {
        var ports = _selectedPorts.ToList();
        if (!ports.Any())
        {
            Snackbar.Add("Vui lòng chọn ít nhất 1 cổng ở tab Danh sách Cổng", Severity.Warning);
            return;
        }

        _isProcessingForward = true;
        _forwardStatusText = $"Đang kiểm tra chuyển tiếp cho {ports.Count} cổng...";
        StateHasChanged();

        int activeCount = 0;
        int inactiveCount = 0;
        int errCount = 0;

        foreach (var p in ports)
        {
            try
            {
                _forwardStatusText = $"[{p.PortName}] Đang kiểm tra trạng thái...";
                StateHasChanged();

                string res = await ModemService.SendCommandAsync(p.PortName, "AT+CCFC=0,2", timeoutMs: 8000);
                var match = System.Text.RegularExpressions.Regex.Match(res, @"\+CCFC:\s*1,\s*\d+,\s*""([^""]+)""");
                
                if (match.Success)
                {
                    p.ForwardedTo = match.Groups[1].Value;
                    activeCount++;
                }
                else
                {
                    p.ForwardedTo = string.Empty;
                    inactiveCount++;
                }
            }
            catch (Exception ex)
            {
                errCount++;
                Vm.AddLog($"[{p.PortName}] Lỗi kiểm tra chuyển tiếp: {ex.Message}", "ERROR");
            }
            await Task.Delay(200);
        }

        _isProcessingForward = false;
        _forwardStatusText = "";
        Snackbar.Add($"Kiểm tra xong: {activeCount} đang bật, {inactiveCount} tắt, {errCount} lỗi.", Severity.Info);
        StateHasChanged();
    }

    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);
    private List<SimPort> FilteredPorts => Ports;

    private System.Threading.Timer? _uiTimer;

    protected override void OnInitialized()
    {
        _uiTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    // =====================================================
    // 1. GỌI NGAY (1 / Selected / All) – FIX THẬT 100%
    // =====================================================
    async Task<bool> MakeCall()
    {
        if (string.IsNullOrWhiteSpace(_phone))
        {
            Snackbar.Add("Nhập số điện thoại", Severity.Warning);
            return false;
        }

        var ports = GetTargetPorts();
        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return false;
        }

        if (ports.Count > 5)
        {
            var ok = await DialogService.ShowMessageBox("Xác nhận",
                $"Gọi {_phone} trên {ports.Count} cổng?", yesText: "Gọi", cancelText: "Hủy");
            if (ok != true) return false;
        }

        _isCalling = true;
        _callCts = new CancellationTokenSource();
        int okCount = 0, failCount = 0;

        foreach (var port in ports)
        {
            if (_callCts.Token.IsCancellationRequested) break;

            _currentPort = port;
            _callStatus = $"[{port}] Đang gọi {_phone}...";
            _elapsedSeconds = 0;
            _progressPercent = 0;
            StateHasChanged();

            bool success = false;
            string resultMsg = "";

            try
            {
                // Ưu tiên method đầy đủ của ViewModel (hỗ trợ WAV + ghi âm)
                if (HasMethod(Vm, "ExecuteCallFromUiAsync"))
                {
                    var callTask = Vm.GetType().GetMethod("ExecuteCallFromUiAsync")!.Invoke(Vm, new object[] { port, _phone, _wavPath ?? "", _duration, _recordCall })!;
                    
                    int maxSeconds = _duration + 45; 
                    for (int i = 0; i < maxSeconds; i++)
                    {
                        if (_callCts.Token.IsCancellationRequested || ((Task)callTask).IsCompleted) break;
                        _elapsedSeconds = i + 1;
                        _progressPercent = Math.Min(100.0, (_elapsedSeconds * 100.0) / _duration);
                        StateHasChanged();
                        try { await Task.Delay(1000, _callCts.Token); } catch { break; }
                    }
                    
                    if (callTask is Task<bool> boolTask)
                    {
                        success = await boolTask;
                    }
                    else
                    {
                        await (Task)callTask;
                        success = true;
                    }
                    resultMsg = success ? "OK" : "Lỗi kết nối / Không nhấc máy";
                }
                else
                {
                    // Fallback thủ công
                    await ModemService.SendCommandAsync(port, $"ATD{_phone};", 15000);
                    _callStatus = $"[{port}] Đang đổ chuông / đàm thoại...";

                    // Phát WAV nếu có (QFUPL + QPSND – tùy firmware)
                    if (!string.IsNullOrEmpty(_wavPath) && System.IO.File.Exists(_wavPath))
                    {
                        // TODO: QFUPL file rồi QPSND nếu backend hỗ trợ
                        _callStatus = $"[{port}] Đang phát WAV...";
                    }

                    // Chờ thời lượng
                    for (int i = 0; i < _duration; i++)
                    {
                        if (_callCts.Token.IsCancellationRequested) break;
                        _elapsedSeconds = i + 1;
                        _progressPercent = (_elapsedSeconds * 100.0) / _duration;
                        StateHasChanged();
                        await Task.Delay(1000, _callCts.Token);
                    }

                    // Dập máy
                    await ModemService.SendCommandAsync(port, "ATH", 5000);
                    success = true;
                    resultMsg = "OK";
                }

                if (success)
                {
                    okCount++;
                    Snackbar.Add($"[{port}] Gọi xong", Severity.Success);
                }
                else
                {
                    failCount++;
                    Snackbar.Add($"[{port}] Gọi thất bại: {resultMsg}", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                failCount++;
                resultMsg = ex.Message;
                try { await ModemService.SendCommandAsync(port, "ATH", 3000); } catch { }
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }

            // Lưu lịch sử
            _callHistory.Insert(0, new CallHistoryItem
            {
                Time = DateTime.Now,
                Port = port,
                Phone = _phone,
                Duration = _elapsedSeconds > 0 ? _elapsedSeconds : _duration,
                WavFile = _wavPath ?? "",
                HasRecording = _recordCall,
                Success = success,
                Result = resultMsg
            });

            if (_callHistory.Count > 200) _callHistory.RemoveRange(200, _callHistory.Count - 200);
            await Task.Delay(600);
        }

        _isCalling = false;
        _callStatus = $"Hoàn tất: {okCount} OK, {failCount} lỗi";
        Snackbar.Add(_callStatus, failCount == 0 ? Severity.Success : Severity.Warning);
        return failCount == 0;
    }

    // =====================================================
    // 2. DẬP MÁY
    // =====================================================
    async Task HangupAll()
    {
        _callCts?.Cancel();
        _isCalling = false;

        var ports = GetTargetPorts();
        if (!ports.Any()) ports = Ports.Select(p => p.PortName).ToList();

        foreach (var port in ports)
        {
            try
            {
                await ModemService.SendCommandAsync(port, "ATH", 3000);
            }
            catch { }
        }

        _callStatus = "Đã dập tất cả";
        Snackbar.Add("Đã dập tất cả cuộc gọi", Severity.Success);
    }

    // =====================================================
    // 3. GỌI LẠI (Redial) – TỰ GỌI
    // =====================================================
    async Task Redial(CallHistoryItem item)
    {
        _phone = item.Phone;
        _wavPath = item.WavFile;
        _duration = item.Duration > 0 ? item.Duration : 30;
        _recordCall = item.HasRecording;
        _callSubTab = 0; // về form gọi
        StateHasChanged();

        // Tự động gọi luôn
        await MakeCall();
    }

    // =====================================================
    // 4. DTMF TRONG LÚC GỌI
    // =====================================================
    async Task SendDtmfDuringCall()
    {
        if (string.IsNullOrWhiteSpace(_dtmf))
        {
            Snackbar.Add("Nhập mã DTMF", Severity.Warning);
            return;
        }

        var port = !string.IsNullOrEmpty(_currentPort) ? _currentPort : GetTargetPorts().FirstOrDefault();
        if (string.IsNullOrEmpty(port))
        {
            Snackbar.Add("Không có cổng đang gọi", Severity.Warning);
            return;
        }

        try
        {
            // Quectel: AT+VTS hoặc AT+QVTS
            try
            {
                await ModemService.SendCommandAsync(port, $"AT+VTS=\"{_dtmf}\"", 5000);
            }
            catch
            {
                await ModemService.SendCommandAsync(port, $"AT+QVTS=\"{_dtmf}\"", 5000);
            }
            Snackbar.Add($"[{port}] Đã gửi DTMF {_dtmf}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("DTMF lỗi: " + ex.Message, Severity.Error);
        }
    }

    // =====================================================
    // 5. HÀNG ĐỢI GỌI – FIX THẬT 100%
    // =====================================================
    void AddToCallQueue()
    {
        var phones = _queuePhones.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                                 .Select(x => x.Trim())
                                 .Where(x => x.Length >= 9)
                                 .Distinct()
                                 .ToList();

        if (!phones.Any())
        {
            Snackbar.Add("Nhập danh sách số hợp lệ", Severity.Warning);
            return;
        }

        var ports = GetTargetPorts();
        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng", Severity.Warning);
            return;
        }

        foreach (var phone in phones)
        {
            foreach (var port in ports)
            {
                _callQueue.Add(new CallQueueItem
                {
                    Phone = phone,
                    Port = port,
                    Wav = _queueWav,
                    Duration = _queueDuration,
                    Record = _queueRecord,
                    Status = "Chờ"
                });
            }
        }

        _queuePhones = "";
        Snackbar.Add($"Đã thêm {phones.Count * ports.Count} cuộc gọi vào hàng đợi", Severity.Success);
    }

    async Task RunCallQueue()
    {
        var pending = _callQueue.Where(x => x.Status == "Chờ").ToList();
        if (!pending.Any())
        {
            Snackbar.Add("Hàng đợi trống", Severity.Warning);
            return;
        }

        _isRunningQueue = true;
        _queueCts = new CancellationTokenSource();
        Snackbar.Add($"Bắt đầu chạy {pending.Count} cuộc gọi...", Severity.Info);

        foreach (var item in pending)
        {
            if (_queueCts.Token.IsCancellationRequested) break;

            item.Status = "Đang gọi";
            StateHasChanged();

            _phone = item.Phone;
            _wavPath = item.Wav;
            _duration = item.Duration;
            _recordCall = item.Record;
            _selectedPorts = new HashSet<SimPort>(Ports.Where(p => p.PortName == item.Port));
            _sendMode = "selected";

            try
            {
                bool isOk = await MakeCall(); // tái sử dụng logic gọi
                item.Status = isOk ? "Xong" : "Lỗi";
            }
            catch
            {
                item.Status = "Lỗi";
            }

            StateHasChanged();
            await Task.Delay(1500, _queueCts.Token);
        }

        _isRunningQueue = false;
        Snackbar.Add("Hoàn tất hàng đợi gọi", Severity.Success);
    }

    void StopCallQueue()
    {
        _queueCts?.Cancel();
        _callCts?.Cancel();
        _isRunningQueue = false;
        _isCalling = false;
        Snackbar.Add("Đã dừng hàng đợi", Severity.Normal);
    }

    void ClearCallQueue()
    {
        _callQueue.Clear();
        Snackbar.Add("Đã xóa hàng đợi", Severity.Normal);
    }

    async Task ClearCallHistory()
    {
        var ok = await DialogService.ShowMessageBox("Xác nhận",
            "Xóa toàn bộ lịch sử cuộc gọi?", yesText: "Xóa", cancelText: "Hủy");
        if (ok == true)
        {
            _callHistory.Clear();
            Snackbar.Add("Đã xóa lịch sử cuộc gọi", Severity.Success);
        }
    }

    // =====================================================
    // 6. CHỌN FILE WAV (UI)
    // =====================================================
    async Task BrowseWav()
    {
        try
        {
            System.Windows.Application.Current.Dispatcher.Invoke(() =>
            {
                var dlg = new Microsoft.Win32.OpenFileDialog
                {
                    Filter = "WAV Files (*.wav)|*.wav|All Files (*.*)|*.*",
                    Title = "Chọn file âm thanh WAV"
                };
                if (dlg.ShowDialog() == true)
                {
                    _wavPath = dlg.FileName;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add("Không mở được hộp thoại: " + ex.Message, Severity.Error);
        }
    }

    // =====================================================
    // HELPERS
    // =====================================================
    List<string> GetTargetPorts()
    {
        if (_sendMode == "all" || !_selectedPorts.Any())
            return ActivePorts.Select(p => p.PortName).ToList();
        return _selectedPorts.Select(p => p.PortName).ToList();
    }

    bool HasMethod(object obj, string name)
    {
        return obj.GetType().GetMethod(name) != null;
    }

    public void Dispose()
    {
        _uiTimer?.Dispose();
        _callTimer?.Dispose();
        _callCts?.Cancel();
        _queueCts?.Cancel();
        _callCts?.Dispose();
        _queueCts?.Dispose();
    }

    // ========== MODELS ==========
    public class CallHistoryItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Phone { get; set; } = "";
        public int Duration { get; set; }
        public string WavFile { get; set; } = "";
        public bool HasRecording { get; set; }
        public bool Success { get; set; }
        public string Result { get; set; } = "";
    }

    public class CallQueueItem
    {
        public string Phone { get; set; } = "";
        public string Port { get; set; } = "";
        public string Wav { get; set; } = "";
        public int Duration { get; set; }
        public bool Record { get; set; }
        public string Status { get; set; } = "Chờ";
    }
}

