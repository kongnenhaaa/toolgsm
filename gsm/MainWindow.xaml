<Window x:Class="gsm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gsm"
        xmlns:converters="clr-namespace:gsm.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="API GSM Pro v1.2.38" Height="750" Width="1250"
        Background="{StaticResource AppBackground}" Foreground="White"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.InputBindings>
        <!-- #14: Hotkeys (Phím tắt) -->
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshPortsCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding CheckBalanceCommand}" CommandParameter="All" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusLogFilterCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ProDialogGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#171827"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ProDialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="ProDialogSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#202236"/>
            <Setter Property="BorderBrush" Value="#343A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ProTerminalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#080A12"/>
            <Setter Property="Foreground" Value="#7CFF9E"/>
            <Setter Property="BorderBrush" Value="#2E3350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader" x:Key="CustomHeaderStyle" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="PortNameHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.PortNameFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImeiHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.ImeiFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SerialHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.SerialFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PhoneHeaderTemplate">
            <StackPanel Margin="0,5">
                <Button Content="SĐT" FontWeight="Bold" Cursor="Hand"
                        ToolTip="Nhấn để copy tất cả Số điện thoại"
                        Foreground="#4CAF50" Background="Transparent" BorderThickness="0"
                        Padding="0" HorizontalAlignment="Left" FontSize="13"
                        Command="{Binding Path=DataContext.CopyAllPhonesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Foreground="Gray" Width="15" Height="15"/>
                    <TextBox Grid.Column="1" Margin="5,0,0,0" materialDesign:HintAssist.Hint="Tìm kiếm" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding Path=DataContext.PhoneNumberFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FilterHeaderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Lọc" Background="#F06292" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Filter" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsTopUpDialogOpen}" CloseOnClickAway="True">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                <Grid Width="480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CashPlus" Width="28" Height="28" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Nạp thẻ / Top-up" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBox Grid.Row="1" materialDesign:HintAssist.Hint="Nhập mã thẻ cào (tự động thêm *100*...#) hoặc tự nhập USSD" 
                             Text="{Binding TopUpInput, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,24" FontSize="16"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,32">
                        <TextBlock Text="Đối tượng nạp thẻ:" Margin="0,0,0,12" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                        <RadioButton Content="Chỉ nạp cổng đang chọn" IsChecked="{Binding TopUpMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Selected}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="Nạp các cổng đã được tick chọn (☑)" IsChecked="{Binding TopUpMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Checked}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="Nạp cho TẤT CẢ cổng đang hoạt động" IsChecked="{Binding TopUpMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=All}" Foreground="White" Margin="0,6"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                        <Button Content="Nạp Tiền" Command="{Binding ExecuteTopUpCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" materialDesign:ButtonAssist.CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <materialDesign:DialogHost IsOpen="{Binding IsCustomUssdDialogOpen}" CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                <Grid Width="480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ConsoleLine" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Chạy USSD Tùy Chỉnh" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ComboBox Grid.Row="1" materialDesign:HintAssist.Hint="Nhập lệnh USSD hoặc chọn từ danh sách" 
                              IsEditable="True"
                              ItemsSource="{Binding PredefinedUssdCommands}"
                              SelectedValuePath="Key"
                              Text="{Binding CustomUssdCode, UpdateSourceTrigger=PropertyChanged}" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Foreground="White" Margin="0,0,0,24" FontSize="16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="80"/>
                                    <TextBlock Text=" - " Foreground="Gray"/>
                                    <TextBlock Text="{Binding Value}" Foreground="#B2EBF2" FontStyle="Italic"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Row="2" Margin="0,0,0,24">
                        <TextBlock Text="Chạy USSD cho:" Margin="0,0,0,12" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                        <RadioButton Content="Chỉ cổng đang chọn" IsChecked="{Binding CustomUssdMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Selected}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="Các cổng đã được tick chọn (☑)" IsChecked="{Binding CustomUssdMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Checked}" Foreground="White" Margin="0,6"/>
                        <RadioButton Content="TẤT CẢ cổng đang hoạt động" IsChecked="{Binding CustomUssdMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=All}" Foreground="White" Margin="0,6"/>
                    </StackPanel>
                    
                    <TextBox Grid.Row="3" Text="{Binding CustomUssdOutput}" IsReadOnly="True" 
                             Height="180" Style="{StaticResource ProTerminalTextBoxStyle}"
                             Margin="0,0,0,24" />
                    
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đóng" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                        <Button Content="Chạy Hàng Loạt" Command="{Binding ExecuteCustomUssdCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" BorderBrush="#FF9800" materialDesign:ButtonAssist.CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
            </materialDesign:DialogHost.DialogContent>

        <materialDesign:DialogHost IsOpen="{Binding IsSettingsDialogOpen}" CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                <Grid Width="680">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Cog" Width="28" Height="28" Foreground="#29B6F6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Cài đặt hệ thống" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Margin="0,0,0,24">
                        <StackPanel>
                            <Border Style="{StaticResource ProDialogSectionStyle}" Background="#252538" BorderBrush="#3D3D5C" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CẤU HÌNH TELEGRAM BOT" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập Bot Token (từ @BotFather)" 
                                             Text="{Binding AppSettings.TelegramBotToken}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,15"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập Chat ID (Ngăn cách dấu phẩy nếu nhiều ID)" 
                                             Text="{Binding AppSettings.TelegramChatIds}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ProDialogSectionStyle}" Background="#252538" BorderBrush="#3D3D5C" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CẤU HÌNH NHẬN THÔNG BÁO" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật gửi thông báo qua Web (Firebase)" IsChecked="{Binding AppSettings.EnableWebNotification}" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập Link Web Firebase (Database URL)" 
                                             Text="{Binding AppSettings.FirebaseUrl}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <CheckBox Content="Bật gửi thông báo qua Telegram" IsChecked="{Binding AppSettings.EnableTelegramNotification}" Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="LỌC TIN NHẮN (SMS)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Nhận TẤT CẢ tin nhắn thay vì chỉ nhận Zalo (Không lọc OTP)" IsChecked="{Binding AppSettings.ReceiveAllSms}" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="*Lưu ý: Bật tính năng này bạn sẽ nhận cả tin nhắn rác, quảng cáo từ nhà mạng." FontStyle="Italic" Foreground="#9E9E9E" FontSize="11" Margin="25,0,0,0" TextWrapping="Wrap"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="CHUYỂN HƯỚNG CUỘC GỌI (Tự động chuyển cuộc gọi đến máy bạn)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật tự động chuyển hướng cuộc gọi khi nhận diện được SIM" IsChecked="{Binding AppSettings.EnableAutoCallForwarding}" Foreground="#03A9F4" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBox materialDesign:HintAssist.Hint="Nhập các SĐT nhận, ngăn cách bằng dấu phẩy (VD: 098.., 097..)" 
                                             Text="{Binding AppSettings.ForwardPhoneNumber}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="25,0,0,0"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="LỌC TỪ ĐỘNG (SENDER FILTER)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                                    <CheckBox Content="Bật Blacklist (Chặn người gửi trong danh sách dưới)" IsChecked="{Binding AppSettings.EnableSenderBlacklist}" Foreground="#E53935" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox materialDesign:HintAssist.Hint="Blacklist: VD: QCBMB, 1900xxxx, spamsender" 
                                             Text="{Binding AppSettings.SenderBlacklist}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="25,0,0,10"/>
                                    <CheckBox Content="Bật Whitelist (Chỉ nhận từ số trong danh sách dưới)" IsChecked="{Binding AppSettings.EnableSenderWhitelist}" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox materialDesign:HintAssist.Hint="Whitelist: VD: ZALO, FACEBOOK, 0987654321" 
                                             Text="{Binding AppSettings.SenderWhitelist}" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="25,0,0,10"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="HTTP API SERVER (cổng 8080)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật HTTP API Server" IsChecked="{Binding AppSettings.EnableApiServer}" Foreground="#03A9F4" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Endpoints: GET /api/ports  |  GET /api/otp/{port}  |  POST /api/send-sms  |  GET /api/history" Foreground="#9E9E9E" FontSize="10" Margin="25,0,0,5" TextWrapping="Wrap"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="PING SIM (Kiểm tra SIM còn sống)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật tự động Ping SIM định kỳ" IsChecked="{Binding AppSettings.EnableSimPing}" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="*Nếu SIM không phản hồi sẽ báo Telegram + Toast notification" FontStyle="Italic" Foreground="#9E9E9E" FontSize="11" Margin="25,0,0,0" TextWrapping="Wrap"/>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <TextBlock Text="🔔 ÂM THANH CẢNH BÁO" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,10"/>
                                    <CheckBox Content="Bật âm thanh cảnh báo tùy chỉnh (OTP / SMS / Cuộc gọi)" IsChecked="{Binding AppSettings.EnableSoundAlert}" Foreground="#4DD0E1" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <CheckBox Content="Phát âm thanh Toast của Windows (Góc màn hình)" IsChecked="{Binding AppSettings.EnableToastSound}" Foreground="#FFB300" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <!-- Sound OTP -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔑 OTP:" VerticalAlignment="Center" Foreground="#FF9800" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Đường dẫn .wav (rổng = âm hệ thống)" Text="{Binding AppSettings.SoundOtpPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding BrowseSoundFileCommand}" CommandParameter="OTP" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                                        <Button Grid.Column="3" Content="Test" Command="{Binding TestSoundAlertCommand}" CommandParameter="OTP" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#4CAF50" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <!-- Sound SMS -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📩 SMS:" VerticalAlignment="Center" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Đường dẫn .wav (rổng = âm hệ thống)" Text="{Binding AppSettings.SoundSmsPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding BrowseSoundFileCommand}" CommandParameter="SMS" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                                        <Button Grid.Column="3" Content="Test" Command="{Binding TestSoundAlertCommand}" CommandParameter="SMS" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#4CAF50" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <!-- Sound Call -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📞 Gọi:" VerticalAlignment="Center" Foreground="#2196F3" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Đường dẫn .wav (rổng = âm hệ thống)" Text="{Binding AppSettings.SoundCallPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding BrowseSoundFileCommand}" CommandParameter="CALL" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="8,4" Margin="0,0,5,0" FontSize="11"/>
                                        <Button Grid.Column="3" Content="Test" Command="{Binding TestSoundAlertCommand}" CommandParameter="CALL" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#4CAF50" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <Separator Background="#3D3D5C" Margin="0,20"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🔗 WEBHOOK TỰ ĐỘNG (Forward OTP)" FontSize="12" FontWeight="Bold" Foreground="#29B6F6" VerticalAlignment="Center"/>
                                        <Button Content="+ Thêm Rule" Command="{Binding OpenAddWebhookRuleCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#5C6BC0" BorderBrush="#5C6BC0" Padding="8,4" Margin="15,0,0,0" FontSize="11" materialDesign:ButtonAssist.CornerRadius="4"/>
                                    </StackPanel>
                                    <TextBlock Text="Khi nhận OTP/SMS, tự động POST JSON đến URL webhook. JSON payload: { port, phone, sender, otp, content, timestamp }" Foreground="#9E9E9E" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding AppSettings.WebhookRules}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              Background="#1A1A2A" RowBackground="#1A1A2A" AlternatingRowBackground="#202040"
                                              Foreground="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#444" VerticalGridLinesBrush="#444"
                                              HeadersVisibility="Column" BorderThickness="1" BorderBrush="#444"
                                              MaxHeight="160" MinHeight="60">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Bật" Binding="{Binding Enabled}" Width="40"/>
                                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="120" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                            <DataGridTextColumn Header="Lọc Sender" Binding="{Binding SenderFilter}" Width="100" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                            <DataGridCheckBoxColumn Header="OTP Only" Binding="{Binding OtpOnly}" Width="70"/>
                                            <DataGridTextColumn Header="URL Webhook" Binding="{Binding WebhookUrl}" Width="*" ElementStyle="{StaticResource ProDataGridTextElementStyle}"/>
                                            <DataGridTemplateColumn Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Sửa" Command="{Binding Path=DataContext.OpenEditWebhookRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#29B6F6" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                                                            <Button Content="Xóa" Command="{Binding Path=DataContext.DeleteWebhookRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#E53935" Padding="6,2" FontSize="10"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                        <Button Content="Lưu Cài Đặt" Command="{Binding SaveSettingsCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" materialDesign:ButtonAssist.CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
            </materialDesign:DialogHost.DialogContent>

            <materialDesign:DialogHost IsOpen="{Binding IsAtCommandDialogOpen}" CloseOnClickAway="True">
                <materialDesign:DialogHost.DialogContent>
                    <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                        <Grid Width="740">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <materialDesign:PackIcon Kind="Terminal" Width="28" Height="28" Foreground="#2196F3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Gửi lệnh AT trực tiếp (AT Commands)" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AtCommandPortOptions}" SelectedValue="{Binding AtCommandSelectedPort}" 
                                          materialDesign:HintAssist.Hint="Chọn cổng COM" Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                          Foreground="White" Margin="0,0,16,0">
                                </ComboBox>
                                
                                <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Nhập lệnh (VD: AT+CUSD=1,&#34;*101#&#34;,15)" 
                                         Text="{Binding AtCommandInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ItemsSource="{Binding PredefinedAtCommands}"
                                         IsEditable="True"
                                         TextSearch.TextPath="Key"
                                         Style="{StaticResource MaterialDesignFloatingHintComboBox}" Foreground="White" Margin="0,0,16,0" FontFamily="Consolas">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="180"/>
                                                <TextBlock Text=" - " Foreground="Gray"/>
                                                <TextBlock Text="{Binding Value}" Foreground="#B2EBF2" FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendAtCommandCommand}"/>
                                    </ComboBox.InputBindings>
                                </ComboBox>
                                
                                <Button Grid.Column="2" Content="Gửi Lệnh" Command="{Binding SendAtCommandCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2196F3" BorderBrush="#2196F3" materialDesign:ButtonAssist.CornerRadius="6"/>
                            </Grid>

                            <TextBox Grid.Row="2" Text="{Binding AtCommandOutput}" IsReadOnly="True" 
                                     Height="320" Style="{StaticResource ProTerminalTextBoxStyle}"
                                     Margin="0,0,0,24"/>
                            
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Đóng" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:DialogHost.DialogContent>

                <materialDesign:DialogHost IsOpen="{Binding IsComposeSmsDialogOpen}" CloseOnClickAway="True">
                    <materialDesign:DialogHost.DialogContent>
                        <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                            <Grid Width="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <materialDesign:PackIcon Kind="MessageTextOutline" Width="28" Height="28" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Soạn tin nhắn SMS" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBox Grid.Row="1" materialDesign:HintAssist.Hint="Số điện thoại nhận (VD: 0987654321)" 
                                         Text="{Binding ComposeSmsPhone, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,24" FontSize="16"/>

                                <TextBox Grid.Row="2" materialDesign:HintAssist.Hint="Nội dung tin nhắn" 
                                         Text="{Binding ComposeSmsContent, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,32" FontSize="16" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>

                                <StackPanel Grid.Row="3" Margin="0,0,0,32">
                                    <TextBlock Text="Gửi từ cổng:" Margin="0,0,0,12" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                                    <RadioButton Content="Chỉ gửi từ cổng đang chọn" IsChecked="{Binding ComposeSmsMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Selected}" Foreground="White" Margin="0,6"/>
                                    <RadioButton Content="Gửi từ các cổng đã được tick chọn (☑)" IsChecked="{Binding ComposeSmsMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Checked}" Foreground="White" Margin="0,6"/>
                                    <RadioButton Content="Gửi đồng loạt từ TẤT CẢ cổng đang hoạt động" IsChecked="{Binding ComposeSmsMode, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=All}" Foreground="White" Margin="0,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Hủy" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                                    <Button Content="Gửi Tin Nhắn" Command="{Binding ExecuteComposeSmsCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" materialDesign:ButtonAssist.CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </materialDesign:DialogHost.DialogContent>

                <materialDesign:DialogHost IsOpen="{Binding IsExportExcelDialogOpen}" CloseOnClickAway="True">
                    <materialDesign:DialogHost.DialogContent>
                        <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                            <Grid Width="450">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="28" Height="28" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Cấu hình Xuất Excel" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                                    <TextBlock Text="Chọn các cột cần xuất:" Margin="0,0,0,12" Foreground="#B0BEC5" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding ExportColumns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding ColumnName}" IsChecked="{Binding IsSelected}" Foreground="White" Margin="0,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Hủy" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                                    <Button Content="Xuất File" Command="{Binding ExecuteExportExcelCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" materialDesign:ButtonAssist.CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </materialDesign:DialogHost.DialogContent>
                    
                    <materialDesign:DialogHost IsOpen="{Binding IsCallManagerDialogOpen}" CloseOnClickAway="True">
                    <materialDesign:DialogHost.DialogContent>
                    <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                        <Grid Width="780">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <materialDesign:PackIcon Kind="PhoneForward" Width="28" Height="28" Foreground="#8BC34A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý cuộc gọi (Voice Call Hub)" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox ItemsSource="{Binding CallManagerPortOptions}" SelectedValue="{Binding CallManagerSelectedPort}" 
                                          materialDesign:HintAssist.Hint="Chọn cổng thao tác" Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                          Foreground="White" Margin="0,0,20,0"/>
                                          
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="Bật Caller ID (CLIP)" Command="{Binding CallManagerActionCommand}" CommandParameter="EnableClip" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+CLIP=1"/>
                                    <Button Content="Ẩn số gọi đi (CLIR)" Command="{Binding CallManagerActionCommand}" CommandParameter="EnableClir" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+CLIR=1"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource ProDialogSectionStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="ĐIỀU KHIỂN CUỘC GỌI" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox materialDesign:HintAssist.Hint="SĐT gọi đi" Text="{Binding CallPhoneNumber}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Gọi đi" Command="{Binding CallManagerActionCommand}" CommandParameter="Dial" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" ToolTip="ATD;"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox materialDesign:HintAssist.Hint="Gửi DTMF (VD: 1, 2, #)" Text="{Binding DtmfTones}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Gửi Tone" Command="{Binding CallManagerActionCommand}" CommandParameter="SendDtmf" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" BorderBrush="#FF9800" ToolTip="AT+VTS"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="Bắt máy" Command="{Binding CallManagerActionCommand}" CommandParameter="Answer" Style="{StaticResource MaterialDesignRaisedButton}" Background="#8BC34A" BorderBrush="#8BC34A" Margin="0,0,10,0" ToolTip="ATA"/>
                                            <Button Content="Ngắt máy" Command="{Binding CallManagerActionCommand}" CommandParameter="HangUp" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E53935" BorderBrush="#E53935" Margin="0,0,10,0" ToolTip="ATH"/>
                                            <Button Content="Hold/Multi" Command="{Binding CallManagerActionCommand}" CommandParameter="Hold" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+CHLD=2"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="CẤU HÌNH &amp; CHUYỂN TIẾP" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox materialDesign:HintAssist.Hint="SĐT Chuyển tiếp" Text="{Binding ForwardNumber}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Chuyển tiếp" Command="{Binding CallManagerActionCommand}" CommandParameter="SetForwarding" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2196F3" BorderBrush="#2196F3" ToolTip="AT+CCFC"/>
                                        </Grid>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button Content="DS Cuộc Gọi (CLCC)" Command="{Binding CallManagerActionCommand}" CommandParameter="CallStatus" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" ToolTip="AT+CLCC" Margin="0,0,10,10"/>
                                            <Button Content="Call Waiting" Command="{Binding CallManagerActionCommand}" CommandParameter="CallWaiting" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+CCWA=1,1,1" Margin="0,0,10,10"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBox Grid.Row="3" Text="{Binding CallManagerOutput}" IsReadOnly="True" 
                                     Height="220" Style="{StaticResource ProTerminalTextBoxStyle}"
                                     Margin="0,0,0,24"/>
                            
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Đóng" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </materialDesign:DialogHost.DialogContent>

                <materialDesign:DialogHost IsOpen="{Binding IsNetworkSimDialogOpen}" CloseOnClickAway="True">
                    <materialDesign:DialogHost.DialogContent>
                    <Border Background="#1E1E2E" CornerRadius="12" Padding="24">
                        <Grid Width="920">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <materialDesign:PackIcon Kind="AccessPointNetwork" Width="28" Height="28" Foreground="#FF5722" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Cấu hình Mạng &amp; SIM (Network &amp; SIM Hub)" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox ItemsSource="{Binding CallManagerPortOptions}" SelectedValue="{Binding NetworkSimSelectedPort}" 
                                          materialDesign:HintAssist.Hint="Chọn cổng thao tác" Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                          Foreground="White" Margin="0,0,20,0"/>
                                          
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="Đọc IMSI" Command="{Binding NetworkSimActionCommand}" CommandParameter="ReadImsi" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+CIMI"/>
                                    <Button Content="Đọc ICCID" Command="{Binding NetworkSimActionCommand}" CommandParameter="ReadIccid" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+QCCID"/>
                                    <Button Content="SIM Detect" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckSimDetect" Style="{StaticResource ModernButtonStyle}" Background="#424242" ToolTip="AT+QSIMSTAT?"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource ProDialogSectionStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Column 1: Cấu hình mạng -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="CẤU HÌNH MẠNG" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox materialDesign:HintAssist.Hint="ID Nhà mạng" Text="{Binding NetworkOperator}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Đặt" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetOperatorManual" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2196F3" BorderBrush="#2196F3" ToolTip="AT+COPS=1,2,..."/>
                                        </Grid>
                                        <Button Content="Tự động chọn mạng (Auto)" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetOperatorAuto" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+COPS=0"/>
                                        <Button Content="Chế độ quét Auto" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetScanAuto" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+QCFG=nwscanmode,0"/>
                                        <Button Content="Chỉ quét 4G (LTE Only)" Command="{Binding NetworkSimActionCommand}" CommandParameter="SetScanLte" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+QCFG=nwscanmode,3"/>
                                    </StackPanel>
                                    
                                    <!-- Column 2: Thông tin & Kiểm tra sóng -->
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock Text="KIỂM TRA SÓNG" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Button Content="Kiểm tra tín hiệu (CSQ)" Command="{Binding NetworkSimActionCommand}" CommandParameter="SignalQuality" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+CSQ"/>
                                        <Button Content="Thông tin mạng (QNWINFO)" Command="{Binding NetworkSimActionCommand}" CommandParameter="NetworkInfo" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+QNWINFO"/>
                                        <Button Content="Trạng thái đăng ký (CREG)" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckRegistration" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+CREG?"/>
                                        <Button Content="Nhà mạng hiện tại (COPS)" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckOperator" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+COPS?"/>
                                    </StackPanel>

                                    <!-- Column 3: Bảo mật & Danh bạ -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="BẢO MẬT &amp; TIỆN ÍCH" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox materialDesign:HintAssist.Hint="Mã PIN" Text="{Binding PinCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Nhập PIN" Command="{Binding NetworkSimActionCommand}" CommandParameter="EnterPin" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" BorderBrush="#FF9800" ToolTip="AT+CPIN"/>
                                        </Grid>
                                        <Button Content="Trạng thái mã PIN" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckPinStatus" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+CPIN?"/>
                                        <Button Content="Đọc danh bạ (CPBR)" Command="{Binding NetworkSimActionCommand}" CommandParameter="ReadPhonebook" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+CPBR=1,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox materialDesign:HintAssist.Hint="Gửi USSD tuỳ chỉnh hoặc chọn lệnh" 
                                                      IsEditable="True"
                                                      ItemsSource="{Binding Path=DataContext.PredefinedUssdCommands, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValuePath="Key"
                                                      Text="{Binding UssdCommand}" 
                                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" Foreground="White" Margin="0,0,10,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="70"/>
                                                            <TextBlock Text=" - " Foreground="Gray"/>
                                                            <TextBlock Text="{Binding Value}" Foreground="#B2EBF2" FontStyle="Italic"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="Gửi" Command="{Binding NetworkSimActionCommand}" CommandParameter="SendUssd" Style="{StaticResource MaterialDesignRaisedButton}" Background="#8BC34A" BorderBrush="#8BC34A" ToolTip="AT+CUSD"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBox Grid.Row="3" Text="{Binding NetworkSimOutput}" IsReadOnly="True" 
                                     Height="240" Style="{StaticResource ProTerminalTextBoxStyle}"
                                     Margin="0,0,0,24"/>
                            
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Đóng" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </materialDesign:DialogHost.DialogContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Nav -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Terminal -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Navigation -->
        <Grid Grid.Row="0" Background="{StaticResource PanelBackground}" Height="50">
            <!-- Segmented Control for Tabs -->
            <Border Background="#12121E" CornerRadius="15" HorizontalAlignment="Center" Padding="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="GSM" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2" Width="100" FontWeight="Bold"/>
                    <RadioButton Content="SMS" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2" Width="100" FontWeight="Bold"/>
                    <RadioButton Content="QUEUE" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2" Width="100" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Thông báo 0" Foreground="#E91E63" BorderBrush="#E91E63" Height="28" Padding="10,0" materialDesign:ButtonAssist.CornerRadius="14"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Settings" Height="36" Width="36" Margin="10,0,0,0" Command="{Binding OpenSettingsDialogCommand}">
                    <materialDesign:PackIcon Kind="Cog" Foreground="White" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: GSM -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- ToolBar GSM -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1">
                        <WrapPanel Margin="10,5">
                            <Button Background="#5C6BC0" Command="{Binding OpenAtCommandDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Terminal" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Bảng lệnh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#F06292" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Sắp xếp cổng">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SortAscending" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Sắp xếp cổng" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Sắp xếp theo thứ tự COM" Command="{Binding SortPortsCommand}" CommandParameter="COM">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="SortNumericAscending"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Nhà mạng" Command="{Binding SortPortsCommand}" CommandParameter="Network">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Sim"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Trạng thái (Online)" Command="{Binding SortPortsCommand}" CommandParameter="Status">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="CheckCircle"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Cường độ sóng" Command="{Binding SortPortsCommand}" CommandParameter="Signal">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Signal"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Số dư (Cao - Thấp)" Command="{Binding SortPortsCommand}" CommandParameter="Balance">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Wallet"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Kiểm tra số dư">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wallet" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Kiểm tra số dư" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Kiểm tra số dư TẤT CẢ các cổng" Command="{Binding CheckBalanceCommand}" CommandParameter="All">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="WalletPlus"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Kiểm tra số dư CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding CheckBalanceCommand}" CommandParameter="Selected">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="WalletOutline"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Background="#424242" Command="{Binding OpenCustomUssdDialogCommand}" CommandParameter="All" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Dialpad" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="USSD Tùy chỉnh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#424242" Command="{Binding OpenExportExcelDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#4CAF50"/>
                                    <TextBlock Text="Xuất Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Làm mới hoặc Khởi động lại cổng">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Làm mới / Reset" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Làm mới danh sách cổng (Refresh)" Command="{Binding RefreshPortsCommand}">
                                        </MenuItem>
                                        <Separator Background="#444"/>
                                        <MenuItem Header="⚡ Khởi động lại Modem CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding RebootModemCommand}" CommandParameter="Selected">
                                        </MenuItem>
                                        <MenuItem Header="⚡ Khởi động lại TẤT CẢ Modem" Command="{Binding RebootModemCommand}" CommandParameter="All">
                                        </MenuItem>
                                        <Separator Background="#444"/>
                                        <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding ClearSmsCommand}" CommandParameter="Selected">
                                        </MenuItem>
                                        <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên TẤT CẢ CỔNG" Command="{Binding ClearSmsCommand}" CommandParameter="All">
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Background="#29B6F6" Command="{Binding OpenNetworkSimDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Sim" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Mạng &amp; SIM" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#26C6DA" Command="{Binding OpenTopUpDialogCommand}" CommandParameter="All" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CreditCardPlus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Nạp thẻ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#AB47BC" Command="{Binding OpenComposeSmsDialogCommand}" CommandParameter="Selected" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MessageText" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Soạn tin nhắn" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#66BB6A" Command="{Binding OpenCallManagerDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Phone" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Quản lý cuộc gọi" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Toggles for Watchdog and Auto-Answer -->
                            <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Đẩy OTT Web" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ToggleButton IsChecked="{Binding IsWebNotificationEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Đẩy OTP/SMS lên máy chủ Web"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Đẩy Telegram" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ToggleButton IsChecked="{Binding IsTelegramNotificationEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bắn thông báo OTP/SMS qua Telegram"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tự phục hồi (Watchdog)" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ToggleButton IsChecked="{Binding IsWatchdogEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Tự động khởi động lại Modem (AT+CFUN=1,1) khi bị lỗi/mất sóng"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tự nhấc máy" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ToggleButton IsChecked="{Binding IsAutoAnswerEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Tự động bắt máy (ATA) khi có cuộc gọi đến"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔 Âm thanh" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ToggleButton IsChecked="{Binding IsSoundAlertEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bật/tắt âm thanh cảnh báo khi nhận OTP/SMS/Cuộc gọi"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔 Âm Toast" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ToggleButton IsChecked="{Binding IsToastSoundEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bật/tắt âm thanh mặc định của thông báo góc màn hình Windows"/>
                                </StackPanel>
                            </Border>

                        </WrapPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="8" Margin="10,10,10,0">
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Tổng COM" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding TotalPortCount}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#11281F" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Online" Foreground="#8BE6B0" FontSize="11"/>
                                <TextBlock Text="{Binding OnlinePortCount}" Foreground="#4CAF50" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2A1820" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Offline" Foreground="#FF9AA8" FontSize="11"/>
                                <TextBlock Text="{Binding OfflinePortCount}" Foreground="#FF5252" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SMS nhận" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding SmsReceivedCount}" Foreground="#FF9800" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2A1820" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Lỗi SMS" Foreground="#FF9AA8" FontSize="11"/>
                                <TextBlock Text="{Binding SmsFailedCount}" Foreground="#FF5252" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2B2414" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Timeout" Foreground="#FFD27A" FontSize="11"/>
                                <TextBlock Text="{Binding TimeoutTotalCount}" Foreground="#FFC107" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2B2414" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Cooldown" Foreground="#FFD27A" FontSize="11"/>
                                <TextBlock Text="{Binding CooldownPortCount}" Foreground="#FFC107" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Lỗi nhiều nhất" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding TopProblemPort}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <!-- GSM DataGrid Wrapper -->
                    <Border Grid.Row="2" Background="#1E1E2F" CornerRadius="12" Margin="10" BorderThickness="1" BorderBrush="#2A2A40">
                        <DataGrid ItemsSource="{Binding FilteredPortsView}" SelectedItem="{Binding SelectedPort}" 
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  Style="{StaticResource ProDataGridStyle}"
                                  Margin="1"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#1E1E2F" Foreground="White">
                                <MenuItem Header="Sao chép SĐT" Command="{Binding Path=DataContext.CopyPhoneFromPortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Padding="10">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="#444"/>
                                <MenuItem Header="Nạp thẻ nhanh" Command="{Binding Path=DataContext.OpenTopUpDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Selected" Padding="10" Foreground="#4CAF50">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CashPlus"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Kiểm tra số dư (Các cổng đã chọn)" Command="{Binding Path=DataContext.CheckBalanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Selected" Padding="10">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Magnify"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="USSD Tùy chỉnh" Command="{Binding Path=DataContext.OpenCustomUssdDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Checked" Padding="10">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CodeBraces"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="☑" ToolTip="Tick để chọn nhiều SIM"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" SortMemberPath="PortNumber" Width="120" HeaderTemplate="{StaticResource PortNameHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="IMEI" Binding="{Binding Imei}" Width="160" HeaderTemplate="{StaticResource ImeiHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Serial" Binding="{Binding Serial}" Width="180" HeaderTemplate="{StaticResource SerialHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SĐT" Binding="{Binding PhoneNumber}" Width="150" HeaderTemplate="{StaticResource PhoneHeaderTemplate}"/>
                            <DataGridTemplateColumn Header="TKC" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Balance}" TextWrapping="Wrap" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="OTP" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Otp}" Value="{x:Null}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Otp}" Value="">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Otp}" TextWrapping="Wrap" Foreground="#FF9800" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding LastMessageContent}" Width="800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Ngày tạo" Binding="{Binding CreatedAt}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="License Suffix" Binding="{Binding LicenseKeySuffix}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lệch Key" Binding="{Binding KeyMismatch}" Width="100"/>
                            <DataGridTemplateColumn Header="Kết nối" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33F44336"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#334CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Background" Value="#339E9E9E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Health" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#263238" CornerRadius="10" Padding="8,3" ToolTip="{Binding LastError}">
                                            <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" Foreground="#B2EBF2" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Timeout" Binding="{Binding TimeoutCount}" Width="75"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi SMS" Binding="{Binding SmsErrorCount}" Width="75"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Reconnect" Binding="{Binding ReconnectCount}" Width="85"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SMS cuối" Binding="{Binding LastSmsSentAt}" Width="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi cuối" Binding="{Binding LastError}" Width="180"/>
                            
                            <!-- Tín hiệu Signal Bars -->
                            <DataGridTemplateColumn Header="Tín hiệu" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                            <ProgressBar Value="{Binding SignalStrength}" Maximum="100" Height="10" Width="40" Background="#444" Foreground="#4CAF50" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            <TextBlock Text="{Binding SignalStrength, StringFormat={}{0}%}" Margin="5,0,0,0" FontSize="11" Foreground="LightGray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            
                            <!-- #8: Tô đỏ HSD nếu sắp hết hạn (dưới 7 ngày) -->
                            <DataGridTemplateColumn Header="HSD" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpiryDate}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- #4: Cột số điện thoại nhận chuyển hướng -->
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Fwd→" Binding="{Binding ForwardedTo}" Width="130" Foreground="#03A9F4"/>
                            
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cập nhật lúc" Binding="{Binding UpdatedAt}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lúc" Binding="{Binding LastReceivedTime}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SMS -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top filter bar for SMS -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="#F06292" Width="20" Height="20" Margin="0,0,15,0"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsPhoneFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nhập SĐT..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="CỔNG" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="100" Text="{Binding SmsPortFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm cổng..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="NGƯỜI GỬI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsSenderFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm người gửi..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="Lọc Dữ Liệu" Command="{Binding ApplySmsFilterCommand}" Background="#F06292" Style="{StaticResource ModernButtonStyle}" Width="110" Height="34" VerticalAlignment="Bottom" Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Command="{Binding MarkAllSmsReadCommand}" Background="#424242" Style="{StaticResource ModernButtonStyle}" ToolTip="Đánh dấu đã đọc" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="CheckAll" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding DeleteFilteredSmsCommand}" Background="#E53935" Style="{StaticResource ModernButtonStyle}" ToolTip="Xóa tin nhắn" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="White"/>
                                </Button>
                                <Button Content="Xuất Excel" Background="#4CAF50" Command="{Binding ExportSmsToExcelCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DataGrid Margin="10" ItemsSource="{Binding FilteredSmsMessages}"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="{StaticResource PanelBackground}"
                                  RowBackground="{StaticResource PanelBackground}" AlternatingRowBackground="#2A2A40"
                                  Foreground="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#444" VerticalGridLinesBrush="#444"
                                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#444"
                                  ColumnHeaderStyle="{StaticResource CustomHeaderStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#1E1E2F" Foreground="White">
                                <MenuItem Header="Sao chép OTP" Command="{Binding Path=DataContext.CopyOtpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Padding="10">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Xóa tin nhắn này" Command="{Binding Path=DataContext.DeleteSmsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Padding="10" Foreground="#E53935">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Delete"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Số điện thoại" Binding="{Binding ReceiverPhone}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhận lúc" Binding="{Binding ReceivedTime}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="OTP" Binding="{Binding Otp}" Width="100" Foreground="#FF9800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cuộc gọi" Binding="{Binding CallCount}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Chuyển lời" Binding="{Binding ForwardContent}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding Content}" Width="800"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: COMMAND QUEUE -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="15,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TimelineClockOutline" Foreground="#5C6BC0" Width="22" Height="22" Margin="0,0,10,0"/>
                            <TextBlock Text="COMMAND QUEUE REALTIME" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CommandQueue.Count, StringFormat='  ({0} lệnh gần nhất)'}" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" Margin="10" ItemsSource="{Binding CommandQueue}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="{StaticResource PanelBackground}" RowBackground="{StaticResource PanelBackground}" AlternatingRowBackground="#2A2A40"
                              Foreground="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#444" VerticalGridLinesBrush="#444"
                              HeadersVisibility="Column" BorderThickness="1" BorderBrush="#444"
                              ColumnHeaderStyle="{StaticResource CustomHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lúc" Binding="{Binding UpdatedAt}" Width="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="CommandId" Binding="{Binding CommandId}" Width="220"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="COM" Binding="{Binding PortId}" Width="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Loại" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Gửi đến" Binding="{Binding Recipient}" Width="130"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding Content}" Width="260"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Kết quả" Binding="{Binding Result}" Width="260"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi" Binding="{Binding Error}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: LỊCH SỬ OTP -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockTimeEightOutline" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Lịch Sử OTP" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter bar -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" VerticalAlignment="Center" Foreground="#FF9800" Width="22" Height="22" Margin="0,0,12,0"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                                    <TextBlock Text="SĐT SIM" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="120" Text="{Binding OtpHistoryFilterPhone, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="SĐT..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                                    <TextBlock Text="SENDER" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="110" Text="{Binding OtpHistoryFilterSender, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Sender..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                                    <TextBlock Text="CỔNG" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="80" Text="{Binding OtpHistoryFilterPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="COM..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                                    <TextBlock Text="NGÀY" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="100" Text="{Binding OtpHistoryFilterDate, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="VD: 2026-06" Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                                    <TextBlock Text="NỘI DUNG" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding OtpHistoryFilterContent, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm nội dung..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="Xóa lọc" Command="{Binding ClearOtpHistoryFilterCommand}" Background="#607D8B" Style="{StaticResource ModernButtonStyle}" Width="70" Height="34" VerticalAlignment="Bottom" Margin="0,0,8,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding FilteredOtpHistoryCount, StringFormat='Kết quả: {0} bản ghi'}" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                                <Button Content="Tải lại" Command="{Binding LoadOtpHistoryCommand}" Background="#455A64" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Xuất Excel" Command="{Binding ExportOtpHistoryToExcelCommand}" Background="#4CAF50" Style="{StaticResource ModernButtonStyle}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OTP History DataGrid -->
                    <Border Grid.Row="1" Background="#1E1E2F" CornerRadius="12" Margin="10" BorderThickness="1" BorderBrush="#2A2A40">
                        <DataGrid ItemsSource="{Binding FilteredOtpHistory}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="{StaticResource PanelBackground}" RowBackground="{StaticResource PanelBackground}" AlternatingRowBackground="#2A2A40"
                                  Foreground="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#444" VerticalGridLinesBrush="#444"
                                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#444"
                                  ColumnHeaderStyle="{StaticResource CustomHeaderStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#1E1E2F" Foreground="White">
                                    <MenuItem Header="Sao chép OTP" Command="{Binding Path=DataContext.CopyOtpFromHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Padding="10">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Thời gian" Binding="{Binding Timestamp}" Width="155"/>
                                <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding Port}" Width="100"/>
                                <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SĐT SIM" Binding="{Binding SimPhone}" Width="130"/>
                                <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Sender" Binding="{Binding Sender}" Width="120"/>
                                <DataGridTemplateColumn Header="OTP" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="6,2" Background="#33FF9800" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Otp}" Foreground="#FF9800" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding Content}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- WEBHOOK RULE DIALOG (nằm ngoài TabControl nhưng trong Grid chính) -->
        <Border Grid.RowSpan="4" Visibility="{Binding IsWebhookDialogOpen, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="#1E1E2E" Padding="28" Width="540" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <materialDesign:PackIcon Kind="WebhookOutline" Width="28" Height="28" Foreground="#5C6BC0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Thêm Webhook Rule"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingExistingWebhookRule}" Value="True">
                                        <Setter Property="Text" Value="Sửa Webhook Rule"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBox materialDesign:HintAssist.Hint="Tên rule (VD: Forward OTP Zalo)" Text="{Binding EditingWebhookRule.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,15"/>
                    <TextBox materialDesign:HintAssist.Hint="URL Webhook (VD: https://webhook.site/abc)" Text="{Binding EditingWebhookRule.WebhookUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,15"/>
                    <TextBox materialDesign:HintAssist.Hint="Lọc Sender (rổng=tất cả, VD: Zalo,8500,ZALO)" Text="{Binding EditingWebhookRule.SenderFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,15"/>
                    <TextBox materialDesign:HintAssist.Hint="Header bí mật (VD: X-Secret: token123)" Text="{Binding EditingWebhookRule.SecretHeader, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="Chỉ gửi khi có OTP (OTP Only)" IsChecked="{Binding EditingWebhookRule.OtpOnly}" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,30,0"/>
                        <CheckBox Content="Bật rule này" IsChecked="{Binding EditingWebhookRule.Enabled}" Foreground="#4CAF50" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Command="{Binding CloseWebhookDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A" Margin="0,0,12,0"/>
                    <Button Content="Lưu Rule" Command="{Binding SaveWebhookRuleCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#5C6BC0" BorderBrush="#5C6BC0" materialDesign:ButtonAssist.CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- #6: Terminal Log với bộ lọc theo cổng -->
        <Expander Grid.Row="2" Background="#0C0C14" Foreground="#4CAF50" ExpandDirection="Up" Padding="0" Header="Lịch sử AT Commands (Terminal)" FontFamily="Consolas">
            <Border BorderBrush="#333" BorderThickness="0,1,0,0" Height="170">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Filter bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#0C0C14" Margin="10,4">
                        <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0"/>
                        <TextBox Width="120" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Lọc cổng (VD: COM41)"
                                 Style="{StaticResource SearchTextBoxStyle}" FontFamily="Consolas" Foreground="#4CAF50"/>
                        <Button Content="All" Command="{Binding SetLogFilterCommand}" CommandParameter="" Background="#333344" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="8,0,0,0"/>
                        <Button Content="IMEI" Command="{Binding SetLogFilterCommand}" CommandParameter="[IMEI]" Background="#455A64" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="Firebase" Command="{Binding SetLogFilterCommand}" CommandParameter="[FIREBASE]" Background="#5C6BC0" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="SMS" Command="{Binding SetLogFilterCommand}" CommandParameter="[SMS]" Background="#00897B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="USSD" Command="{Binding SetLogFilterCommand}" CommandParameter="[USSD]" Background="#7E57C2" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <TextBlock Text="|" Foreground="#444" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilteredLogCount, StringFormat='Hiển thị: {0} dòng'}" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>
                        <Button Content="Reload IMEI CSV" Command="{Binding ReloadImeiBackupCommand}" Background="#607D8B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="10,0" Margin="12,0,0,0" ToolTip="Nạp lại imei_backup.csv và imei-lookup-*.csv trong thư mục chạy"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}" Background="Transparent" BorderThickness="0" Margin="10,0,10,6">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="#1E1E2F" Foreground="White">
                                <MenuItem Header="Sao chép" Command="{Binding Path=DataContext.CopySelectedLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Padding="10">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sao chép tất cả" Command="{Binding Path=DataContext.CopyAllLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Padding="10">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="Gray" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Level}" Foreground="Cyan" Margin="0,0,10,0" Width="50"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Expander>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#1A1A2A" Foreground="Gray" Padding="10,5">
            <StatusBarItem>
                <TextBlock Text="{Binding Ports.Count, StringFormat='Số lượng cổng: \{0\}'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SmsMessages.Count, StringFormat='Mẹo: Giữ Ctrl và lăn chuột để phóng to/thu nhỏ bảng | Tổng SMS: \{0\}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Global Snackbar Notifications -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}" Grid.RowSpan="4"/>
    </Grid>
                        </materialDesign:DialogHost>
                    </materialDesign:DialogHost>
                </materialDesign:DialogHost>
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>
    </materialDesign:DialogHost>
    </materialDesign:DialogHost>
</materialDesign:DialogHost>
</Window>
