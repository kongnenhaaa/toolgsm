                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <!-- Cảnh báo chưa hỗ trợ -->
                                <Border Background="#33FF5722" BorderBrush="#FF5722" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <TextBlock Text="⚠️ Tính năng Đổi IMEI qua Hàng đợi lệnh bị khóa để đảm bảo an toàn. Việc đổi IMEI sẽ khởi động lại sóng, làm đứt kết nối cổng COM và gãy toàn bộ hàng đợi phía sau. Vui lòng bật Fake IMEI tự động ở phần Cài Đặt." Foreground="#FFCCBC" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- IMEI -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Mã IMEI" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelImeiValue, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Trễ -->
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Delay">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Thời gian trễ -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Thời gian" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandPanelDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                    <TextBlock Grid.Column="2" Text="giây" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Chế độ" Foreground="White" VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding CommandPanelModeIndex}"
                                              Height="28">
                                        <ComboBoxItem Content="Đồng thời"/>
                                        <ComboBoxItem Content="Tuần tự"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Text="Thử lại"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CommandPanelRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1e293b"
                                             Foreground="White"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             Padding="8,3"/>
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Chạy"
                                    Background="#625BFF"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="26"
                                    Margin="0,0,8,0"
                                    Command="{Binding RunCommandQueueCommand}"/>

                            <Button Content="Chạy cộng lỗi"
                                    Background="#EC3F9B"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="26"
                                    Margin="0,0,8,0"
                                    Command="{Binding RunWithErrorCommandQueueCommand}"/>

                            <Button Content="+ Thêm"
                                    Background="#12B886"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="26"
                                    Command="{Binding AddCommandQueueCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="2"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#334155"
                              ShowsPreview="True"
                              Cursor="SizeNS"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <!-- Header kịch bản -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,8,2">
                        <TextBlock Text="Kịch bản" Foreground="#DDE2FF" FontWeight="Bold"/>
                        <TextBlock Text="  0" Foreground="#00D1C7" FontWeight="Bold"/>
                        <TextBlock Text="  3" Foreground="#625BFF" FontWeight="Bold"/>
                        <TextBlock Text="  4" Foreground="#FFC857" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Bảng kịch bản -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CommandQueue}"
                              Style="{StaticResource ProDataGridStyle}"
                              Margin="6,0,6,6"
                              HeadersVisibility="Column"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="55"/>
                            <DataGridTextColumn Header="Đến" Binding="{Binding Recipient}" Width="80"/>
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="*"/>
                            <DataGridTextColumn Header="Cơ chế" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="Thử lại" Binding="{Binding Error}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,0,6,6">
                        <Button Content="Chạy" Background="#625BFF" Style="{StaticResource ModernButtonStyle}" Height="26" Margin="0,0,8,0" Command="{Binding RunCommandQueueCommand}"/>
                        <Button Content="Chạy cộng lỗi" Background="#EC3F9B" Style="{StaticResource ModernButtonStyle}" Height="26" Margin="0,0,8,0" Command="{Binding RunWithErrorCommandQueueCommand}"/>
                        <Button Content="Xóa" Background="#D94B59" Style="{StaticResource ModernButtonStyle}" Height="26" Margin="0,0,8,0" Command="{Binding ClearCommandQueueCommand}"/>
                        <Button Content="Nhập" Background="#12B886" Style="{StaticResource ModernButtonStyle}" Height="26" Margin="0,0,8,0" Command="{Binding ImportCommandQueueCommand}"/>
                        <Button Content="Sao chép" Background="#00AEEF" Style="{StaticResource ModernButtonStyle}" Height="26" Command="{Binding CopyCommandQueueCommand}"/>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Row="4"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#334155"
                              ShowsPreview="True"
                              Cursor="SizeNS"/>

                <!-- Hàng đợi -->
                <Border Grid.Row="5" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Hàng đợi"
                                   Foreground="#DDE2FF"
                                   FontWeight="Bold"
                                   Margin="8,4,0,0"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Ports}"
                                  Style="{StaticResource ProDataGridStyle}"
                                  Margin="6"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cổng" Binding="{Binding PortName}" Width="65"/>
                                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="115"/>
                                <DataGridTextColumn Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="85"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Status}" Width="70"/>
                                <DataGridTextColumn Header="Người nhận" Binding="{Binding Sender}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>



        <!-- #6: Terminal Log với bộ lọc theo cổng -->
        <Expander Grid.Row="2" Background="#020617" Foreground="#4CAF50" ExpandDirection="Up" Padding="0" Header="Lịch sử AT Commands (Terminal)" FontFamily="Consolas">
            <Border BorderBrush="#333" BorderThickness="0,1,0,0" Height="170">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Filter bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#020617" Margin="10,4">
                        <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0"/>
                        <TextBox Width="120" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Lọc cổng (VD: COM41)"
                                 Style="{StaticResource SearchTextBoxStyle}" FontFamily="Consolas" Foreground="#4CAF50"/>
                        <Button Content="All" Command="{Binding SetLogFilterCommand}" CommandParameter="" Background="#333344" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="8,0,0,0"/>
                        <Button Content="IMEI" Command="{Binding SetLogFilterCommand}" CommandParameter="[IMEI]" Background="#455A64" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="Firebase" Command="{Binding SetLogFilterCommand}" CommandParameter="[FIREBASE]" Background="#5C6BC0" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="SMS" Command="{Binding SetLogFilterCommand}" CommandParameter="[SMS]" Background="#00897B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <Button Content="USSD" Command="{Binding SetLogFilterCommand}" CommandParameter="[USSD]" Background="#7E57C2" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="8,0" Margin="5,0,0,0"/>
                        <TextBlock Text="|" Foreground="#444" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilteredLogCount, StringFormat='Hiển thị: {0} dòng'}" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>
                        <Button Content="Reload IMEI CSV" Command="{Binding ReloadImeiBackupCommand}" Background="#607D8B" Style="{StaticResource ModernButtonStyle}" Height="24" FontSize="11" Padding="10,0" Margin="12,0,0,0" ToolTip="Nạp lại imei_backup.csv và imei-lookup-*.csv trong thư mục chạy"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}" Background="Transparent" BorderThickness="0" Margin="10,0,10,6">
                        <ListBox.ContextMenu>
                            <ContextMenu >
                                <MenuItem Header="Sao chép" Command="{Binding Path=DataContext.CopySelectedLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sao chép tất cả" Command="{Binding Path=DataContext.CopyAllLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="Gray" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Level}" Foreground="Cyan" Margin="0,0,10,0" Width="50"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Expander>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#020617" Foreground="#94a3b8" Padding="10,5" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Ports.Count, StringFormat='Số lượng cổng: \{0\}'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SmsMessages.Count, StringFormat='Mẹo: Giữ Ctrl và lăn chuột để phóng to/thu nhỏ bảng | Tổng SMS: \{0\}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Global Snackbar Notifications -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}" Grid.RowSpan="4"/>
        </Grid> <!-- Close Main Workspace Grid -->
    </Grid> <!-- Close Outer Grid -->
                        <!-- DialogHost closing tag removed -->
                    <!-- DialogHost closing tag removed -->
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>
    </materialDesign:DialogHost>
    </materialDesign:DialogHost>
</materialDesign:DialogHost>
</Window>

