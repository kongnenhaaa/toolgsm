                        <Separator Background="#334155" Margin="10,15" />
                        <TextBlock Text="CÔNG CỤ" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold" Margin="15,0,0,10" Style="{StaticResource SidebarTextStyle}"/>
                        
                        <Button Background="#5C6BC0" Command="{Binding ToggleCommandPanelCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="Mở/đóng bảng lệnh" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
