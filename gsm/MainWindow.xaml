                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Serial" Binding="{Binding Serial}" Width="180" HeaderTemplate="{StaticResource SerialHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SĐT" Binding="{Binding PhoneNumber}" Width="150" HeaderTemplate="{StaticResource PhoneHeaderTemplate}"/>
                            <DataGridTemplateColumn Header="TKC" Width="110" ClipboardContentBinding="{Binding Balance}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Balance}" TextWrapping="Wrap" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="OTP" Width="110" ClipboardContentBinding="{Binding Otp}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Otp}" Value="{x:Null}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Otp}" Value="">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Otp}" TextWrapping="Wrap" Foreground="#FF9800" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Quét vét" Binding="{Binding LastSweepTime}" Width="90" Foreground="#00E676"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding LastMessageContent}" Width="800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Ngày tạo" Binding="{Binding CreatedAt}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="License Suffix" Binding="{Binding LicenseKeySuffix}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lệch Key" Binding="{Binding KeyMismatch}" Width="100"/>
                            <DataGridTemplateColumn Header="Kết nối" Width="110" ClipboardContentBinding="{Binding Status}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33F44336"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#334CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Background" Value="#339E9E9E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Health" Width="150" ClipboardContentBinding="{Binding HealthSummary}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#263238" CornerRadius="10" Padding="8,3" ToolTip="{Binding LastError}">
                                            <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" Foreground="#B2EBF2" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Timeout" Binding="{Binding TimeoutCount}" Width="75"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi SMS" Binding="{Binding SmsErrorCount}" Width="75"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Reconnect" Binding="{Binding ReconnectCount}" Width="85"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SMS cuối" Binding="{Binding LastSmsSentAt}" Width="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi cuối" Binding="{Binding LastError}" Width="180"/>
                            
                            <!-- Tín hiệu Signal Bars -->
                            <DataGridTemplateColumn Header="Tín hiệu" Width="100" ClipboardContentBinding="{Binding SignalStrength}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                            <ProgressBar Value="{Binding SignalStrength}" Maximum="100" Height="10" Width="40" Background="#444" Foreground="#4CAF50" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            <TextBlock Text="{Binding SignalStrength, StringFormat={}{0}%}" Margin="5,0,0,0" FontSize="11" Foreground="LightGray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            
                            <!-- #8: Tô đỏ HSD nếu sắp hết hạn (dưới 7 ngày) -->
                            <DataGridTemplateColumn Header="HSD" Width="120" ClipboardContentBinding="{Binding ExpiryDate}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpiryDate}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- #4: Cột số điện thoại nhận chuyển hướng -->
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Fwd→" Binding="{Binding ForwardedTo}" Width="130" Foreground="#03A9F4"/>
                            
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cập nhật lúc" Binding="{Binding UpdatedAt}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lúc" Binding="{Binding LastReceivedTime}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SMS -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top filter bar for SMS -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="#F06292" Width="20" Height="20" Margin="0,0,15,0"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsPhoneFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nhập SĐT..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="CỔNG" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="100" Text="{Binding SmsPortFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm cổng..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="NGƯỜI GỬI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsSenderFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm người gửi..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="Lọc Dữ Liệu" Command="{Binding ApplySmsFilterCommand}" Background="#F06292" Style="{StaticResource ModernButtonStyle}" Width="110" Height="34" VerticalAlignment="Bottom" Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Command="{Binding MarkAllSmsReadCommand}" Background="#424242" Style="{StaticResource ModernButtonStyle}" ToolTip="Đánh dấu đã đọc" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="CheckAll" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding DeleteFilteredSmsCommand}" Background="#E53935" Style="{StaticResource ModernButtonStyle}" ToolTip="Xóa tin nhắn" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="White"/>
                                </Button>
                                <Button Content="Xuất Excel" Background="#4CAF50" Command="{Binding ExportSmsToExcelCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DataGrid Margin="10" ItemsSource="{Binding FilteredSmsMessages}"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="{StaticResource PanelBackground}"
                                  RowBackground="{StaticResource PanelBackground}" AlternatingRowBackground="#2A2A40"
                                  Foreground="White" GridLinesVisibility="All" HorizontalGridLinesBrush="#444" VerticalGridLinesBrush="#444"
                                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#444"
                                  ColumnHeaderStyle="{StaticResource CustomHeaderStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu >
                                <MenuItem Header="Sao chép OTP" Command="{Binding Path=DataContext.CopyOtpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Xóa tin nhắn này" Command="{Binding Path=DataContext.DeleteSmsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"  Foreground="#E53935">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Delete"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Số điện thoại" Binding="{Binding ReceiverPhone}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhận lúc" Binding="{Binding ReceivedTime}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="OTP" Binding="{Binding Otp}" Width="100" Foreground="#FF9800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cuộc gọi" Binding="{Binding CallCount}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Chuyển lời" Binding="{Binding ForwardContent}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding Content}" Width="800"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <!-- TAB 5: HƯỚNG DẪN SỬ DỤNG -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Hướng Dẫn" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="20" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="📖 HƯỚNG DẪN QUY TRÌNH KẾT NỐI MODEM &amp; CẮM SIM AN TOÀN 100%" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,20"/>

                        <Border Background="#1E1E2F" CornerRadius="10" Padding="20" BorderThickness="1" BorderBrush="#3D3D5C" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="CẢNH BÁO QUAN TRỌNG VỀ LỘ IMEI" FontSize="18" FontWeight="Bold" Foreground="#FF5252" Margin="0,0,0,15"/>
                                <TextBlock Text="Mạch GSM/Modem sẽ luôn tự động khởi động và BẬT SÓNG ngay khi được cấp nguồn từ cổng USB. Nếu bạn cắm SIM vào modem trước khi cắm USB vào máy tính, nhà mạng sẽ ngay lập tức nhận được IMEI gốc của phần cứng mạch. Phần mềm KHÔNG THỂ can thiệp chặn quá trình này nếu nó diễn ra trước khi Tool kết nối được với mạch."
                                           FontSize="14" Foreground="White" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="✅ QUY TRÌNH CHUẨN 3 BƯỚC (BẢO MẬT IMEI TUYỆT ĐỐI)" FontSize="18" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#5C6BC0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,5,0,0">
                                <TextBlock Text="Cắm Modem/Box vào PC (CHƯA CÓ SIM)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Hãy tháo toàn bộ SIM ra khỏi khay trước khi cắm cáp USB vào máy tính. Đảm bảo cổng COM đã hiện trong Device Manager." 
                                           FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#5C6BC0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,5,0,0">
                                <TextBlock Text="Mở Tool GSM Pro và chờ Khởi Tạo" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Mở ứng dụng Tool GSM Pro. Tool sẽ tự động quét các cổng COM và lập tức gửi lệnh ÉP TẮT SÓNG (AT+CFUN=4). Các cổng sẽ chuyển sang trạng thái Đang chờ cắm SIM (Hot-plug)." 
                                           FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,5,0,0">
                                <TextBlock Text="Tiến hành Cắm Nóng SIM (Hot-Plug)" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,8"/>
                                <TextBlock Text="Bây giờ bạn có thể lần lượt cắm SIM vào các khe. Tool sẽ tự động quét ngầm, phát hiện SIM mới, tạo/đổi IMEI Fake an toàn, và CHỈ BẬT SÓNG sau khi đã ghi IMEI Fake thành công. Sóng sẽ lên màu xanh (Active) và IMEI hiển thị là IMEI an toàn." 
                                           FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Background="#3D3D5C" Margin="0,10,0,20"/>
                        
                        <TextBlock Text="🛠 CÁC CƠ CHẾ BẢO VỆ ĐÃ ĐƯỢC TÍCH HỢP:" FontSize="16" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,15"/>
                        <TextBlock Text="• Khóa cứng (Safety Lock): Nếu Tool không thể ép tắt sóng ban đầu, cổng đó sẽ bị khóa hoàn toàn (STATUS_NO_RESPONSE) để bảo vệ." FontSize="14" Foreground="#B0BEC5" Margin="20,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="• Quét ngầm (Continuous Polling): Tool liên tục quét tìm SIM 24/24 (không giới hạn thời gian cắm nóng)." FontSize="14" Foreground="#B0BEC5" Margin="20,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="• Khóa kép (Double Lock): Trước khi ghi đè IMEI, Tool bồi thêm một lệnh tắt sóng tuyệt đối (AT+CFUN=0) và chỉ kích hoạt lại (AT+CFUN=1) nếu đã ghi xong." FontSize="14" Foreground="#B0BEC5" Margin="20,0,0,10" TextWrapping="Wrap"/>
                        
                        <Separator Background="#3D3D5C" Margin="0,20"/>
                        
                        <TextBlock Text="📱 HƯỚNG DẪN CÁC TÍNH NĂNG KHÁC" FontSize="20" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,20"/>
                        
                        <!-- Tính năng Webhook -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Web" Width="40" Height="40" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="1. Webhook Tự Động (Forward OTP/SMS lên Server)" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="Dùng để đẩy OTP tự động sang Telegram, Zalo, hoặc Website riêng.&#x0a;• Vào Cài Đặt (Bánh răng) -> Thêm Rule Webhook.&#x0a;• Bạn có thể lọc Sender (VD: Zalo, Telegram) hoặc tích 'Chỉ lấy OTP' để bỏ qua tin nhắn rác.&#x0a;• Dữ liệu gửi đi dạng JSON chuẩn." 
                                           FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tính năng USSD/Nạp thẻ -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
