@page "/sms"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject IPortSessionRegistry PortSessions
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_phone"
                          Label="Số điện thoại nhận"
                          Placeholder="900 / 888 / số điện thoại (mỗi dòng 1 đích)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_message"
                          Label="Nội dung tin nhắn"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudStack Spacing="1">
                <MudSelect T="string" @bind-Value="_sendMode" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Label="Gửi tới" FullWidth="true">
                    <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
                    <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
                </MudSelect>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Send" OnClick="SendNow"
                               Disabled="@(string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message) || _isConfirmingSend || _immediateBatches.IsStopping)"
                               FullWidth="true">
                        Gửi ngay
                    </MudButton>
                    @if (_immediateBatches.IsRunning)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error" Size="Size.Small"
                                       OnClick="StopImmediateSend" Disabled="@_immediateBatches.IsStopping"
                                       title="Dừng các lượt Gửi ngay đang chạy" />
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="AddToQueue"
                               Disabled="@(string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))"
                               FullWidth="true">
                        + Queue
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         PanelClass="pa-0" Class="mx-3 mt-1 feature-tabs"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_smsSubTab">

    <!-- TAB 1: DANH SÁCH CỔNG -->
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" Operation="SMS" @bind-SelectedItems="Vm.SelectedComPorts"
                  OnDeleteSmsStorage="ClearSelectedSimStorage"
                  IsDeletingSmsStorage="_isClearingSimSms" />
    </MudTabPanel>

    <!-- TAB 2: TIN NHẮN TỚI -->
    <MudTabPanel Text="@($"Tin nhắn tới ({IncomingSmsCount})")">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">
                    Lịch sử tin nhắn nhận được
                </MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearHistory"
                               Disabled="@(!IncomingSms.Any())">
                        Xóa tất cả
                    </MudButton>
                </MudStack>
            </MudStack>
            <MudTable Items="@IncomingSms" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 280px)" FixedHeader="true" Filter="FilterSms">
                <ToolBarContent>
                    <MudTextField @bind-Value="_smsFilter" Placeholder="Lọc theo số/nội dung..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Style="max-width:280px;" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SIM nhận</MudTh>
                    <MudTh>Người gửi</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh Style="width:100px;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:16px; white-space:nowrap;">@context.ReceivedTime</MudTd>
                    <MudTd Style="font-weight:600;">@context.PortName</MudTd>
                    <MudTd Style="font-size:16px; white-space:nowrap;">
                        <div style="font-weight:600; color:#0F172A;">@GetReceiverDisplay(context)</div>
                        @if (!string.IsNullOrWhiteSpace(context.NetworkProvider))
                        {
                            <div style="font-size:12px; color:#64748B;">@context.NetworkProvider</div>
                        }
                    </MudTd>
                    <MudTd Style="font-size:16px;">@context.Sender</MudTd>
                    <MudTd Style="font-size:16px; white-space:nowrap;"
                           title="@context.DisplayContent">
                        @context.DisplayContent
                    </MudTd>
                    <MudTd Style="font-size:16px; font-family:monospace; color:#2563EB; font-weight:600;">
                        @(context.Otp ?? "—")
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                       OnClick="@(() => CopyText(context.DisplayContent))" title="Copy nội dung" />
                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => ResendSms(context))" title="Gửi lại" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteSms(context))" title="Xóa" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có tin nhắn tới</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 3: HÀNG ĐỢI GỬI -->
    <MudTabPanel Text="@($"Hàng đợi ({SmsQueueCount} lệnh, {SmsQueuePendingCount} chờ)")">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" Class="pa-3" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunQueue"
                           Disabled="@(_queueBatches.IsStopping || !SmsQueue.Any(CanScheduleSms))">
                    ▶ Chạy hàng đợi
                </MudButton>
                @if (_queueBatches.IsRunning)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Stop" OnClick="StopQueue"
                               Disabled="@_queueBatches.IsStopping">
                        @(_queueBatches.IsStopping ? "Đang dừng..." : "⏹ Dừng")
                    </MudButton>
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetFailedQueue"
                           Disabled="@_queueBatches.IsRunning">
                    Reset lỗi → Chờ
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearQueue"
                           Disabled="@(_queueBatches.IsRunning || _immediateBatches.IsRunning)">
                    Xóa tất cả
                </MudButton>
                <MudSpacer />
                @if (_queueBatches.IsRunning || _immediateBatches.IsRunning)
                {
                    <MudText Typo="Typo.caption" Style="color:#64748B;">
                        Đang xử lý... còn @SmsQueuePendingCount tin chờ
                    </MudText>
                }
            </MudStack>
            <MudTable Items="@SmsQueue" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 280px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Nguồn</MudTh>
                    <MudTh>Mã yêu cầu</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT SIM</MudTh>
                    <MudTh>Đầu số</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Kết quả</MudTh>
                    <MudTh Style="width:60px;">Thời gian</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Source == "Firebase" ? Color.Secondary : Color.Default)">
                            @(string.IsNullOrWhiteSpace(context.Source) ? "Tool" : context.Source)
                        </MudChip>
                    </MudTd>
                    <MudTd Style="font-family:monospace; font-size:11px; white-space:nowrap;"
                           title="@context.CommandId">@ShortCommandId(context.CommandId)</MudTd>
                    <MudTd Style="font-weight:600;">@context.PortId</MudTd>
                    <MudTd Style="white-space:nowrap; font-weight:600;">@GetQueueSimPhone(context.PortId)</MudTd>
                    <MudTd>@context.Recipient</MudTd>
                    <MudTd Style="font-family:monospace; font-weight:700; color:#D97706; white-space:nowrap;">
                        @FormatQueueOtp(context.Otp)
                    </MudTd>
                    <MudTd Style="white-space:nowrap;"
                           title="@context.Content">@context.Content</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetQueueStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd Style="font-size:11px; color:#475569;" title="@GetQueueResult(context)">
                        @GetQueueResult(context)
                    </MudTd>
                    <MudTd Style="font-size:11px; white-space:nowrap;">@context.UpdatedAt</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-10 text-center" Style="color:#94A3B8;">Hàng đợi trống</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 4: MẪU TIN NHẮN -->
    <MudTabPanel Text="Mẫu tin nhắn">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Quản lý mẫu tin nhắn</MudText>
            <MudStack Row="true" Class="mb-3" Spacing="2" AlignItems="AlignItems.End">
                <MudTextField @bind-Value="_newTemplate"
                              Label="Nội dung mẫu mới"
                              Placeholder="Nhập nội dung mẫu..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="flex:1;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTemplate"
                           Size="Size.Small"
                           Disabled="@string.IsNullOrWhiteSpace(_newTemplate)">
                    + Thêm mẫu
                </MudButton>
            </MudStack>

            @if (!_templates.Any())
            {
                <MudText Style="color:#94A3B8; font-size:13px;">Chưa có mẫu nào. Thêm mẫu bên trên.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var tpl in _templates.ToList())
                    {
                        <MudListItem>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                                <MudText Style="flex:1; font-size:13px; word-break:break-word;">@tpl</MudText>
                                <MudTooltip Text="Copy nội dung">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   OnClick="@(() => CopyText(tpl))" />
                                </MudTooltip>
                                <MudTooltip Text="Nạp vào form gửi">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => UseTemplate(tpl))" />
                                </MudTooltip>
                                <MudTooltip Text="Xóa mẫu">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveTemplate(tpl))" />
                                </MudTooltip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Style="color:#64748B;">
                💡 Biến hỗ trợ trong mẫu: <code>{port}</code> · <code>{phone}</code> · <code>{otp}</code> · <code>{time}</code>
            </MudText>
        </MudPaper>
    </MudTabPanel>

</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _phone = "";
    private string _message = "";
    private string _sendMode = "selected";   // "selected" | "all"
    private string _smsFilter = "";
    private int _smsSubTab = 0;
    private bool _isConfirmingSend;
    private bool _isClearingSimSms = false;

    // Mẫu tin nhắn
    private string _newTemplate = "";
    private List<string> _templates = new()
    {
        "Ma OTP cua ban la: {otp}",
        "Xin chao, tai khoan cua ban da duoc kich hoat.",
        "Vui long nap them tien de tiep tuc su dung dich vu."
    };

    // Queue
    private readonly SmsBatchGroup _immediateBatches = new();
    private readonly SmsBatchGroup _queueBatches = new();
    private readonly PortOperationCoordinator _smsPortQueue = new();
    private readonly HashSet<string> _scheduledCommandIds = new(StringComparer.OrdinalIgnoreCase);
    private bool _disposed;

    // ========== DATA ==========
    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);
    private List<SimPort> FilteredPorts => Ports;
    private List<SimPort> SelectedActivePorts => Vm.SelectedComPorts
        .Where(p => p.Status == SimStatus.Active && !string.IsNullOrWhiteSpace(p.PortName))
        .DistinctBy(p => p.PortName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IEnumerable<SmsMessage> IncomingSms =>
        (Vm.SmsMessages ?? Enumerable.Empty<SmsMessage>())
            // ReceivedTime is display-only HH:mm:ss and has no date. Sorting it
            // made yesterday's 20:47 SMS appear above today's 11:xx SMS.
            // Always show the item just ingested by this app first. Carrier
            // timestamps can be stale, delayed or have a wrong time zone and
            // therefore are metadata, not the live inbox ordering key.
            .OrderByDescending(MainViewModel.GetSmsDisplayTime);

    private int IncomingSmsCount => Vm.SmsMessages?.Count ?? 0;

    [Parameter] public bool IsPageActive { get; set; }

    private IEnumerable<CommandQueueItem> SmsQueue =>
        PortDisplayOrder.Sort(
            (Vm.CommandQueue ?? Enumerable.Empty<CommandQueueItem>())
                .Where(x => string.Equals(x.Type, "SMS", StringComparison.OrdinalIgnoreCase)
                         || string.IsNullOrEmpty(x.Type)),
            Ports,
            item => item.PortId);

    private int SmsQueueCount => SmsQueue.Count();

    private int SmsQueuePendingCount => SmsQueue.Count(IsPendingSms);

    private static bool IsPendingSms(CommandQueueItem item) =>
        item.Status == "Chờ" || item.Status == "Pending" || string.IsNullOrEmpty(item.Status);

    private bool CanScheduleSms(CommandQueueItem item) =>
        IsPendingSms(item) && !_scheduledCommandIds.Contains(item.CommandId);

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Vm.SmsMessages.CollectionChanged += OnSmsMessagesChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            if (IsPageActive)
                _ = InvokeAsync(StateHasChanged);
        }, null, 1500, 1500);
    }

    private void OnSmsMessagesChanged(
        object? sender,
        System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
    {
        // ObservableCollection is updated by the WPF dispatcher, but Blazor does
        // not observe it automatically. Render as soon as an SMS is inserted so
        // the inbox does not have to wait for the 1.5-second fallback timer.
        if (IsPageActive)
            _ = InvokeAsync(StateHasChanged);
    }

    // ========== HELPERS ==========
    /// <summary>Lấy danh sách portName theo chế độ gửi được chọn.</summary>
    List<string> GetTargetPorts()
    {
        if (_sendMode == "all")
            return ActivePorts.Select(p => p.PortName).ToList();

        // "selected" means exactly the checked Active ports.
        if (Vm.SelectedComPorts.Any())
            return Vm.SelectedComPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();

        // SMS can incur charges: selected mode must never silently fall back to all ports.
        return new List<string>();
    }

    List<string> ParsePhones() => _phone
        .Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => GsmDestination.TryNormalizeSms(x, out string destination) ? destination : "")
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    static bool IsSmsSuccess(string? result) =>
        !string.IsNullOrWhiteSpace(result)
        && (result.Contains("thành công", StringComparison.OrdinalIgnoreCase)
            || result.Contains("+CMGS:", StringComparison.OrdinalIgnoreCase)
            || result.StartsWith("OK", StringComparison.OrdinalIgnoreCase));

    Color GetQueueStatusColor(string status) => status?.Trim().ToLowerInvariant() switch
    {
        "xong" or "done" or "success" or "otp_received" => Color.Success,
        "lỗi" or "failed" or "timeout" => Color.Error,
        "đang gửi" or "running" or "sent" or "maybe_sent" or "có thể đã gửi" => Color.Info,
        "chờ" or "pending" or "queued" => Color.Warning,
        _ => Color.Default
    };

    static string ShortCommandId(string commandId) =>
        string.IsNullOrWhiteSpace(commandId) || commandId.Length <= 14
            ? commandId
            : commandId[..14] + "…";

    string GetQueueSimPhone(string portId)
    {
        var phone = Ports.FirstOrDefault(p =>
            string.Equals(p.PortName, portId, StringComparison.OrdinalIgnoreCase))?.PhoneNumber;
        return string.IsNullOrWhiteSpace(phone) ? "Trống" : phone;
    }

    static string FormatQueueOtp(string? otp) =>
        string.IsNullOrWhiteSpace(otp) || otp == "N/A" ? "—" : otp;

    static string GetQueueResult(CommandQueueItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Error)) return item.Result;
        if (string.IsNullOrWhiteSpace(item.Result)) return "Lỗi: " + item.Error;
        return $"{item.Result} | Lỗi: {item.Error}";
    }

    bool FilterSms(SmsMessage sms)
    {
        if (string.IsNullOrWhiteSpace(_smsFilter)) return true;
        string f = _smsFilter.ToLowerInvariant();
        return (sms.Sender?.ToLowerInvariant().Contains(f) == true)
            || (sms.ReceiverPhone?.ToLowerInvariant().Contains(f) == true)
            || (sms.Content?.ToLowerInvariant().Contains(f) == true)
            || sms.DisplayContent.ToLowerInvariant().Contains(f)
            || (sms.PortName?.ToLowerInvariant().Contains(f) == true)
            || (sms.Otp?.Contains(f) == true);
    }

    static string GetReceiverDisplay(SmsMessage sms) =>
        string.IsNullOrWhiteSpace(sms.ReceiverPhone) ? sms.PortName : sms.ReceiverPhone;

    // ========== 2. GỬI NGAY ==========
    async Task SendNow()
    {
        if (_disposed || _immediateBatches.IsStopping || _isConfirmingSend) return;

        string content = _message;
        if (string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(content))
        {
            Snackbar.Add("Nhập số điện thoại và nội dung", Severity.Warning);
            return;
        }

        var phones = ParsePhones();
        if (phones.Count == 0)
        {
            Snackbar.Add("Không có địa chỉ nhận hợp lệ", Severity.Warning);
            return;
        }

        var ports = GetTargetPorts();
        if (ports.Count == 0)
        {
            Snackbar.Add(_sendMode == "selected"
                ? "Hãy chọn ít nhất một cổng Active"
                : "Không có cổng Active", Severity.Warning);
            return;
        }

        int totalSms = ports.Count * phones.Count;
        if (totalSms > 20)
        {
            _isConfirmingSend = true;
            try
            {
                var confirmed = await DialogService.ShowMessageBox("Xác nhận",
                    $"Gửi {phones.Count} số × {ports.Count} cổng = {totalSms} SMS?",
                    yesText: "Gửi ngay", cancelText: "Hủy");
                if (confirmed != true) return;
            }
            finally
            {
                _isConfirmingSend = false;
            }
        }

        if (_disposed || _immediateBatches.IsStopping) return;

        var requests = ports.SelectMany(port => phones.Select(phone =>
            new SmsRequest(Guid.NewGuid().ToString("N")[..12], port, "SMS", phone, content)))
            .ToList();
        Snackbar.Add($"Đã nhận {totalSms} SMS cho {ports.Count} cổng.", Severity.Info);
        await DispatchSmsBatchAsync(requests, _immediateBatches, fromQueue: false);
    }

    void StopImmediateSend()
    {
        _immediateBatches.Stop();
        Snackbar.Add(
            "Đang dừng các lượt Gửi ngay. SMS đã qua Ctrl+Z có thể vẫn được nhà mạng nhận.",
            Severity.Info);
    }

    // ========== 3. THÊM VÀO HÀNG ĐỢI ==========
    void AddToQueue()
    {
        if (string.IsNullOrWhiteSpace(_phone) || string.IsNullOrWhiteSpace(_message))
        {
            Snackbar.Add("Nhập số và nội dung", Severity.Warning);
            return;
        }

        var phones = ParsePhones();

        var ports = GetTargetPorts();

        if (!ports.Any() || !phones.Any())
        {
            Snackbar.Add("Thiếu cổng Active hoặc số hợp lệ", Severity.Warning);
            return;
        }

        int added = 0;
        foreach (var port in ports)
        {
            foreach (var phone in phones)
            {
                // Thêm vào CommandQueue qua UpsertCommandQueue để đảm bảo đúng format
                string cmdId = Guid.NewGuid().ToString("N")[..12];
                Vm.UpsertCommandQueue(cmdId, port, "SMS", phone, _message, "Chờ");
                added++;
            }
        }

        Snackbar.Add($"Đã thêm {added} tin vào hàng đợi", Severity.Success);
        _smsSubTab = 2; // chuyển sang tab Hàng đợi
        StateHasChanged();
    }

    // ========== 4. CHẠY HÀNG ĐỢI ==========
    async Task RunQueue()
    {
        if (_disposed || _queueBatches.IsStopping) return;

        var requests = SmsQueue.Where(CanScheduleSms).Reverse()
            .Select(item => new SmsRequest(item.CommandId, item.PortId, item.Type, item.Recipient, item.Content))
            .ToList();
        if (requests.Count == 0) return;

        await DispatchSmsBatchAsync(requests, _queueBatches, fromQueue: true);
    }

    private async Task DispatchSmsBatchAsync(
        IReadOnlyList<SmsRequest> requests, SmsBatchGroup batches, bool fromQueue)
    {
        CancellationToken token = batches.Start();
        int sent = 0, failed = 0, uncertain = 0;
        try
        {
            // Each COM owns its current batch while other COMs take new work.
            await Task.WhenAll(requests.GroupBy(item => item.PortId, StringComparer.OrdinalIgnoreCase)
                .Select(SendForPortAsync));
        }
        finally
        {
            batches.Finish();
            if (!_disposed)
            {
                string title = token.IsCancellationRequested
                    ? fromQueue ? "Đã dừng hàng đợi" : "Đã dừng gửi"
                    : fromQueue ? "Lượt hàng đợi hoàn tất" : "Lượt gửi hoàn tất";
                Snackbar.Add(
                    $"{title}: {sent} thành công, {uncertain} có thể đã gửi, {failed} lỗi",
                    failed > 0 || uncertain > 0 ? Severity.Warning
                        : token.IsCancellationRequested ? Severity.Info : Severity.Success);
                StateHasChanged();
            }
        }

        async Task SendForPortAsync(IGrouping<string, SmsRequest> portRequests)
        {
            string port = portRequests.Key;
            try
            {
                foreach (var request in portRequests)
                {
                    _scheduledCommandIds.Add(request.CommandId);
                    UpdateSmsRequest(request, "Chờ", "");
                }

                token.ThrowIfCancellationRequested();
                if (string.IsNullOrWhiteSpace(port) || !PortSessions.TryGet(port, out var session))
                {
                    foreach (var request in portRequests)
                    {
                        UpdateSmsRequest(request, "Lỗi", PortUnavailableMessage);
                        failed++;
                    }
                    return;
                }

                using var portLease = await _smsPortQueue.AcquireAsync(port, token);
                using var sendCts = CancellationTokenSource.CreateLinkedTokenSource(token, session.Token);
                foreach (var request in portRequests)
                {
                    token.ThrowIfCancellationRequested();
                    if (session.Token.IsCancellationRequested || !Vm.IsPortReadyForOperation(port))
                    {
                        UpdateSmsRequest(request, "Lỗi", PortUnavailableMessage);
                        failed++;
                        continue;
                    }

                    switch (await SendScheduledSmsAsync(request, sendCts.Token, token))
                    {
                        case SmsSubmitDisposition.Confirmed:
                            sent++;
                            break;
                        case SmsSubmitDisposition.PayloadSubmittedUncertain:
                            uncertain++;
                            break;
                        case SmsSubmitDisposition.FailedBeforePayload:
                            failed++;
                            break;
                    }

                    if (!_disposed) StateHasChanged();
                    await Task.Delay(fromQueue ? 800 : 600, token);
                }
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                // Messages that never started stay in Chờ and can be run manually.
            }
            finally
            {
                foreach (var request in portRequests)
                    _scheduledCommandIds.Remove(request.CommandId);
            }
        }
    }

    private const string PortUnavailableMessage = "Cổng không còn Active hoặc SIM đã thay đổi";

    private async Task<SmsSubmitDisposition> SendScheduledSmsAsync(
        SmsRequest request, CancellationToken sendToken, CancellationToken batchToken)
    {
        UpdateSmsRequest(request, "Đang gửi", "Đang xử lý...");
        if (!_disposed) StateHasChanged();
        try
        {
            string result = await Vm.QueueSmsAsync(request.PortId, request.Recipient, request.Content, sendToken);
            var disposition = GsmSmsService.ClassifySubmitResult(result);
            switch (disposition)
            {
                case SmsSubmitDisposition.Confirmed:
                    UpdateSmsRequest(request, "Xong", result.Trim());
                    return disposition;
                case SmsSubmitDisposition.PayloadSubmittedUncertain:
                    UpdateSmsRequest(request, "Có thể đã gửi", "Đã qua Ctrl+Z; không tự gửi lại. " + result.Trim());
                    return disposition;
                case SmsSubmitDisposition.CancelledBeforePayload when !sendToken.IsCancellationRequested
                    || batchToken.IsCancellationRequested:
                    UpdateSmsRequest(request, "Chờ", "Đã dừng trước Ctrl+Z; có thể gửi lại an toàn.");
                    return disposition;
                default:
                    UpdateSmsRequest(request, "Lỗi", result?.Trim() ?? "Không có phản hồi");
                    return SmsSubmitDisposition.FailedBeforePayload;
            }
        }
        catch (OperationCanceledException) when (batchToken.IsCancellationRequested)
        {
            UpdateSmsRequest(request, "Chờ", "Đã dừng");
            return SmsSubmitDisposition.CancelledBeforePayload;
        }
        catch (Exception ex)
        {
            UpdateSmsRequest(request, "Lỗi", ex.Message);
            return SmsSubmitDisposition.FailedBeforePayload;
        }
    }

    private void UpdateSmsRequest(SmsRequest request, string status, string result) =>
        Vm.UpsertCommandQueue(request.CommandId, request.PortId, request.Type,
            request.Recipient, request.Content, status, result);

    private sealed record SmsRequest(string CommandId, string PortId, string Type, string Recipient, string Content);

    private sealed class SmsBatchGroup
    {
        private CancellationTokenSource? _cancellation;
        private int _activeBatches;

        public bool IsRunning => _activeBatches > 0;
        public bool IsStopping => _cancellation?.IsCancellationRequested == true;

        public CancellationToken Start()
        {
            _cancellation ??= new CancellationTokenSource();
            _activeBatches++;
            return _cancellation.Token;
        }

        public void Stop() => _cancellation?.Cancel();

        public void Finish()
        {
            if (--_activeBatches != 0) return;
            _cancellation?.Dispose();
            _cancellation = null;
        }
    }

    void StopQueue()
    {
        _queueBatches.Stop();
        Snackbar.Add(
            "Đang dừng hàng đợi; SMS đã qua Ctrl+Z sẽ không được đưa lại về Chờ.",
            Severity.Info);
    }

    // ========== 5. RESET FAILED → CHỜ ==========
    void ResetFailedQueue()
    {
        var failedItems = SmsQueue.Where(x => x.Status == "Lỗi").ToList();
        if (!failedItems.Any())
        {
            Snackbar.Add("Không có tin nào bị lỗi trong hàng đợi", Severity.Info);
            return;
        }
        foreach (var item in failedItems)
        {
            Vm.UpsertCommandQueue(item.CommandId, item.PortId, item.Type,
                item.Recipient, item.Content, "Chờ", "");
        }
        Snackbar.Add($"Đã reset {failedItems.Count} tin lỗi → Chờ", Severity.Success);
    }

    // ========== 6. XÓA HÀNG ĐỢI ==========
    async Task ClearQueue()
    {
        if (_queueBatches.IsRunning || _immediateBatches.IsRunning) return;
        int count = SmsQueue.Count();
        if (count == 0) return;

        var ok = await DialogService.ShowMessageBox("Xác nhận",
            $"Xóa {count} tin trong hàng đợi?", yesText: "Xóa", cancelText: "Hủy");
        if (ok != true || _queueBatches.IsRunning || _immediateBatches.IsRunning) return;

        var toRemove = SmsQueue.ToList();
        foreach (var item in toRemove)
            Vm.CommandQueue?.Remove(item);

        Snackbar.Add($"Đã xóa {count} tin", Severity.Success);
    }

    // ========== 7. RESEND TỪ LỊCH SỬ ==========
    async Task ResendSms(SmsMessage sms)
    {
        if (string.IsNullOrEmpty(sms.Sender) || string.IsNullOrEmpty(sms.Content))
        {
            Snackbar.Add("Thiếu số hoặc nội dung để gửi lại", Severity.Warning);
            return;
        }

        // Reply from the original SIM only. Falling back to another COM can expose
        // the wrong phone number and charge a different subscriber.
        string? port = !string.IsNullOrEmpty(sms.PortName)
                       && Vm.IsPortReadyForOperation(sms.PortName)
            ? sms.PortName
            : null;

        if (string.IsNullOrEmpty(port))
        {
            Snackbar.Add($"Cổng gốc {sms.PortName} không còn sẵn sàng để gửi lại", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox("Xác nhận gửi lại",
            $"Gửi lại SMS từ {port} tới {sms.Sender}?", yesText: "Gửi", cancelText: "Hủy");
        if (confirmed != true) return;

        string commandId = Guid.NewGuid().ToString("N")[..12];
        Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Đang gửi", "Đang xử lý...");
        try
        {
            string res = await Vm.QueueSmsAsync(port, sms.Sender, sms.Content);
            gsm.Services.SmsSubmitDisposition disposition =
                gsm.Services.GsmSmsService.ClassifySubmitResult(res);
            if (disposition == gsm.Services.SmsSubmitDisposition.PayloadSubmittedUncertain)
            {
                string detail = "Đã qua Ctrl+Z; không tự gửi lại. " + res.Trim();
                Vm.UpsertCommandQueue(
                    commandId, port, "SMS", sms.Sender, sms.Content,
                    "Có thể đã gửi", detail);
                Snackbar.Add($"[{port}] SMS có thể đã gửi; không tự thử lại", Severity.Warning);
            }
            else if (disposition != gsm.Services.SmsSubmitDisposition.Confirmed)
            {
                string error = res?.Trim() ?? "Không có phản hồi";
                Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Lỗi", error);
                Snackbar.Add($"[{port}] Gửi lại lỗi: {error}", Severity.Error);
            }
            else
            {
                Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Xong", res.Trim());
                Snackbar.Add($"[{port}] ✓ Đã gửi lại tới {sms.Sender}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Vm.UpsertCommandQueue(commandId, port, "SMS", sms.Sender, sms.Content, "Lỗi", ex.Message);
            Snackbar.Add("Gửi lại lỗi: " + ex.Message, Severity.Error);
        }
    }

    // ========== 8. MẪU TIN NHẮN ==========
    void AddTemplate()
    {
        if (string.IsNullOrWhiteSpace(_newTemplate)) return;
        if (_templates.Contains(_newTemplate.Trim()))
        {
            Snackbar.Add("Mẫu đã tồn tại", Severity.Warning);
            return;
        }
        _templates.Add(_newTemplate.Trim());
        _newTemplate = "";
        Snackbar.Add("Đã thêm mẫu", Severity.Success);
    }

    void UseTemplate(string tpl)
    {
        SimPort? selected = Vm.SelectedComPorts.FirstOrDefault();
        // Thay biến động nếu có
        string expanded = tpl
            .Replace("{time}", DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy"))
            .Replace("{port}", selected?.PortName ?? "")
            .Replace("{phone}", selected?.PhoneNumber ?? "")
            .Replace("{otp}", selected?.Otp ?? "");
        _message = expanded;
        // Không cần switch tab — form gửi luôn nằm ở trên cùng
        Snackbar.Add("Đã nạp mẫu vào form gửi", Severity.Info);
        StateHasChanged();
    }

    void RemoveTemplate(string tpl)
    {
        _templates.Remove(tpl);
        Snackbar.Add("Đã xóa mẫu", Severity.Normal);
    }

    // ========== 10. COPY / DELETE ==========
    async Task ClearSelectedSimStorage()
    {
        if (_isClearingSimSms) return;

        List<SimPort> targets = SelectedActivePorts;
        if (targets.Count == 0)
        {
            Snackbar.Add("Hãy chọn ít nhất một cổng Active.", Severity.Warning);
            return;
        }

        string portNames = string.Join(", ", targets.Select(p => p.PortName));
        bool? confirmed = await DialogService.ShowMessageBox(
            "Xóa toàn bộ SMS trong SIM?",
            $"Sẽ xóa vĩnh viễn tất cả tin nhắn đang lưu trong {targets.Count} SIM ({portNames}). " +
            "Lịch sử đã nhận trên ứng dụng vẫn được giữ nguyên. Thao tác này không thể hoàn tác.",
            yesText: "Xóa trong SIM",
            cancelText: "Hủy");
        if (confirmed != true) return;

        _isClearingSimSms = true;
        try
        {
            var results = await Task.WhenAll(targets.Select(async port =>
            {
                try
                {
                    var (success, msg) = await Vm.WipeAllSmsFromPortAsync(port.PortName);
                    Vm.AddLog($"[{port.PortName}] {msg}", success ? "SUCCESS" : "ERROR");
                    return (port.PortName, Success: success);
                }
                catch (Exception ex)
                {
                    Vm.AddLog($"[{port.PortName}] Xóa SMS trong SIM lỗi: {ex.Message}", "ERROR");
                    return (port.PortName, Success: false);
                }
            }));

            int successCount = results.Count(x => x.Success);
            int failedCount = results.Length - successCount;
            if (failedCount == 0)
                Snackbar.Add($"Đã giải phóng bộ nhớ SMS trên {successCount}/{results.Length} SIM.", Severity.Success);
            else
                Snackbar.Add($"Đã xóa trên {successCount}/{results.Length} SIM; {failedCount} cổng thất bại. Xem tab Log để biết chi tiết.", Severity.Warning);
        }
        finally
        {
            _isClearingSimSms = false;
        }
    }

    async Task CopyText(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("clipboardCopy.copyText", text);
            Snackbar.Add("Đã copy vào Clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Copy thất bại", Severity.Warning);
        }
    }

    void DeleteSms(SmsMessage sms)
    {
        if (Vm.DeleteSmsHistoryItem(sms))
            Snackbar.Add("Đã xóa tin nhắn khỏi lịch sử", Severity.Normal);
        else
            Snackbar.Add("Xóa tin nhắn thất bại; bản ghi vẫn được giữ lại", Severity.Warning);
    }

    async Task ClearHistory()
    {
        var ok = await DialogService.ShowMessageBox("Xác nhận",
            "Xóa toàn bộ lịch sử tin nhắn tới?", yesText: "Xóa", cancelText: "Hủy");
        if (ok == true)
        {
            if (Vm.ClearSmsHistory())
                Snackbar.Add("Đã xóa vĩnh viễn lịch sử SMS", Severity.Success);
            else
                Snackbar.Add("Xóa lịch sử SMS thất bại", Severity.Error);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Vm.SmsMessages.CollectionChanged -= OnSmsMessagesChanged;
        _timer?.Dispose();
        _immediateBatches.Stop();
        _queueBatches.Stop();
    }
}
