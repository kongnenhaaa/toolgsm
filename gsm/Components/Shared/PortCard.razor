@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Class="@($"pa-4 port-card {GetStateClass()} {(Port.IsRebooting ? "card-accepting" : "")}")" Elevation="0" Style="height:100%;">
    <MudStack Spacing="2">
        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@Port.PortName</MudText>
                <MudText Typo="Typo.caption" Style="color:#94A3B8;">@Port.DeviceName</MudText>
            </div>
            <StatusBadge Status="@Port.Status" />
        </MudStack>

        <MudDivider Class="my-1" />

        @if (Port.Status == gsm.Models.SimStatus.Connecting)
        {
            <MudStack Spacing="1">
                <MudSkeleton Width="100%" Height="20px" />
                <MudSkeleton Width="80%" Height="20px" />
                <MudSkeleton Width="60%" Height="20px" />
                <MudSkeleton Width="90%" Height="20px" />
                <MudSkeleton Width="50%" Height="20px" />
            </MudStack>
            
            <MudStack Row="true" Spacing="1" Class="mt-2">
                <MudSkeleton Width="100%" Height="32px" />
            </MudStack>
        }
        else
        {
            <!-- Info -->
            <MudStack Spacing="1">
            <InfoRow Label="IMEI" Value="@(string.IsNullOrEmpty(Port.Imei) ? "—" : Port.Imei)" Mono="true" />
            <InfoRow Label="SĐT" Value="@(string.IsNullOrEmpty(Port.PhoneNumber) || Port.PhoneNumber.Contains("Chưa") ? "—" : Port.PhoneNumber)" Bold="true" />
            <InfoRow Label="TKC" Value="@(string.IsNullOrEmpty(Port.Balance) ? "—" : Port.Balance)" Color="#16A34A" Bold="true" />
            <InfoRow Label="Nhà mạng" Value="@(string.IsNullOrEmpty(Port.NetworkProvider) ? "—" : Port.NetworkProvider)" />
            <InfoRow Label="CCID" Value="@(string.IsNullOrEmpty(Port.Serial) ? "—" : Port.Serial)" Mono="true" Small="true" />
        </MudStack>

        <!-- Actions chính -->
        <MudStack Spacing="1" Class="mt-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       FullWidth="true" OnClick="OnRefreshClicked" StartIcon="@Icons.Material.Filled.Refresh">
                Làm mới dữ liệu
            </MudButton>

            <!-- Quick actions -->
            <MudStack Row="true" Spacing="1">
                <MudTooltip Text="Kiểm tra TKC (*101#)">
                    <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet" 
                                   Color="Color.Success" Size="Size.Small" 
                                   OnClick="CheckBalance" Disabled="@(Port.Status != gsm.Models.SimStatus.Active)" />
                </MudTooltip>
                <MudTooltip Text="Gửi USSD tùy chỉnh">
                    <MudIconButton Icon="@Icons.Material.Filled.Dialpad" 
                                   Color="Color.Info" Size="Size.Small" 
                                   OnClick="OpenUssd" Disabled="@(Port.Status != gsm.Models.SimStatus.Active)" />
                </MudTooltip>
                <MudTooltip Text="Gửi SMS nhanh">
                    <MudIconButton Icon="@Icons.Material.Filled.Sms" 
                                   Color="Color.Secondary" Size="Size.Small" 
                                   OnClick="OpenSms" Disabled="@(Port.Status != gsm.Models.SimStatus.Active)" />
                </MudTooltip>
                <MudTooltip Text="Gọi điện ra ngoài">
                    <MudIconButton Icon="@Icons.Material.Filled.Phone" 
                                   Color="Color.Warning" Size="Size.Small" 
                                   OnClick="OpenCall" Disabled="@(Port.Status != gsm.Models.SimStatus.Active)" />
                </MudTooltip>
                <MudSpacer />
                <MudTooltip Text="Xem log / chi tiết">
                    <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" OnClick="ShowDetail" />
                </MudTooltip>
            </MudStack>
        </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public SimPort Port { get; set; } = new();
    [Parameter] public EventCallback<SimPort> OnRefresh { get; set; }
    [Parameter] public EventCallback<SimPort> OnCheckBalance { get; set; }
    [Parameter] public EventCallback<SimPort> OnUssd { get; set; }
    [Parameter] public EventCallback<SimPort> OnSms { get; set; }
    [Parameter] public EventCallback<SimPort> OnCall { get; set; }

    async Task OnRefreshClicked() => await OnRefresh.InvokeAsync(Port);
    async Task CheckBalance() => await OnCheckBalance.InvokeAsync(Port);
    async Task OpenUssd() => await OnUssd.InvokeAsync(Port);
    async Task OpenSms() => await OnSms.InvokeAsync(Port);
    async Task OpenCall() => await OnCall.InvokeAsync(Port);

    string GetStateClass() => Port.Status switch
    {
        gsm.Models.SimStatus.Active => "state-active",
        gsm.Models.SimStatus.WaitingAccept => "state-pending",
        gsm.Models.SimStatus.SecurityBlocked => "state-error",
        gsm.Models.SimStatus.Connecting => "state-processing",
        gsm.Models.SimStatus.NoResponse => "state-error",
        _ => "state-idle"
    };

    async Task ShowDetail()
    {
        await DialogService.ShowMessageBox(
            $"Chi tiết {Port.PortName}",
            $"IMEI: {Port.Imei}\nSĐT: {Port.PhoneNumber}\nTKC: {Port.Balance}\nNhà mạng: {Port.NetworkProvider}\nCCID: {Port.Serial}\nStatus: {Port.Status}",
            yesText: "Đóng");
    }
}
