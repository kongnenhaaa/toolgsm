@page "/sms"
@inject MainViewModel Vm
@inject IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.ViewModels
@using gsm.Models
@implements IDisposable

<MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:700;">Quản lý SMS</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="color:#64748B;">
    Gửi tin nhắn • Lịch sử • Hàng đợi • Mẫu tin nhắn
</MudText>

<!-- ========== TOOLBAR ========== -->
<MudStack Row="true" Class="mb-4" Spacing="2" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Send"
               OnClick="OpenBulkSmsDialog" Size="Size.Small">
        Gửi SMS hàng loạt
    </MudButton>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Message"
               OnClick="OpenSingleSmsDialog" Size="Size.Small">
        Gửi 1 tin
    </MudButton>

    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" 
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="Refresh" Size="Size.Small">
        Làm mới
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Error" 
               StartIcon="@Icons.Material.Filled.DeleteSweep"
               OnClick="ClearHistory" Size="Size.Small"
               Disabled="@(!FilteredSms.Any())">
        Xóa lịch sử
    </MudButton>

    <MudSpacer />

    <MudSelect T="string" @bind-Value="_filterStatus" Dense="true" 
               Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px;"
               Placeholder="Trạng thái">
        <MudSelectItem Value="@("all")">Tất cả</MudSelectItem>
        <MudSelectItem Value="@("success")">Đã đọc</MudSelectItem>
        <MudSelectItem Value="@("pending")">Mới</MudSelectItem>
    </MudSelect>

    <MudTextField @bind-Value="_search" Placeholder="Tìm SĐT / nội dung / cổng..." 
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Style="max-width:260px;" Variant="Variant.Outlined" Margin="Margin.Dense" />
</MudStack>

<!-- ========== STATS ========== -->
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Tin nhắn đã nhận</MudText>
            <MudText Typo="Typo.h5" Style="font-weight:700;">@_receivedCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Trong hàng đợi</MudText>
            <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight:700;">@Vm.QueuePendingCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Thành công</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">@Vm.QueueSuccessCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.caption" Style="color:#64748B;">Lỗi</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight:700;">@Vm.QueueErrorCount</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- ========== TABS: Lịch sử | Hàng đợi | Mẫu ========== -->
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0" Class="mb-2">
    
    <!-- TAB 1: LỊCH SỬ -->
    <MudTabPanel Text="Lịch sử SMS" Icon="@Icons.Material.Filled.History">
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; overflow:hidden; margin-top:12px;">
            <MudTable Items="@FilteredSms" Hover="true" Dense="true" Elevation="0" 
                      MultiSelection="true" @bind-SelectedItems="_selectedSms"
                      Style="background:white;" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Người gửi / Nhận</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>Hướng</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh Style="width:100px;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="white-space:nowrap; font-size:12px;">
                        @context.ReceivedTime
                    </MudTd>
                    <MudTd Style="font-weight:600;">@context.PortName</MudTd>
                    <MudTd>@context.Sender</MudTd>
                    <MudTd Style="max-width:280px;">
                        <MudText Typo="Typo.caption" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @context.Content
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" 
                                 Color="Color.Info" 
                                 Variant="Variant.Outlined">
                            Đến
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" 
                                 Color="@(context.Status == "Đã đọc" ? Color.Default : Color.Success)" 
                                 Variant="Variant.Filled">
                            @(string.IsNullOrWhiteSpace(context.Status) ? "Mới" : context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="Trả lời">
                                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" 
                                               OnClick="@(() => ResendSms(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Copy nội dung">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                               OnClick="@(() => CopyText(context.Content))" />
                            </MudTooltip>
                            <MudTooltip Text="Xóa">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => DeleteSms(context))" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-10 text-center">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-3" Style="opacity:0.35;" />
                        <MudText Typo="Typo.body1" Style="color:#94A3B8;">Chưa có tin nhắn nào</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{20,50,100}" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 2: HÀNG ĐỢI -->
    <MudTabPanel Text="Hàng đợi Gửi" Icon="@Icons.Material.Filled.Queue" BadgeData="@Vm.QueuePendingCount" BadgeColor="Color.Warning">
        <MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px; overflow:hidden; margin-top:12px;">
            <MudStack Row="true" Class="pa-3" Spacing="2">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunQueue">
                    Chạy hàng đợi
                </MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" 
                           StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearQueue">
                    Xóa hàng đợi
                </MudButton>
            </MudStack>

            <MudTable Items="@(Vm.CommandQueue?.Where(x => x.Type == "SMS") ?? Enumerable.Empty<CommandQueueItem>())" 
                      Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Kết quả</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PortId</MudTd>
                    <MudTd>@context.Recipient</MudTd>
                    <MudTd Style="max-width:250px; overflow:hidden; text-overflow:ellipsis;">@context.Content</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" 
                                 Color="@(context.Status == "Xong" ? Color.Success : context.Status == "Lỗi" ? Color.Error : Color.Warning)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd Style="font-size:12px; color:#64748B;">@context.Result</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-8 text-center" Style="color:#94A3B8;">Hàng đợi trống</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 3: MẪU TIN NHẮN -->
    <MudTabPanel Text="Mẫu tin nhắn" Icon="@Icons.Material.Filled.TextSnippet">
        <MudPaper Class="pa-4 mt-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:12px;">
            <MudStack Row="true" Class="mb-3" Spacing="2">
                <MudTextField T="string" @bind-Value="_newTemplate" Placeholder="Nhập nội dung mẫu..." 
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTemplate" Size="Size.Small">
                    Thêm mẫu
                </MudButton>
            </MudStack>

            <MudList T="string" Dense="true">
                @foreach (var tpl in _templates)
                {
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                            <MudText Style="flex:1; font-size:13px;">@tpl</MudText>
                            <MudTooltip Text="Copy">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                               OnClick="@(() => CopyText(tpl))" />
                            </MudTooltip>
                            <MudTooltip Text="Dùng">
                                <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => UseTemplate(tpl))" />
                            </MudTooltip>
                            <MudTooltip Text="Xóa">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveTemplate(tpl))" />
                            </MudTooltip>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>

            @if (_templates.Count == 0)
            {
                <MudText Class="pa-6 text-center" Style="color:#94A3B8;">Chưa có mẫu nào. Thêm mẫu để dùng nhanh.</MudText>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private string _search = "";
    private string _filterStatus = "all";
    private string _newTemplate = "";
    private HashSet<SmsMessage> _selectedSms = new();
    private List<string> _templates = new()
    {
        "Ma OTP cua ban la: {otp}",
        "Xin chao, tai khoan cua ban da duoc kich hoat.",
        "Vui long nap them tien de tiep tuc su dung dich vu."
    };

    private int _receivedCount => Vm.SmsMessages?.Count ?? 0;

    private IEnumerable<SmsMessage> FilteredSms
    {
        get
        {
            var list = Vm.SmsMessages ?? Enumerable.Empty<SmsMessage>();

            if (_filterStatus == "success") list = list.Where(x => x.Status == "Đã đọc");
            else if (_filterStatus == "pending") list = list.Where(x => string.IsNullOrWhiteSpace(x.Status));

            if (!string.IsNullOrWhiteSpace(_search))
            {
                list = list.Where(x =>
                    (x.Sender?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Content?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.PortName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return list.OrderByDescending(x => x.ReceivedTime);
        }
    }

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 2000, 2000);
    }

    // ========== ACTIONS ==========

    async Task OpenBulkSmsDialog()
    {
        // Mở dialog gửi hàng loạt
        var parameters = new DialogParameters();
        var dialog = await DialogService.ShowAsync<gsm.Components.Shared.SmsDialog>("Gửi SMS hàng loạt", parameters, 
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    async Task OpenSingleSmsDialog()
    {
        var parameters = new DialogParameters();
        var dialog = await DialogService.ShowAsync<gsm.Components.Shared.SmsDialog>("Gửi SMS", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is (string phone, string message))
        {
            Snackbar.Add("Đã thêm vào hàng đợi", Severity.Success);
        }
    }

    async Task ResendSms(SmsMessage sms)
    {
        Snackbar.Add($"Đang gửi phản hồi tới {sms.Sender}...", Severity.Info);
        var parameters = new DialogParameters();
        var dialog = await DialogService.ShowAsync<gsm.Components.Shared.SmsDialog>("Trả lời SMS", parameters);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled && result.Data is (string phone, string message))
        {
            await Vm.QueueSmsAsync(sms.PortName, phone, message);
            Snackbar.Add("Đã thêm vào hàng đợi", Severity.Success);
        }
    }

    void CopyText(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        Snackbar.Add("Đã copy vào clipboard", Severity.Success);
    }

    async Task DeleteSms(SmsMessage sms)
    {
        Vm.SmsMessages.Remove(sms);
        Snackbar.Add("Đã xóa tin nhắn", Severity.Normal);
    }

    async Task ClearHistory()
    {
        var confirm = await DialogService.ShowMessageBox("Xác nhận", "Xóa toàn bộ lịch sử nhận SMS?", yesText: "Xóa", cancelText: "Hủy");
        if (confirm == true)
        {
            Vm.SmsMessages.Clear();
            Snackbar.Add("Đã xóa lịch sử", Severity.Success);
        }
    }

    async Task RunQueue()
    {
        Snackbar.Add("Đang chạy hàng đợi SMS...", Severity.Info);
    }

    async Task ClearQueue()
    {
        Vm.CommandQueue.Clear();
        Snackbar.Add("Đã xóa hàng đợi", Severity.Normal);
    }

    void AddTemplate()
    {
        if (string.IsNullOrWhiteSpace(_newTemplate)) return;
        _templates.Add(_newTemplate.Trim());
        _newTemplate = "";
        Snackbar.Add("Đã thêm mẫu", Severity.Success);
    }

    void RemoveTemplate(string tpl) => _templates.Remove(tpl);

    async Task UseTemplate(string tpl)
    {
        Snackbar.Add($"Sử dụng mẫu: {tpl}", Severity.Success);
    }

    async Task Refresh()
    {
        Snackbar.Add("Đã làm mới", Severity.Normal);
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
