                                        <Button Content="Thông tin mạng (QNWINFO)" Command="{Binding NetworkSimActionCommand}" CommandParameter="NetworkInfo" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+QNWINFO"/>
                                        <Button Content="Trạng thái đăng ký (CREG)" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckRegistration" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+CREG?"/>
                                        <Button Content="Nhà mạng hiện tại (COPS)" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckOperator" Style="{StaticResource ModernButtonStyle}" Background="#5C6BC0" Margin="0,0,0,10" ToolTip="AT+COPS?"/>
                                    </StackPanel>

                                    <!-- Column 3: Bảo mật & Danh bạ -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="BẢO MẬT &amp; TIỆN ÍCH" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox materialDesign:HintAssist.Hint="Mã PIN" Text="{Binding PinCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Nhập PIN" Command="{Binding NetworkSimActionCommand}" CommandParameter="EnterPin" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" BorderBrush="#FF9800" ToolTip="AT+CPIN"/>
                                        </Grid>
                                        <Button Content="Trạng thái mã PIN" Command="{Binding NetworkSimActionCommand}" CommandParameter="CheckPinStatus" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+CPIN?"/>
                                        <Button Content="Đọc danh bạ (CPBR)" Command="{Binding NetworkSimActionCommand}" CommandParameter="ReadPhonebook" Style="{StaticResource ModernButtonStyle}" Background="#424242" Margin="0,0,0,10" ToolTip="AT+CPBR=1,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox materialDesign:HintAssist.Hint="Gửi USSD tuỳ chỉnh hoặc chọn lệnh" 
                                                      IsEditable="True"
                                                      ItemsSource="{Binding Path=DataContext.PredefinedUssdCommands, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValuePath="Key"
                                                      Text="{Binding UssdCommand}" 
                                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" Foreground="White" Margin="0,0,10,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Key}" FontWeight="Bold" Width="70"/>
                                                            <TextBlock Text=" - " Foreground="Gray"/>
                                                            <TextBlock Text="{Binding Value}" Foreground="#B2EBF2" FontStyle="Italic"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="Gửi" Command="{Binding NetworkSimActionCommand}" CommandParameter="SendUssd" Style="{StaticResource MaterialDesignRaisedButton}" Background="#8BC34A" BorderBrush="#8BC34A" ToolTip="AT+CUSD"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBox Grid.Row="3" Text="{Binding NetworkSimOutput}" IsReadOnly="True" 
                                     Height="240" Style="{StaticResource ProTerminalTextBoxStyle}"
                                     Margin="0,0,0,24"/>
                            
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Đóng" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#CFD8DC" BorderBrush="#546E7A"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </materialDesign:DialogHost.DialogContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Nav -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Terminal -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Navigation -->
        <Grid Grid.Row="0" Background="{StaticResource PanelBackground}" Height="50">
            <!-- Segmented Control for Tabs -->
            <Border Background="#12121E" CornerRadius="15" HorizontalAlignment="Center" Padding="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="GSM" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2" Width="100" FontWeight="Bold"/>
                    <RadioButton Content="TIN NHẮN" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2" Width="100" FontWeight="Bold"/>
                    <RadioButton Content="HƯỚNG DẪN" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2" Width="120" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Settings" Height="36" Width="36" Margin="10,0,0,0" Command="{Binding OpenSettingsDialogCommand}">
                    <materialDesign:PackIcon Kind="Cog" Foreground="White" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCommandPanelOpen}" Value="True">
                                    <Setter Property="Width" Value="575"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: GSM -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- ToolBar GSM -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1">
                        <WrapPanel Margin="10,5">
                            <Button Background="#5C6BC0" Command="{Binding ToggleCommandPanelCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="Mở/đóng bảng lệnh">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Asterisk" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Bảng lệnh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#F06292" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Sắp xếp cổng">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SortAscending" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Sắp xếp cổng" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Sắp xếp theo thứ tự COM" Command="{Binding SortPortsCommand}" CommandParameter="COM">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="SortNumericAscending"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Nhà mạng" Command="{Binding SortPortsCommand}" CommandParameter="Network">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Sim"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Trạng thái (Online)" Command="{Binding SortPortsCommand}" CommandParameter="Status">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="CheckCircle"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Cường độ sóng" Command="{Binding SortPortsCommand}" CommandParameter="Signal">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Signal"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sắp xếp theo Số dư (Cao - Thấp)" Command="{Binding SortPortsCommand}" CommandParameter="Balance">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Wallet"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Kiểm tra số dư">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wallet" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Kiểm tra số dư" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Kiểm tra số dư TẤT CẢ các cổng" Command="{Binding CheckBalanceCommand}" CommandParameter="All">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="WalletPlus"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Kiểm tra số dư CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding CheckBalanceCommand}" CommandParameter="Selected">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="WalletOutline"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Background="#424242" Command="{Binding OpenCustomUssdDialogCommand}" CommandParameter="All" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Dialpad" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="USSD Tùy chỉnh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#424242" Command="{Binding OpenExportExcelDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#4CAF50"/>
                                    <TextBlock Text="Xuất Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Quét tin nhắn kẹt">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Broom" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#00E676"/>
                                    <TextBlock Text="Quét tin kẹt" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Quét TẤT CẢ các cổng" Command="{Binding SweepSmsCommand}" CommandParameter="All">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="Broom"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Quét CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding SweepSmsCommand}" CommandParameter="Selected">
                                            <MenuItem.Icon><materialDesign:PackIcon Kind="CursorDefaultClick"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Làm mới hoặc Khởi động lại cổng">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Làm mới / Reset" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Làm mới danh sách cổng (Refresh)" Command="{Binding RefreshPortsCommand}">
                                        </MenuItem>
                                        <Separator Background="#444"/>
                                        <MenuItem Header="⚡ Khởi động lại Modem CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding RebootModemCommand}" CommandParameter="Selected">
                                        </MenuItem>
                                        <MenuItem Header="⚡ Khởi động lại TẤT CẢ Modem" Command="{Binding RebootModemCommand}" CommandParameter="All">
                                        </MenuItem>
                                        <Separator Background="#444"/>
                                        <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding ClearSmsCommand}" CommandParameter="Selected">
                                        </MenuItem>
                                        <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên TẤT CẢ CỔNG" Command="{Binding ClearSmsCommand}" CommandParameter="All">
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Background="#29B6F6" Command="{Binding OpenNetworkSimDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Sim" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Mạng &amp; SIM" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#26C6DA" Command="{Binding OpenTopUpDialogCommand}" CommandParameter="All" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CreditCardPlus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Nạp thẻ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#AB47BC" Command="{Binding OpenComposeSmsDialogCommand}" CommandParameter="Selected" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MessageText" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Soạn tin nhắn" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#66BB6A" Command="{Binding OpenCallManagerDialogCommand}" Style="{StaticResource ModernButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Phone" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Quản lý cuộc gọi" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Toggles for Watchdog and Auto-Answer -->
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Đẩy OTT Web" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsWebNotificationEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Đẩy OTP/SMS lên máy chủ Web"/>
                                    </StackPanel>
                                </Border>
    
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Đẩy Telegram" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsTelegramNotificationEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bắn thông báo OTP/SMS qua Telegram"/>
                                    </StackPanel>
                                </Border>
    
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tự phục hồi (Watchdog)" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsWatchdogEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Tự động khởi động lại Modem (AT+CFUN=1,1) khi bị lỗi/mất sóng"/>
                                    </StackPanel>
                                </Border>
    
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tự nhấc máy" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsAutoAnswerEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Tự động bắt máy (ATA) khi có cuộc gọi đến"/>
                                    </StackPanel>
                                </Border>
    
                            </StackPanel>

                            <!-- 3 Ưu tiên IMEI -->
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="[1] Fake IMEI" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"/>
                                        <ToggleButton IsChecked="{Binding IsDeviceSpoofingEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bật tính năng giả lập (Fake IMEI) và tạo Profile thiết bị ngẫu nhiên"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="[2] Phục hồi IMEI" Foreground="#FFB300" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"/>
                                        <ToggleButton IsChecked="{Binding IsImeiRestoreEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bật tự động phục hồi (Restore) IMEI đã lưu nếu thẻ SIM bị chuyển sang cổng khác"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="[3] Chặn SIM lạ" Foreground="#90CAF9" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"/>
                                        <ToggleButton IsChecked="{Binding IsBlockUnknownSimsEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Không ghi nhận SIM mới (Chặn SIM lạ, chờ chấp thuận)"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="8" Margin="10,10,10,0">
