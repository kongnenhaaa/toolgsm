@using gsm.Components.Pages
@inject NavigationManager Nav
@implements IDisposable

<div class="persistent-page-host">
    <div class="persistent-page" style="@PageStyle("ussd")" aria-hidden="@(!IsActive("ussd"))">
        <Ussd IsPageActive="@IsActive("ussd")" />
    </div>
    <div class="persistent-page" style="@PageStyle("sms")" aria-hidden="@(!IsActive("sms"))">
        <Sms IsPageActive="@IsActive("sms")" />
    </div>
    <div class="persistent-page" style="@PageStyle("call")" aria-hidden="@(!IsActive("call"))">
        <Call IsPageActive="@IsActive("call")" />
    </div>
    <div class="persistent-page" style="@PageStyle("datausage")" aria-hidden="@(!IsActive("datausage"))">
        <DataUsage IsPageActive="@IsActive("datausage")" />
    </div>
    <div class="persistent-page" style="@PageStyle("ezcom")" aria-hidden="@(!IsActive("ezcom"))">
        <EzCom IsPageActive="@IsActive("ezcom")" />
    </div>
    <div class="persistent-page" style="@PageStyle("vnptpass")" aria-hidden="@(!IsActive("vnptpass"))">
        <VnptPass IsPageActive="@IsActive("vnptpass")" />
    </div>
    <div class="persistent-page" style="@PageStyle("dmx")" aria-hidden="@(!IsActive("dmx"))">
        <DienMayXanh IsPageActive="@IsActive("dmx")" />
    </div>
    <div class="persistent-page" style="@PageStyle("proxy")" aria-hidden="@(!IsActive("proxy"))">
        <Proxy IsPageActive="@IsActive("proxy")" />
    </div>
    <div class="persistent-page" style="@PageStyle("deviceunlock")" aria-hidden="@(!IsActive("deviceunlock"))">
        <DeviceUnlock IsPageActive="@IsActive("deviceunlock")" />
    </div>
    <div class="persistent-page" style="@PageStyle("icocunlock")" aria-hidden="@(!IsActive("icocunlock"))">
        <IcOcUnlock IsPageActive="@IsActive("icocunlock")" />
    </div>
    <div class="persistent-page" style="@PageStyle("settings")" aria-hidden="@(!IsActive("settings"))">
        <Settings />
    </div>
</div>

@code {
    private string _activeRoute = "ussd";

    protected override void OnInitialized()
    {
        SyncRoute();
        Nav.LocationChanged += OnLocationChanged;
    }

    private bool IsActive(string route) =>
        string.Equals(_activeRoute, route, StringComparison.OrdinalIgnoreCase);

    private string PageStyle(string route) =>
        IsActive(route) ? "display:block;" : "display:none;";

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();
        _activeRoute = path switch
        {
            "" or "ussd" => "ussd",
            "vnpt-pass" => "vnptpass",
            "dien-may-xanh" => "dmx",
            "proxy" => "proxy",
            "device-unlock" => "deviceunlock",
            "icoc-unlock" => "icocunlock",
            "sms" => "sms",
            "call" => "call",
            "data-usage" => "datausage",
            "ezcom" => "ezcom",
            "settings" => "settings",
            _ => "ussd"
        };
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
