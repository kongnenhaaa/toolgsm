<div style="display:flex; justify-content:space-between; align-items:center;">
    <MudText Typo="Typo.caption" Style="color:#64748B;">@Label</MudText>
    <MudText Typo="@(Small ? Typo.caption : Typo.body2)" 
             Style="@($"font-weight:{(Bold ? "600" : "400")}; color:{(string.IsNullOrEmpty(Color) ? "inherit" : Color)}; font-family:{(Mono ? "monospace" : "inherit")};")">
        @Value
    </MudText>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Bold { get; set; }
    [Parameter] public bool Mono { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public string Color { get; set; } = "";
}
