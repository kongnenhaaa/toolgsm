<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>gsm</RootNamespace>
    <AssemblyName>ToolGSM</AssemblyName>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);RegexTest\**;artifacts\**;gsm\**;logs\**;scratch\**;**\__pycache__\**;**\*.pyc</DefaultItemExcludes>
    <!-- Bộ eKYC gốc được đóng gói cạnh ToolGSM.exe khi build/publish. -->
    <DktttbSourceDirectory>$(MSBuildProjectDirectory)\..\..\..\kyc</DktttbSourceDirectory>
    <!-- .NET self-contained không chứa Python. Runtime này được chuẩn bị lúc
         publish và chép cạnh EXE để máy đích không cần cài Python/pip. -->
    <PortablePythonDirectory>$(BaseIntermediateOutputPath)portable-python\win-x64</PortablePythonDirectory>
    <PortablePythonRequirements>$(MSBuildProjectDirectory)\..\tools\requirements-portable-python.txt</PortablePythonRequirements>
    <PortablePythonPrepareScript>$(MSBuildProjectDirectory)\..\tools\PreparePortablePython.ps1</PortablePythonPrepareScript>
    <PortableWhisperModelDirectory>$(BaseIntermediateOutputPath)portable-models\faster-whisper-small</PortableWhisperModelDirectory>
    <PortableWhisperModelPrepareScript>$(MSBuildProjectDirectory)\..\tools\PreparePortableWhisperModel.ps1</PortableWhisperModelPrepareScript>
    <BundleWhisperModel Condition="'$(BundleWhisperModel)' == ''">false</BundleWhisperModel>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="MudBlazor" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="EPPlus" Version="7.7.3" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="voice_otp\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="device_unlock\run_unlock.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>run_unlock.py</TargetPath>
    </None>
    <None Update="device_unlock\auth_source.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>auth_source.py</TargetPath>
    </None>
  </ItemGroup>

  <!-- Các import nội bộ duy nhất của ekyc_full.py. Không chép tài khoản,
       token, ảnh hoặc history từ máy phát triển sang bản phát hành. -->
  <ItemGroup Condition="Exists('$(DktttbSourceDirectory)\ekyc_full.py')">
    <None Include="$(DktttbSourceDirectory)\ekyc_full.py" Link="ekyc_full.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(DktttbSourceDirectory)\cbss_support.py" Link="cbss_support.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(DktttbSourceDirectory)\proxy_support.py" Link="proxy_support.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Publish vào một thư mục cũ không tự xóa dependency đã bỏ khỏi project. -->
  <Target Name="RemoveRetiredSpeechRecognitionArtifactsAfterPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libvosk.dll;$(PublishDir)Vosk.dll;$(PublishDir)NAudio.dll;$(PublishDir)System.Speech.dll" />
    <RemoveDir Directories="$(PublishDir)vosk-model-vn-0.4"
               Condition="Exists('$(PublishDir)vosk-model-vn-0.4')" />
  </Target>

  <Target Name="PreparePortablePythonForPublish"
          BeforeTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(PortablePythonPrepareScript)&quot; -RuntimeDir &quot;$(PortablePythonDirectory)&quot; -RequirementsFile &quot;$(PortablePythonRequirements)&quot;" />
  </Target>

  <Target Name="PreparePortableWhisperModelForPublish"
          BeforeTargets="Publish"
          DependsOnTargets="PreparePortablePythonForPublish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(BundleWhisperModel)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(PortableWhisperModelPrepareScript)&quot; -PythonExe &quot;$(PortablePythonDirectory)\python.exe&quot; -ModelDir &quot;$(PortableWhisperModelDirectory)&quot;" />
  </Target>

  <!-- `dotnet publish -o` may point at a child of TargetDir (for example the
       user-facing ...\win-x64\gsm folder). In that layout the SDK can leave
       the app files in TargetDir while custom post-publish files reach the
       requested folder. Copy the resolved publish manifest explicitly so the
       requested directory is always a complete portable application. -->
  <Target Name="EnsureApplicationFilesAfterPublish"
          AfterTargets="Publish">
    <Copy SourceFiles="@(ResolvedFileToPublish)"
          DestinationFiles="@(ResolvedFileToPublish-&gt;'$(PublishDir)%(RelativePath)')"
          SkipUnchangedFiles="true"
          Condition="'@(ResolvedFileToPublish)' != ''" />
  </Target>

  <Target Name="CopyPortablePythonAfterPublish"
          AfterTargets="Publish"
          DependsOnTargets="PreparePortablePythonForPublish;EnsureApplicationFilesAfterPublish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_PortablePythonFile Include="$(PortablePythonDirectory)\**\*"
                           Exclude="$(PortablePythonDirectory)\Scripts\**\*;$(PortablePythonDirectory)\**\__pycache__\**\*;$(PortablePythonDirectory)\**\*.pyc" />
    </ItemGroup>
    <Copy SourceFiles="@(_PortablePythonFile)"
          DestinationFiles="@(_PortablePythonFile-&gt;'$(PublishDir)python_runtime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPortableWhisperModelAfterPublish"
          AfterTargets="Publish"
          DependsOnTargets="PreparePortableWhisperModelForPublish;EnsureApplicationFilesAfterPublish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(BundleWhisperModel)' == 'true'">
    <ItemGroup>
      <_PortableWhisperModelFile Include="$(PortableWhisperModelDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PortableWhisperModelFile)"
          DestinationFiles="@(_PortableWhisperModelFile-&gt;'$(PublishDir)voice_otp\models\faster-whisper-small\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
