@page "/ezcom"
@inject gsm.ViewModels.MainViewModel Vm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:10px;">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_ezCommand"
                      Label="Lệnh SMS"
                      Placeholder="DK EZ"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="width:160px;" />

        <MudTextField @bind-Value="_ezNumber"
                      Label="Số nhận"
                      Placeholder="888"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="width:120px;" />

        <MudSelect T="string" @bind-Value="_sendMode" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="width:150px;" Label="Gửi tới">
            <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
            <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
        </MudSelect>

        <MudNumericField @bind-Value="_delayMs"
                         Label="Delay (ms)"
                         Min="300" Max="5000"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         Style="width:110px;"
                         HelperText="giữa mỗi cổng" />

        @if (!_isRegistering)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="RegisterEzCom"
                       Disabled="@(string.IsNullOrWhiteSpace(_ezCommand) || string.IsNullOrWhiteSpace(_ezNumber))">
                Đăng ký
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Stop"
                       OnClick="StopRegister">
                ⏹ Dừng
            </MudButton>
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
        }

        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                   OnClick="ClearEzResults"
                   Disabled="@(!_ezResults.Any())">
            Xóa kết quả
        </MudButton>

        <MudSpacer />

        <MudChip T="string" Color="Color.Success" Size="Size.Small"
                 Variant="Variant.Text" Style="font-weight:600;">
            Thành công: <b>@_ezResults.Count(r => r.Success)</b>
        </MudChip>
        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                 Variant="Variant.Text" Style="font-weight:600;">
            Thất bại: <b>@_ezResults.Count(r => !r.Success)</b>
        </MudChip>
    </MudStack>

    @if (_isRegistering)
    {
        <MudStack Class="mt-2" Spacing="1">
            <MudText Typo="Typo.caption" Style="color:#64748B;">@_progressText</MudText>
            <MudProgressLinear Color="Color.Primary" Value="@_progressPercent" />
        </MudStack>
    }
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         PanelClass="pa-0" Class="mx-3 mt-1 feature-tabs"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_subTab">

    <!-- TAB 1: DANH SÁCH CỔNG -->
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <!-- TAB 2: KẾT QUẢ ĐĂNG KÝ -->
    <MudTabPanel Text="@($"Kết quả ({_ezResults.Count})")">
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">
                    Kết quả đăng ký EZ COM
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           OnClick="ClearEzResults"
                           Disabled="@(!_ezResults.Any())">
                    Xóa kết quả
                </MudButton>
            </MudStack>

            <MudTable Items="@_ezResults" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 280px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Lệnh</MudTh>
                    <MudTh>Số nhận</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Phản hồi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px; white-space:nowrap;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd Style="font-family:monospace;">@context.Command</MudTd>
                    <MudTd>@context.Number</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "Thành công" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="max-width:240px; overflow:hidden; text-overflow:ellipsis; font-size:12px; white-space:nowrap;"
                           title="@context.Response">
                        @context.Response
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có kết quả đăng ký</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _ezCommand = "DK EZ";
    private string _ezNumber = "888";
    private string _sendMode = "selected";
    private int _delayMs = 800;
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab = 0;

    // State
    private bool _isRegistering = false;
    private CancellationTokenSource? _cts;
    private string _progressText = "";
    private double _progressPercent = 0;

    private List<EzResultItem> _ezResults = new();

    // ========== DATA ==========
    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);
    private List<SimPort> FilteredPorts => Ports;

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
    }

    // ========== HELPERS ==========
    List<string> GetTargetPorts()
    {
        if (_sendMode == "all")
            return ActivePorts.Select(p => p.PortName).ToList();
        if (_selectedPorts.Any())
            return _selectedPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList();
        return ActivePorts.Select(p => p.PortName).ToList();
    }

    // ========== 2. ĐĂNG KÝ EZ COM ==========
    async Task RegisterEzCom()
    {
        if (string.IsNullOrWhiteSpace(_ezCommand) || string.IsNullOrWhiteSpace(_ezNumber))
        {
            Snackbar.Add("Nhập lệnh và số nhận (VD: DK EZ → 888)", Severity.Warning);
            return;
        }

        var targets = GetTargetPorts();
        if (!targets.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        if (targets.Count > 5)
        {
            var ok = await DialogService.ShowMessageBox("Xác nhận",
                $"Gửi SMS đăng ký EZ COM trên {targets.Count} cổng?\nLệnh: {_ezCommand} → {_ezNumber}",
                yesText: "Đăng ký", cancelText: "Hủy");
            if (ok != true) return;
        }

        _isRegistering = true;
        _cts = new CancellationTokenSource();
        _progressPercent = 0;
        int okCount = 0, failCount = 0;

        Snackbar.Add($"Đang đăng ký EZ COM trên {targets.Count} cổng...", Severity.Info);
        _subTab = 1; // Chuyển sang tab kết quả

        for (int i = 0; i < targets.Count; i++)
        {
            if (_cts.Token.IsCancellationRequested) break;

            string port = targets[i];
            string rawResponse = "";
            bool success = false;

            _progressText = $"[{i + 1}/{targets.Count}] {port} → Đang gửi...";
            _progressPercent = ((i + 1) * 100.0) / targets.Count;
            StateHasChanged();

            try
            {
                if (!Vm.IsPortReadyForOperation(port))
                {
                    rawResponse = "Cổng không còn Active hoặc SIM đã thay đổi";
                    failCount++;
                    throw new OperationCanceledException(rawResponse);
                }
                // Gửi SMS: lệnh đăng ký tới số dịch vụ
                rawResponse = await Vm.QueueSmsAsync(port, _ezNumber.Trim(), _ezCommand.Trim(), _cts.Token);

                if (rawResponse != null && (rawResponse.Contains("ERROR") || rawResponse.Contains("TIMEOUT")))
                {
                    failCount++;
                    Snackbar.Add($"[{port}] Lỗi: {rawResponse.Trim()}", Severity.Error);
                }
                else
                {
                    success = true;
                    okCount++;
                    Snackbar.Add($"[{port}] ✓ Đã gửi đăng ký EZ COM", Severity.Success);
                }
            }
            catch (OperationCanceledException ex)
            {
                rawResponse = ex.Message;
            }
            catch (Exception ex)
            {
                rawResponse = ex.Message;
                failCount++;
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }

            // Lấy SĐT của cổng nếu có
            string phone = Ports.FirstOrDefault(p => p.PortName == port)?.PhoneNumber ?? "—";

            _ezResults.Insert(0, new EzResultItem
            {
                Time = DateTime.Now,
                Port = port,
                Phone = phone,
                Command = _ezCommand.Trim(),
                Number = _ezNumber.Trim(),
                Success = success,
                Response = string.IsNullOrEmpty(rawResponse)
                    ? (success ? "Đã gửi SMS" : "Lỗi không xác định")
                    : rawResponse.Trim()
            });

            if (_ezResults.Count > 300)
                _ezResults.RemoveRange(300, _ezResults.Count - 300);

            StateHasChanged();

            // Delay an toàn giữa các cổng (có CancellationToken)
            try { await Task.Delay(_delayMs, _cts.Token); }
            catch (TaskCanceledException) { break; }
        }

        _isRegistering = false;
        _progressText = "";
        _progressPercent = 0;

        Snackbar.Add($"Hoàn tất EZ COM: {okCount} thành công, {failCount} lỗi",
            failCount == 0 ? Severity.Success : Severity.Warning);
        StateHasChanged();
    }

    // ========== 3. DỪNG ==========
    void StopRegister()
    {
        _cts?.Cancel();
        _isRegistering = false;
        _progressText = "Đã dừng";
        Snackbar.Add("Đã dừng đăng ký", Severity.Normal);
    }

    // ========== 4. XÓA KẾT QUẢ ==========
    void ClearEzResults()
    {
        _ezResults.Clear();
        Snackbar.Add("Đã xóa kết quả", Severity.Normal);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
    }

    // ========== MODEL ==========
    public class EzResultItem
    {
        public DateTime Time { get; set; }
        public string Port { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Command { get; set; } = "";
        public string Number { get; set; } = "";
        public bool Success { get; set; }
        public string Response { get; set; } = "";
    }
}
