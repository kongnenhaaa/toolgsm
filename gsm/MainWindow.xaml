                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#1e293b"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="8,6">
                                        <Grid>
                                            <TextBox Text="{Binding CommandPanelSmsRecipient, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="54"
                                                     Padding="0"
                                                     materialDesign:HintAssist.Hint="Nhập số điện thoại, rồi nhấn Enter, dấu cách, dấu phẩy hoặc dán danh sách"/>
