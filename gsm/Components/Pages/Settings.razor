    // ========== EXPORT / IMPORT ==========
    async Task ExportSettings()
    {
        try
        {
            await SaveAll();
            var path = FileDialog.SaveFile($"appsettings_{DateTime.Now:yyyyMMdd_HHmmss}.json",
                "JSON files (*.json)|*.json");
            if (string.IsNullOrEmpty(path)) return;

            var json = System.Text.Json.JsonSerializer.Serialize(
                gsm.Services.SettingsService.Current,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await File.WriteAllTextAsync(path, json);
            Snackbar.Add($"✓ Đã export: {path}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Export lỗi: " + ex.Message, Severity.Error);
        }
    }

    async Task ImportSettings()
    {
        try
        {
            var path = FileDialog.OpenFile("JSON files (*.json)|*.json");
            if (string.IsNullOrEmpty(path)) return;

            var json = await File.ReadAllTextAsync(path);
            var cfg = System.Text.Json.JsonSerializer.Deserialize<AppSettings>(json);
            if (cfg == null)
            {
                Snackbar.Add("File cấu hình rỗng hoặc sai định dạng", Severity.Warning);
                return;
            }

            gsm.Services.SettingsService.SaveSettings(cfg);
            LoadSettings();
            Snackbar.Add("✓ Đã import + áp dụng cấu hình thành công", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Import lỗi: " + ex.Message, Severity.Error);
        }
    }

    // ========== TEST TELEGRAM ==========
    async Task TestTelegram()
    {
        if (string.IsNullOrWhiteSpace(_telegramBotToken) || string.IsNullOrWhiteSpace(_telegramChatId))
        {
            Snackbar.Add("Nhập Bot Token và Chat ID trước", Severity.Warning);
            return;
        }

        Snackbar.Add("Đang gửi tin test Telegram...", Severity.Info);

        try
        {
            // Hỗ trợ nhiều Chat ID phân cách dấu phẩy
            var chatIds = _telegramChatId.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                                         .Select(x => x.Trim())
                                         .Where(x => !string.IsNullOrEmpty(x))
                                         .ToList();

            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
            bool allOk = true;

            foreach (var chatId in chatIds)
            {
                var url = $"https://api.telegram.org/bot{_telegramBotToken}/sendMessage";
                var payload = new
                {
                    chat_id = chatId,
                    text = $"✅ [Tool GSM] Test thông báo thành công!\nBot Token hợp lệ.\nTime: {DateTime.Now:HH:mm:ss dd/MM/yyyy}",
                    parse_mode = "HTML"
                };
                var json = System.Text.Json.JsonSerializer.Serialize(payload);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var resp = await http.PostAsync(url, content);

                if (!resp.IsSuccessStatusCode)
                {
                    string body = await resp.Content.ReadAsStringAsync();
                    Snackbar.Add($"Telegram lỗi (ChatID: {chatId}): {body}", Severity.Error);
                    allOk = false;
                }
            }

            if (allOk)
                Snackbar.Add($"✓ Gửi Telegram thành công tới {chatIds.Count} Chat ID", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi Telegram: " + ex.Message, Severity.Error);
        }
    }

