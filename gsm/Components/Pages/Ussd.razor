@page "/ussd"
@page "/"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@using System.Collections.Concurrent
@implements IDisposable

<!-- ========== ACTION FORM ========== -->
<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.caption" Style="color:#64748B; min-width:70px;">Mã USSD</MudText>
        <MudTextField @bind-Value="_ussdCode" Placeholder="*101#" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Style="max-width:160px; background:#F8FAFC;" Immediate="true" />

        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="SendSelectedOrAll" Disabled="@string.IsNullOrWhiteSpace(_ussdCode)">
            @(_ussdInFlight.IsEmpty ? "Thực hiện" : $"Thực hiện ({_ussdInFlight.Count} đang chạy)")
        </MudButton>

        <MudText Typo="Typo.caption" Style="color:#64748B; margin-left:12px;">Mức sóng</MudText>
        <MudSelect T="string" @bind-Value="_scanMode" Dense="true" Variant="Variant.Outlined" 
                   Margin="Margin.Dense" Style="width:100px; background:#F8FAFC;">
            <MudSelectItem Value="@("Auto")">Auto</MudSelectItem>
            <MudSelectItem Value="@("4G")">4G</MudSelectItem>
            <MudSelectItem Value="@("3G")">3G</MudSelectItem>
            <MudSelectItem Value="@("2G")">2G</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Wifi" OnClick="ApplyScanMode">
            Thay đổi
        </MudButton>

        <MudButton Variant="Variant.Filled" Size="Size.Small"
                   Style="background:#A16207; color:white;"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecoverSignal">
            Khôi phục sóng
        </MudButton>
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Link" OnClick="ConnectAll">
            Connect All
        </MudButton>
    </MudStack>
</MudPaper>

<!-- ========== SUB TABS ========== -->
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
         PanelClass="pa-0" Class="mx-3 feature-tabs"
         Style="background:transparent;"
         @bind-ActivePanelIndex="_subTab">

    <!-- TAB 1: DANH SÁCH CỔNG -->
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="FilteredPorts" Operation="USSD" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <!-- TAB 2: TIN NHẮN TỚI -->
    <MudTabPanel Text="Tin nhắn tới">
        <MudPaper Elevation="0" Class="mt-2" Style="border:1px solid #E2E8F0; border-radius:10px; overflow:hidden;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-2" Spacing="2">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">
                    Tin nhắn tới (@IncomingSms.Count)
                </MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           OnClick="ClearAllSms"
                           Disabled="@(!IncomingSms.Any())">
                    Xóa tất cả
                </MudButton>
            </MudStack>
            <MudTable Items="@IncomingSms" Dense="true" Hover="true" Elevation="0" Height="calc(100vh - 280px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SIM nhận</MudTh>
                    <MudTh>Người gửi</MudTh>
                    <MudTh>Nội dung</MudTh>
                    <MudTh>OTP</MudTh>
                    <MudTh Style="width:90px;">Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:16px; white-space:nowrap;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd Style="font-size:16px; white-space:nowrap;">
                        <div style="font-weight:600; color:#0F172A;">@context.ReceiverDisplay</div>
                        @if (!string.IsNullOrWhiteSpace(context.NetworkProvider))
                        {
                            <div style="font-size:12px; color:#64748B;">@context.NetworkProvider</div>
                        }
                    </MudTd>
                    <MudTd Style="font-size:16px;">@context.Sender</MudTd>
                    <MudTd Style="font-size:16px; white-space:nowrap;" title="@context.Content">
                        @context.Content
                    </MudTd>
                    <MudTd Style="font-size:16px; font-family:monospace; color:#2563EB; font-weight:600;">
                        @(context.Otp ?? "—")
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                       OnClick="@(() => CopyText(context.Content))" title="Copy" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteSms(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.Sms" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có tin nhắn tới</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 3: SPAM SMS -->
    <MudTabPanel Text="Spam SMS">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Spam SMS hàng loạt</MudText>
            
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_spamPhone" Label="Số nhận (mỗi dòng 1 số)" Lines="5"
                                  Variant="Variant.Outlined" Placeholder="0912345678&#10;0987654321" Class="mb-3" />
                    <MudTextField @bind-Value="_spamContent" Label="Nội dung" Lines="3"
                                  Variant="Variant.Outlined" Class="mb-3" />
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudNumericField @bind-Value="_spamDelay" Label="Delay (ms)" Min="500" Max="10000"
                                         Variant="Variant.Outlined" Style="max-width:160px;" />
                        <MudText Typo="Typo.caption" Style="color:#64748B;">giữa mỗi tin</MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Send" OnClick="StartSpamSms"
                                   Disabled="@(string.IsNullOrWhiteSpace(_spamPhone) || string.IsNullOrWhiteSpace(_spamContent) || _isSpamming)">
                            Bắt đầu Spam
                        </MudButton>
                        @if (_isSpamming)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="StopSpamSms"
                                       Disabled="@_isStoppingSpam" Size="Size.Medium">
                                @(_isStoppingSpam ? "Đang dừng..." : "⏹ Dừng Spam")
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-3" Style="background:#F8FAFC; border-radius:8px; min-height:220px; max-height:350px; overflow-y:auto;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudText Typo="Typo.caption" Style="font-weight:600;">Tiến trình</MudText>
                            @if (_isSpamming)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            }
                        </MudStack>
                        <pre style="font-size:11px; white-space:pre-wrap; margin:0; color:#1F2937;">@_spamLog</pre>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 4: SPAM/CHECK GỌI -->
    <MudTabPanel Text="Spam/Check Gọi">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Spam / Check cuộc gọi</MudText>
            
            <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_checkCallPhone" Label="Số cần check / spam" 
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:200px;" />
                <MudNumericField @bind-Value="_checkCallDuration" Label="Thời lượng (giây)" Min="5" Max="120"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:150px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartCheckCall"
                           Disabled="@(string.IsNullOrWhiteSpace(_checkCallPhone) || _isCheckingCall)">
                    @(_isCheckingCall ? "Đang gọi..." : "Gọi Check")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="StopAllCalls">
                    ⏹ Dập tất cả
                </MudButton>
                @if (_callCheckHistory.Any())
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => _callCheckHistory.Clear())">
                        Xóa lịch sử
                    </MudButton>
                }
            </MudStack>

            <MudTable Items="@_callCheckHistory" Dense="true" Hover="true" Elevation="0" Height="calc(100vh - 280px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>Số gọi</MudTh>
                    <MudTh>Kết quả</MudTh>
                    <MudTh>Thời lượng</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:12px;">@context.Time.ToString("HH:mm:ss")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Success ? Color.Success : Color.Error)">
                            @context.Result
                        </MudChip>
                    </MudTd>
                    <MudTd>@(context.Duration > 0 ? $"{context.Duration}s" : "—")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-8 text-center" Style="color:#94A3B8;">Chưa có lịch sử check gọi</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 5: DTMF -->
    <MudTabPanel Text="DTMF (Call)">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">DTMF / Nhấn phím trong cuộc gọi</MudText>
            
            <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                <MudSelect T="string" Label="Cổng đang gọi" @bind-Value="_dtmfPort" 
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" Dense="true">
                    @foreach (var p in Ports.Where(x => x.Status == SimStatus.Active))
                    {
                        <MudSelectItem Value="@p.PortName">@p.PortName @(string.IsNullOrEmpty(p.PhoneNumber) ? "" : $"({p.PhoneNumber})")</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_dtmfCode" Label="Mã DTMF" Placeholder="1# hoặc 1234#"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:160px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendDtmf"
                           Disabled="@(string.IsNullOrWhiteSpace(_dtmfPort) || string.IsNullOrWhiteSpace(_dtmfCode))">
                    Gửi DTMF
                </MudButton>
            </MudStack>

            <MudAlert Severity="Severity.Info" Dense="true">
                Chỉ gửi được khi cổng đang trong cuộc gọi (trạng thái CLCC active). Dùng AT+VTS (Quectel).
            </MudAlert>

            @if (!string.IsNullOrEmpty(_dtmfLog))
            {
                <MudPaper Class="pa-2 mt-3" Style="background:#F8FAFC; border-radius:8px;">
                    <pre style="font-size:12px; margin:0;">@_dtmfLog</pre>
                </MudPaper>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 6: THÔNG BÁO -->
    <MudTabPanel Text="Thông báo">
        <MudPaper Class="pa-4 mt-2" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">Cài đặt thông báo</MudText>
            
            <MudSwitch T="bool" @bind-Value="_notifySms" Label="Thông báo âm thanh khi có SMS mới" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_notifyCall" Label="Thông báo âm thanh khi có cuộc gọi" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_notifyOtp" Label="Thông báo âm thanh khi phát hiện OTP" Color="Color.Primary" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_notifyTelegram" Label="Gửi Telegram khi có OTP" Color="Color.Primary" Class="mb-3" />
            
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveNotifySettings">
                💾 Lưu cài đặt thông báo
            </MudButton>
        </MudPaper>
    </MudTabPanel>

</MudTabs>

@code {
    // ========== BINDINGS ==========
    private string _ussdCode = "*101#";
    private string _scanMode = "Auto";
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab = 0;
    private readonly ConcurrentDictionary<string, byte> _ussdInFlight = new(StringComparer.OrdinalIgnoreCase);
    private readonly ConcurrentDictionary<string, byte> _networkInFlight = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _pageCts = new();

    // Spam SMS
    private string _spamPhone = "";
    private string _spamContent = "";
    private int _spamDelay = 1500;
    private string _spamLog = "";
    private bool _isSpamming = false;
    private bool _isStoppingSpam = false;
    private CancellationTokenSource? _spamCts;

    // Check Call
    private string _checkCallPhone = "";
    private int _checkCallDuration = 15;
    private List<CallCheckItem> _callCheckHistory = new();
    private bool _isCheckingCall = false;
    private CancellationTokenSource? _checkCallCts;

    // DTMF
    private string _dtmfPort = "";
    private string _dtmfCode = "";
    private string _dtmfLog = "";

    // Notify
    private bool _notifySms = true;
    private bool _notifyCall = true;
    private bool _notifyOtp = true;
    private bool _notifyTelegram = false;

    // ========== DATA ==========
    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private List<SimPort> FilteredPorts => Ports;
    private IEnumerable<SimPort> ActivePorts => Ports.Where(p => p.Status == SimStatus.Active);

    private List<IncomingSmsItem> IncomingSms =>
        Vm.SmsMessages?
            .Select(x => new IncomingSmsItem
            {
                Time = DateTime.TryParse(x.ReceivedTime, out var t) ? t : DateTime.Now,
                Port = x.PortName,
                ReceiverPhone = x.ReceiverPhone,
                NetworkProvider = x.NetworkProvider,
                Sender = x.Sender,
                Content = x.Content,
                Otp = x.Otp,
                OriginalMessage = x
            }).OrderByDescending(x => x.Time).Take(200).ToList()
        ?? new();

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1500, 1500);
        var settings = gsm.Services.SettingsService.Current;
        if (settings != null)
        {
            _notifySms = settings.SoundOnSms;
            _notifyCall = settings.SoundOnCall;
            _notifyOtp = settings.SoundOnOtp;
            _notifyTelegram = settings.TelegramOnOtp;
        }
    }

    // ========== 3. GỬI USSD (qua ViewModel throttle) ==========
    async Task SendSelectedOrAll()
    {
        if (string.IsNullOrWhiteSpace(_ussdCode)) return;
        string requestedCode = _ussdCode.Trim();

        var requested = _selectedPorts.Any()
            ? _selectedPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!requested.Any())
        {
            Snackbar.Add("Không có cổng Active nào để gửi USSD", Severity.Warning);
            return;
        }

        if (requested.Count > 5)
        {
            var confirm = await DialogService.ShowMessageBox("Xác nhận",
                $"Gửi USSD \"{requestedCode}\" tới {requested.Count} cổng?",
                yesText: "Gửi", cancelText: "Hủy");
            if (confirm != true) return;
        }

        var targets = requested
            .Where(portName => !_networkInFlight.ContainsKey(portName) && _ussdInFlight.TryAdd(portName, 0))
            .ToList();
        int alreadyRunning = requested.Count - targets.Count;
        if (alreadyRunning > 0)
            Snackbar.Add($"Bỏ qua {alreadyRunning} COM đang chạy USSD; các COM mới vẫn được thực hiện.", Severity.Info);
        if (!targets.Any())
        {
            Snackbar.Add("Các COM đã chọn đang chạy USSD.", Severity.Warning);
            return;
        }

        // Nhả selection ngay sau khi chụp danh sách để người dùng chọn COM khác trong lúc chạy.
        if (_selectedPorts.Any())
            _selectedPorts.RemoveWhere(p => targets.Contains(p.PortName, StringComparer.OrdinalIgnoreCase));

        foreach (string portName in targets)
            SetPortContent(portName, $"[USSD][ĐANG CHẠY] Đang gửi {requestedCode}...");
        Snackbar.Add($"Đang gửi USSD tới {targets.Count} cổng...", Severity.Info);
        StateHasChanged();

        var tasks = targets.Select(async portName =>
        {
            (string Port, string Result, bool Success) completed;
            try
            {
                string result = gsm.Services.UssdResponseDecoder.Normalize(
                    await Vm.SendUssdForPortAsync(portName, requestedCode));
                completed = (portName, result, IsUssdSuccess(result));
            }
            catch (Exception ex)
            {
                completed = (portName, $"Lỗi: {ex.Message}", false);
            }
            finally
            {
                _ussdInFlight.TryRemove(portName, out _);
            }

            await InvokeAsync(() =>
            {
                SetPortContent(completed.Port,
                    $"[USSD][{(completed.Success ? "HOÀN TẤT" : "THẤT BẠI")}] {completed.Result}");
                StateHasChanged();
            });
            return completed;
        });

        var results = await Task.WhenAll(tasks);
        int ok = results.Count(r => r.Success);
        int fail = results.Count(r => !r.Success);

        Snackbar.Add($"USSD xong: {ok} thành công, {fail} lỗi",
            fail == 0 ? Severity.Success : Severity.Warning);
    }

    static bool IsUssdSuccess(string result) =>
        !string.IsNullOrWhiteSpace(result)
        && !result.Contains("ERROR", StringComparison.OrdinalIgnoreCase)
        && !result.Contains("Timeout", StringComparison.OrdinalIgnoreCase)
        && !result.Contains("Lỗi", StringComparison.OrdinalIgnoreCase)
        && !result.Contains("failed", StringComparison.OrdinalIgnoreCase);

    static bool IsCommandFailure(string response) =>
        string.IsNullOrWhiteSpace(response)
        || response.Contains("ERROR", StringComparison.OrdinalIgnoreCase)
        || response.Contains("Timeout", StringComparison.OrdinalIgnoreCase);

    void SetPortContent(string portName, string content)
    {
        var port = Ports.FirstOrDefault(p =>
            p.PortName.Equals(portName, StringComparison.OrdinalIgnoreCase));
        if (port == null) return;
        port.LastMessageContent = content;
        port.Sender = content.StartsWith("[USSD]", StringComparison.OrdinalIgnoreCase) ? "USSD" : "SYSTEM";
        port.UpdatedAt = DateTime.Now.ToString("HH:mm:ss");
    }

    // ========== 4. THAY ĐỔI MỨC SÓNG ==========
    async Task ApplyScanMode()
    {
        var requested = _selectedPorts.Any()
            ? _selectedPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!requested.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }
        if (requested.Count > 5)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Xác nhận đổi mạng",
                $"Chuyển {requested.Count} COM sang chế độ {_scanMode}? Các COM sẽ đăng ký mạng lại.",
                yesText: "Thay đổi", cancelText: "Hủy");
            if (confirmed != true) return;
        }

        string nwscanmode = _scanMode switch
        {
            "2G" => "1",
            "3G" => "2",
            "4G" => "3",
            _ => "0"
        };

        var targets = requested
            .Where(port => !_ussdInFlight.ContainsKey(port) && _networkInFlight.TryAdd(port, 0))
            .ToList();
        int skipped = requested.Count - targets.Count;
        if (!targets.Any())
        {
            Snackbar.Add("Các COM đã chọn đang bận USSD hoặc phục hồi mạng.", Severity.Warning);
            return;
        }

        Snackbar.Add($"Đang áp dụng mức sóng {_scanMode} cho {targets.Count} cổng{(skipped > 0 ? $"; bỏ qua {skipped} COM đang bận" : "")}...", Severity.Info);
        foreach (string port in targets)
        {
            SetPortContent(port, $"[MẠNG][ĐANG CHẠY] Chuyển sang {_scanMode}");
        }

        var tasks = targets.Select(async port =>
        {
            bool success = false;
            string message;
            try
            {
                if (!Vm.IsPortReadyForOperation(port))
                    throw new InvalidOperationException("COM không còn Active hoặc SIM đã thay đổi");
                if (ModemService.GetModemProfile(port)?.Supports(ModemCapability.NetworkScanConfig) != true)
                    throw new NotSupportedException("Model không hỗ trợ QCFG nwscanmode");

                string response = await ModemService.SendCommandAsync(
                    port, $"AT+QCFG=\"nwscanmode\",{nwscanmode}", 10000, true);
                if (IsCommandFailure(response))
                    throw new InvalidOperationException(response.Trim());

                string verify = await ModemService.SendCommandAsync(
                    port, "AT+QCFG=\"nwscanmode\"", 5000, true);
                success = !IsCommandFailure(verify)
                    && System.Text.RegularExpressions.Regex.IsMatch(
                        verify, $@"nwscanmode\""\s*,\s*{nwscanmode}\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (success)
                {
                    // Đổi RAT làm modem đăng ký mạng lại. Khởi động lại vòng
                    // polling để phát ngay CSQ/COPS mới thay vì chờ chu kỳ nền
                    // tiếp theo (trước đây cột Tín hiệu bị giữ dấu '-').
                    var pollingPort = Vm.GetPortsSnapshot()
                        .FirstOrDefault(item => string.Equals(
                            item.PortName,
                            port,
                            StringComparison.OrdinalIgnoreCase));
                    ModemService.StartPollingNetwork(
                        port,
                        pollingPort?.Serial ?? string.Empty,
                        pollingPort?.Imei ?? string.Empty);
                    _ = RefreshSignalAfterNetworkChangeAsync(port);
                }
                message = success
                    ? $"Đã chuyển sang {_scanMode}; modem xác nhận {verify.Trim()}"
                    : $"Không xác minh được chế độ {_scanMode}: {verify.Trim()}";
            }
            catch (Exception ex)
            {
                message = $"Lỗi chuyển {_scanMode}: {ex.Message}";
            }
            finally
            {
                _networkInFlight.TryRemove(port, out _);
            }

            await InvokeAsync(() =>
            {
                SetPortContent(port, $"[MẠNG][{(success ? "HOÀN TẤT" : "THẤT BẠI")}] {message}");
                StateHasChanged();
            });
            return success;
        });

        bool[] results = await Task.WhenAll(tasks);
        int ok = results.Count(x => x);
        Snackbar.Add($"Chuyển {_scanMode} xong: {ok} thành công, {results.Length - ok} lỗi",
            ok == results.Length ? Severity.Success : Severity.Warning);
    }

    async Task<bool> RefreshSignalAfterNetworkChangeAsync(string portName)
    {
        // CSQ có thể trả 99 trong vài giây đầu khi RF đang đăng ký lại. Thử
        // hữu hạn để UI nhận giá trị mới mà không giữ task mạng vô thời hạn.
        for (int attempt = 0; attempt < 8 && !_pageCts.IsCancellationRequested; attempt++)
        {
            try
            {
                await Task.Delay(attempt == 0 ? 800 : 1500, _pageCts.Token);
                if (!Vm.IsPortReadyForOperation(portName)) return false;

                string response = await ModemService.SendCommandAsync(
                    portName, "AT+CSQ", 5000, silent: true, ct: _pageCts.Token);
                if (!gsm.ViewModels.MainViewModel.TryParseCsqResponse(response, out int rssi, out int percent))
                    continue;

                var port = Ports.FirstOrDefault(p =>
                    p.PortName.Equals(portName, StringComparison.OrdinalIgnoreCase));
                if (port == null) return false;

                if (rssi != 99)
                {
                    await InvokeAsync(() =>
                    {
                        port.SignalRssi = rssi;
                        port.SignalStrength = percent;
                        port.LastSignalScanAt = DateTime.Now;
                        StateHasChanged();
                    });
                    return true;
                }
            }
            catch (OperationCanceledException) when (_pageCts.IsCancellationRequested)
            {
                return false;
            }
            catch (Exception ex)
            {
                Vm.AddLog($"[{portName}] [NETWORK_SIGNAL_REFRESH] {ex.Message}", "WARN");
            }
        }

        Vm.AddLog($"[{portName}] [NETWORK_SIGNAL_WAIT] Đã chuyển chế độ mạng nhưng CSQ vẫn chưa có giá trị.", "INFO");
        return false;
    }

    // ========== 5. KHÔI PHỤC SÓNG ==========
    async Task RecoverSignal()
    {
        var requested = _selectedPorts.Any()
            ? _selectedPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!requested.Any())
        {
            Snackbar.Add("Không có cổng", Severity.Warning);
            return;
        }
        if (requested.Count > 5)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Xác nhận khôi phục sóng",
                $"Khôi phục {requested.Count} COM? Modem sẽ reload và xác minh lại SIM/IMEI.",
                yesText: "Khôi phục", cancelText: "Hủy");
            if (confirmed != true) return;
        }

        var targets = requested
            .Where(port => !_ussdInFlight.ContainsKey(port) && _networkInFlight.TryAdd(port, 0))
            .ToList();
        if (!targets.Any())
        {
            Snackbar.Add("Các COM đã chọn đang bận USSD hoặc thao tác mạng.", Severity.Warning);
            return;
        }

        Snackbar.Add($"Đang khôi phục sóng {targets.Count} cổng...", Severity.Info);
        foreach (string port in targets)
        {
            SetPortContent(port, "[MẠNG][ĐANG CHẠY] Khôi phục sóng và xác minh SIM/IMEI");
        }

        var tasks = targets.Select(async port =>
        {
            bool success = false;
            string message;
            try
            {
                bool started = await Vm.RecoverActivePortAsync(port);
                if (started)
                {
                    for (int probe = 0; probe < 45 && !Vm.IsPortReadyForOperation(port); probe++)
                        await Task.Delay(2000, _pageCts.Token);
                    success = Vm.IsPortReadyForOperation(port);
                }
                message = success
                    ? "Khôi phục hoàn tất, SIM/IMEI đã được xác minh và COM đã Active"
                    : started
                        ? "Khôi phục timeout: COM chưa trở lại Active sau 90 giây"
                        : "Không thể bắt đầu khôi phục: COM không còn Active hoặc phiên SIM đã thay đổi";
            }
            catch (Exception ex)
            {
                message = "Khôi phục lỗi: " + ex.Message;
            }
            finally
            {
                _networkInFlight.TryRemove(port, out _);
            }

            await InvokeAsync(() =>
            {
                SetPortContent(port, $"[MẠNG][{(success ? "HOÀN TẤT" : "THẤT BẠI")}] {message}");
                StateHasChanged();
            });
            return success;
        });

        bool[] results = await Task.WhenAll(tasks);
        int ok = results.Count(x => x);
        Snackbar.Add($"Khôi phục sóng xong: {ok} thành công, {results.Length - ok} lỗi",
            ok == results.Length ? Severity.Success : Severity.Warning);
    }

