        Snackbar.Add("Đã xóa tất cả tin nhắn", Severity.Normal);
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _timer?.Dispose();
        _spamCts?.Cancel();
        _checkCallCts?.Cancel();
        _spamCts?.Dispose();
        _checkCallCts?.Dispose();
        _pageCts.Dispose();
    }

