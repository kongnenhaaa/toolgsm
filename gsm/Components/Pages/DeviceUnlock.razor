@page "/device-unlock"
@inject gsm.ViewModels.MainViewModel Vm
@inject gsm.Services.DeviceUnlockAuthService AuthService
@inject gsm.Services.DeviceUnlockAccountHistoryService AccountHistory
@inject gsm.Services.IFileDialogService FileDialogs
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@using gsm.Services
@implements IDisposable

<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:10px;">
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="3">
            <MudSelect T="string" @bind-Value="_sendMode" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Label="Thực hiện trên">
                <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
                <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudNumericField T="int" @bind-Value="_parallelism"
                             Label="Số luồng" Min="1" Max="64"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" Disabled="@_isRunning" />
        </MudItem>
        <MudItem xs="12" md="7">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                @if (!_isRunning)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PhonelinkLock"
                               OnClick="StartDeviceUnlock">
                        Mở khóa đổi thiết bị
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Replay"
                               OnClick="RetryFailedDeviceUnlock"
                               Disabled="@(Vm.LastDeviceUnlockFailedPortCount == 0)">
                        Chạy lại COM lỗi (@Vm.LastDeviceUnlockFailedPortCount)
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="StopDeviceUnlock">
                        Dừng
                    </MudButton>
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }

                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                           OnClick="ClearResults"
                           Disabled="@(!Vm.DeviceUnlockResults.Any())">
                    Xóa kết quả
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportCurrentSessionExcel"
                           Disabled="@(_isRunning || Vm.CurrentDeviceUnlockSessionResultCount == 0)">
                    Xuất Excel phiên này
                </MudButton>

                <MudTooltip Text="@DeviceUnlockAutoOutputService.FileName">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                        Tự lưu Excel · tối đa 500 dòng
                    </MudChip>
                </MudTooltip>

                <MudSpacer />
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">
                    Thành công: <b>@Vm.DeviceUnlockSuccessCount</b>
                </MudChip>
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">
                    Thất bại: <b>@Vm.DeviceUnlockFailCount</b>
                </MudChip>
            </MudStack>
        </MudItem>
    </MudGrid>

    @if (_isRunning)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
            Tool đang yêu cầu OTP đăng nhập MyVNPT, tự bắt OTP theo đúng COM rồi chạy DKTTTB/eKYC.
            @if (!string.IsNullOrWhiteSpace(Vm.DeviceUnlockSummaryText))
            {
                <br /><b>@Vm.DeviceUnlockSummaryText</b>
            }
        </MudAlert>
    }
    else if (!Vm.IsDeviceUnlockRuntimeAvailable)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">
            Không tìm thấy <b>ekyc_full.py</b>. Tool đang dò trong thư mục <b>Pictures\kyc</b>.
        </MudAlert>
    }
</MudPaper>

<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:10px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" />
        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Đăng nhập nguồn ảnh</MudText>
        <MudTooltip Text="@_cbssSessionMessage">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@CbssSessionColor">
                CBSS: @CbssSessionLabel
            </MudChip>
        </MudTooltip>
        <MudTooltip Text="@_employSessionMessage">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@EmploySessionColor">
                Employ: @EmploySessionLabel
            </MudChip>
        </MudTooltip>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RefreshSourceSessions"
                   Disabled="@AuthControlsDisabled">
            Refresh phiên
        </MudButton>
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@(_showSourceLogin ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _showSourceLogin = !_showSourceLogin)">
            @(_showSourceLogin ? "Thu gọn" : "Mở đăng nhập")
        </MudButton>
    </MudStack>

    @if (_showSourceLogin)
    {
        <MudGrid Spacing="2" Class="mt-1">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:8px;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:700;">CBSS trực tiếp</MudText>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_cbssUsername" Label="Tài khoản CBSS"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@AuthControlsDisabled" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_cbssPassword" Label="Mật khẩu"
                                          InputType="InputType.Text" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Disabled="@AuthControlsDisabled" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_cbssOtp" Label="OTP/PIN (6 số)"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@AuthControlsDisabled" />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="SendCbssPin" Disabled="@(AuthControlsDisabled || string.IsNullOrWhiteSpace(_cbssUsername))">
                            Lấy OTP/PIN
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="LoginCbss"
                                   Disabled="@(AuthControlsDisabled || string.IsNullOrWhiteSpace(_cbssUsername) || string.IsNullOrWhiteSpace(_cbssPassword) || string.IsNullOrWhiteSpace(_cbssOtp))">
                            Đăng nhập CBSS
                        </MudButton>
                        <MudText Typo="Typo.caption" Style="color:#64748B;">Cần mạng nội bộ/VPN.</MudText>
                    </MudStack>
                    @if (_cbssSavedAccounts.Count > 0)
                    {
                        <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.caption" Style="color:#64748B;">Đã đăng nhập:</MudText>
                            @foreach (string account in _cbssSavedAccounts)
                            {
                                <MudButton @key="account" Size="Size.Small" Variant="Variant.Text"
                                           Color="Color.Default" OnClick="@(() => SelectCbssAccount(account))">
                                    @account
                                </MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       OnClick="ClearCbssAccounts">Xóa danh sách</MudButton>
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E2E8F0; border-radius:8px;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:700;">Employ (OneBSS)</MudText>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_employUsername" Label="Tài khoản Employ"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@AuthControlsDisabled" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_employPassword" Label="Mật khẩu"
                                          InputType="InputType.Text" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Disabled="@AuthControlsDisabled" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_employOtp" Label="OTP Employ"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@AuthControlsDisabled" />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="BeginEmployLogin"
                                   Disabled="@(AuthControlsDisabled || string.IsNullOrWhiteSpace(_employUsername) || string.IsNullOrWhiteSpace(_employPassword))">
                            Gửi OTP Employ
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="LoginEmployWithOtp"
                                   Disabled="@(AuthControlsDisabled || string.IsNullOrWhiteSpace(_employUsername) || string.IsNullOrWhiteSpace(_employPassword) || string.IsNullOrWhiteSpace(_employOtp))">
                            Đăng nhập OTP
                        </MudButton>
                    </MudStack>
                    @if (_employSavedAccounts.Count > 0)
                    {
                        <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.caption" Style="color:#64748B;">Đã đăng nhập:</MudText>
                            @foreach (string account in _employSavedAccounts)
                            {
                                <MudButton @key="account" Size="Size.Small" Variant="Variant.Text"
                                           Color="Color.Default" OnClick="@(() => SelectEmployAccount(account))">
                                    @account
                                </MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       OnClick="ClearEmployAccounts">Xóa danh sách</MudButton>
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(_authMessage))
        {
            <MudAlert Severity="@(_authMessageIsError ? Severity.Error : Severity.Info)"
                      Dense="true" Class="mt-2">
                @_authMessage
            </MudAlert>
        }
    }
</MudPaper>

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         PanelClass="pa-0" Class="mx-3 mt-1 feature-tabs"
         Style="background:transparent;" @bind-ActivePanelIndex="_subTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="Ports" Operation="DKTTTB" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="@($"Kết quả ({Vm.DeviceUnlockResults.Count})")">
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudTable Items="@Vm.DeviceUnlockResults" Dense="true" Hover="true"
                      Elevation="0" Height="calc(100vh - 280px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Họ tên</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Phản hồi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(Vm.DeviceUnlockResults.IndexOf(context) + 1)</MudTd>
                    <MudTd Style="white-space:nowrap;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(context.FullName) ? "—" : context.FullName)</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.AlreadyCompleted ? "Đã hoàn thành" : context.Success ? "Thành công" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                           title="@context.Response">
                        @context.Response
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.PhonelinkLock" Size="Size.Large" Class="mb-2" />
                        <div>Chưa có kết quả mở khóa đổi thiết bị</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hướng dẫn">
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Info" Dense="true">
                    SIM phải Active, có SĐT VinaPhone và nhận được SMS OTP MyVNPT.
                    Không cần nhập mật khẩu MyVNPT.
                </MudAlert>
                <MudText Typo="Typo.body2">
                    <b>1.</b> Đăng nhập ít nhất một nguồn ảnh: <b>CBSS</b> hoặc <b>Employ</b> (có thể bỏ qua nếu ảnh local đã có).<br />
                    <b>2.</b> Chọn các COM cần xử lý.<br />
                    <b>3.</b> Nhấn <b>Mở khóa đổi thiết bị</b>.<br />
                    <b>4.</b> Tool chờ xóa SMS kết thúc, gửi OTP đăng nhập MyVNPT và tự bắt mã đúng COM.<br />
                    <b>5.</b> Khi nhận OTP, Tool tải ảnh và chạy luồng DKTTTB/eKYC từ <b>ekyc_full.py</b>.<br />
                    <b>6.</b> Xem kết quả ở tab <b>Kết quả</b>.
                </MudText>
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Luồng eKYC vẫn cần ảnh thuê bao/phiên CBSS theo cấu hình hiện có của thư mục KYC.
                </MudAlert>
            </MudStack>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public bool IsPageActive { get; set; }

    private string _sendMode = "selected";
    private int _parallelism = 5;
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab;
    private bool _isRunning;
    private int _startGuard;
    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _authCts;
    private List<SimPort>? _retryTargets;
    private System.Threading.Timer? _timer;
    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private bool _showSourceLogin = true;
    private bool _authBusy;
    private bool _cbssConfigured;
    private bool _employConfigured;
    private bool _cbssPinged;
    private bool _cbssSessionValid;
    private int _cbssHttpStatus;
    private string _cbssSessionMessage = string.Empty;
    private bool _employPinged;
    private bool _employSessionValid;
    private int _employHttpStatus;
    private string _employSessionMessage = string.Empty;
    private bool _authMessageIsError;
    private string _authMessage = string.Empty;
    private string _cbssUsername = string.Empty;
    private string _cbssPassword = string.Empty;
    private string _cbssOtp = string.Empty;
    private string _employUsername = string.Empty;
    private string _employPassword = string.Empty;
    private string _employOtp = string.Empty;
    private string _employChallenge = string.Empty;
    private string _employDeviceId = string.Empty;
    private string _employPendingUsername = string.Empty;
    private string _employPendingPassword = string.Empty;
    private List<string> _cbssSavedAccounts = [];
    private List<string> _employSavedAccounts = [];
    private bool AuthControlsDisabled => _authBusy || _isRunning;
    private string CbssSessionLabel => GetSessionLabel(
        _cbssPinged,
        _cbssConfigured,
        _cbssSessionValid,
        _cbssHttpStatus,
        _cbssSessionMessage,
        "Đã lưu phiên");
    private string EmploySessionLabel => GetSessionLabel(
        _employPinged,
        _employConfigured,
        _employSessionValid,
        _employHttpStatus,
        _employSessionMessage,
        "Đã lưu phiên");
    private Color CbssSessionColor => GetSessionColor(
        _cbssPinged, _cbssConfigured, _cbssSessionValid, _cbssHttpStatus,
        _cbssSessionMessage);
    private Color EmploySessionColor => GetSessionColor(
        _employPinged, _employConfigured, _employSessionValid, _employHttpStatus,
        _employSessionMessage);

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (IsPageActive) _ = InvokeAsync(StateHasChanged);
        }, null, 1500, 1500);
        RefreshSavedAccounts();
        RestoreLastSavedCredentials();
        _ = RefreshAuthStatus();
    }

    private async Task RefreshAuthStatus()
    {
        try
        {
            DeviceUnlockAuthResult result = await AuthService.GetStatusAsync();
            if (result.Success) ApplyAuthState(result);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task RefreshSourceSessions()
    {
        if (_authBusy || _isRunning) return;
        _authBusy = true;
        _authMessage = "Đang ping phiên CBSS và OneBSS...";
        _authMessageIsError = false;
        _authCts?.Cancel();
        _authCts?.Dispose();
        _authCts = new CancellationTokenSource(TimeSpan.FromSeconds(75));
        try
        {
            DeviceUnlockAuthResult result = await AuthService.PingSourceSessionsAsync(
                _authCts.Token);
            if (!result.Success)
            {
                _authMessage = result.Message;
                _authMessageIsError = true;
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            _cbssPinged = result.CbssPinged;
            _cbssSessionValid = result.CbssSessionValid;
            _cbssHttpStatus = result.CbssHttpStatus;
            _cbssSessionMessage = result.CbssSessionMessage;
            _employPinged = result.EmployPinged;
            _employSessionValid = result.EmploySessionValid;
            _employHttpStatus = result.EmployHttpStatus;
            _employSessionMessage = result.EmploySessionMessage;

            if (_cbssHttpStatus > 0 || IsMissingSession(_cbssSessionMessage))
                _cbssConfigured = _cbssSessionValid;
            if (_employHttpStatus > 0 || IsMissingSession(_employSessionMessage))
                _employConfigured = _employSessionValid;

            _authMessage = result.Message;
            bool confirmedExpired =
                IsConfirmedExpired(_cbssHttpStatus, _cbssSessionMessage)
                || IsConfirmedExpired(_employHttpStatus, _employSessionMessage);
            _authMessageIsError = confirmedExpired;
            Severity severity = confirmedExpired
                ? Severity.Warning
                : (_cbssSessionValid || _employSessionValid)
                    ? Severity.Success
                    : Severity.Info;
            Snackbar.Add(result.Message, severity);
        }
        catch (OperationCanceledException)
        {
            _authMessage = "Ping phiên đăng nhập hết thời gian.";
            _authMessageIsError = true;
            Snackbar.Add(_authMessage, Severity.Warning);
        }
        finally
        {
            _authBusy = false;
        }
    }

    private static bool IsMissingSession(string message) =>
        message.Contains("Chưa lưu", StringComparison.OrdinalIgnoreCase);

    private static bool IsConfirmedExpired(int httpStatus, string message) =>
        httpStatus is 401 or 403
        || message.Contains("hết hạn", StringComparison.OrdinalIgnoreCase);

    private static string GetSessionLabel(
        bool pinged,
        bool configured,
        bool valid,
        int httpStatus,
        string message,
        string configuredLabel)
    {
        if (!pinged) return configured ? configuredLabel : "Chưa đăng nhập";
        if (valid) return $"HTTP {httpStatus} · Còn phiên";
        if (IsConfirmedExpired(httpStatus, message))
            return $"HTTP {httpStatus} · Hết hạn";
        if (IsMissingSession(message)) return "Chưa có phiên";
        return httpStatus > 0
            ? $"HTTP {httpStatus} · Không xác nhận"
            : "Lỗi kết nối";
    }

    private static Color GetSessionColor(
        bool pinged,
        bool configured,
        bool valid,
        int httpStatus,
        string message)
    {
        if (!pinged) return configured ? Color.Success : Color.Default;
        if (valid) return Color.Success;
        if (IsConfirmedExpired(httpStatus, message)) return Color.Error;
        return IsMissingSession(message) ? Color.Default : Color.Warning;
    }

    private void ApplyAuthState(DeviceUnlockAuthResult result)
    {
        _cbssConfigured = result.CbssConfigured;
        _employConfigured = result.EmployConfigured;
        if (string.IsNullOrWhiteSpace(_cbssUsername))
            _cbssUsername = result.CbssUsername;
        if (string.IsNullOrWhiteSpace(_employUsername))
            _employUsername = result.EmployUsername;
        if (result.CbssConfigured)
            RememberCbssAccount(result.CbssUsername);
        if (result.EmployConfigured)
            RememberEmployAccount(result.EmployUsername);
    }

    private void RefreshSavedAccounts()
    {
        _cbssSavedAccounts = AccountHistory.GetCbssAccounts().ToList();
        _employSavedAccounts = AccountHistory.GetEmployAccounts().ToList();
    }

    private void RememberCbssAccount(string username, string? password = null)
    {
        if (password is null)
            AccountHistory.RememberCbss(username);
        else
            AccountHistory.RememberCbss(username, password);
        RefreshSavedAccounts();
    }

    private void RememberEmployAccount(string username, string? password = null)
    {
        if (password is null)
            AccountHistory.RememberEmploy(username);
        else
            AccountHistory.RememberEmploy(username, password);
        RefreshSavedAccounts();
    }

    private void RestoreLastSavedCredentials()
    {
        if (_cbssSavedAccounts.Count > 0)
            SelectCbssAccount(_cbssSavedAccounts[0]);
        if (_employSavedAccounts.Count > 0)
            SelectEmployAccount(_employSavedAccounts[0]);
    }

    private void SelectCbssAccount(string username)
    {
        _cbssUsername = username;
        _cbssPassword = AccountHistory.GetCbssPassword(username);
        _cbssOtp = string.Empty;
    }

    private void SelectEmployAccount(string username)
    {
        _employUsername = username;
        _employPassword = AccountHistory.GetEmployPassword(username);
        _employOtp = string.Empty;
    }

    private void ClearCbssAccounts()
    {
        AccountHistory.ClearCbssAccounts();
        RefreshSavedAccounts();
    }

    private void ClearEmployAccounts()
    {
        AccountHistory.ClearEmployAccounts();
        RefreshSavedAccounts();
    }

    private async Task RunAuthAction(
        Func<CancellationToken, Task<DeviceUnlockAuthResult>> action,
        Action<DeviceUnlockAuthResult>? onSuccess = null)
    {
        if (_authBusy) return;
        _authBusy = true;
        _authMessage = "Đang kết nối nguồn ảnh...";
        _authMessageIsError = false;
        _authCts?.Cancel();
        _authCts?.Dispose();
        _authCts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
        try
        {
            DeviceUnlockAuthResult result = await action(_authCts.Token);
            _authMessage = result.Message;
            _authMessageIsError = !result.Success;
            if (!string.IsNullOrWhiteSpace(result.Challenge))
                _employChallenge = result.Challenge;
            if (!string.IsNullOrWhiteSpace(result.DeviceId))
                _employDeviceId = result.DeviceId;
            if (result.Success)
            {
                _cbssPinged = false;
                _employPinged = false;
                ApplyAuthState(result);
                onSuccess?.Invoke(result);
                Snackbar.Add(result.Message, Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (OperationCanceledException)
        {
            _authMessage = "Đăng nhập nguồn ảnh hết thời gian hoặc đã bị hủy.";
            _authMessageIsError = true;
            Snackbar.Add(_authMessage, Severity.Warning);
        }
        finally
        {
            _authBusy = false;
        }
    }

    private Task SendCbssPin() => RunAuthAction(token =>
        AuthService.SendCbssPinAsync(_cbssUsername.Trim(), token));

    private Task LoginCbss() => RunAuthAction(
        token => AuthService.LoginCbssAsync(
            _cbssUsername.Trim(),
            _cbssPassword,
            _cbssOtp.Trim(),
            token),
        _ =>
        {
            RememberCbssAccount(_cbssUsername, _cbssPassword);
            _cbssOtp = string.Empty;
        });

    private Task BeginEmployLogin() => RunAuthAction(
        token =>
        {
            _employChallenge = string.Empty;
            _employDeviceId = string.Empty;
            _employPendingUsername = _employUsername.Trim();
            _employPendingPassword = _employPassword;
            return AuthService.BeginEmployLoginAsync(
                _employPendingUsername,
                _employPendingPassword,
                token);
        },
        result =>
        {
            RememberEmployAccount(_employPendingUsername, _employPendingPassword);
            _employChallenge = result.Challenge;
            _employDeviceId = result.DeviceId;
            _employOtp = string.Empty;
        });

    private Task LoginEmployWithOtp()
    {
        string username = _employUsername.Trim();
        string password = _employPassword;
        bool challengeBelongsToCurrentAccount = string.Equals(
            _employPendingUsername,
            username,
            StringComparison.OrdinalIgnoreCase);
        if (!challengeBelongsToCurrentAccount)
        {
            _employChallenge = string.Empty;
            _employDeviceId = string.Empty;
        }

        _employPendingUsername = username;
        _employPendingPassword = password;
        return RunAuthAction(
        token => AuthService.LoginEmployWithOtpAsync(
            username,
            password,
            _employOtp.Trim(),
            _employChallenge,
            _employDeviceId,
            token),
        _ =>
        {
            RememberEmployAccount(_employPendingUsername, _employPendingPassword);
            _employChallenge = string.Empty;
            _employDeviceId = string.Empty;
            _employPendingUsername = string.Empty;
            _employPendingPassword = string.Empty;
            _employOtp = string.Empty;
        });
    }

    private List<SimPort> GetTargets() =>
        (_retryTargets is not null
            ? _retryTargets
            : _sendMode == "all"
            ? Ports
            : _selectedPorts.ToList())
        .Where(port => port.Status == SimStatus.Active)
        .ToList();

    private async Task RetryFailedDeviceUnlock()
    {
        List<SimPort> failedPorts = Vm.GetLastDeviceUnlockFailedPorts();
        if (failedPorts.Count == 0)
        {
            Snackbar.Add("Không còn COM lỗi trong lần chạy gần nhất.", Severity.Normal);
            return;
        }

        _retryTargets = failedPorts;
        try
        {
            await StartDeviceUnlock();
        }
        finally
        {
            _retryTargets = null;
        }
    }

    private async Task StartDeviceUnlock()
    {
        if (Interlocked.CompareExchange(ref _startGuard, 1, 0) != 0)
        {
            Snackbar.Add("Tiến trình đang được khởi chạy; không gửi lặp OTP.", Severity.Warning);
            return;
        }

        try
        {
            if (_authBusy)
            {
                Snackbar.Add("Đang đăng nhập nguồn ảnh; vui lòng chờ hoàn tất.", Severity.Warning);
                return;
            }
            if (!Vm.IsDeviceUnlockRuntimeAvailable)
            {
                Snackbar.Add("Không tìm thấy Pictures\\kyc\\ekyc_full.py.", Severity.Error);
                return;
            }

            List<SimPort> targets = GetTargets();
            if (targets.Count == 0)
            {
                Snackbar.Add("Không có cổng Active / đã chọn.", Severity.Warning);
                return;
            }

            if (targets.Count > 5)
            {
                bool? confirmed = await DialogService.ShowMessageBox(
                    "Xác nhận",
                    $"Yêu cầu OTP và mở khóa đổi thiết bị cho {targets.Count} cổng?",
                    yesText: "Thực hiện",
                    cancelText: "Hủy");
                if (confirmed != true) return;
            }

            _cts?.Cancel();
            _cts?.Dispose();
            _cts = new CancellationTokenSource();
            _isRunning = true;
            _subTab = 1;
            Snackbar.Add(
                $"Đang yêu cầu OTP cho {targets.Count} cổng...",
                Severity.Info);
            try
            {
                await Vm.RunDeviceUnlockBatchAsync(
                    targets,
                    Math.Clamp(_parallelism, 1, 64),
                    _cts.Token);
            }
            catch (OperationCanceledException)
            {
                Snackbar.Add("Đã dừng mở khóa đổi thiết bị.", Severity.Normal);
            }
            finally
            {
                _isRunning = false;
            }
        }
        finally
        {
            Interlocked.Exchange(ref _startGuard, 0);
        }
    }

    private void StopDeviceUnlock()
    {
        _cts?.Cancel();
        Snackbar.Add("Đang dừng các yêu cầu OTP và tiến trình eKYC...", Severity.Normal);
    }

    private void ClearResults()
    {
        Vm.ClearDeviceUnlockResults();
        Snackbar.Add("Đã xóa kết quả.", Severity.Normal);
    }

    private void ExportCurrentSessionExcel()
    {
        IReadOnlyList<DeviceUnlockResultItem> results =
            Vm.GetCurrentDeviceUnlockSessionResults();
        if (results.Count == 0)
        {
            Snackbar.Add("Phiên chạy gần nhất chưa có kết quả để xuất.", Severity.Warning);
            return;
        }

        string defaultName = $"DKTTTB_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        string? filePath = FileDialogs.SaveFile(
            defaultName,
            "Excel (*.xlsx)|*.xlsx");
        if (string.IsNullOrWhiteSpace(filePath)) return;

        try
        {
            DeviceUnlockExcelExportService.Export(filePath, results);
            Snackbar.Add(
                $"Đã xuất {results.Count} kết quả: {System.IO.Path.GetFileName(filePath)}",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Xuất Excel lỗi: " + ex.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _authCts?.Cancel();
        _authCts?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
    }
