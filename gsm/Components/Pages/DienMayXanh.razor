@page "/dien-may-xanh"
@inject gsm.ViewModels.MainViewModel Vm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using gsm.Models
@using gsm.Components.Shared
@using gsm.Services
@implements IDisposable

<MudPaper Class="pa-3 mx-3 mb-2 feature-toolbar" Elevation="0"
          Style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:10px;">
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_password"
                          Label="Mật khẩu mới"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Text"
                          HelperText="Mặc định giống tab Pass VNPT"
                          FullWidth="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudNumericField T="int" @bind-Value="_minimumBirthYear"
                             Label="Năm sinh từ"
                             Min="1900" Max="@MaximumAllowedBirthYear"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             FullWidth="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudNumericField T="int" @bind-Value="_maximumBirthYear"
                             Label="Đến năm"
                             Min="1900" Max="@MaximumAllowedBirthYear"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string" @bind-Value="_sendMode" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Label="Gửi tới" FullWidth="true">
                <MudSelectItem Value="@("selected")">Cổng đã chọn</MudSelectItem>
                <MudSelectItem Value="@("all")">Tất cả Active</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        @if (!_isRunning)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="StartCreateAccounts">
                Tạo tài khoản
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Replay"
                       OnClick="RetryFailedPorts"
                       Disabled="@(Vm.LastDmxFailedPortCount == 0)">
                Chạy lại COM lỗi (@Vm.LastDmxFailedPortCount)
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Stop"
                       OnClick="StopCreateAccounts">
                Dừng
            </MudButton>
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
        }

        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                   OnClick="ClearResults"
                   Disabled="@(!Vm.DmxResults.Any())">
            Xóa kết quả
        </MudButton>

        <MudCheckBox T="bool" Value="@SettingsService.Current.UseProxyForDmx"
                     ValueChanged="SetUseProxy"
                     Label="Sử dụng proxy"
                     Color="Color.Primary"
                     Disabled="@_isRunning" />

        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Description"
                   OnClick="@(() => OpenOutputFile(Vm.DmxLatestSessionOutputPath))">
            TXT phiên
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Description"
                   OnClick="@(() => OpenOutputFile(Vm.DmxAggregateOutputPath))">
            TXT tổng
        </MudButton>

        <MudTooltip Text="Lưu SĐT thành công tại gsm\Data; TXT tổng giữ lâu dài, TXT phiên tạo lại khi bắt đầu phiên mới">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                Tự lưu TXT · giữ lâu dài
            </MudChip>
        </MudTooltip>

        <MudSpacer />
        <MudChip T="string" Color="Color.Success" Size="Size.Small"
                 Variant="Variant.Text" Style="font-weight:600;">
            Thành công: <b>@Vm.DmxSuccessCount</b>
        </MudChip>
        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                 Variant="Variant.Text" Style="font-weight:600;">
            Thất bại: <b>@Vm.DmxFailCount</b>
        </MudChip>
    </MudStack>

    @if (_isRunning)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            Đang chạy song song tối đa 64 COM và 20 request API. Mỗi COM tự nhận OTP,
            tự gửi lại tối đa 3 lần. Tài khoản mới sẽ được cập nhật hồ sơ và tạo mật khẩu;
            số đã có mật khẩu sẽ tự chuyển sang luồng quên mật khẩu.
            @if (!string.IsNullOrWhiteSpace(Vm.DmxSummaryText))
            {
                <br /><b>@Vm.DmxSummaryText</b>
            }
        </MudAlert>
    }
</MudPaper>

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         PanelClass="pa-0" Class="mx-3 mt-1 feature-tabs"
         Style="background:transparent;" @bind-ActivePanelIndex="_subTab">
    <MudTabPanel Text="Danh sách Cổng">
        <ComTable Ports="Ports" Operation="DMX" @bind-SelectedItems="_selectedPorts" />
    </MudTabPanel>

    <MudTabPanel Text="@($"Kết quả ({Vm.DmxResults.Count})")">
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">
                Kết quả xử lý tài khoản Điện Máy Xanh
            </MudText>
            <MudTable Items="@Vm.DmxResults" Dense="true" Hover="true" Elevation="0"
                      Height="calc(100vh - 300px)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Cổng</MudTh>
                    <MudTh>SĐT</MudTh>
                    <MudTh>Họ tên</MudTh>
                    <MudTh>Ngày sinh</MudTh>
                    <MudTh>Mật khẩu</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Phản hồi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-size:11px; color:#94A3B8;">@(Vm.DmxResults.IndexOf(context) + 1)</MudTd>
                    <MudTd Style="font-size:12px; white-space:nowrap;">@context.Time.ToString("HH:mm:ss dd/MM")</MudTd>
                    <MudTd Style="font-weight:600;">@context.Port</MudTd>
                    <MudTd>@context.Phone</MudTd>
                    <MudTd>@(context.IsPasswordRecovery ? "—" : context.FullName)</MudTd>
                    <MudTd Style="white-space:nowrap;">@(context.IsPasswordRecovery ? "—" : context.BirthDate.ToString("dd/MM/yyyy"))</MudTd>
                    <MudTd Style="font-family:monospace; font-size:12px;">@context.Password</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Success ? Color.Success : Color.Error)">
                            @(context.Success ? "Thành công" : "Lỗi")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="max-width:300px; overflow:hidden; text-overflow:ellipsis; font-size:12px; white-space:nowrap;"
                           title="@context.Response">
                        @context.Response
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-12 text-center" style="color:#94A3B8;">
                        <MudIcon Icon="@Icons.Material.Outlined.PersonAdd" Size="Size.Large"
                                 Class="mb-2" Style="opacity:0.4;" />
                        <div>Chưa có kết quả tạo tài khoản</div>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hướng dẫn">
        <MudPaper Class="pa-4 mt-2" Elevation="0"
                  Style="border:1px solid #E2E8F0; border-radius:10px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;">
                Luồng tạo tài khoản Quà Tặng VIP
            </MudText>
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Tên, giới tính, ngày và tháng sinh được tạo ngẫu nhiên. Năm sinh được lấy
                    trong khoảng đã chọn, mặc định từ 1990 đến 2007.
                </MudAlert>
                <MudText Typo="Typo.body2">
                    <b>1.</b> OAuth đã được cấu hình sẵn; kiểm tra mật khẩu muốn tạo.<br />
                    <b>2.</b> Chọn cổng hoặc chọn Tất cả Active, rồi bấm <b>Tạo tài khoản</b>.<br />
                    <b>3.</b> Tool gửi OTP và chỉ nhận tin nhắn đúng mẫu:<br />
                    <code>QuaTangVIP - Ma OTP cua ban la 955823...</code><br />
                    <b>4.</b> Với số mới, tool tự cập nhật hồ sơ ngẫu nhiên rồi tạo mật khẩu.<br />
                    <b>5.</b> Với số đã có mật khẩu, tool tự chuyển sang gửi OTP quên mật khẩu và đặt lại mật khẩu.<br />
                    <b>6.</b> Nếu chưa nhận được OTP, mỗi COM tự gửi lại tối đa 3 lần.
                </MudText>
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Access token, device token và OTP chỉ dùng trong bộ nhớ của phiên hiện tại.
                </MudAlert>
            </MudStack>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private string _password = "123456a@A";
    private readonly string _oauthAuthorization =
        DmxAccountService.DefaultOAuthAuthorization;
    private int _minimumBirthYear = 1990;
    private int _maximumBirthYear = 2007;
    private string _sendMode = "all";
    private HashSet<SimPort> _selectedPorts = new();
    private int _subTab;
    private bool _isRunning;
    private int _startGuard;
    private CancellationTokenSource? _cancellationTokenSource;
    private System.Threading.Timer? _timer;
    private List<SimPort>? _retryTargets;

    [Parameter] public bool IsPageActive { get; set; }

    private int MaximumAllowedBirthYear => DateTime.Today.Year - 1;
    private List<SimPort> Ports => Vm.Ports?.ToList() ?? new();
    private IEnumerable<SimPort> ActivePorts =>
        Ports.Where(port => port.Status == SimStatus.Active);

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (IsPageActive)
                _ = InvokeAsync(StateHasChanged);
        }, null, 1500, 1500);
    }

    private void SetUseProxy(bool enabled)
    {
        if (enabled && !WorkflowProxyService.IsConfigured)
        {
            Snackbar.Add("Chưa thêm proxy trong tab Proxy.", Severity.Warning);
            return;
        }

        bool previous = SettingsService.Current.UseProxyForDmx;
        SettingsService.Current.UseProxyForDmx = enabled;
        if (!SettingsService.SaveSettings(SettingsService.Current))
        {
            SettingsService.Current.UseProxyForDmx = previous;
            Snackbar.Add("Không lưu được lựa chọn proxy.", Severity.Error);
            return;
        }
    }

    private List<SimPort> GetTargets()
    {
        if (_retryTargets is not null)
        {
            return _retryTargets
                .Where(port => port.Status == SimStatus.Active)
                .ToList();
        }
        return _sendMode == "all"
            ? ActivePorts.ToList()
            : _selectedPorts.Where(port => port.Status == SimStatus.Active).ToList();
    }

    private async Task RetryFailedPorts()
    {
        List<SimPort> failedPorts = Vm.GetLastDmxFailedPorts();
        if (failedPorts.Count == 0)
        {
            Snackbar.Add("Không còn COM lỗi trong lần chạy gần nhất.", Severity.Normal);
            return;
        }

        _retryTargets = failedPorts;
        try
        {
            await StartCreateAccounts();
        }
        finally
        {
            _retryTargets = null;
        }
    }

    private async Task StartCreateAccounts()
    {
        if (Interlocked.CompareExchange(ref _startGuard, 1, 0) != 0)
        {
            Snackbar.Add("Tiến trình Điện Máy Xanh đang được khởi chạy.", Severity.Warning);
            return;
        }

        try
        {
            if (_password.Length < 8
                || !_password.Any(char.IsLetter)
                || !_password.Any(char.IsDigit))
            {
                Snackbar.Add("Mật khẩu cần ít nhất 8 ký tự, có cả chữ cái và số.", Severity.Warning);
                return;
            }
            if (string.IsNullOrWhiteSpace(_oauthAuthorization))
            {
                Snackbar.Add("Thiếu cấu hình OAuth của ứng dụng Quà Tặng VIP.", Severity.Warning);
                return;
            }
            if (_minimumBirthYear < 1900
                || _maximumBirthYear > MaximumAllowedBirthYear
                || _minimumBirthYear > _maximumBirthYear)
            {
                Snackbar.Add("Khoảng năm sinh không hợp lệ.", Severity.Warning);
                return;
            }

            List<SimPort> targets = GetTargets();
            var validTargets = targets
                .Where(port => !string.IsNullOrWhiteSpace(
                    DmxAccountService.NormalizePhone(port.PhoneNumber)))
                .GroupBy(
                    port => DmxAccountService.NormalizePhone(port.PhoneNumber),
                    StringComparer.Ordinal)
                .Select(group => group.First())
                .ToList();
            if (validTargets.Count == 0)
            {
                Snackbar.Add("Không có cổng Active nào có SĐT hợp lệ.", Severity.Warning);
                return;
            }

            int skipped = targets.Count - validTargets.Count;
            if (skipped > 0)
                Snackbar.Add($"Bỏ qua {skipped} cổng chưa có hoặc bị trùng SĐT.", Severity.Warning);

            if (validTargets.Count > 5)
            {
                bool? confirmed = await DialogService.ShowMessageBox(
                    "Xác nhận",
                    $"Tạo tài khoản Điện Máy Xanh cho {validTargets.Count} cổng?",
                    yesText: "Tạo tài khoản",
                    cancelText: "Hủy");
                if (confirmed != true) return;
            }

            _isRunning = true;
            _cancellationTokenSource?.Cancel();
            _cancellationTokenSource?.Dispose();
            _cancellationTokenSource = new CancellationTokenSource();
            _subTab = 1;
            Snackbar.Add(
                $"Đang chạy {validTargets.Count} COM; OTP sẽ được bắt tự động.",
                Severity.Info);

            try
            {
                await Vm.CreateDmxAccounts(
                    validTargets,
                    _password.Trim(),
                    _oauthAuthorization.Trim(),
                    _minimumBirthYear,
                    _maximumBirthYear,
                    _cancellationTokenSource.Token);
            }
            catch (OperationCanceledException)
            {
                Snackbar.Add("Đã dừng tiến trình Điện Máy Xanh.", Severity.Normal);
            }
            catch (Exception ex)
            {
                Snackbar.Add(
                    DmxAccountService.GetFriendlyExceptionMessage(ex),
                    Severity.Error);
            }
            finally
            {
                _isRunning = false;
            }
        }
        finally
        {
            Interlocked.Exchange(ref _startGuard, 0);
        }
    }

    private void StopCreateAccounts()
    {
        _cancellationTokenSource?.Cancel();
        Snackbar.Add("Đang hủy các request và tiến trình chờ OTP...", Severity.Normal);
    }

    private void ClearResults()
    {
        Vm.ClearDmxResults();
        Snackbar.Add("Đã xóa kết quả Điện Máy Xanh.", Severity.Normal);
    }

    private void OpenOutputFile(string path)
    {
        try
        {
            if (!System.IO.File.Exists(path))
            {
                Snackbar.Add(
                    "Chưa có file TXT. Hãy chạy một phiên Điện Máy Xanh trước.",
                    Severity.Info);
                return;
            }

            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = path,
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add("Không mở được file TXT: " + ex.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}
