@using gsm.Components.Pages
@inject NavigationManager Nav
@implements IDisposable

<div class="persistent-page-host">
    <div class="persistent-page" style="@PageStyle("ussd")" aria-hidden="@(!IsActive("ussd"))">
        <Ussd IsPageActive="@IsActive("ussd")" />
    </div>
    <div class="persistent-page" style="@PageStyle("sms")" aria-hidden="@(!IsActive("sms"))">
        <Sms IsPageActive="@IsActive("sms")" />
    </div>
    <div class="persistent-page" style="@PageStyle("call")" aria-hidden="@(!IsActive("call"))">
        <Call IsPageActive="@IsActive("call")" />
    </div>
    <div class="persistent-page" style="@PageStyle("imei")" aria-hidden="@(!IsActive("imei"))">
        <ImeiManager IsPageActive="@IsActive("imei")" />
    </div>
    <div class="persistent-page" style="@PageStyle("ezcom")" aria-hidden="@(!IsActive("ezcom"))">
        <EzCom IsPageActive="@IsActive("ezcom")" />
    </div>
    <div class="persistent-page" style="@PageStyle("vnptpass")" aria-hidden="@(!IsActive("vnptpass"))">
        <VnptPass IsPageActive="@IsActive("vnptpass")" />
    </div>
    <div class="persistent-page" style="@PageStyle("settings")" aria-hidden="@(!IsActive("settings"))">
        <Settings />
    </div>
</div>

@code {
    private string _activeRoute = "ussd";

    protected override void OnInitialized()
    {
        SyncRoute();
        Nav.LocationChanged += OnLocationChanged;
    }

    private bool IsActive(string route) =>
        string.Equals(_activeRoute, route, StringComparison.OrdinalIgnoreCase);

    private string PageStyle(string route) =>
        IsActive(route) ? "display:block;" : "display:none;";

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();
        _activeRoute = path switch
        {
            "" or "ussd" => "ussd",
            "vnpt-pass" => "vnptpass",
            "sms" => "sms",
            "call" => "call",
            "imei" => "imei",
            "ezcom" => "ezcom",
            "settings" => "settings",
            _ => "ussd"
        };
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
