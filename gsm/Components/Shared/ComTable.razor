@using gsm.Models
@using gsm.Components.Shared
@inject gsm.Services.IGsmModemService ModemService
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Style="border:1px solid #E2E8F0; border-radius:8px; overflow:hidden; background:#FFFFFF;">
        <MudToolBar Dense="true" Style="background:#F1F5F9; border-bottom:1px solid #E2E8F0;">
            @if (SelectedItems.Any())
            {
                <MudText Typo="Typo.subtitle2" Style="color:#1D4ED8; font-weight:600;" Class="mr-4">
                    Đã chọn @SelectedItems.Count cổng
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Style="color:#64748B; font-weight:600;" Class="mr-4">
                    Tất cả cổng (@Ports.Count())
                </MudText>
            }
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" Class="mr-2"
                       Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshSelected">Refresh</MudButton>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CreditCard" Class="mr-2"
                       Variant="Variant.Outlined" Color="Color.Success" OnClick="CheckTkcSelected">Check TKC</MudButton>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Dialpad" Class="mr-2"
                       Variant="Variant.Outlined" Color="Color.Warning" OnClick="Ussd101Selected">USSD *101#</MudButton>
            
            @{
                var pendingList = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
                var pendingCount = pendingList.Count(IsPendingAccept);
            }
            @if (pendingCount > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Class="mr-2"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="AcceptSelectedPending"
                           Disabled="@_bulkAccepting">
                    @(_bulkAccepting ? "Đang chấp nhận..." : $"CHẤP NHẬN ({pendingCount})")
                </MudButton>
            }

                  <MudSpacer />
            @if (SelectedItems.Any())
            {
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" 
                           Variant="Variant.Text" Color="Color.Default" OnClick="() => SelectedItems.Clear()">Bỏ chọn</MudButton>
            }
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Settings" 
                       Variant="Variant.Text" Color="Color.Default" OnClick="OpenSettingsDialog">Cấu hình Cột/Cổng</MudButton>
        </MudToolBar>

    <MudTable Items="@VisiblePorts" Hover="true" Dense="true" Elevation="0" Striped="true"
              MultiSelection="true" @bind-SelectedItems="SelectedItems"
              Style="background:#FFFFFF; color:#1E293B;"
              FixedHeader="true" Height="calc(100vh - 280px)"
              Breakpoint="Breakpoint.None">
        <HeaderContent>
            @foreach (var col in VisibleColumns)
            {
                var minWidth = col.Name == "LastMessageContent" ? "min-width: 250px;" : "";
                <MudTh Style="@($"background:#F8FAFC; border-bottom:1px solid #E2E8F0; color:#64748B; white-space: nowrap; {minWidth}")">@col.Header</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @foreach (var col in VisibleColumns)
            {
                @if (col.Name == "PortName")
                {
                    <MudTd Style="font-weight:600; border-bottom:1px solid #F1F5F9; color:#1E293B; white-space: nowrap;">@context.PortName</MudTd>
                }
                else if (col.Name == "Status")
                {
                    <MudTd Style="border-bottom:1px solid #F1F5F9; white-space: nowrap;">
                        <StatusBadge Status="@context.Status" />
                    </MudTd>
                }
                else if (col.Name == "NetworkProvider")
                {
                    <MudTd Style="border-bottom:1px solid #F1F5F9; color:#475569; white-space: nowrap;">@RenderLoadingOrValue(context, context.NetworkProvider)</MudTd>
                }
                else if (col.Name == "Balance")
                {
                    <MudTd Style="color:#16A34A; font-weight:600; border-bottom:1px solid #F1F5F9; white-space: nowrap;">
                        @RenderLoadingOrValue(context, context.Balance)
                    </MudTd>
                }
                else if (col.Name == "PhoneNumber")
                {
                    <MudTd Style="@("border-bottom:1px solid #F1F5F9; color:#475569; white-space: nowrap; mso-number-format: '\\@';")">@RenderLoadingOrValue(context, context.PhoneNumber)</MudTd>
                }
                else if (col.Name == "Imei")
                {
                    <MudTd Style="@("font-family:monospace; font-size:13px; border-bottom:1px solid #F1F5F9; color:#64748B; white-space: nowrap; mso-number-format: '\\@';")">@RenderLoadingOrValue(context, context.Imei)</MudTd>
                }
                else if (col.Name == "Serial")
                {
                    <MudTd Style="@("font-family:monospace; font-size:13px; border-bottom:1px solid #F1F5F9; color:#64748B; white-space: nowrap; mso-number-format: '\\@';")">@RenderLoadingOrValue(context, context.Serial)</MudTd>
                }
                else if (col.Name == "ExpiryDate")
                {
                    <MudTd Style="font-size:12px; border-bottom:1px solid #F1F5F9; color:#64748B; white-space: nowrap;">@RenderLoadingOrValue(context, context.ExpiryDate)</MudTd>
                }
                else if (col.Name == "SimRegDate")
                {
                    <MudTd Style="font-size:12px; border-bottom:1px solid #F1F5F9; color:#64748B; white-space: nowrap;">@(context.SimRegDate ?? "—")</MudTd>
                }
                else if (col.Name == "Lock1C")
                {
                    <MudTd Style="font-size:12px; border-bottom:1px solid #F1F5F9; color:#991B1B; white-space: nowrap;">@(context.Lock1C ?? "—")</MudTd>
                }
                else if (col.Name == "Lock2C")
                {
                    <MudTd Style="font-size:12px; border-bottom:1px solid #F1F5F9; color:#991B1B; white-space: nowrap;">@(context.Lock2C ?? "—")</MudTd>
                }
                else if (col.Name == "VnptStatus")
                {
                    <MudTd Style="font-weight:600; font-size:12px; border-bottom:1px solid #F1F5F9; color:#E11D48; white-space: nowrap;">@(string.IsNullOrEmpty(context.VnptStatus) ? "—" : context.VnptStatus)</MudTd>
                }
                else if (col.Name == "Otp")
                {
                    <MudTd Style="font-weight:600; font-size:12px; border-bottom:1px solid #F1F5F9; color:#2563EB; white-space: nowrap;">
                        @(string.IsNullOrEmpty(context.Otp) ? "—" : context.Otp)
                    </MudTd>
                }
                else if (col.Name == "LastMessageContent")
                {
                    <MudTd Style="word-break:break-word; font-size:12px; border-bottom:1px solid #F1F5F9; color:#475569;">
                        @(context.LastMessageContent ?? "—")
                    </MudTd>
                }
            }
        </RowTemplate>
        <NoRecordsContent>
            <div class="pa-16 text-center" style="color:#64748B;">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                <div class="mb-4">Chưa có dữ liệu. Hãy kết nối thiết bị.</div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Link" OnClick="ConnectAll">
                    Quét kết nối (Connect All)
                </MudButton>
            </div>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter]
    public IEnumerable<SimPort> Ports { get; set; } = Enumerable.Empty<SimPort>();

    [Parameter]
    public HashSet<SimPort> SelectedItems { get; set; } = new();

    [Parameter]
    public EventCallback<HashSet<SimPort>> SelectedItemsChanged { get; set; }

    [Parameter] public EventCallback<SimPort> OnAccept { get; set; }
    [Parameter] public EventCallback<SimPort> OnRefresh { get; set; }

    private HashSet<string> _accepting = new();

    bool IsPendingAccept(SimPort p)
    {
        if (p == null) return false;
        var s = p.Status.ToString();
        var err = p.LastError?.ToLowerInvariant() ?? "";
        return s.Contains("Pending", StringComparison.OrdinalIgnoreCase)
            || s.Contains("WaitAccept", StringComparison.OrdinalIgnoreCase)
            || s.Contains("SecurityBlocked", StringComparison.OrdinalIgnoreCase)
            || err.Contains("sim_mới_chờ_chấp_nhận", StringComparison.OrdinalIgnoreCase);
    }

    async Task AcceptOne(SimPort port)
    {
        if (port == null || _accepting.Contains(port.PortName)) return;
        _accepting.Add(port.PortName);
        try
        {
            if (OnAccept.HasDelegate)
                await OnAccept.InvokeAsync(port);
        }
        finally
        {
            _accepting.Remove(port.PortName);
            StateHasChanged();
        }
    }

    async Task RefreshOne(SimPort port)
    {
        if (OnRefresh.HasDelegate)
            await OnRefresh.InvokeAsync(port);
        else
        {
            try { ModemService.Disconnect(port.PortName); } catch {}
            await Task.Delay(500);
            ModemService.ConnectAll(115200);
        }
    }

    [Inject] private IDialogService DialogService { get; set; } = default!;

    bool _bulkAccepting;

    async Task AcceptSelectedPending()
    {
        var list = SelectedItems.Any() ? SelectedItems.Where(IsPendingAccept).ToList() : Ports.Where(IsPendingAccept).ToList();
        if (!list.Any())
        {
            Snackbar.Add("Không có cổng nào đang Chờ Accept", Severity.Warning);
            return;
        }

        if (list.Count > 5)
        {
            var ok = await DialogService.ShowMessageBox(
                "Xác nhận",
                $"Chấp nhận SIM + tráng IMEI cho {list.Count} cổng?\nChỉ Accept khi đã chắc SIM đúng.",
                yesText: "Chấp nhận", cancelText: "Hủy");
            if (ok != true) return;
        }

        _bulkAccepting = true;
        try
        {
            var tasks = list.Select(async port =>
            {
                try
                {
                    if (OnAccept.HasDelegate)
                    {
                        await OnAccept.InvokeAsync(port);
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"[{port.PortName}] Lỗi: {ex.Message}", Severity.Error);
                }
            });
            await Task.WhenAll(tasks);
            Snackbar.Add($"Đã hoàn thành gửi lệnh chấp nhận cho {list.Count} cổng.", Severity.Success);
        }
        finally
        {
            _bulkAccepting = false;
        }
    }

    async Task RefreshSelected()
    {
        var ports = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
        Snackbar.Add($"Đang làm mới {ports.Count} cổng...", Severity.Info);
        foreach (var p in ports)
        {
            try { ModemService.Disconnect(p.PortName); } catch {}
            await Task.Delay(500);
        }
        ModemService.ConnectAll(115200);
        SelectedItems.Clear();
        _ = SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    async Task CheckTkcSelected()
    {
        var ports = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
        Snackbar.Add($"Đang kiểm tra tài khoản {ports.Count} cổng...", Severity.Info);
        foreach (var p in ports)
        {
            try { await ModemService.SendCommandAsync(p.PortName, "AT+CUSD=1,\"*101#\",15", 20000); } catch {}
            await Task.Delay(500);
        }
        SelectedItems.Clear();
        _ = SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    async Task Ussd101Selected() => await CheckTkcSelected();

    void ConnectAll()
    {
        Snackbar.Add("Đang quét kết nối...", Severity.Info);
        string result = ModemService.ConnectAll(115200);
        Snackbar.Add(result, result.Contains("Lỗi") ? Severity.Warning : Severity.Success);
    }

    private IEnumerable<SimPort> VisiblePorts
    {
        get
        {
            var hidden = SettingsService.Current.HiddenComPorts ?? new List<string>();
            return Ports.Where(p => !hidden.Contains(p.PortName));
        }
    }

    private List<ColumnItem> VisibleColumns
    {
        get
        {
            var cfg = SettingsService.Current;
            var savedOrder = cfg.ColumnOrder ?? new List<string>();
            var hiddenCols = new HashSet<string>(cfg.HiddenColumns ?? new List<string>());

            var defaultCols = GetDefaultColumns();
            var ordered = new List<ColumnItem>();

            foreach (var colName in savedOrder)
            {
                var match = defaultCols.FirstOrDefault(c => c.Name == colName);
                if (match != null)
                {
                    ordered.Add(match);
                    defaultCols.Remove(match);
                }
            }
            ordered.AddRange(defaultCols);

            return ordered.Where(c => !hiddenCols.Contains(c.Name)).ToList();
        }
    }

    private List<ColumnItem> GetDefaultColumns()
    {
        return new List<ColumnItem>
        {
            new() { Name = "PortName", Header = "Cổng" },
            new() { Name = "Status", Header = "Trạng thái" },
            new() { Name = "NetworkProvider", Header = "Nhà mạng" },
            new() { Name = "Balance", Header = "Số dư" },
            new() { Name = "PhoneNumber", Header = "Số điện thoại" },
            new() { Name = "Imei", Header = "IMEI" },
            new() { Name = "Serial", Header = "CCID" },
            new() { Name = "ExpiryDate", Header = "HSD" },
            new() { Name = "SimRegDate", Header = "Ngày ĐK SIM" },
            new() { Name = "Lock1C", Header = "Khóa 1C" },
            new() { Name = "Lock2C", Header = "Khóa 2C" },
            new() { Name = "VnptStatus", Header = "Trạng thái VNPT" },
            new() { Name = "Otp", Header = "OTP" },
            new() { Name = "LastMessageContent", Header = "Nội dung" }
        };
    }

    async Task OpenSettingsDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = DialogService.Show<ComSettingsDialog>("Cấu hình hiển thị Cột & Cổng", options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            StateHasChanged();
        }
    }

    public class ColumnItem
    {
        public string Name { get; set; } = "";
        public string Header { get; set; } = "";
    }
    private RenderFragment RenderLoadingOrValue(gsm.Models.SimPort context, string value, string fallback = "—") => __builder =>
    {
        if ((string.IsNullOrEmpty(value) || value.Contains("Chưa")) && (context.Status == "Active" || context.Status == "Đang kết nối..."))
        {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            @(!string.IsNullOrEmpty(value) ? value : fallback)
        }
    };
}