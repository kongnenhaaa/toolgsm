                                        <MenuItem.Icon><materialDesign:PackIcon Kind="Broom"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Quét CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding SweepSmsCommand}" CommandParameter="Selected">
                                        <MenuItem.Icon><materialDesign:PackIcon Kind="CursorDefaultClick"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Làm mới hoặc Khởi động lại cổng" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Làm mới / Reset" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🔄 Làm mới danh sách cổng (Refresh)" Command="{Binding RefreshPortsCommand}">
                                    </MenuItem>
                                    <Separator Background="#444"/>
                                    <MenuItem Header="⚡ Khởi động lại Modem CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding RebootModemCommand}" CommandParameter="Selected">
                                    </MenuItem>
                                    <MenuItem Header="⚡ Khởi động lại TẤT CẢ Modem" Command="{Binding RebootModemCommand}" CommandParameter="All">
                                    </MenuItem>
                                    <Separator Background="#444"/>
                                    <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên CÁC CỔNG ĐÃ CHỌN (☑)" Command="{Binding ClearSmsCommand}" CommandParameter="Selected">
                                    </MenuItem>
                                    <MenuItem Header="🗑️ Xóa toàn bộ SMS rác trên TẤT CẢ CỔNG" Command="{Binding ClearSmsCommand}" CommandParameter="All">
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Background="#424242" Style="{StaticResource ModernButtonStyle}" Click="OpenContextMenu_Click" ToolTip="Ngắt sóng an toàn để đổi SIM" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SimOutline" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#81C784"/>
                                <TextBlock Text="Đổi SIM mới" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}" Foreground="#81C784"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🛡️ CHUẨN BỊ ĐỔI SIM CÁC CỔNG ĐÃ CHỌN (An Toàn)" Command="{Binding PrepareSwapSimCommand}" Foreground="#81C784">
                                        <MenuItem.ToolTip>
                                            <ToolTip Content="Ngắt sóng các cổng đã chọn để bạn có thể rút khay SIM ra thay SIM mới mà không bị lộ IMEI phần cứng." />
                                        </MenuItem.ToolTip>
                                    </MenuItem>
                                    <MenuItem Header="🛡️ CHUẨN BỊ ĐỔI SIM TẤT CẢ (An Toàn)" Command="{Binding PrepareSwapSimCommand}" CommandParameter="All" Foreground="#81C784">
                                        <MenuItem.ToolTip>
                                            <ToolTip Content="Ngắt sóng tất cả các cổng để bạn có thể rút khay SIM ra thay SIM mới mà không bị lộ IMEI phần cứng." />
                                        </MenuItem.ToolTip>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Background="#26C6DA" Command="{Binding OpenTopUpDialogCommand}" CommandParameter="All" Style="{StaticResource ModernButtonStyle}" ToolTip="Nạp thẻ cào điện thoại" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardPlus" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Nạp thẻ" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                        <!-- Sidebar ComposeSms Button removed -->
                        <Button Background="#66BB6A" Command="{Binding OpenCallManagerDialogCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="Quản lý lịch sử và thực hiện cuộc gọi" HorizontalAlignment="Stretch" Height="40" HorizontalContentAlignment="Left" Margin="0,4" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Phone" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý cuộc gọi" VerticalAlignment="Center" Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Background="#0f172a">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Tab Content -->
                <RowDefinition Height="Auto"/> <!-- Terminal -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToggleSidebarButton" Style="{StaticResource MaterialDesignHamburgerToggleButton}" Foreground="White" Margin="0,0,15,0"/>
                        <TextBlock Text="Trang chủ" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Quản lý IMEI" Height="40" Width="40" Margin="10,0" Command="{Binding OpenImeiManagerCommand}" Background="#1e293b" BorderThickness="0">
                            <materialDesign:PackIcon Kind="CellphoneSettings" Foreground="#e2e8f0" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cài đặt hệ thống" Height="40" Width="40" Command="{Binding OpenSettingsDialogCommand}" Background="#1e293b" BorderThickness="0">
                            <materialDesign:PackIcon Kind="Cog" Foreground="#e2e8f0" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tab Content -->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCommandPanelOpen}" Value="True">
                                    <Setter Property="Width" Value="575"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: GSM -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- ToolBar GSM -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#333" BorderThickness="0,0,0,1">
                        <WrapPanel Margin="10,5">
                            <!-- Action buttons have been moved to the sidebar -->
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Đẩy OTT Web" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsWebNotificationEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Đẩy OTP/SMS lên máy chủ Web"/>
                                    </StackPanel>
                                </Border>
    
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Đẩy Telegram" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsTelegramNotificationEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bắn thông báo OTP/SMS qua Telegram"/>
                                    </StackPanel>
                                </Border>
    
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tự phục hồi (Watchdog)" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsWatchdogEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Tự động khởi động lại Modem (AT+CFUN=1,1) khi bị lỗi/mất sóng"/>
                                    </StackPanel>
                                </Border>
    
                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tự nhấc máy" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ToggleButton IsChecked="{Binding IsAutoAnswerEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Tự động bắt máy (ATA) khi có cuộc gọi đến"/>
                                    </StackPanel>
                                </Border>
    
                            </StackPanel>

                            <!-- 3 Ưu tiên IMEI -->
                            <StackPanel Orientation="Horizontal">


                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="[1] Phục hồi IMEI" Foreground="#FFB300" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"/>
                                        <ToggleButton IsChecked="{Binding IsImeiRestoreEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Bật tự động phục hồi (Restore) IMEI đã lưu nếu thẻ SIM bị chuyển sang cổng khác"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A40" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="[2] Chặn SIM lạ" Foreground="#90CAF9" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"/>
                                        <ToggleButton IsChecked="{Binding IsBlockUnknownSimsEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="Không ghi nhận SIM mới (Chặn SIM lạ, chờ chấp thuận)"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="10,10,10,5">
                        <!-- Tổng COM -->
                        <Border Background="#1E1E2E" CornerRadius="8" Margin="0,0,8,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng COM" Foreground="#A0A0B0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding TotalPortCount}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="UsbPort" Width="28" Height="28" Foreground="#3A3A4A" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Online -->
                        <Border Background="#11281F" CornerRadius="8" Margin="0,0,8,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Online" Foreground="#8BE6B0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding OnlinePortCount}" Foreground="#4CAF50" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircleOutline" Width="28" Height="28" Foreground="#1B5E20" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Offline -->
                        <Border Background="#2A1820" CornerRadius="8" Margin="0,0,8,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Offline" Foreground="#FF9AA8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding OfflinePortCount}" Foreground="#FF5252" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="CloseCircleOutline" Width="28" Height="28" Foreground="#8E1D2A" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- SMS Nhận -->
                        <Border Background="#2E2211" CornerRadius="8" Margin="0,0,0,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SMS Nhận" Foreground="#FFD27A" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SmsReceivedCount}" Foreground="#FF9800" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="MessageTextOutline" Width="28" Height="28" Foreground="#7A5212" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    
                    <!-- GSM DataGrid Wrapper -->
                    <Border Grid.Row="2" Background="#1e293b" CornerRadius="12" Margin="10" Padding="5">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding FilteredPortsView}" SelectedItem="{Binding SelectedPort}" 
                                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                                      Style="{StaticResource ProDataGridStyle}"
                                      Margin="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu >
                                <MenuItem Command="Copy" Header="Sao chép (Ctrl+C)" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="#444"/>
                                <MenuItem Header="Chấp thuận SIM lạ (Lưu vào kho)" Command="{Binding Path=DataContext.ApproveUnknownSimCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#90CAF9">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CheckDecagram"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="#444"/>
                                <MenuItem Header="Sao chép SĐT" Command="{Binding Path=DataContext.CopyPhoneFromPortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Phone"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Nạp thẻ nhanh" Command="{Binding Path=DataContext.OpenTopUpDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Selected"  Foreground="#4CAF50">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CashPlus"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Kiểm tra số dư (Các cổng đã chọn)" Command="{Binding Path=DataContext.CheckBalanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Selected" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Magnify"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- ContextMenu USSD removed -->
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.IsAllPortsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" ToolTip="Chọn / Bỏ chọn tất cả" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" SortMemberPath="PortNumber" Width="120" HeaderTemplate="{StaticResource PortNameHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Thiết bị (Fake)" Binding="{Binding DeviceName}" Width="160" Foreground="#29B6F6"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="IMEI" Binding="{Binding Imei}" Width="160" HeaderTemplate="{StaticResource ImeiHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Serial" Binding="{Binding Serial}" Width="180" HeaderTemplate="{StaticResource SerialHeaderTemplate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SĐT" Binding="{Binding PhoneNumber}" Width="150" HeaderTemplate="{StaticResource PhoneHeaderTemplate}"/>
                            <DataGridTemplateColumn Header="TKC" Width="110" ClipboardContentBinding="{Binding Balance}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Balance}" TextWrapping="Wrap" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="OTP" Width="110" ClipboardContentBinding="{Binding Otp}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Otp}" Value="{x:Null}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Otp}" Value="">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Otp}" TextWrapping="Wrap" Foreground="#FF9800" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Quét vét" Binding="{Binding LastSweepTime}" Width="90" Foreground="#00E676"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding LastMessageContent}" Width="800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Ngày tạo" Binding="{Binding CreatedAt}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="License Suffix" Binding="{Binding LicenseKeySuffix}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lệch Key" Binding="{Binding KeyMismatch}" Width="100"/>
                            <DataGridTemplateColumn Header="Kết nối" Width="110" ClipboardContentBinding="{Binding Status}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33F44336"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#334CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Background" Value="#339E9E9E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Health" Width="150" ClipboardContentBinding="{Binding HealthSummary}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#263238" CornerRadius="10" Padding="8,3" ToolTip="{Binding LastError}">
                                            <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" Foreground="#B2EBF2" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Timeout" Binding="{Binding TimeoutCount}" Width="75"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi SMS" Binding="{Binding SmsErrorCount}" Width="75"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Reconnect" Binding="{Binding ReconnectCount}" Width="85"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="SMS cuối" Binding="{Binding LastSmsSentAt}" Width="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lỗi cuối" Binding="{Binding LastError}" Width="180"/>
                            
                            <!-- Tín hiệu Signal Bars -->
                            <DataGridTemplateColumn Header="Tín hiệu" Width="100" ClipboardContentBinding="{Binding SignalStrength}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                            <ProgressBar Value="{Binding SignalStrength}" Maximum="100" Height="10" Width="40" Background="#444" Foreground="#4CAF50" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            <TextBlock Text="{Binding SignalStrength, StringFormat={}{0}%}" Margin="5,0,0,0" FontSize="11" Foreground="LightGray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            
                            <!-- #8: Tô đỏ HSD nếu sắp hết hạn (dưới 7 ngày) -->
                            <DataGridTemplateColumn Header="HSD" Width="120" ClipboardContentBinding="{Binding ExpiryDate}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpiryDate}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- #4: Cột số điện thoại nhận chuyển hướng -->
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Fwd→" Binding="{Binding ForwardedTo}" Width="130" Foreground="#03A9F4"/>
                            
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cập nhật lúc" Binding="{Binding UpdatedAt}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Lúc" Binding="{Binding LastReceivedTime}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SMS -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top filter bar for SMS -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackground}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOutline" VerticalAlignment="Center" Foreground="#F06292" Width="20" Height="20" Margin="0,0,15,0"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsPhoneFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nhập SĐT..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="CỔNG" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="100" Text="{Binding SmsPortFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm cổng..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                    <TextBlock Text="NGƯỜI GỬI" FontSize="11" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Width="140" Text="{Binding SmsSenderFilter, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm người gửi..." Style="{StaticResource SearchTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="Lọc Dữ Liệu" Command="{Binding ApplySmsFilterCommand}" Background="#F06292" Style="{StaticResource ModernButtonStyle}" Width="110" Height="34" VerticalAlignment="Bottom" Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Command="{Binding MarkAllSmsReadCommand}" Background="#424242" Style="{StaticResource ModernButtonStyle}" ToolTip="Đánh dấu đã đọc" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="CheckAll" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding DeleteFilteredSmsCommand}" Background="#E53935" Style="{StaticResource ModernButtonStyle}" ToolTip="Xóa tin nhắn" Width="34" Padding="0" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="White"/>
                                </Button>
                                <Button Content="Xuất Excel" Background="#4CAF50" Command="{Binding ExportSmsToExcelCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DataGrid Margin="10" ItemsSource="{Binding FilteredSmsMessages}"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  Style="{StaticResource ProDataGridStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu >
                                <MenuItem Header="Sao chép OTP" Command="{Binding Path=DataContext.CopyOtpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" >
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Xóa tin nhắn này" Command="{Binding Path=DataContext.DeleteSmsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.CurrentItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"  Foreground="#E53935">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Delete"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cổng" Binding="{Binding PortName}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Người gửi" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Số điện thoại" Binding="{Binding ReceiverPhone}" Width="150"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhà mạng" Binding="{Binding NetworkProvider}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nhận lúc" Binding="{Binding ReceivedTime}" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="OTP" Binding="{Binding Otp}" Width="100" Foreground="#FF9800"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Cuộc gọi" Binding="{Binding CallCount}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Chuyển lời" Binding="{Binding ForwardContent}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource ProDataGridTextElementStyle}" Header="Nội dung" Binding="{Binding Content}" Width="800"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <!-- TAB 5: HƯỚNG DẪN SỬ DỤNG -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Hướng Dẫn" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="20" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="📖 HƯỚNG DẪN QUẢN LÝ IMEI &amp; ĐỔI SIM" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,20"/>

                        <Border Background="#1e293b" CornerRadius="10" Padding="20" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="MỘT SỐ NGUYÊN TẮC CƠ BẢN" FontSize="18" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,15"/>
                                <TextBlock Text="Tool GSM Pro phiên bản mới được trang bị tính năng Khóa sóng tự động (Auto-Airplane Mode) và Phục hồi IMEI thông minh. Tool sẽ tự động Fake IMEI để chống bị nhà mạng khóa SIM, quy trình cắm rút cực kỳ đơn giản và an toàn tuyệt đối."
                                           FontSize="14" Foreground="White" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="✅ QUY TRÌNH XỬ LÝ SIM MỚI (LẦN ĐẦU CẮM)" FontSize="18" FontWeight="Bold" Foreground="#29B6F6" Margin="0,0,0,15"/>
                        <TextBlock Text="Khi một SIM mới (chưa từng được Tool lưu lại) được cắm vào mạch, Tool sẽ ứng xử dựa trên tuỳ chọn [Chặn SIM lạ]:" FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,10"/>
                        
                        <Grid Margin="10,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#FF5252" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG BẬT [Chặn SIM lạ]:" FontSize="15" FontWeight="Bold" Foreground="#FF5252"/>
                                <TextBlock Text="Tool sẽ ngay lập tức vô hiệu hóa cổng COM, đổi màu trạng thái sang Đỏ (Security Blocked) và báo Lỗi Cảnh báo. SIM này sẽ không hoạt động, không nhận được tin nhắn hay thao tác nào.&#x0a;Để cấp quyền sử dụng, hãy click Chuột phải vào dòng SIM đó -&gt; Chọn 'Chấp Thuận SIM Lạ'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="10,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#4CAF50" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG TẮT [Chặn SIM lạ]:" FontSize="15" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="Tool sẽ tự động chấp nhận SIM này. Nó lấy IMEI gốc hiện tại của mạch phần cứng và gán vĩnh viễn cặp [CCID của SIM] + [IMEI của mạch] vào Kho dữ liệu Backup (imei_backup.csv). Lần sau cắm lại SIM này, Tool sẽ nhận diện nó là 'SIM cũ đã có Backup'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>


                        <TextBlock Text="✅ QUY TRÌNH XỬ LÝ SIM CŨ (ĐÃ TỪNG CẮM &amp; CÓ BACKUP)" FontSize="18" FontWeight="Bold" Foreground="#FFB300" Margin="0,0,0,15"/>
                        <TextBlock Text="Khi một SIM cũ (đã có trong file backup) được cắm vào bất kỳ mạch/cổng nào, Tool sẽ kiểm tra IMEI hiện tại của mạch và so sánh với IMEI đã lưu trong Backup. Nó sẽ ứng xử dựa trên tuỳ chọn [Phục hồi IMEI]:" FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,10"/>
                        
                        <Grid Margin="10,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#FFB300" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG BẬT [Phục hồi IMEI]:" FontSize="15" FontWeight="Bold" Foreground="#FFB300"/>
                                <TextBlock Text="Nếu IMEI của mạch khác với IMEI Backup, Tool sẽ tự động ra lệnh (AT+EGMR) để ép ghi lại IMEI cũ vào mạch. Điều này giúp nhà mạng không phát hiện ra việc bạn đã đổi khay SIM hay đổi thiết bị." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="10,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="#9E9E9E" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nếu ĐANG TẮT [Phục hồi IMEI]:" FontSize="15" FontWeight="Bold" Foreground="#9E9E9E"/>
                                <TextBlock Text="Tool sẽ bỏ qua quá trình kiểm tra. SIM sẽ nhận và sử dụng đúng IMEI nguyên bản gốc của cổng COM mà nó đang cắm vào." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#E91E63" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,5,0,0">
                                <TextBlock Text="Thay Đổi Thẻ SIM (TỰ ĐỘNG KHÓA MÕM)" FontSize="16" FontWeight="Bold" Foreground="#E91E63" Margin="0,0,0,8"/>
                                <TextBlock Text="Khi muốn thay SIM khác, bạn chỉ cần RÚT THẺ SIM CŨ RA. Sau đó, ĐỢI KHOẢNG 2 ĐẾN 3 GIÂY. Tool sẽ tự động nhận diện cổng vừa bị rút SIM và lập tức ép nó về trạng thái Tắt sóng (Airplane Mode). Sau khi đợi 3 giây xong, bạn cứ thoải mái chọc thẻ SIM mới vào rồi bấm Làm mới trên Tool. Việc chờ 3 giây này đảm bảo SIM mới cắm vào sẽ không bị lộ IMEI phần cứng lên VinaPhone, giúp chống khóa SIM 100%!" 
                                           FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        
                        <Separator Background="#3D3D5C" Margin="0,20"/>
                        
                        <TextBlock Text="📱 HƯỚNG DẪN CÁC TÍNH NĂNG KHÁC" FontSize="20" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,20"/>
                        
                        <!-- Hướng dẫn Bảng Hàng Đợi Lệnh -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="RocketLaunch" Width="40" Height="40" Foreground="#E91E63" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="1. Bảng Hàng Đợi Lệnh (Góc trên bên phải)" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="Bảng Hàng đợi lệnh là nơi bạn xếp chồng và chạy liên hoàn các thao tác. Hỗ trợ các tính năng:" FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="• USSD: Chọn mã lệnh (VD: *101#) hoặc tự nhập, sau đó ấn 'Thêm USSD'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• SMS: Gửi tin nhắn đồng loạt. Nhập SĐT và Nội dung -> 'Thêm SMS'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• MMS: Gửi tin nhắn đa phương tiện có đính kèm file ảnh/video." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Gọi: Nhập SĐT và thời gian (giây). Tool sẽ tự động ngắt cuộc gọi khi hết thời gian." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• IMEI: Sinh mã IMEI ngẫu nhiên hoặc tự cấu hình để ghi đè xuống thiết bị." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Data: Cấu hình bật hoặc tắt kết nối dữ liệu mạng 3G/4G." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                <TextBlock Text="• Trễ: Thêm khoảng thời gian chờ (giây) giữa các lệnh. Rất hữu ích để tạo kịch bản tự động hóa (VD: Gọi -> Trễ 10s -> Gửi SMS)." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22" Margin="10,0,0,5"/>
                                
                                <TextBlock Text="💡 Mẹo: Bạn có thể thêm hàng chục lệnh vào danh sách đợi, sau đó bấm 'Chạy' để Tool thực thi lần lượt từng lệnh trên tất cả các cổng đang chọn!" FontSize="14" Foreground="#A5D6A7" FontStyle="Italic" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tính năng Webhook -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Web" Width="40" Height="40" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="2. Webhook Tự Động (Forward OTP/SMS lên Server)" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="Vào Cài Đặt (Bánh răng) -> Thêm Rule Webhook để tự động đẩy tin nhắn OTP về Telegram, Zalo hoặc API riêng." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tính năng Khác -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Menu" Width="40" Height="40" Foreground="#FF9800" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="3. Các phím tắt &amp; thao tác nhanh" FontSize="16" FontWeight="Bold" Foreground="#B2DFDB" Margin="0,0,0,8"/>
                                <TextBlock Text="• Kiểm tra số dư: Chuột phải vào cổng -> 'Kiểm tra tài khoản' (Ctrl+B).&#x0a;• Lọc tin nhắn rác: Vào Cài đặt -> Cấu hình Blacklist / Whitelist.&#x0a;• Nạp thẻ: Chuột phải vào cổng -> 'Nạp thẻ / Top-up'." FontSize="14" Foreground="#CFD8DC" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Command panel bên phải giống ảnh 3 -->
        <Border Grid.Column="1"
                Background="#0f172a"
                BorderBrush="#334155"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsCommandPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="3*" MinHeight="260"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="1.2*" MinHeight="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1e293b" Padding="8,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Asterisk" Foreground="#B8C0FF" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Hàng đợi lệnh" Foreground="#DDE2FF" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCommandPanelCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="30"
                                Height="30"
                                ToolTip="Đóng">
                            <materialDesign:PackIcon Kind="Close" Foreground="White" Width="18" Height="18"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Vùng tạo lệnh giống ảnh 3 -->
                <Border Grid.Row="1" Margin="8,6,8,4" Padding="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button Content="USSD" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="USSD" Margin="0,0,6,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="USSD">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="SMS" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="SMS" Margin="0,0,6,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="SMS">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="MMS" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="MMS" Margin="0,0,6,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="MMS">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Gọi" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="Call" Margin="0,0,6,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="Call">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="IMEI" Command="{Binding SelectCommandPanelTabCommand}" CommandParameter="IMEI" Margin="0,0,6,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniCommandButtonStyle}">
                                        <Setter Property="Background" Value="#252A36"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelTab}" Value="IMEI">
                                                <Setter Property="Background" Value="#5B5CF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
