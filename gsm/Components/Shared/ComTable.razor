@using gsm.Models
@using gsm.Components.Shared
@inject gsm.Services.IGsmModemService ModemService
@inject gsm.ViewModels.MainViewModel Vm
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="com-table-shell">
        <MudToolBar Dense="true" Class="com-toolbar">
            @if (SelectedItems.Any())
            {
                <MudText Typo="Typo.subtitle2" Style="color:#1D4ED8; font-weight:600;" Class="mr-4">
                    Đã chọn @SelectedItems.Count cổng
                </MudText>
            }
            else
            {
                var statActive    = Ports.Count(p => p.Status == SimStatus.Active);
                var statConn      = Ports.Count(p => p.Status == SimStatus.Connecting);
                var statWaitSim   = Ports.Count(p => p.Status == "Chờ cắm SIM");
                var statNoResp    = Ports.Count(p => p.Status == SimStatus.NoResponse);
                var statBlocked   = Ports.Count(p => p.Status == SimStatus.WaitingAccept || p.Status == SimStatus.SecurityBlocked || p.Status == SimStatus.Quarantined);
                var statTotal     = Ports.Count();
                var isDark        = gsm.Services.SettingsService.Current.DarkMode;
                var titleColor    = isDark ? "color:#E2E8F0; font-weight:600;" : "color:#64748B; font-weight:600;";

                <MudText Typo="Typo.subtitle2" Style="@titleColor" Class="mr-3">
                    Tất cả cổng (@statTotal)
                </MudText>
                @if (statActive > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1 com-stat-chip">
                        Active: @statActive
                    </MudChip>
                }
                @if (statConn > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Sync" Class="mr-1 com-stat-chip">
                        Kết nối: @statConn
                    </MudChip>
                }
                @if (statWaitSim > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.SimCardAlert"
                             Style="@($"{(isDark ? "color:#CBD5E1; border-color:#94A3B8;" : "")}")" Class="mr-1 com-stat-chip">
                        Chờ SIM: @statWaitSim
                    </MudChip>
                }
                @if (statNoResp > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.Warning" Style="border-color:#EF4444;" Class="mr-1 com-stat-chip">
                        Không phản hồi: @statNoResp
                    </MudChip>
                }
                @if (statBlocked > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Block" Class="mr-1 com-stat-chip">
                        Chặn SIM: @statBlocked
                    </MudChip>
                }
            }
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" Class="mr-2"
                       Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshSelected">Refresh</MudButton>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.SimCard" Class="mr-2"
                       Variant="Variant.Outlined" Color="Color.Error" OnClick="ReloadSimSelected">Tải lại SIM</MudButton>
            @{
                var pendingList = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
                var pendingCount = pendingList.Count(IsImeiActionPending);
            }
            
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Class="mr-2"
                       StartIcon="@Icons.Material.Filled.Brush"
                       OnClick="CreateNewImeiSelected"
                       Disabled="@_bulkImeiAction">
                @(_bulkImeiAction ? "Đang xử lý..." : pendingCount > 0 ? $"TẠO IMEI MỚI ({pendingCount})" : "TẠO IMEI MỚI")
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2"
                       StartIcon="@Icons.Material.Filled.Restore"
                       OnClick="RestoreImeiSelected"
                       Disabled="@_bulkImeiAction">
                @(pendingCount > 0 ? $"KHÔI PHỤC IMEI ({pendingCount})" : "KHÔI PHỤC IMEI")
            </MudButton>

                  <MudSpacer />
            @if (SelectedItems.Any())
            {
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" 
                           Variant="Variant.Text" Color="Color.Default" OnClick="ClearSelectionAsync">Bỏ chọn</MudButton>
            }
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.TableView"
                       Variant="Variant.Outlined" Color="Color.Success" OnClick="CopyToExcel"
                       title="Copy đúng cột vào Excel (TSV)">Copy Excel</MudButton>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Settings" 
                       Variant="Variant.Text" Color="Color.Default" OnClick="OpenSettingsDialog">Cấu hình Cột/Cổng</MudButton>
        </MudToolBar>

    <MudTable Items="@VisiblePorts" Hover="true" Dense="true" Elevation="0" Striped="false"
              MultiSelection="true" @bind-SelectedItems="SelectedItems"
              Class="com-table"
              RowClassFunc="GetRowClass"
              FixedHeader="true" Height="calc(100vh - 280px)"
              Breakpoint="Breakpoint.None">
        <HeaderContent>
            @{
                var _dk = gsm.Services.SettingsService.Current.DarkMode;
                var _hBg  = _dk ? "#1E293B" : "#F8FAFC";
                var _hBrd = _dk ? "#334155" : "#E2E8F0";
                var _hClr = _dk ? "#CBD5E1" : "#64748B";
            }
            @foreach (var col in VisibleColumns)
            {
                var minWidth = col.Name == "LastMessageContent" ? "min-width: 250px;" : "";
                <MudTh Style="@($"background:{_hBg}; border-bottom:1px solid {_hBrd}; color:{_hClr}; white-space: nowrap; font-weight:700; letter-spacing:0.03em; {minWidth}")">@col.Header</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @{
                var _d   = gsm.Services.SettingsService.Current.DarkMode;
                var _brd = _d ? "border-bottom:1px solid #334155;" : "border-bottom:1px solid #F1F5F9;";
                var _muted  = _d ? "color:#94A3B8;" : "color:#64748B;";
                var _body   = _d ? "color:#CBD5E1;" : "color:#475569;";
                var _strong = _d ? "color:#F1F5F9;" : "color:#1E293B;";
            }
            @foreach (var col in VisibleColumns)
            {
                @if (col.Name == "Stt")
                {
                    <MudTd Style="@($"{_brd} {_muted} font-size:16px; white-space:nowrap;")">
                        @(VisiblePorts.ToList().IndexOf(context) + 1)
                    </MudTd>
                }
                else if (col.Name == "PortName")
                {
                    <MudTd Style="@($"font-weight:600; {_brd} {_strong} white-space:nowrap;")">@context.PortName</MudTd>
                }
                else if (col.Name == "Status")
                {
                    <MudTd Style="@($"{_brd} white-space:nowrap; font-size:16px;")">
                        <StatusBadge Status="@context.Status" />
                    </MudTd>
                }
                else if (col.Name == "NetworkProvider")
                {
                    <MudTd Style="@($"{_brd} {_body} white-space:nowrap; font-size:16px;")">@RenderLoadingOrValue(context, context.NetworkProvider)</MudTd>
                }
                else if (col.Name == "NetworkType")
                {
                    <MudTd Style="@($"{_brd} {_body} white-space:nowrap; font-size:16px;")">@RenderLoadingOrValue(context, context.NetworkType)</MudTd>
                }
                else if (col.Name == "Signal")
                {
                    var signalColor = context.SignalRssi >= 20 && context.SignalRssi <= 31
                        ? "color:#16A34A;"
                        : context.SignalRssi is >= 1 and < 15 ? "color:#DC2626;" : _body;
                    <MudTd Style="@($"{_brd} {signalColor} white-space:nowrap; font-size:16px; font-weight:600;")">@RenderLoadingOrValue(context, context.SignalDisplay)</MudTd>
                }
                else if (col.Name == "Balance")
                {
                    <MudTd Style="@($"color:#22C55E; font-weight:600; {_brd} white-space:nowrap; font-size:16px;")">
                        @RenderLoadingOrValue(context, context.Balance, forceLoading: context.IsBalanceLoading)
                    </MudTd>
                }
                else if (col.Name == "PhoneNumber")
                {
                    <MudTd Style="@($"{_brd} {_body} white-space:nowrap; mso-number-format:'\\@'; font-size:16px;")">@RenderLoadingOrValue(context, context.PhoneNumber)</MudTd>
                }
                else if (col.Name == "Imei")
                {
                    <MudTd Style="@($"font-family:monospace; font-size:16px; {_brd} {_muted} white-space:nowrap; mso-number-format:'\\@';")">@RenderLoadingOrValue(context, context.Imei)</MudTd>
                }
                else if (col.Name == "Serial")
                {
                    <MudTd Style="@($"font-family:monospace; font-size:16px; {_brd} {_muted} white-space:nowrap; mso-number-format:'\\@';")">@RenderLoadingOrValue(context, context.Serial)</MudTd>
                }
                else if (col.Name == "ExpiryDate")
                {
                    <MudTd Style="@($"font-size:16px; {_brd} {_body} white-space:nowrap;")">@RenderLoadingOrValue(context, context.ExpiryDate, forceLoading: context.IsBalanceLoading)</MudTd>
                }
                else if (col.Name == "SimRegDate")
                {
                    <MudTd Style="@($"font-size:16px; {_brd} {_body} white-space:nowrap;")">@(string.IsNullOrWhiteSpace(context.SimRegDate) ? "—" : context.SimRegDate)</MudTd>
                }
                else if (col.Name == "Lock1C")
                {
                    <MudTd Style="@($"font-size:16px; {_brd} color:#F87171; white-space:nowrap;")">@(string.IsNullOrWhiteSpace(context.Lock1C) ? "—" : context.Lock1C)</MudTd>
                }
                else if (col.Name == "Lock2C")
                {
                    <MudTd Style="@($"font-size:16px; {_brd} color:#F87171; white-space:nowrap;")">@(string.IsNullOrWhiteSpace(context.Lock2C) ? "—" : context.Lock2C)</MudTd>
                }
                else if (col.Name == "ForwardedTo")
                {
                    <MudTd Style="@($"font-weight:600; font-size:16px; {_brd} color:#60A5FA; white-space:nowrap;")">@(string.IsNullOrEmpty(context.ForwardedTo) ? "—" : context.ForwardedTo)</MudTd>
                }
                else if (col.Name == "VnptStatus")
                {
                    <MudTd Style="@($"font-weight:600; font-size:16px; {_brd} color:#FB7185; white-space:nowrap;")">@(string.IsNullOrEmpty(context.VnptStatus) ? "—" : context.VnptStatus)</MudTd>
                }
                else if (col.Name == "Otp")
                {
                    <MudTd Style="@($"font-weight:600; font-size:16px; {_brd} color:#60A5FA; white-space:nowrap;")">
                        @(string.IsNullOrEmpty(context.Otp) ? "—" : context.Otp)
                    </MudTd>
                }
                else if (col.Name == "LastMessageContent")
                {
                    <MudTd Style="@($"white-space:nowrap; font-size:16px; {_brd} {_body}")">
                        @(context.LastMessageContent ?? "—")
                    </MudTd>
                }
            }
        </RowTemplate>
        <NoRecordsContent>
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" Class="mb-2" Style="opacity:0.4;" />
                <div class="mb-4">Chưa có dữ liệu. Hãy kết nối thiết bị.</div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Link" OnClick="ConnectAll">
                    Quét kết nối (Connect All)
                </MudButton>
            </div>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter]
    public IEnumerable<SimPort> Ports { get; set; } = Enumerable.Empty<SimPort>();

    [Parameter]
    public HashSet<SimPort> SelectedItems { get; set; } = new();

    [Parameter]
    public EventCallback<HashSet<SimPort>> SelectedItemsChanged { get; set; }

    [Parameter] public EventCallback<SimPort> OnRefresh { get; set; }

    bool IsImeiActionPending(SimPort p)
    {
        if (p == null) return false;
        var s = p.Status ?? "";

        // Chỉ các cổng đang bị chặn chờ thao tác IMEI mới được xử lý.
        if (s == gsm.Models.SimStatus.Active
            || s == gsm.Models.SimStatus.Connecting
            || s == gsm.Models.SimStatus.NoResponse
            || s == "Chờ cắm SIM")
        {
            return false;
        }

        // WaitingAccept chỉ được giữ để tương thích dữ liệu trạng thái cũ; UI hiển thị là Chặn SIM.
        return s == gsm.Models.SimStatus.WaitingAccept
            || s == gsm.Models.SimStatus.SecurityBlocked;
    }

    async Task RefreshOne(SimPort port)
    {
        if (OnRefresh.HasDelegate)
            await OnRefresh.InvokeAsync(port);
        else
        {
            await Vm.RefreshPortAsync(port.PortName);
        }
    }

    async Task ReloadSimSelected()
    {
        var list = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
        if (!list.Any()) return;

        Snackbar.Add($"Đang tải lại SIM cho {list.Count} cổng...", Severity.Info);
        int success = 0;
        int failed = 0;
        await RunAllPortsAsync(list, async p =>
        {
            try
            {
                if (await Vm.ReloadPortSafelyAsync(p.PortName))
                    Interlocked.Increment(ref success);
                else
                    Interlocked.Increment(ref failed);
            }
            catch
            {
                Interlocked.Increment(ref failed);
            }
        });
        Snackbar.Add($"Tải lại SIM: {success} COM đã bắt đầu reload, {failed} COM không thể khởi động.",
            failed == 0 ? Severity.Success : Severity.Warning);
        SelectedItems.Clear();
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    [Inject] private IDialogService DialogService { get; set; } = default!;

    bool _bulkImeiAction;

    async Task<List<SimPort>> RefreshPortsForImeiActionAsync()
    {
        var candidates = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
        var waitingForSim = candidates.Where(port => (port.Status ?? string.Empty) == "Chờ cắm SIM").ToList();
        if (waitingForSim.Count > 0)
        {
            Snackbar.Add($"Đang quét lại SIM trên {waitingForSim.Count} cổng...", Severity.Info);
            await RunAllPortsAsync(waitingForSim, port => ModemService.HandleSimInsertedAsync(port.PortName));

            for (int attempt = 0; attempt < 20; attempt++)
            {
                if (waitingForSim.All(port => (port.Status ?? string.Empty) != "Chờ cắm SIM")) break;
                await Task.Delay(250);
            }
        }

        return candidates;
    }

    bool CanCreateImei(SimPort port) =>
        (port.Status ?? string.Empty) == "Chờ cắm SIM"
        || IsImeiActionPending(port)
        || port.Status == gsm.Models.SimStatus.Active;

    static string Digits(string? value) =>
        new((value ?? string.Empty).Where(char.IsDigit).ToArray());

    async Task CreateNewImeiSelected()
    {
        if (_bulkImeiAction) return;
        _bulkImeiAction = true;
        try
        {
            var candidates = await RefreshPortsForImeiActionAsync();
            var targets = candidates.Where(CanCreateImei).ToList();
            if (targets.Count == 0)
            {
                Snackbar.Add("Không có cổng modem nào sẵn sàng để tạo IMEI mới.", Severity.Warning);
                return;
            }

            var ok = await DialogService.ShowMessageBox(
                "Tạo IMEI mới",
                $"Tạo IMEI mới cho {targets.Count} cổng? Cổng chưa cắm SIM vẫn được xử lý.",
                yesText: "Tạo IMEI mới", cancelText: "Hủy");
            if (ok != true) return;

            int success = 0;
            await RunAllPortsAsync(targets, async port =>
            {
                string target = gsm.Services.ImeiManagementService.GenerateRandomImei();
                bool hasSim = !string.IsNullOrWhiteSpace(Digits(port.Serial));
                bool applied = hasSim
                    ? await Vm.PaintImeiForCurrentSimAsync(
                        port.PortName, target, overwriteBackupWithCurrentImei: true)
                    : await Vm.PaintImeiWithoutSimAsync(
                        port.PortName, target, backupCurrentBeforeWrite: true);
                if (applied)
                    Interlocked.Increment(ref success);
            });
            Snackbar.Add($"Tạo IMEI mới hoàn tất: {success}/{targets.Count} cổng.",
                success == targets.Count ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _bulkImeiAction = false;
            StateHasChanged();
        }
    }

    async Task RestoreImeiSelected()
    {
        if (_bulkImeiAction) return;
        _bulkImeiAction = true;
        try
        {
            var candidates = await RefreshPortsForImeiActionAsync();
            var restoreImeis = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var port in candidates.Where(CanCreateImei))
            {
                string ccid = Digits(port.Serial);
                if (!string.IsNullOrWhiteSpace(ccid)
                    && Vm.ImeiCache.TryGetValue(ccid, out var simEntry)
                    && gsm.Services.ImeiManagementService.IsValidImei(simEntry.Imei))
                {
                    restoreImeis[port.PortName] = simEntry.Imei;
                }
                else if (string.IsNullOrWhiteSpace(ccid)
                    && Vm.TryGetModemImeiBackup(port.PortName, out var modemEntry))
                {
                    restoreImeis[port.PortName] = modemEntry.Imei;
                }
            }
            var targets = candidates.Where(port => restoreImeis.ContainsKey(port.PortName)).ToList();

            if (targets.Count == 0)
            {
                Snackbar.Add("Không có cổng nào có IMEI backup phù hợp trong XLSX.", Severity.Warning);
                return;
            }

            var ok = await DialogService.ShowMessageBox(
                "Khôi phục IMEI",
                $"Khôi phục IMEI gần nhất từ XLSX cho {targets.Count} cổng?",
                yesText: "Khôi phục", cancelText: "Hủy");
            if (ok != true) return;

            int success = 0;
            await RunAllPortsAsync(targets, async port =>
            {
                string backupImei = restoreImeis[port.PortName];
                bool hasSim = !string.IsNullOrWhiteSpace(Digits(port.Serial));
                bool applied = hasSim
                    ? await Vm.PaintImeiForCurrentSimAsync(
                        port.PortName, backupImei, overwriteBackupWithCurrentImei: false)
                    : await Vm.PaintImeiWithoutSimAsync(
                        port.PortName, backupImei, backupCurrentBeforeWrite: false);
                if (applied)
                    Interlocked.Increment(ref success);
            });
            Snackbar.Add($"Khôi phục IMEI hoàn tất: {success}/{targets.Count} cổng.",
                success == targets.Count ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _bulkImeiAction = false;
            StateHasChanged();
        }
    }

    async Task RefreshSelected()
    {
        var ports = SelectedItems.Any() ? SelectedItems.ToList() : Ports.ToList();
        Snackbar.Add($"Đang làm mới {ports.Count} cổng...", Severity.Info);
        await Vm.RefreshPortsAsync(ports.Select(p => p.PortName));
        Snackbar.Add($"Đã gửi lệnh làm mới {ports.Count} cổng; trạng thái sẽ cập nhật khi kết nối lại.", Severity.Success);
        SelectedItems.Clear();
        _ = SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    async Task ClearSelectionAsync()
    {
        SelectedItems.Clear();
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    private static Task RunAllPortsAsync(
        IReadOnlyCollection<SimPort> ports,
        Func<SimPort, Task> operation)
    {
        gsm.Services.BackendConcurrency.ConfigureThreadPool(ports.Count);
        return Task.WhenAll(ports.Select(operation));
    }

    private static string GetRowClass(SimPort port, int rowNumber) => port.Status switch
    {
        gsm.Models.SimStatus.Active => "row-active",
        gsm.Models.SimStatus.WaitingAccept => "row-pending",
        gsm.Models.SimStatus.Connecting => "row-processing",
        gsm.Models.SimStatus.SecurityBlocked => "row-error",
        gsm.Models.SimStatus.NoResponse => "row-error",
        _ => "row-idle"
    };

    void ConnectAll()
    {
        Snackbar.Add("Đang quét kết nối...", Severity.Info);
        try
        {
            string result = ModemService.ConnectAll(115200);
            bool failed = result.Contains("Lỗi", StringComparison.OrdinalIgnoreCase)
                || result.Contains("ERROR", StringComparison.OrdinalIgnoreCase);
            Snackbar.Add(result, failed ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Connect All lỗi: " + ex.Message, Severity.Error);
        }
    }

    private IEnumerable<SimPort> VisiblePorts
    {
        get
        {
            var hidden = SettingsService.Current.HiddenComPorts ?? new List<string>();
            return Ports.Where(p => !hidden.Contains(p.PortName));
        }
    }

    private List<ColumnItem> VisibleColumns
    {
        get
        {
            var cfg = SettingsService.Current;
            var savedOrder = (cfg.ColumnOrder ?? new List<string>())
                .SelectMany(name => name == "NetworkSignal"
                    ? new[] { "NetworkType", "Signal" }
                    : new[] { name })
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (savedOrder.Count > 0
                && !savedOrder.Contains("NetworkType", StringComparer.OrdinalIgnoreCase)
                && !savedOrder.Contains("Signal", StringComparer.OrdinalIgnoreCase))
            {
                int providerIndex = savedOrder.FindIndex(name =>
                    name.Equals("NetworkProvider", StringComparison.OrdinalIgnoreCase));
                int insertIndex = providerIndex >= 0 ? providerIndex + 1 : savedOrder.Count;
                savedOrder.Insert(insertIndex, "NetworkType");
                savedOrder.Insert(insertIndex + 1, "Signal");
            }
            var hiddenCols = new HashSet<string>(cfg.HiddenColumns ?? new List<string>());
            if (hiddenCols.Remove("NetworkSignal"))
            {
                hiddenCols.Add("NetworkType");
                hiddenCols.Add("Signal");
            }

            var defaultCols = GetDefaultColumns();
            var ordered = new List<ColumnItem>();

            var sttCol = defaultCols.FirstOrDefault(c => c.Name == "Stt");
            if (sttCol != null && !savedOrder.Contains("Stt"))
            {
                ordered.Add(sttCol);
                defaultCols.Remove(sttCol);
            }

            foreach (var colName in savedOrder)
            {
                var match = defaultCols.FirstOrDefault(c => c.Name == colName);
                if (match != null)
                {
                    ordered.Add(match);
                    defaultCols.Remove(match);
                }
            }
            ordered.AddRange(defaultCols);

            return ordered.Where(c => !hiddenCols.Contains(c.Name)).ToList();
        }
    }

    private List<ColumnItem> GetDefaultColumns()
    {
        return new List<ColumnItem>
        {
            new() { Name = "Stt", Header = "STT" },
            new() { Name = "PortName", Header = "Cổng" },
            new() { Name = "Status", Header = "Trạng thái" },
            new() { Name = "NetworkProvider", Header = "Nhà mạng" },
            new() { Name = "NetworkType", Header = "Mạng" },
            new() { Name = "Signal", Header = "Tín hiệu" },
            new() { Name = "Balance", Header = "TKC" },
            new() { Name = "PhoneNumber", Header = "SĐT" },
            new() { Name = "Imei", Header = "IMEI" },
            new() { Name = "Serial", Header = "CCID" },
            new() { Name = "ExpiryDate", Header = "HSD" },
            new() { Name = "SimRegDate", Header = "Ngày ĐK SIM" },
            new() { Name = "Lock1C", Header = "Khóa 1C" },
            new() { Name = "Lock2C", Header = "Khóa 2C" },
            new() { Name = "ForwardedTo", Header = "Chuyển tiếp" },
            new() { Name = "VnptStatus", Header = "Trạng thái VNPT" },
            new() { Name = "Otp", Header = "OTP" },
            new() { Name = "LastMessageContent", Header = "Nội dung" }
        };
    }

    async Task OpenSettingsDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ComSettingsDialog>("Cấu hình hiển thị Cột & Cổng", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            StateHasChanged();
        }
    }

    public class ColumnItem
    {
        public string Name { get; set; } = "";
        public string Header { get; set; } = "";
    }
    private RenderFragment RenderLoadingOrValue(gsm.Models.SimPort context, string value, string fallback = "—", bool forceLoading = false) => __builder =>
    {
        bool isLoading = string.IsNullOrEmpty(value)
                         && (context.Status == gsm.Models.SimStatus.Connecting || forceLoading);
        if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            @(!string.IsNullOrEmpty(value) ? value : fallback)
        }
    };
    void CopyToExcel()
    {
        var cols = VisibleColumns;
        var rows = SelectedItems.Any() ? SelectedItems.Cast<SimPort>().ToList() : VisiblePorts.ToList();

        var sb = new System.Text.StringBuilder();

        // Header row
        sb.AppendLine(string.Join("\t", cols.Select(c => c.Header)));

        // Data rows
        int stt = 1;
        foreach (var p in rows)
        {
            var values = cols.Select(col => col.Name switch
            {
                "Stt"                => (stt++).ToString(),
                "PortName"           => p.PortName ?? "",
                "Status"             => p.Status?.ToString() ?? "",
                "NetworkProvider"    => p.NetworkProvider ?? "",
                "NetworkType"        => p.NetworkType ?? "",
                "Signal"             => p.SignalDisplay,
                "Balance"            => p.Balance ?? "",
                "PhoneNumber"        => p.PhoneNumber ?? "",
                "Imei"               => p.Imei ?? "",
                "Serial"             => p.Serial ?? "",
                "ExpiryDate"         => p.ExpiryDate ?? "",
                "SimRegDate"         => p.SimRegDate ?? "",
                "Lock1C"             => p.Lock1C ?? "",
                "Lock2C"             => p.Lock2C ?? "",
                "ForwardedTo"        => p.ForwardedTo ?? "",
                "VnptStatus"         => p.VnptStatus ?? "",
                "Otp"                => p.Otp ?? "",
                "LastMessageContent" => p.LastMessageContent ?? "",
                _                    => ""
            });
            // Escape tab/newline trong ô để không bị lệch cột
            sb.AppendLine(string.Join("\t", values.Select(v => v.Replace("\t", " ").Replace("\r\n", " ").Replace("\n", " "))));
        }

        // Dùng System.Windows.Clipboard (WPF) để đặt text Unicode — đây là clipboard đúng cho Excel
        try
        {
            System.Windows.Application.Current.Dispatcher.Invoke(() =>
            {
                System.Windows.Clipboard.SetText(sb.ToString(), System.Windows.TextDataFormat.UnicodeText);
            });
            Snackbar.Add($"✅ Đã copy {rows.Count} dòng vào clipboard — Paste thẳng vào Excel!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Copy Excel lỗi: " + ex.Message, Severity.Error);
        }
    }
