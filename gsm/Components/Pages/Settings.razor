    // ========== TEST WEBHOOK ==========
    async Task TestWebhook()
    {
        if (string.IsNullOrWhiteSpace(_otpWebhookUrl))
        {
            Snackbar.Add("Nhập Webhook URL trước", Severity.Warning);
            return;
        }

        Snackbar.Add("Đang gửi test Webhook...", Severity.Info);

        try
        {
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
            var payload = new
            {
                event_type = "test",
                port = "TEST_PORT",
                phone = "0900000000",
                sender = "TEST_SENDER",
                otp = "123456",
                content = "[Tool GSM] Test webhook thành công!",
                imei = "",
                ccid = "",
                time = DateTime.Now.ToString("o"),
                timestamp = DateTimeOffset.Now.ToUnixTimeSeconds()
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var resp = await http.PostAsync(_otpWebhookUrl, content);

            string respBody = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
                Snackbar.Add($"✓ Webhook OK ({(int)resp.StatusCode})", Severity.Success);
            else
                Snackbar.Add($"Webhook lỗi {(int)resp.StatusCode}: {respBody.Substring(0, Math.Min(100, respBody.Length))}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Webhook lỗi: " + ex.Message, Severity.Error);
        }
    }

    // ========== ÂM THANH ==========
    void BrowseSound(string type)
    {
        var path = FileDialog.OpenFile("WAV files (*.wav)|*.wav|All files (*.*)|*.*");
        if (string.IsNullOrEmpty(path)) return;

        if (type == "sms") _soundSmsPath = path;
        else if (type == "call") _soundCallPath = path;
        else if (type == "otp") _soundOtpPath = path;

        Snackbar.Add($"✓ Đã chọn file âm thanh {type.ToUpper()}", Severity.Success);
    }

    void TestSound(string type)
    {
        var path = type switch
        {
            "sms" => _soundSmsPath,
            "call" => _soundCallPath,
            "otp" => _soundOtpPath,
            _ => ""
        };

        if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
        {
            Snackbar.Add($"File âm thanh {type.ToUpper()} không tồn tại hoặc chưa chọn", Severity.Warning);
            return;
        }

        Audio.Play(path);
        Snackbar.Add($"▶ Đang phát âm thanh {type.ToUpper()}...", Severity.Normal);
    }

    // ========== XÓA DỮ LIỆU ==========
    async Task ClearAllData()
    {
        var ok = await DialogService.ShowMessageBox(
            "⚠ CẢNH BÁO",
            "Xóa TOÀN BỘ dữ liệu tool? Thao tác này không thể hoàn tác!",
            yesText: "XÓA HẾT", cancelText: "Hủy");
        if (ok != true) return;

        try
        {
            var dataDir = Path.Combine(AppContext.BaseDirectory, "Data");
            if (Directory.Exists(dataDir))
                Directory.Delete(dataDir, true);
            Snackbar.Add("✓ Đã xóa toàn bộ dữ liệu tool", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi xóa: " + ex.Message, Severity.Error);
        }
    }
