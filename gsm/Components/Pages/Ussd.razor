    // ========== 7. SPAM SMS ==========
    async Task StartSpamSms()
    {
        if (string.IsNullOrWhiteSpace(_spamPhone) || string.IsNullOrWhiteSpace(_spamContent))
        {
            Snackbar.Add("Nhập số và nội dung", Severity.Warning);
            return;
        }

        var phones = _spamPhone.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                               .Select(x => x.Trim()).Where(x => x.Length >= 9).ToList();

        if (!phones.Any())
        {
            Snackbar.Add("Không có số hợp lệ (tối thiểu 9 chữ số)", Severity.Warning);
            return;
        }

        var ports = _selectedPorts.Any()
            ? _selectedPorts.Where(p => p.Status == SimStatus.Active).Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        if (phones.Count * ports.Count > 50)
        {
            var ok = await DialogService.ShowMessageBox("Xác nhận",
                $"Gửi {phones.Count} số × {ports.Count} cổng = {phones.Count * ports.Count} tin?\nThao tác này có thể mất nhiều thời gian.",
                yesText: "Bắt đầu", cancelText: "Hủy");
            if (ok != true) return;
        }

        _spamCts?.Cancel();
        _spamCts?.Dispose();
        _isSpamming = true;
        _isStoppingSpam = false;
        var spamCts = new CancellationTokenSource();
        _spamCts = spamCts;
        CancellationToken token = spamCts.Token;
        _spamLog = $"[{DateTime.Now:HH:mm:ss}] Bắt đầu spam {phones.Count} số × {ports.Count} cổng\n";

        int sent = 0, fail = 0, uncertain = 0;
        try
        {
            foreach (var phone in phones)
            {
                if (token.IsCancellationRequested) break;

                foreach (var port in ports)
                {
                    if (token.IsCancellationRequested) break;

                    try
                    {
                        if (!Vm.IsPortReadyForOperation(port))
                        {
                            fail++;
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} ✗ Cổng không còn Active / SIM đã thay đổi\n";
                            continue;
                        }

                        var res = await Vm.QueueSmsAsync(port, phone, _spamContent, token);
                        gsm.Services.SmsSubmitDisposition disposition =
                            gsm.Services.GsmSmsService.ClassifySubmitResult(res);
                        if (disposition == gsm.Services.SmsSubmitDisposition.Confirmed)
                        {
                            sent++;
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} ✓ OK\n";
                        }
                        else if (disposition == gsm.Services.SmsSubmitDisposition.PayloadSubmittedUncertain)
                        {
                            uncertain++;
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} ⚠ Có thể đã gửi; không tự gửi lại\n";
                            if (token.IsCancellationRequested) break;
                        }
                        else if (disposition == gsm.Services.SmsSubmitDisposition.CancelledBeforePayload
                                 && token.IsCancellationRequested)
                        {
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} ⏹ Dừng trước Ctrl+Z\n";
                            break;
                        }
                        else
                        {
                            fail++;
                            _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} ✗ {res.Trim()}\n";
                        }
                    }
                    catch (Exception ex)
                    {
                        fail++;
                        _spamLog += $"[{DateTime.Now:HH:mm:ss}] {port} → {phone} ✗ {ex.Message}\n";
                    }
                    StateHasChanged();
                    await Task.Delay(_spamDelay, token);
                }
            }
        }
        catch (OperationCanceledException)
        {
            _spamLog += $"[{DateTime.Now:HH:mm:ss}] Đã dừng bởi người dùng.\n";
        }
        finally
        {
            _isSpamming = false;
            _isStoppingSpam = false;
            if (ReferenceEquals(_spamCts, spamCts))
                _spamCts = null;
            spamCts.Dispose();
        }

        _spamLog += $"\n[{DateTime.Now:HH:mm:ss}] ✅ Xong • Gửi: {sent} • Có thể đã gửi: {uncertain} • Lỗi: {fail}\n";
        Snackbar.Add(
            $"Spam xong: {sent} OK, {uncertain} có thể đã gửi, {fail} lỗi",
            fail > 0 || uncertain > 0 ? Severity.Warning : token.IsCancellationRequested ? Severity.Info : Severity.Success);
    }

    void StopSpamSms()
    {
        if (_spamCts == null || _spamCts.IsCancellationRequested) return;
        _isStoppingSpam = true;
        _spamCts?.Cancel();
        Snackbar.Add(
            "Đang dừng spam; SMS đã qua Ctrl+Z có thể vẫn được nhà mạng nhận.",
            Severity.Info);
        StateHasChanged();
    }

    // ========== 9. SPAM / CHECK GỌI ==========
    async Task StartCheckCall()
    {
        if (string.IsNullOrWhiteSpace(_checkCallPhone))
        {
            Snackbar.Add("Nhập số điện thoại", Severity.Warning);
            return;
        }

        var ports = _selectedPorts.Any()
            ? _selectedPorts.Where(p => p.Status == SimStatus.Active && Vm.IsPortReadyForOperation(p.PortName))
                            .Select(p => p.PortName).ToList()
            : ActivePorts.Select(p => p.PortName).ToList();

        if (!ports.Any())
        {
            Snackbar.Add("Không có cổng Active / đã chọn", Severity.Warning);
            return;
        }

        _checkCallCts?.Cancel();
        _checkCallCts?.Dispose();
        _checkCallCts = new CancellationTokenSource();
        var ct = _checkCallCts.Token;
        _isCheckingCall = true;
        Snackbar.Add($"Đang check gọi {_checkCallPhone} trên {ports.Count} cổng...", Severity.Info);

        foreach (var port in ports)
        {
            if (ct.IsCancellationRequested) break;

            try
            {
                if (!Vm.IsPortReadyForOperation(port))
                    throw new InvalidOperationException("Cổng không còn Active hoặc SIM đã thay đổi.");

                bool callOk = await Vm.ExecuteCallFromUiAsync(
                    port, _checkCallPhone, string.Empty, _checkCallDuration,
                    record: false, ct: ct);
                string result = callOk ? "Gọi thành công" : "Cuộc gọi thất bại hoặc không được kết nối";
                _callCheckHistory.Insert(0, new CallCheckItem
                {
                    Time = DateTime.Now,
                    Port = port,
                    Phone = _checkCallPhone,
                    Duration = callOk ? _checkCallDuration : 0,
                    Success = callOk,
                    Result = result
                });
                SetPortContent(port, $"[CALL][{(callOk ? "HOÀN TẤT" : "THẤT BẠI")}] {result}");
                Snackbar.Add($"[{port}] {result}", callOk ? Severity.Success : Severity.Warning);
            }
            catch (OperationCanceledException)
            {
                try { await ModemService.SendCommandAsync(port, "ATH", 3000); } catch { }
                break;
            }
            catch (Exception ex)
            {
                _callCheckHistory.Insert(0, new CallCheckItem
                {
                    Time = DateTime.Now, Port = port, Phone = _checkCallPhone,
                    Duration = 0, Success = false, Result = ex.Message
                });
                Snackbar.Add($"[{port}] Lỗi: {ex.Message}", Severity.Error);
            }
            try { await Task.Delay(800, ct); }
            catch (OperationCanceledException) { break; }
        }

        _isCheckingCall = false;
        if (_callCheckHistory.Count > 100)
            _callCheckHistory.RemoveRange(100, _callCheckHistory.Count - 100);
    }

    async Task StopAllCalls()
    {
        _checkCallCts?.Cancel();
        var tasks = Ports.Select(async p =>
        {
            try
            {
                string response = await ModemService.SendCommandAsync(p.PortName, "ATH", 3000, true);
                return !IsCommandFailure(response);
            }
            catch
            {
                return false;
            }
        });
        bool[] results = await Task.WhenAll(tasks);
        _isCheckingCall = false;
        int ok = results.Count(x => x);
        Snackbar.Add($"Dập cuộc gọi: {ok}/{results.Length} COM phản hồi",
            ok == results.Length ? Severity.Success : Severity.Warning);
    }

    // ========== 10. DTMF ==========
    async Task SendDtmf()
    {
        if (string.IsNullOrWhiteSpace(_dtmfPort) || string.IsNullOrWhiteSpace(_dtmfCode))
        {
            Snackbar.Add("Chọn cổng và nhập mã DTMF", Severity.Warning);
            return;
        }

        if (!Vm.IsPortReadyForOperation(_dtmfPort))
        {
            Snackbar.Add($"[{_dtmfPort}] Cổng không còn Active hoặc SIM đã thay đổi", Severity.Warning);
            return;
        }

        try
        {
            var cmd = $"AT+VTS=\"{_dtmfCode}\"";
            var resp = await ModemService.SendCommandAsync(_dtmfPort, cmd, 8000);

            if (resp.Contains("ERROR"))
            {
                // Fallback: thử AT+QVTS (Quectel specific)
                resp = await ModemService.SendCommandAsync(_dtmfPort, $"AT+QVTS=\"{_dtmfCode}\"", 8000);
                if (resp.Contains("ERROR"))
                {
                    Snackbar.Add($"[{_dtmfPort}] DTMF lỗi: {resp.Trim()}", Severity.Error);
                    _dtmfLog += $"[{DateTime.Now:HH:mm:ss}] {_dtmfPort} DTMF {_dtmfCode} → LỖI: {resp.Trim()}\n";
                    return;
                }
            }

            _dtmfLog += $"[{DateTime.Now:HH:mm:ss}] {_dtmfPort} DTMF {_dtmfCode} → OK\n";
            Snackbar.Add($"[{_dtmfPort}] Đã gửi DTMF: {_dtmfCode}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"DTMF lỗi: {ex.Message}", Severity.Error);
            _dtmfLog += $"[{DateTime.Now:HH:mm:ss}] {_dtmfPort} DTMF {_dtmfCode} → Exception: {ex.Message}\n";
        }
    }

    // ========== 11. THÔNG BÁO ==========
    void SaveNotifySettings()
    {
        try
        {
            var settings = gsm.Services.SettingsService.Current;
            if (settings != null)
            {
                settings.SoundOnSms = _notifySms;
                settings.SoundOnCall = _notifyCall;
                settings.SoundOnOtp = _notifyOtp;
                settings.TelegramOnOtp = _notifyTelegram;
                gsm.Services.SettingsService.SaveSettings(settings);
                Snackbar.Add("Đã lưu cài đặt thông báo", Severity.Success);
            }
            else
            {
                Snackbar.Add("Không tải được cấu hình để lưu thông báo", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi lưu: " + ex.Message, Severity.Error);
        }
    }

